+                    }
+                    $_c3R = UcrmCatalogue::setMode($store, true, (int)$_c3Off['install']['p'], $_c3Actor, $_c3Cfg, $_c3Dir);
+                } else {
+                    $_c3R = UcrmCatalogue::setMode($store, false, null, $_c3Actor, $_c3Cfg, $_c3Dir);
