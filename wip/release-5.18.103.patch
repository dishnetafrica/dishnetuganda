+        $off = $this->offered($installId, $applyKeptOff ? $keptOff : []);
+        $prev = $this->directWords;
+        $this->directWords = true;
+        try {
+            $lines = [];
+            $pl = null;
+            foreach ($off['plans'] as $row) {
+                if ($row['sp'] === $plan['sp'] && $row['p'] === $plan['p']) { $pl = $row; break; }
+            }
+            if ($pl === null) {
