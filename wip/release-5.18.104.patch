+    public static function masterCheck(string $pluginRoot): string
+    {
+        $src = @file_get_contents(rtrim($pluginRoot, '/') . '/cron/master.php');
+        if (!is_string($src) || $src === '') return 'unreadable';
+        $start = strpos($src, '$_m_jobs = [');
