+            foreach ($row['options'] as $o) $c[$o['key']] = $o['type'] === 'channels' ? 'all' : SalesFollowupLadder::today($now - $ago);
+            if ($row['ledger']) { $c['wa_send_ledger'] = 'on'; $c['wa_send_ledger_since'] = UtcClock::stamp($now - $ago); }
+        }
+        if ($s === $upto) break;
