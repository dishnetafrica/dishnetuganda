+        $ctx->eq(QuoteAgentCopy::usableAddress('  Agent.One@Agents.EXAMPLE.test '), 'agent.one@agents.example.test', 'A1 upper case lower-cased, trimmed');
+        $bad = [
+            'empty' => '', 'no @' => 'agent.agents.example.test', 'two @' => 'a@b@agents.example.test',
