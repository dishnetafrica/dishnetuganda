+    $esc = function (array $b, int $conv): int {
+        return (int)vm_q($b, "SELECT COUNT(*) n FROM events WHERE event_type = 'wa.escalation' AND entity_id = ?", [$conv])[0]['n'];
+    };
+    $state = function (array $b, int $conv): string {
