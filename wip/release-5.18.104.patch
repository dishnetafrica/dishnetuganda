+    public static function parseTime($v): ?int
+    {
+        if (is_int($v)) return $v > 0 ? $v : null;
+        if (!is_string($v) || trim($v) === '') return null;
+        $s = trim($v);
+        $t = ctype_digit($s) ? (int)$s : UtcClock::parse($s);
+        return $t > 0 ? $t : null;
+    }
+
+    /** The Kampala date of $t, Y-m-d. */
+    public static function today(int $t): string
+    {
+        return (new \DateTime('@' . $t))->setTimezone(new \DateTimeZone(self::TZ))->format('Y-m-d');
+    }
+
+    // ── the one status vocabulary (ruling R6) ─────────────────────────────────────────────────────────────────
+
+    /**
+     * A check's status read strictly: PASS, FAIL <code>, NOT_YET too_soon|no_traffic|no_test. Anything else — WAIT, WARN,
+     * an empty string, a note — is FAIL unknown_status, never taken as PASS (TL17).
+     *
+     * @return array{kind:string, code:string, status:string}
+     */
+    public static function status(string $s): array
+    {
+        $s = trim($s);
+        if ($s === 'PASS') return ['kind' => 'PASS', 'code' => '', 'status' => 'PASS'];
+        if (preg_match('/^FAIL ([A-Za-z0-9_:.\-]+)$/', $s, $m)) return ['kind' => 'FAIL', 'code' => $m[1], 'status' => $s];
+        if (preg_match('/^NOT_YET (too_soon|no_traffic|no_test)$/', $s, $m)) return ['kind' => 'NOT_YET', 'code' => $m[1], 'status' => $s];
+        return ['kind' => 'FAIL', 'code' => 'unknown_status', 'status' => 'FAIL unknown_status'];
+    }
+
+    /**
+     * A step's one status: its check, or for step 2 the worse of L-ON and VA-ON1 (FAIL before NOT_YET before PASS; L-ON's
+     * code where both give the status). $checker(id) answers a check's result array.
+     *
+     * @return array{kind:string, code:string, status:string, parts:array<string,array>}
+     */
+    public static function stepStatus(string $step, callable $checker): array
+    {
+        $row = self::STEPS[$step] ?? null;
+        if ($row === null) return ['kind' => 'FAIL', 'code' => 'unknown_step', 'status' => 'FAIL unknown_step', 'parts' => []];
+        $rank = ['PASS' => 0, 'NOT_YET' => 1, 'FAIL' => 2];
+        $best = null; $parts = [];
+        foreach ($row['check'] as $id) {
+            $r = $checker($id);
+            $parts[$id] = is_array($r) ? $r : [];
+            $s = self::status((string)($parts[$id]['status'] ?? ''));
+            if ($best === null || $rank[$s['kind']] > $rank[$best['kind']]) $best = $s;
+        }
+        $best = $best ?? self::status('');
+        $best['parts'] = $parts;
+        return $best;
+    }
+
+    // ── admission: rules 2, 3 and 4 (§H.2.12.3) ────────────────────────────────────────────────────────────────
+
+    /**
+     * Whether `on <step>` may proceed past ORDER, the running FAILs and the Needs. Rule 1 (tenant, uid) is the tool's;
+     * rule 5 (options, then the row's own precondition) runs after this.
+     *
+     * @param ?string  $accept  the --accept-not-yet reason, or null
+     * @param callable $checker fn(string $id): array{status, counts, notes}
+     * @return array{ok:bool, code:?string, lines:list<string>, overrides:array<string,string>}
+     */
+    public static function admit(array $config, string $step, ?string $accept, int $now, callable $checker): array
+    {
+        $no = function (string $code, array $lines): array { return ['ok' => false, 'code' => $code, 'lines' => $lines, 'overrides' => []]; };
+        $row = self::STEPS[$step] ?? null;
+        if ($row === null) return $no('unknown_step', []);
+        $lines = [];
+        $lower = array_slice(self::steps(), 0, (int)array_search($step, self::steps(), true));
+        // Rule 2: every lower step on, skipped, or optional (a skipped voice step never serves a voice step).
+        foreach ($lower as $l) {
+            if (self::STEPS[$l]['optional']) continue;
+            if (self::isOn($config, $l)) continue;
+            if (self::isSkipped($config, $l) && !(self::STEPS[$l]['voice'] && $row['voice'])) continue;
+            return $no('order:' . $l, ['step ' . self::STEPS[$l]['n'] . ' (' . $l . ') is neither on nor recorded skipped']);
+        }
+        // Rule 3: no lower step that is on reads FAIL now (step 2 by its one status).
+        foreach ($lower as $l) {
+            if (!self::isOn($config, $l)) continue;
+            $s = self::stepStatus($l, $checker);
+            if ($s['kind'] === 'FAIL') {
+                return $no('earlier_fail:' . $l, ['step ' . self::STEPS[$l]['n'] . ' (' . $l . ') reads ' . $s['status'] . ': turn it off or skip it first']);
+            }
+        }
+        // Rule 4: every need on (not skipped), on long enough, its check at PASS or an accepted NOT_YET no_traffic.
+        $overrides = [];
+        foreach ($row['needs'] as $need) {
+            $n = $need['step'];
+            $label = $n === 'sending' ? 'the ledger' : 'step ' . self::STEPS[$n]['n'] . ' (' . $n . ')';
+            if (!self::isOn($config, $n)) {
+                return $no('need_off:' . $n, [$label . ' is not on' . (self::isSkipped($config, $n) ? ' (recorded skipped, which no need accepts)' : '')]);
+            }
+            $since = self::sinceOf($config, $n);
+            if ($need['min_on_s'] > 0 && ($since === null || $now - $since < $need['min_on_s'])) {
+                return $no('need_too_soon:' . $n, [$label . ' has not been on for ' . intdiv($need['min_on_s'], 3600) . ' h']);
+            }
+            if ($need['check'] === null) continue;
+            $s = self::status((string)(($checker($need['check']))['status'] ?? ''));
+            if ($s['kind'] === 'PASS') { $lines[] = $label . ': ' . $need['check'] . ' PASS'; continue; }
+            if ($s['kind'] === 'NOT_YET' && $s['code'] === 'no_traffic' && !$need['pass_only']) {
+                $old = trim((string)($config['sf_override_' . $n] ?? ''));
+                $long = $since !== null && $now - $since >= self::ACCEPT_AFTER_S;
+                if ($long && ($old !== '' || ($accept !== null && trim($accept) !== ''))) {
+                    if ($old === '') $overrides['sf_override_' . $n] = UtcClock::stamp($now) . '|' . trim((string)$accept);
+                    $lines[] = $label . ': ' . $need['check'] . ' NOT_YET no_traffic, accepted';
+                    continue;
+                }
+                return $no('need_not_yet:' . $n, [$label . ': ' . $need['check'] . ' reads ' . $s['status']
+                    . ($long ? ' (--accept-not-yet "<reason>" accepts it)' : ' (it may be accepted once it has been on for 72 h)')]);
+            }
+            return $no(($s['kind'] === 'FAIL' ? 'need_fail:' : 'need_not_pass:') . $n,
+                       [$label . ': ' . $need['check'] . ' reads ' . $s['status'] . ($need['pass_only'] ? ' (this need is met only by PASS)' : '')]);
+        }
+        return ['ok' => true, 'code' => null, 'lines' => $lines, 'overrides' => $overrides];
+    }
+
+    // ── skip and off: the cascades and the one sequence ────────────────────────────────────────────────────────
+
+    /** The steps a `skip` of $step also records skipped: every step whose Needs name it, recursively, in order. @return string[] */
+    public static function skipCascade(string $step): array
+    {
+        $out = [];
+        $todo = [$step];
+        while ($todo !== []) {
+            $s = array_shift($todo);
+            foreach (self::STEPS as $name => $row) {
+                foreach ($row['needs'] as $need) {
+                    if ($need['step'] === $s && !in_array($name, $out, true) && $name !== $step) { $out[] = $name; $todo[] = $name; }
+                }
+            }
+        }
+        return array_values(array_filter(self::steps(), function ($n) use ($out) { return in_array($n, $out, true); }));
+    }
+
+    /** The steps `off <step>` clears: the step and its "off also clears", recursively, in the one sequence. @return string[] */
+    public static function offCascade(string $step): array
+    {
+        if (!isset(self::STEPS[$step])) return [];
+        $set = [$step];
+        $todo = [$step];
+        while ($todo !== []) {
+            $s = array_shift($todo);
+            foreach (self::STEPS[$s]['clears'] as $c) {
+                if (!in_array($c, $set, true)) { $set[] = $c; $todo[] = $c; }
+            }
+        }
+        return self::inSequence($set);
+    }
+
+    /** $steps ordered by the one sequence (row 1b, never in it, last). @return string[] */
+    public static function inSequence(array $steps): array
+    {
+        $out = [];
+        foreach (self::SEQUENCE as $s) if (in_array($s, $steps, true)) $out[] = $s;
+        foreach ($steps as $s) if (!in_array($s, $out, true)) $out[] = $s;
+        return $out;
+    }
+
+    /**
+     * What `off <what>` does, in order: each action is [kind, name] with kind 'step' (its hook and keys), 'ledger' (the
+     * ledger's keys, under both locks) or 'last' (the record keys and Part P's two keys). @return array<int,array{0:string,1:string}>
+     */
+    public static function offPlan(string $what): array
+    {
+        if ($what === 'all') {
+            $plan = [];
+            foreach (self::SEQUENCE as $s) $plan[] = ['step', $s];
+            $plan[] = ['ledger', 'sending'];
+            $plan[] = ['last', 'records'];
+            return $plan;
+        }
+        if ($what === 'sending') return [['ledger', 'sending']];
+        if ($what === 'agent-cc') return [['step', 'agent-cc']];
+        $plan = [];
+        foreach (self::offCascade($what) as $s) $plan[] = ['step', $s];
+        return $plan;
+    }
+
+    /** A row's off-hook, or null: [part, place, when]. */
+    public static function hookOf(string $step): ?array
+    {
+        return self::STEPS[$step]['hook'] ?? null;
+    }
+
+    /** The locks taken before $step's keys clear ('quote': the quote pass's; 'offers': the offers sender's). @return string[] */
+    public static function locksOf(string $step): array
+    {
+        if ($step === 'sending') return ['quote', 'offers'];
+        return self::STEPS[$step]['locks'] ?? [];
+    }
+
+    // ── the dispatch: ruling R13's table ───────────────────────────────────────────────────────────────────────
+
+    /** Load a part's holder from this directory (each holder loads what it needs itself). */
+    public static function load(string $part): void
+    {
+        $files = ['F' => ['SalesFollowupChecks', 'QuoteChase'], 'V' => ['VoiceSteps'], 'O' => ['OfferSwitch'], 'P' => ['QuoteAgentCopy']];
+        foreach ($files[$part] ?? [] as $c) {
+            if (!class_exists($c)) require_once __DIR__ . '/' . $c . '.php';
+        }
+    }
+
+    /**
+     * A check by id, dispatched to the callable ruling R13 names, given the tool's $ro. 'report' is the engine's own:
+     * PASS once sf_report_ran_at is set.
+     *
+     * @return array{status:string, counts:array<string,int>, notes:list<string>}
+     */
+    public static function check(\PDO $ro, array $config, string $dataDir, string $pluginRoot, string $id, int $now): array
+    {
+        try {
+            switch ($id) {
+                case 'report':
+                    return ['status' => self::isOn($config, 'report') ? 'PASS' : 'FAIL report_not_run', 'counts' => [], 'notes' => []];
+                case 'AC-ON':
+                    self::load('P');
+                    return \QuoteAgentCopy::check($ro, $pluginRoot, $dataDir, $now);
+                case 'L-ON': case 'Q1-ON': case 'Q2-ON': case 'Q3-ON': case 'Q5-ON':
+                    self::load('F');
+                    return \SalesFollowupChecks::check($ro, $config, $dataDir, $id, $now);
+                case 'VA-ON1': case 'VN-ON1': case 'VN-ON2': case 'VN-ON3': case 'VN-ON4':
+                    self::load('V');
+                    return \VoiceSteps::check($ro, $config, $dataDir, $id, $now);
+                case 'offers-test':
+                    self::load('O');
+                    return \OfferSwitch::checkTest($ro, $config, $dataDir, $now);
+                case 'offers-live':
+                    self::load('O');
+                    return \OfferSwitch::checkLive($ro, $config, $dataDir, $now);
+            }
+        } catch (\Throwable $e) {
+            return ['status' => 'FAIL check_threw', 'counts' => [], 'notes' => ['the check ' . $id . ' could not run (' . get_class($e) . ')']];
+        }
+        return ['status' => 'FAIL unknown_check', 'counts' => [], 'notes' => []];
+    }
+
+    /**
+     * A row's own precondition: each part's half in order, the first refusal answering; ruling R13's shape. Row 1b's is
+     * QuoteAgentCopy::preconditions($dataDir), given no connection; rows 8 and 9 have none.
+     *
+     * @return array{ok:bool, code:?string, lines:list<string>}
+     */
+    public static function precondition(\PDO $ro, array $config, string $dataDir, string $step): array
+    {
+        $row = self::STEPS[$step] ?? null;
+        if ($row === null) return ['ok' => false, 'code' => 'unknown_step', 'lines' => []];
+        $lines = [];
+        foreach ($row['pre'] as $part) {
+            self::load($part);
+            try {
+                switch ($part) {
+                    case 'F': $p = \SalesFollowupChecks::preconditions($ro, $config, $dataDir, $step); break;
+                    case 'V': $p = \VoiceSteps::preconditions($ro, $config, $dataDir, $step); break;
+                    case 'O': $p = \OfferSwitch::preconditions($ro, $config, $dataDir, $step); break;
+                    case 'P': $p = \QuoteAgentCopy::preconditions($dataDir); break;
+                    default:  $p = ['ok' => false, 'code' => 'unknown_part', 'lines' => []];
+                }
+            } catch (\Throwable $e) {
+                return ['ok' => false, 'code' => 'precondition_threw', 'lines' => array_merge($lines, ['the precondition of part ' . $part . ' could not run (' . get_class($e) . ')'])];
+            }
+            $lines = array_merge($lines, array_map('strval', (array)($p['lines'] ?? [])));
+            if (empty($p['ok'])) {
+                $code = (string)($p['code'] ?? '');
+                return ['ok' => false, 'code' => $code !== '' ? $code : 'precondition', 'lines' => $lines];
+            }
+        }
+        return ['ok' => true, 'code' => null, 'lines' => $lines];
+    }
+
+    /**
+     * A row's off-hook on the tool's $rw, $why 'switch' or 'rollback'. Returns its counts; throws on failure (the tool
+     * reports it by the hook's place, §H.2.12.4). A hook whose `when` is rollback runs only in the rollback.
+     *
+     * @return array<string,int>|null null when the row has no hook to run now
+     */
+    public static function runHook(\PDO $rw, array $config, string $dataDir, string $step, string $why): ?array
+    {
+        $h = self::hookOf($step);
+        if ($h === null) return null;
+        if ($h[2] === 'rollback' && $why !== 'rollback') return null;
+        self::load($h[0]);
+        switch ($h[0]) {
+            case 'F': return \QuoteChase::offHook($rw, $config, $dataDir, $step, $why);
+            case 'V': return \VoiceSteps::offHook($rw, $config, $dataDir, $step, $why);
+            case 'O': return \OfferSwitch::offHook($rw, $config, $dataDir, $step, $why);
+        }
+        throw new \RuntimeException('no holder for this hook');
+    }
+
+    // ── options and settings (rule 5; §H.2.12.7) ───────────────────────────────────────────────────────────────
+
+    /**
+     * A row's options, validated by their declarations before any precondition is called: each declared option present,
+     * none undeclared, each value inside its declaration. $known lists the channel ids a `channels` option may name.
+     *
+     * @param array<string,string> $opts the options given (without the tool's own: accept-not-yet)
+     * @return array{ok:bool, code:?string, line:string, keys:array<string,string>}
+     */
+    public static function validateOptions(string $step, array $opts, array $known, int $now): array
+    {
+        $no = function (string $code, string $line): array { return ['ok' => false, 'code' => $code, 'line' => $line, 'keys' => []]; };
+        $row = self::STEPS[$step] ?? null;
+        if ($row === null) return $no('unknown_step', 'no such step');
+        foreach (array_keys($opts) as $o) {
+            if (!isset($row['options'][$o])) return $no('option_undeclared', '--' . $o . ' is not an option of ' . $step);
+        }
+        $keys = [];
+        foreach ($row['options'] as $name => $decl) {
+            if (!array_key_exists($name, $opts) || trim((string)$opts[$name]) === '') return $no('option_missing', $step . ' needs --' . $name);
+            $v = trim((string)$opts[$name]);
+            if ($decl['type'] === 'date') {
+                if (!self::dateOk($v, 'past', $now)) return $no('option_invalid', '--' . $name . ' must be a YYYY-MM-DD date not after today (Kampala)');
+            } elseif ($decl['type'] === 'channels') {
+                $v = strtolower($v);
+                if ($v !== 'all') {
+                    $ids = array_values(array_filter(array_map('trim', explode(',', $v)), 'strlen'));
+                    if ($ids === []) return $no('option_invalid', '--' . $name . ' names no channel');
+                    foreach ($ids as $id) {
+                        if (!in_array($id, $known, true)) return $no('option_invalid', '--' . $name . ' names a channel that is not known here');
+                    }
+                    $v = implode(',', array_values(array_unique($ids)));
+                }
+            }
+            $keys[$decl['key']] = $v;
+        }
+        return ['ok' => true, 'code' => null, 'line' => '', 'keys' => $keys];
+    }
+
+    /** A YYYY-MM-DD date; 'past' also requires it not after today in Kampala. */
+    public static function dateOk(string $v, string $when, int $now): bool
+    {
+        if (!preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $v, $m) || !checkdate((int)$m[2], (int)$m[3], (int)$m[1])) return false;
+        return $when !== 'past' || strcmp($v, self::today($now)) <= 0;
+    }
+
+    /** A setting's row by key or alias: [keys, row of the first]. Null for anything not declared. */
+    public static function settingOf(string $name): ?array
+    {
+        if (isset(self::PAIRS[$name])) return self::PAIRS[$name];
+        if (isset(self::SETTINGS[$name])) return [$name];
+        foreach (self::SETTINGS as $k => $r) {
+            if (($r['alias'] ?? '') === $name) return [$k];
+        }
+        return null;
+    }
+
+    /** A setting's inclusive range [min, max] (an acknowledgement row: VoiceAckLimits::RANGES, ruling R4). */
+    public static function rangeOf(string $key): ?array
+    {
+        $r = self::SETTINGS[$key] ?? null;
+        if ($r === null || $r['type'] !== 'int') return null;
+        if (isset($r['ack'])) return VoiceAckLimits::RANGES[$r['ack']] ?? null;
+        return [(int)$r['min'], (int)$r['max']];
+    }
+
+    /**
+     * `set <key|alias> <value…>`, validated by the declared row(s); nothing is saved on a refusal and nothing is clamped.
+     * A switch key, a record key, a pre-existing key or an undeclared name is refused. $retailerIds lists the active
+     * accounts' ids (for list-staff).
+     *
+     * @param string[] $values
+     * @return array{ok:bool, code:?string, line:string, changes:array<string,string>}
+     */
+    public static function validateSet(string $name, array $values, array $config, array $retailerIds, int $now): array
+    {
+        $no = function (string $code, string $line): array { return ['ok' => false, 'code' => $code, 'line' => $line, 'changes' => []]; };
+        if (in_array($name, self::allKeys(), true) || in_array($name, self::preexistingKeys(), true)) {
+            return $no('not_a_setting', $name . ' is not a setting: `set` never writes a switch, a record or an existing key');
+        }
+        $keys = self::settingOf($name);
+        if ($keys === null) return $no('undeclared', $name . ' is not a declared setting');
+        $values = array_values(array_map(function ($v) { return trim((string)$v); }, $values));
+        if (count($values) !== count($keys)) return $no('arity', $name . ' takes ' . count($keys) . ' value' . (count($keys) > 1 ? 's' : ''));
+        $changes = [];
+        foreach ($keys as $i => $k) {
+            $r = self::SETTINGS[$k];
+            $v = $values[$i];
+            if ($r['type'] === 'int') {
+                if (!preg_match('/^\d{1,9}$/', $v)) return $no('out_of_range', $k . ' takes a whole number');
+                [$lo, $hi] = self::rangeOf($k);
+                if ((int)$v < $lo || (int)$v > $hi) return $no('out_of_range', $k . ' must be within ' . $lo . '–' . $hi);
+                $changes[$k] = (string)(int)$v;
+            } elseif ($r['type'] === 'date') {
+                if (!self::dateOk($v, $r['when'], $now)) return $no('out_of_range', $k . ' takes a YYYY-MM-DD date' . ($r['when'] === 'past' ? ' not after today' : ''));
+                $changes[$k] = $v;
+            } elseif ($r['type'] === 'enum' && ($r['values'] ?? null) === 'retailers') {
+                $ids = array_values(array_filter(array_map('trim', explode(',', $v)), 'strlen'));
+                if ($ids === []) return $no('out_of_range', $k . ' takes one or more account ids');
+                foreach ($ids as $id) {
+                    if (!ctype_digit($id) || !in_array((int)$id, $retailerIds, true)) return $no('out_of_range', $k . ' takes active account ids only');
+                }
+                $changes[$k] = implode(',', array_values(array_unique($ids)));
+            } elseif ($r['type'] === 'enum') {
+                if (!in_array($v, (array)$r['values'], true)) return $no('out_of_range', $k . ' is one of ' . implode(', ', (array)$r['values']));
+                $changes[$k] = $v;
+            } else {
+                return $no('undeclared', $k . ' has no type');
+            }
+        }
+        // The pairs: the second bounded by the first, as the stored partner reads when only one is given.
+        foreach (self::PAIRS as $pair => [$a, $b]) {
+            if (!isset($changes[$a]) && !isset($changes[$b])) continue;
+            $va = (int)($changes[$a] ?? self::storedInt($config, $a));
+            $vb = (int)($changes[$b] ?? self::storedInt($config, $b));
+            $lowB = $pair === 'gap' ? $va : $va + 1;
+            if ($vb < $lowB) return $no('out_of_range', $b . ' must be at least ' . $lowB . ' with ' . $a . ' ' . $va);
+        }
+        foreach (self::SETTINGS as $k => $r) {
+            if (!isset($r['within'])) continue;
+            if (!isset($changes[$k])) continue;   // a narrower cap is never refused for another part's ceiling
+            $cap = isset($changes[$r['within']]) ? (int)$changes[$r['within']] : self::storedInt($config, $r['within']);
+            if ((int)$changes[$k] > $cap) return $no('out_of_range', $k . ' may not exceed ' . $r['within'] . ' (' . $cap . ')');
+        }
+        return ['ok' => true, 'code' => null, 'line' => '', 'changes' => $changes];
+    }
+
+    /** A setting as stored, or its default (the defaults each part's reader applies). */
+    private static function storedInt(array $config, string $key): int
+    {
+        $v = $config[$key] ?? null;
+        if (is_int($v)) return $v;
+        if (is_string($v) && preg_match('/^\s*\d{1,9}\s*$/', $v)) return (int)trim($v);
+        $r = self::SETTINGS[$key] ?? [];
+        if (isset($r['ack'])) return (int)(VoiceAckLimits::DEFAULTS[$r['ack']] ?? 0);
+        $defaults = ['wa_send_daily_cap' => 60, 'wa_send_hourly_cap' => 15, 'wa_send_gap_min_s' => 60, 'wa_send_gap_max_s' => 180,
+                     'wa_send_hour_from' => 8, 'wa_send_hour_to' => 20, 'offers_daily_max_per_handset' => 20];
+        return $defaults[$key] ?? 0;
+    }
+
+    /** A --reason (or a typed statement): free text with no run of 9 or more digits, so no phone enters the record. */
+    public static function reasonOk(string $s): bool
+    {
+        return trim($s) !== '' && !preg_match('/\d{9,}/', (string)preg_replace('/[\s().+\-]/', '', $s));
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/Transcriber.php b/dishnet-hybrid-sudan/lib/Transcriber.php
new file mode 100644
index 0000000..b103dfb
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/Transcriber.php
@@ -0,0 +1,137 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/MediaBlob.php';
+
+/**
+ * The transcription boundary (Batch 2 of the AI communication layer, docs/56; 5.18.104, root docs/73 §H.3.2, §H.3.9:
+ * ported from the development tree; the factory gains `openai`, lib/OpenAiTranscriber.php).
+ *
+ * Everything on this side — fetching the voice note, validating it, labelling and persisting the transcript, STOP
+ * detection, queueing the one ai.reply event — is this plugin's code and runs without a network. Everything on the
+ * other side is a provider that does NOT exist in this repository yet: no value of ai_transcription_provider selects a
+ * real one, and the operator chooses it (and whether audio may leave the server at all) after reading docs/56.
+ *
+ * A provider receives the bytes in memory and a time budget, and answers with the result shape below and nothing
+ * else: a transcript, or a FIXED reason code with a retryable flag. `detail` may name an HTTP status or an error class
+ * and may never carry audio, a transcript, a key, a phone number or a JID. PHP 7.4 compatible.
+ */
+interface TranscriberPort
+{
+    /** A short stable name for logs and the record: 'fake', later e.g. 'openai-whisper'. */
+    public function name(): string;
+
+    /**
+     * @param MediaBlob $audio          the bytes in memory, with mimetype, size and sha256 — never a path
+     * @param array     $hints          'mimetype' (as announced), 'seconds' (announced duration, 0 unknown),
+     *                                  'language' (BCP-47 hint or ''), 'channel' (sales | support | account)
+     * @param int       $timeoutSeconds the whole call must return within this many seconds
+     * @return array    ok=true:  ['ok' => true, 'text' => string, 'language' => string, 'duration_s' => float|null]
+     *                  ok=false: ['ok' => false, 'reason' => string (VoiceTranscription::REASONS), 'retryable' => bool,
+     *                             'detail' => string]
+     */
+    public function transcribe(MediaBlob $audio, array $hints, int $timeoutSeconds): array;
+}
+
+/**
+ * Which provider, from the configuration. Null means none: with ai_media_voice on, every voice note is then handed to
+ * a person with the reason `provider_missing` — never answered from a guess.
+ */
+final class TranscriberFactory
+{
+    /** The fake is constructible only when the test environment names its script file. Production never sets these. */
+    public const ENV_FAKE_FILE = 'DN_FAKE_TRANSCRIBER_FILE';
+    public const ENV_FAKE_LOG  = 'DN_FAKE_TRANSCRIBER_LOG';
+
+    public static function providerName(array $config): string
+    {
+        $p = strtolower(trim((string)($config['ai_transcription_provider'] ?? '')));
+        return $p === '' ? 'none' : $p;
+    }
+
+    public static function fromConfig(array $config): ?TranscriberPort
+    {
+        try {   // 5.18.104 (root docs/73 §H.3.9): the factory never throws; any doubt is no provider
+            $p = self::providerName($config);
+            if ($p === 'none') return null;
+            if ($p === 'openai') {
+                // 5.18.104 (root docs/73 §H.3.9): a key must be stored; the adapter reads it from the array itself.
+                if (trim((string)($config['openai_api_key'] ?? '')) === '') return null;
+                if (!class_exists('OpenAiTranscriber')) require_once __DIR__ . '/OpenAiTranscriber.php';
+                return new OpenAiTranscriber($config);
+            }
+            if ($p === 'fake') {
+                $file = (string)getenv(self::ENV_FAKE_FILE);
+                if ($file === '' || !is_file($file)) {
+                    error_log('[Transcriber] provider "fake" is test-only and its script file is not present — no provider');
+                    return null;
+                }
+                return FakeTranscriber::fromFile($file, (string)getenv(self::ENV_FAKE_LOG));
+            }
+            error_log('[Transcriber] unknown transcription provider — no provider (docs/56)');
+            return null;
+        } catch (\Throwable $e) {
+            return null;
+        }
+    }
+}
+
+/**
+ * The deterministic fake: the same audio always gives the same answer, from a script keyed by the audio's sha256.
+ *
+ *   sha256 => ['text' => 'what was said', 'language' => 'en']          a transcript ('' means nothing recognised)
+ *   sha256 => ['fail' => 'timeout' | 'provider_error' | 'invalid_audio' | 'unsupported_audio', 'retryable' => bool?]
+ *   '*'    => the answer for any audio not named
+ *
+ * Unscripted audio with no '*' entry is `invalid_audio`, permanent — a test must say what it expects. It records
+ * sha256 prefixes and counts only — never bytes, never the text — in memory and, when asked, to a log file so a test
+ * that ran the CLI runner can count the calls afterwards.
+ */
+final class FakeTranscriber implements TranscriberPort
+{
+    /** @var array<string,array> */
+    private $script;
+    /** @var string */
+    private $logPath;
+    /** @var array<int,array> */
+    public $calls = [];
+
+    public function __construct(array $script, string $logPath = '')
+    {
+        $this->script  = $script;
+        $this->logPath = $logPath;
+    }
+
+    public static function fromFile(string $path, string $logPath = ''): ?self
+    {
+        $script = json_decode((string)@file_get_contents($path), true);
+        if (!is_array($script)) return null;
+        return new self($script, $logPath);
+    }
+
+    public function name(): string
+    {
+        return 'fake';
+    }
+
+    public function transcribe(MediaBlob $audio, array $hints, int $timeoutSeconds): array
+    {
+        $call = ['sha' => substr($audio->sha256, 0, 12), 'bytes' => $audio->size, 'timeout' => $timeoutSeconds,
+                 'seconds' => (int)($hints['seconds'] ?? 0)];
+        $this->calls[] = $call;
+        if ($this->logPath !== '') @file_put_contents($this->logPath, json_encode($call) . "\n", FILE_APPEND);
+
+        $entry = $this->script[$audio->sha256] ?? ($this->script['*'] ?? null);
+        if (!is_array($entry)) {
+            return ['ok' => false, 'reason' => 'invalid_audio', 'retryable' => false, 'detail' => 'unscripted audio'];
+        }
+        if (isset($entry['fail'])) {
+            $reason = (string)$entry['fail'];
+            $retry  = array_key_exists('retryable', $entry) ? (bool)$entry['retryable']
+                    : in_array($reason, ['timeout', 'provider_error'], true);
+            return ['ok' => false, 'reason' => $reason, 'retryable' => $retry, 'detail' => 'scripted'];
+        }
+        return ['ok' => true, 'text' => (string)($entry['text'] ?? ''), 'language' => (string)($entry['language'] ?? ''),
+                'duration_s' => isset($entry['duration_s']) ? (float)$entry['duration_s'] : null];
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/VoiceAck.php b/dishnet-hybrid-sudan/lib/VoiceAck.php
new file mode 100644
index 0000000..bc52407
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/VoiceAck.php
@@ -0,0 +1,448 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/StaffJobsGate.php';
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/VoiceAckLimits.php';
+require_once __DIR__ . '/MediaPolicy.php';
+require_once __DIR__ . '/WaSendBudget.php';
+require_once __DIR__ . '/HumanTakeover.php';
+require_once __DIR__ . '/PluginConfig.php';
+require_once __DIR__ . '/ContactOptOut.php';
+require_once __DIR__ . '/QuoteChaseText.php';
+
+/**
+ * VoiceAck — P5, the instant acknowledgement of a customer's voice note (5.18.104, Uganda, root docs/73 §H.3.15–§H.3.17;
+ * rulings R2, R4, R18, R19).
+ *
+ * The webhook queues one `ai.voice_ack` event per voice note (step 8c); the reply worker hands it here
+ * (AiReplyWorker::handleVoiceAck). acknowledge() decides in §H.3.15's fifteen steps, in order, and is the ONLY method in
+ * this file that sends (step 15, `evo->sendText`, class `reply`; Part F's HK7 names it). Every refusal writes one
+ * `skipped` decision with a fixed reason (INSERT OR IGNORE on the note's id); nothing escalates on a refusal and P5 never
+ * parks. A send claims the shared ledger first (kind `voice_ack`, ref `ack:<wa_message_id>`), on a ledger built from the
+ * configuration read again from the files immediately before the claim, never the worker's start-time configuration
+ * (B13-03, ruling R19), and maps every answer by code (§H.3.15's table; ruling R2). After a send that went, or may have
+ * gone, a person is told at once through lib/Handover.php (created_by `voice_ack`), with no holding line.
+ *
+ * The wording is root docs/72 §H.1's, byte for byte (A and B, alternating per handset). On a salesperson's own number
+ * the persona sentence is prefixed, and held until `sf_persona_confirmed` holds a date not after today (Q1 unanswered:
+ * held); an owner with no usable first name is given A or B unprefixed once it holds (Part F's one rule).
+ *
+ * Inert unless enabled(): Uganda (StaffJobsGate, with the data directory), the assistant on, `wa_voice_ack_enabled`.
+ * Logs carry counts and fixed codes only — never a phone, a name or the text. PHP 7.4.
+ */
+final class VoiceAck
+{
+    /** The literal zone the persona date is judged in (R-16). */
+    public const TZ = 'Africa/Kampala';
+
+    /** root docs/72 §H.1 (D9), byte for byte: ASCII apostrophe, em dash U+2014. */
+    const TEXT = [
+        'A' => "Thanks for your voice note. We can't listen to voice notes automatically yet \u{2014} could you type your question in a short message? A colleague will also listen and reply.",
+        'B' => 'We got your voice note, thank you. To help you faster, please type your question here. A member of our team will also listen to it.',
+    ];
+
+    /** A voice note older than this when it comes up is not acknowledged (§H.3.15 step 6), measured from received_at. */
+    const STALE_S = 600;
+    /** C7 looks back this far before the note (ruling R4: received_at − 30 min). */
+    const C7_BACK_S = 1800;
+    /** The defer while the note's own claim is in flight (§H.3.15 step 13). */
+    const IN_FLIGHT_DEFER_S = 15;
+    /** The staff alert's reason (§H.3.15 step 16). */
+    const ALERT_REASON = 'a voice note is waiting: the customer was asked to type; listen to it in WhatsApp';
+    /** Who queued the hand-over event, and the stored row's source. */
+    const SOURCE = 'voice_ack';
+
+    /** The ledger's answers that end in a skip, and the decision's reason for each (§H.3.15 step 13; ruling R2). */
+    const LEDGER_SKIP = [
+        'ack_ceiling'  => 'number_cap',
+        'window'       => 'quiet_hours',
+        'zone'         => 'ledger_zone',
+        'ledger_off'   => 'ledger_off',
+        'ledger_error' => 'ledger_error',
+        'no_instance'  => 'no_instance',
+    ];
+    /** The ledger's answers that defer while inside STALE_S of received_at. */
+    const LEDGER_DEFER = ['in_flight', 'spacing', 'handset_busy'];
+
+    /** @var \PDO */ private $pdo;
+    /** @var EventBus */ private $bus;
+    /** @var mixed */ private $store;
+    /** @var array */ private $config;
+    /** @var string */ private $dataDir;
+    /** @var EvolutionApiService */ private $evo;
+    /** @var ConversationService */ private $convSvc;
+    /** @var callable */ private $log;
+    /** @var callable */ private $echo;
+    /** @var callable */ private $now;
+    /** @var callable|null TEST SEAM: the clock every acknowledgement reads; null in production (time()). */
+    private static $testClock = null;
+
+    /**
+     * @param callable $log  function (string $level, string $message): void — the worker's logger
+     * @param callable $echo function (array $send, string $channel, string $source) — the worker's claimOwnEcho
+     */
+    public function __construct(\PDO $pdo, $bus, $store, array $config, string $dataDir, $evo, $convSvc,
+                                callable $log, callable $echo)
+    {
+        $this->pdo     = $pdo;
+        $this->bus     = $bus;
+        $this->store   = $store;
+        $this->config  = $config;
+        $this->dataDir = $dataDir;
+        $this->evo     = $evo;
+        $this->convSvc = $convSvc;
+        $this->log     = $log;
+        $this->echo    = $echo;
+        $this->now     = self::$testClock ?? function (): int { return time(); };
+    }
+
+    /** TEST SEAM: the clock every step reads (the ledger is given the same one); null restores time(). */
+    public static function useClock(?callable $now): void
+    {
+        self::$testClock = $now;
+    }
+
+    /** P5 on: Uganda (StaffJobsGate, with the data directory), the assistant on, wa_voice_ack_enabled (§H.3.5). */
+    public static function enabled(array $config, ?string $dataDir): bool
+    {
+        if (!self::flag($config['ai_enabled'] ?? null) || !self::flag($config['wa_voice_ack_enabled'] ?? null)) return false;
+        return StaffJobsGate::applies($config, $dataDir);
+    }
+
+    /** sf_persona_confirmed holds a real date not after today, Kampala (ruling R5; §H.3.15). */
+    public static function personaConfirmed(array $config, int $now): bool
+    {
+        if (!QuoteChaseText::personaConfirmed($config)) return false;
+        $s = trim((string)($config['sf_persona_confirmed'] ?? ''));
+        [$y, $m, $d] = array_map('intval', explode('-', $s));
+        if (!checkdate($m, $d, $y)) return false;
+        $today = (new \DateTime('@' . $now))->setTimezone(new \DateTimeZone(self::TZ))->format('Y-m-d');
+        return strcmp($s, $today) <= 0;
+    }
+
+    /**
+     * The decision, §H.3.15's steps 1–16 in order. Returns nothing; a defer throws WorkerDefer (no decision row), and a
+     * failure before the send throws (the queue retries; nothing was sent).
+     */
+    public function acknowledge(array $event): void
+    {
+        $p       = is_array($event['_payload'] ?? null) ? $event['_payload'] : [];
+        $convId  = (int)($event['entity_id'] ?? 0);
+        $channel = trim((string)($p['channel'] ?? ''));
+        $phone   = trim((string)($p['customer_phone'] ?? ''));
+        $waId    = trim((string)($p['wa_message_id'] ?? ''));
+        $inst    = trim((string)($p['whatsapp_instance'] ?? ''));
+        $recv    = UtcClock::parse((string)($p['received_at'] ?? ''));
+
+        // 1. A payload field is missing: drop, no row.
+        if ($convId <= 0 || $channel === '' || $phone === '' || $waId === '' || $recv <= 0) {
+            $this->say('warn', "conv {$convId}: voice acknowledgement event missing required fields — dropped");
+            return;
+        }
+        $now     = (int)($this->now)();
+        $handset = $this->handsetOf($channel);
+        $d = ['wa' => $waId, 'conv' => $convId, 'channel' => $channel, 'handset' => $handset, 'now' => $now];
+
+        // 2. P5's switch (tested again at step 13 on a fresh read).
+        if (!self::enabled($this->config, $this->dataDirOrNull())) { $this->skip($d, 'switched_off'); return; }
+        // 3. R4 answers this number: P5 is silent there.
+        if (MediaPolicy::voiceMode($this->config, $this->dataDirOrNull(), $channel) === 'reply') { $this->skip($d, 'p4_answers'); return; }
+        // 4. A colleague's number; one of DishNet's own (as AiReplyWorker::handle :181-197).
+        if ($this->isStaffNumber($phone)) { $this->skip($d, 'staff_number'); return; }
+        $reg = $this->evo->registryOn();
+        if ($reg && $this->evo->automationPolicy()->senderClass($channel, $phone) !== '') { $this->skip($d, 'dishnet_number'); return; }
+        // 5. The registry's route and the automated-send policy (registry_unreadable included; never retried).
+        if ($reg) {
+            $route = $this->evo->replyRoute($channel, $inst);
+            if (empty($route['ok'])) { $this->skip($d, 'route:' . self::code((string)($route['reason'] ?? ''))); return; }
+            $why = (string)$this->evo->automationPolicy()->refusal($channel, $phone);
+            if ($why !== '') { $this->skip($d, 'policy:' . self::code($why)); return; }
+        }
+        // 6. Stale: more than 600 s since received_at.
+        if ($now - $recv > self::STALE_S) { $this->skip($d, 'stale'); return; }
+        // 7. The limits (the one holder, ruling R4), and the window, every day.
+        $lim = VoiceAckLimits::of($this->config);
+        if ($lim === null) { $this->skip($d, 'limits_invalid'); return; }
+        if (!VoiceAckLimits::inWindow($lim, $now)) { $this->skip($d, 'quiet_hours'); return; }
+        // 8. A colleague's pause is running (as the AI would park).
+        if ($this->humanPauseRemaining($convId, $now) > 0) { $this->skip($d, 'human_active'); return; }
+        // 9. C7, Part F's signature: since = received_at − 30 min (ruling R4); an unreadable stamp answers a code.
+        if (HumanTakeover::since($this->pdo, $phone, [$convId], UtcClock::stamp($recv - self::C7_BACK_S)) !== null) {
+            $this->skip($d, 'person_active'); return;
+        }
+        // 10. A hand-over holding line stored after the note.
+        if ($this->handedOverSince($convId, $recv)) { $this->skip($d, 'handed_over'); return; }
+        // 11. Once per period_hours per conversation (a sent or uncertain acknowledgement).
+        $period = (int)$lim['period_hours'];
+        if ($this->ackedWithin($convId, $now - $period * 3600)) { $this->skip($d, 'already_acked'); return; }
+        // 12. Persona: an owner line waits for sf_persona_confirmed; an unnamed owner then gets the department wording.
+        $persona = $this->persona($channel);
+        if ($persona !== null && !self::personaConfirmed($this->config, $now)) { $this->skip($d, 'persona_unconfirmed'); return; }
+        $variant = $this->nextVariant($handset);
+        $text = ($persona !== null && $persona !== '')
+              ? strtr(QuoteChaseText::PERSONA_SENTENCE, ['{first name}' => $persona]) . ' ' . self::TEXT[$variant]
+              : self::TEXT[$variant];
+        $personaFlag = ($persona !== null && $persona !== '') ? 1 : 0;
+
+        // 13. The ledger claim, on a fresh read (B13-03, ruling R19).
+        try {
+            $fresh = PluginConfig::read(dirname(__DIR__), $this->dataDir);
+        } catch (\Throwable $e) {
+            $this->skip($d, 'switched_off'); return;
+        }
+        if (!self::enabled($fresh, $this->dataDirOrNull())) { $this->skip($d, 'switched_off'); return; }
+        if (MediaPolicy::voiceMode($fresh, $this->dataDirOrNull(), $channel) === 'reply') { $this->skip($d, 'p4_answers'); return; }
+        $freshLim = VoiceAckLimits::of($fresh);
+        $gap = $freshLim !== null ? (int)$freshLim['gap_s'] : 0;
+        $instance = (string)$this->evo->instanceFor($channel);
+        $ledger = WaSendBudget::forInstall($fresh, $this->dataDirOrNull(), $this->store, null, $this->now);
+        $ref = 'ack:' . $waId;
+        $c = $ledger->claim($instance, 'voice_ack', $ref);
+        if (empty($c['ok'])) {
+            $code = (string)($c['defer'] ?? '');
+            if ($code === 'already_sent') return;                                 // the first decision stands
+            if (in_array($code, self::LEDGER_DEFER, true)) {
+                $t = (int)($this->now)();
+                if ($t - $recv > self::STALE_S) { $this->skip($d, 'stale'); return; }
+                $secs = $code === 'in_flight' ? self::IN_FLIGHT_DEFER_S
+                      : max(5, min((int)($c['retry_at'] ?? ($t + 5)) - $t, 60));
+                throw new WorkerDefer($secs, 'voice_ack: ' . ($code === 'in_flight' ? 'claim in flight' : $code));
+            }
+            if (isset(self::LEDGER_SKIP[$code])) { $this->skip($d, self::LEDGER_SKIP[$code]); return; }
+            $this->say('warn', "conv {$convId}: voice acknowledgement — the ledger answered " . self::code($code) . '; nothing sent');
+            $this->skip($d, 'ledger_unknown');                                    // any answer not in the table sends nothing (A25)
+            return;
+        }
+        $claim = (int)$c['claim'];
+
+        // 14. The claimed decision, with the period and the gap it applied (ruling R18).
+        $ins = $this->pdo->prepare("INSERT OR IGNORE INTO wa_voice_acks (wa_message_id, conversation_id, channel, handset, outcome,
+                                        reason, variant, persona, ledger_ref, period_hours, gap_s, local_day, created_at, updated_at)
+                                    VALUES (?, ?, ?, ?, 'claimed', NULL, ?, ?, ?, ?, ?, ?, ?, ?)");
+        $ins->execute([$waId, $convId, $channel, $handset, $variant, $personaFlag, $ref, $period, $gap,
+                       WaSendBudget::localDay($now), UtcClock::stamp($now), UtcClock::stamp($now)]);
+        if ($ins->rowCount() !== 1) {
+            $ledger->settle($claim, 'failed', ['maybe_sent' => false]);
+            return;
+        }
+        $decision = (int)$this->pdo->lastInsertId();
+
+        // 15. The send, and everything after it in try/catch: never throws.
+        $outcome = 'failed';
+        try {
+            try {
+                $send = $this->evo->sendText($channel, $phone, $text, ContactOptOut::CLASS_REPLY);
+            } catch (\Throwable $e) {
+                $send = ['ok' => false, 'error' => EvolutionApiService::MAYBE_SENT . get_class($e)];   // a throw: never re-sent
+            }
+            $sentId = (string)($send['data']['key']['id'] ?? '');
+            if (EvolutionApiService::policyRefused($send)) {
+                $ledger->settle($claim, 'failed', ['maybe_sent' => false]);
+                $this->settleDecision($decision, 'skipped', 'policy_at_send');
+                $outcome = 'skipped:policy_at_send';
+            } elseif (!empty($send['suppressed'])) {
+                $ledger->settle($claim, 'failed', ['maybe_sent' => false]);
+                $this->settleDecision($decision, 'skipped', 'opted_out');
+                $outcome = 'skipped:opted_out';
+            } elseif (empty($send['ok'])) {
+                if (EvolutionApiService::mayHaveBeenSent($send)) {
+                    $ledger->settle($claim, 'failed', ['maybe_sent' => true, 'wa_message_id' => $sentId]);
+                    $this->settleDecision($decision, 'uncertain', null);
+                    $outcome = 'uncertain';
+                } else {
+                    $ledger->settle($claim, 'failed', ['maybe_sent' => false]);
+                    $this->settleDecision($decision, 'failed', null);
+                    $outcome = 'failed';
+                }
+            } else {
+                // R-05: the echo claimed first, then the settle with the id, then the store, then the decision.
+                ($this->echo)($send, $channel, 'ai.voice_ack');
+                $ledger->settle($claim, 'sent', ['wa_message_id' => $sentId]);
+                $outcome = 'sent';
+                $this->convSvc->storeMessage($convId, [
+                    'direction'     => 'out',
+                    'role'          => 'assistant',
+                    'body'          => $text,
+                    'agent_name'    => 'DishNet AI',
+                    'wa_message_id' => $sentId !== '' ? $sentId : null,
+                    'metadata'      => json_encode(['channel' => $channel, 'voice_ack' => $variant, 'source' => self::SOURCE]),
+                ]);
+                $this->settleDecision($decision, 'sent', null, true);
+            }
+        } catch (\Throwable $e) {
+            $this->say('error', "conv {$convId}: voice acknowledgement bookkeeping failed (" . get_class($e) . ')');
+        }
+        $this->say('info', "conv {$convId}: voice acknowledgement {$outcome} (variant {$variant}" . ($personaFlag ? ', persona' : '') . ')');
+
+        // 16. Sent or uncertain: a person is told at once; no holding line.
+        if ($outcome === 'sent' || $outcome === 'uncertain') {
+            try {
+                if (!class_exists('Handover')) require_once __DIR__ . '/Handover.php';
+                Handover::escalate($this->pdo, $this->bus, $this->store, $this->config, $this->evo, $this->convSvc,
+                    $convId, $channel, $phone, self::ALERT_REASON,
+                    true, $this->log, self::SOURCE, $this->owner($channel));
+            } catch (\Throwable $e) {
+                $this->say('error', "conv {$convId}: voice acknowledgement hand-over failed (" . get_class($e) . ')');
+            }
+        }
+    }
+
+    // ── the steps' reads ────────────────────────────────────────────────────────────────────────────────────────
+
+    /** Write the skipped decision (INSERT OR IGNORE: the first decision for the note stands). */
+    private function skip(array $d, string $reason): void
+    {
+        $this->pdo->prepare("INSERT OR IGNORE INTO wa_voice_acks (wa_message_id, conversation_id, channel, handset, outcome, reason,
+                                 local_day, created_at, updated_at)
+                             VALUES (?, ?, ?, ?, 'skipped', ?, ?, ?, ?)")
+                  ->execute([$d['wa'], $d['conv'], $d['channel'], $d['handset'], $reason, WaSendBudget::localDay($d['now']),
+                             UtcClock::stamp($d['now']), UtcClock::stamp($d['now'])]);
+        $this->say('info', "conv {$d['conv']}: voice acknowledgement skipped — {$reason}");
+    }
+
+    private function settleDecision(int $id, string $outcome, ?string $reason, bool $sent = false): void
+    {
+        $t = UtcClock::stamp((int)($this->now)());
+        $this->pdo->prepare("UPDATE wa_voice_acks SET outcome = ?, reason = ?, sent_at = ?, updated_at = ? WHERE id = ? AND outcome = 'claimed'")
+                  ->execute([$outcome, $reason, $sent ? $t : null, $t, $id]);
+    }
+
+    private function handsetOf(string $channel): string
+    {
+        try {
+            return WaSendBudget::handset((string)$this->evo->instanceFor($channel));
+        } catch (\Throwable $e) {
+            return '';
+        }
+    }
+
+    /** J8, as AiReplyWorker::isStaffNumber: the whole number of an ACTIVE DishNet staff account, on Uganda. */
+    private function isStaffNumber(string $phone): bool
+    {
+        try {
+            if (!StaffJobsGate::applies($this->config, $this->dataDirOrNull())) return false;
+            if (!class_exists('StaffDirectory')) require_once __DIR__ . '/StaffDirectory.php';
+            if (!class_exists('TenantProfile')) require_once __DIR__ . '/TenantProfile.php';
+            return \StaffDirectory::activeStaffByPhone($this->store->load('retailers.json') ?? [], $phone,
+                       \TenantProfile::current($this->config, $this->dataDirOrNull())) !== null;
+        } catch (\Throwable $e) {
+            return false;
+        }
+    }
+
+    /** Seconds left on a colleague's pause, as AiReplyWorker::humanPauseRemaining (:1345-1365); 0 when none. */
+    private function humanPauseRemaining(int $convId, int $now): int
+    {
+        try {
+            $st = $this->pdo->prepare('SELECT state, last_human_reply_at FROM wa_conversations WHERE id = ?');
+            $st->execute([$convId]);
+            $row = $st->fetch(\PDO::FETCH_ASSOC);
+            if (!$row || ($row['state'] ?? '') !== 'human_active') return 0;
+            $mins = $this->config['wa_human_cooldown_minutes'] ?? null;
+            $mins = ($mins === null || $mins === '' || !is_numeric($mins)) ? 1440 : max(0, (int)$mins);
+            if ($mins === 0) return 0;
+            $last = UtcClock::parse($row['last_human_reply_at'] ?? '');
+            if ($last <= 0) return 0;
+            $left = $last + $mins * 60 - $now;
+            return $left > 0 ? $left : 0;
+        } catch (\Throwable $e) {
+            return 0;
+        }
+    }
+
+    /** A hand-over holding line (metadata handover:true) stored after the note. */
+    private function handedOverSince(int $convId, int $recv): bool
+    {
+        $st = $this->pdo->prepare("SELECT 1 FROM wa_messages WHERE conversation_id = ? AND direction = 'out'
+                                     AND " . self::metaHas('metadata', '"handover":true') . " AND created_at > ? LIMIT 1");
+        $st->execute([$convId, UtcClock::stamp($recv)]);
+        return $st->fetchColumn() !== false;
+    }
+
+    /** A sent or uncertain acknowledgement of this conversation stored after $sinceT. */
+    private function ackedWithin(int $convId, int $sinceT): bool
+    {
+        $st = $this->pdo->prepare("SELECT 1 FROM wa_voice_acks WHERE conversation_id = ? AND outcome IN ('sent','uncertain')
+                                     AND created_at > ? LIMIT 1");
+        $st->execute([$convId, UtcClock::stamp($sinceT)]);
+        return $st->fetchColumn() !== false;
+    }
+
+    /** The variant not used last by a sent or uncertain acknowledgement on this handset. */
+    private function nextVariant(string $handset): string
+    {
+        $st = $this->pdo->prepare("SELECT variant FROM wa_voice_acks WHERE handset = ? AND outcome IN ('sent','uncertain')
+                                     AND variant IS NOT NULL ORDER BY id DESC LIMIT 1");
+        $st->execute([$handset]);
+        return ((string)$st->fetchColumn()) === 'A' ? 'B' : 'A';
+    }
+
+    /**
+     * The persona of a channel, Part F's one rule (QuoteChase::persona): the owner's first name on a salesperson's own
+     * number (a resolved LineOwner); '' on such a number with no usable first name; null on a department or partner line,
+     * and always with the registry off.
+     */
+    private function persona(string $channel): ?string
+    {
+        try {
+            if (!$this->evo->registryOn()) return null;
+            $cx = $this->evo->channelContext($channel);
+            if ($cx === null) return null;
+            if (!class_exists('LineOwner')) require_once __DIR__ . '/LineOwner.php';
+            $lo = \LineOwner::of($cx, $this->store, $this->config, $this->dataDirOrNull());
+            if ($lo !== null) return $lo->firstName();
+            return $cx->ownerType() === 'staff' ? '' : null;
+        } catch (\Throwable $e) {
+            return null;
+        }
+    }
+
+    /** The salesperson the alert also goes to (as MediaWorker::handover, §H.3.6 change 7), or null. */
+    private function owner(string $channel): ?\LineOwner
+    {
+        try {
+            if (!$this->evo->registryOn()) return null;
+            $cx = $this->evo->channelContext($channel);
+            if ($cx === null || $cx->handoverTo() !== 'owner') return null;
+            if (!class_exists('LineOwner')) require_once __DIR__ . '/LineOwner.php';
+            return \LineOwner::of($cx, $this->store, $this->config, $this->dataDirOrNull());
+        } catch (\Throwable $e) {
+            return null;
+        }
+    }
+
+    private function dataDirOrNull(): ?string
+    {
+        return $this->dataDir !== '' ? $this->dataDir : null;
+    }
+
+    private function say(string $level, string $message): void
+    {
+        try { ($this->log)($level, $message); } catch (\Throwable $e) { /* a log line is never worth a send */ }
+    }
+
+    /**
+     * SQL: the metadata column holds this JSON fragment, however it was stored — storeMessage json_encodes what it is
+     * given, so a caller's encoded string (the hand-over line's, this file's own row) is stored as a JSON string.
+     */
+    public static function metaHas(string $col, string $fragment): string
+    {
+        $q = function (string $s): string { return "'%" . str_replace("'", "''", $s) . "%'"; };
+        return "({$col} LIKE " . $q($fragment) . " OR {$col} LIKE " . $q(str_replace('"', '\\"', $fragment)) . ')';
+    }
+
+    /** A reason or code as a fixed token: letters, digits, '_' and '-' only. */
+    private static function code(string $s): string
+    {
+        $c = (string)preg_replace('/[^A-Za-z0-9_-]/', '', $s);
+        return $c === '' ? 'unknown' : substr($c, 0, 40);
+    }
+
+    private static function flag($v): bool
+    {
+        if ($v === null || $v === '') return false;
+        if (is_bool($v)) return $v;
+        return in_array(strtolower(trim((string)$v)), ['1', 'true', 'on', 'yes'], true);
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/VoiceAckLimits.php b/dishnet-hybrid-sudan/lib/VoiceAckLimits.php
new file mode 100644
index 0000000..5266f52
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/VoiceAckLimits.php
@@ -0,0 +1,82 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * VoiceAckLimits — the one holder of the voice-note acknowledgement's limits (5.18.104, root docs/73 §H.3.15; ruling R4).
+ *
+ * Part V's file, built with the ledger because WaSendBudget::ackPolicy() is a thin delegate to of(): P5, the ledger's
+ * voice_ack branch and the switch tool's `set` all read these keys, defaults and ranges here and nowhere else, so they
+ * can never disagree. Pure: no store, no clock of its own, no I/O.
+ *
+ * The hours only narrow D15's every-day window (hour_from 7-20, hour_to from+1-21); a wider one is an owner answer,
+ * never a setting. of() answers null on any stored value it cannot use — unparseable, out of range, or from >= to —
+ * and every reader then sends nothing (the ledger answers `window`, final). Inert until something on Uganda calls it.
+ * PHP 7.4.
+ */
+final class VoiceAckLimits
+{
+    /** The literal zone D15's hours are judged in, never dn_tz(). */
+    public const TZ = 'Africa/Kampala';
+
+    /** The limit's name => the configuration key that holds it. */
+    const KEYS = [
+        'hour_from'    => 'wa_voice_ack_hour_from',
+        'hour_to'      => 'wa_voice_ack_hour_to',
+        'gap_s'        => 'wa_voice_ack_gap_s',
+        'daily_max'    => 'wa_voice_ack_daily_max',
+        'period_hours' => 'wa_voice_ack_period_hours',
+    ];
+
+    /** D15 (07:00-21:00 every day), the gap between two acknowledgements on a number, its daily ceiling, the period. */
+    const DEFAULTS = [
+        'hour_from'    => 7,
+        'hour_to'      => 21,
+        'gap_s'        => 20,
+        'daily_max'    => 25,
+        'period_hours' => 24,
+    ];
+
+    /** Inclusive [min, max]. hour_to is further bounded below by hour_from + 1 (narrow only, ruling R4). */
+    const RANGES = [
+        'hour_from'    => [7, 20],
+        'hour_to'      => [8, 21],
+        'gap_s'        => [5, 120],
+        'daily_max'    => [1, 60],
+        'period_hours' => [1, 168],
+    ];
+
+    /**
+     * The five limits, a default where a key is absent; null when any stored value is unparseable or out of its range,
+     * or when hour_from >= hour_to.
+     *
+     * @return array{hour_from:int,hour_to:int,gap_s:int,daily_max:int,period_hours:int}|null
+     */
+    public static function of(array $config): ?array
+    {
+        $out = [];
+        foreach (self::KEYS as $name => $key) {
+            $raw = array_key_exists($key, $config) ? $config[$key] : null;
+            if ($raw === null || (is_string($raw) && trim($raw) === '')) {
+                $v = self::DEFAULTS[$name];
+            } elseif (is_int($raw)) {
+                $v = $raw;
+            } elseif (is_string($raw) && preg_match('/^\s*\d{1,6}\s*$/', $raw)) {
+                $v = (int)trim($raw);
+            } else {
+                return null;
+            }
+            [$lo, $hi] = self::RANGES[$name];
+            if ($v < $lo || $v > $hi) return null;
+            $out[$name] = $v;
+        }
+        if ($out['hour_from'] >= $out['hour_to']) return null;
+        return $out;
+    }
+
+    /** Is $nowUtc inside [hour_from, hour_to) in a literal Africa/Kampala, any day of the week? */
+    public static function inWindow(array $limits, int $nowUtc): bool
+    {
+        $h = (int)(new \DateTime('@' . $nowUtc))->setTimezone(new \DateTimeZone(self::TZ))->format('G');
+        return $h >= (int)($limits['hour_from'] ?? 24) && $h < (int)($limits['hour_to'] ?? 0);
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/VoiceBudget.php b/dishnet-hybrid-sudan/lib/VoiceBudget.php
new file mode 100644
index 0000000..6c16411
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/VoiceBudget.php
@@ -0,0 +1,100 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/MediaPolicy.php';
+
+/**
+ * VoiceBudget — the cost bound on transcription: seconds per Kampala day and voice notes per conversation per day,
+ * reserved before every call (5.18.104, root docs/73 §H.3.10).
+ *
+ * A `started` row in wa_voice_calls is written before the call, in one BEGIN IMMEDIATE with the two checks, so two
+ * workers cannot both fit under the cap, and a crash after the reservation still counts. Every attempt counts (every
+ * outcome is summed), by the packet-counted duration (VoiceDuration), never the announced one. The row records the
+ * cap it applied (cap_day_s) and the rung the call is made at (voice_rung), which no later statement changes: the
+ * checks judge each past call by them, never by the settings as they read now (ruling R18). The minutes and the
+ * per-conversation maximum are those of the configuration VoiceTranscription::process read for this call (ruling R19).
+ * PHP 7.4 compatible.
+ */
+final class VoiceBudget
+{
+    public const TZ = 'Africa/Kampala';
+    public const RUNGS = ['fetch_only', 'dry_run', 'handover', 'reply'];
+
+    /** @var \PDO */
+    private $pdo;
+    /** @var array */
+    private $config;
+    /** @var int|null a fixed clock for tests; null is time() */
+    private $now;
+
+    public function __construct(\PDO $pdo, array $config, ?int $now = null)
+    {
+        $this->pdo    = $pdo;
+        $this->config = $config;
+        $this->now    = $now;
+    }
+
+    /** Today in Kampala, the day a reservation counts against. */
+    public function localDay(): string
+    {
+        return (new \DateTime('@' . ($this->now ?? time())))->setTimezone(new \DateTimeZone(self::TZ))->format('Y-m-d');
+    }
+
+    /**
+     * @return array ['ok' => true, 'id' => int] | ['ok' => false, 'reason' => 'budget_daily'|'budget_conversation'|'duplicate']
+     */
+    public function reserve(int $mediaId, int $convId, int $attempt, int $seconds, string $model, string $rung): array
+    {
+        if (!in_array($rung, self::RUNGS, true)) throw new \InvalidArgumentException('voice budget: unknown rung');
+        $seconds = max(0, $seconds);
+        $minutes = MediaPolicy::voiceDailyMinutes($this->config);
+        $capDay  = $minutes * 60;
+        $convMax = MediaPolicy::voiceConversationDailyMax($this->config);
+        $day     = $this->localDay();
+
+        $this->pdo->exec('BEGIN IMMEDIATE');
+        try {
+            $q = $this->pdo->prepare('SELECT COALESCE(SUM(COALESCE(seconds_billed, seconds_reserved)), 0) FROM wa_voice_calls WHERE local_day = ?');
+            $q->execute([$day]);
+            $used = (int)$q->fetchColumn();
+            if ($minutes === 0 || $used + $seconds > $capDay) {
+                $this->pdo->exec('ROLLBACK');
+                return ['ok' => false, 'reason' => 'budget_daily'];
+            }
+            $q = $this->pdo->prepare('SELECT DISTINCT media_id FROM wa_voice_calls WHERE conversation_id = ? AND local_day = ?');
+            $q->execute([$convId, $day]);
+            $notes = array_map('intval', $q->fetchAll(\PDO::FETCH_COLUMN));
+            if (count($notes) >= $convMax && !in_array($mediaId, $notes, true)) {
+                $this->pdo->exec('ROLLBACK');
+                return ['ok' => false, 'reason' => 'budget_conversation'];
+            }
+            $dup = $this->pdo->prepare('SELECT 1 FROM wa_voice_calls WHERE media_id = ? AND attempt = ?');
+            $dup->execute([$mediaId, $attempt]);
+            if ($dup->fetchColumn() !== false) {
+                $this->pdo->exec('ROLLBACK');
+                return ['ok' => false, 'reason' => 'duplicate'];
+            }
+            $this->pdo->prepare('INSERT INTO wa_voice_calls
+                (media_id, conversation_id, attempt, model, local_day, seconds_reserved, cap_day_s, voice_rung, outcome)
+                VALUES (?, ?, ?, ?, ?, ?, ?, ?, \'started\')')
+                ->execute([$mediaId, $convId, $attempt, $model, $day, $seconds, $capDay, $rung]);
+            $id = (int)$this->pdo->lastInsertId();
+            $this->pdo->exec('COMMIT');
+            return ['ok' => true, 'id' => $id];
+        } catch (\Throwable $e) {
+            try { $this->pdo->exec('ROLLBACK'); } catch (\Throwable $e2) { /* nothing held */ }
+            throw $e;
+        }
+    }
+
+    /** The call's outcome, once: a row already settled is left as it is. */
+    public function settle(int $id, string $outcome, int $http, int $ms, ?int $billedSeconds, string $reason = ''): bool
+    {
+        if (!in_array($outcome, ['ok', 'failed'], true)) $outcome = 'failed';
+        $u = $this->pdo->prepare("UPDATE wa_voice_calls SET outcome = ?, http = ?, ms = ?, seconds_billed = ?, reason = ?,
+                                   settled_at = datetime('now') WHERE id = ? AND outcome = 'started'");
+        $u->execute([$outcome, $http > 0 ? $http : null, max(0, $ms), $billedSeconds !== null ? max(0, $billedSeconds) : null,
+                     $reason !== '' ? $reason : null, $id]);
+        return $u->rowCount() === 1;
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/VoiceDuration.php b/dishnet-hybrid-sudan/lib/VoiceDuration.php
new file mode 100644
index 0000000..d4c9416
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/VoiceDuration.php
@@ -0,0 +1,124 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/MediaBlob.php';
+
+/**
+ * VoiceDuration — how long a voice note plays, counted from its Opus packets, so a sender cannot fake it
+ * (5.18.104, root docs/73 §H.3.8; R-15, S2-23).
+ *
+ * The announced `seconds` and the container's last granule are both written by the sender's client, so a billing cap
+ * that trusted either would not be a cap. What a decoder plays is the sum of the Opus packets' frame durations
+ * (RFC 6716 §3.1), so that is what is counted; and because whether the provider measures the decoded frames or the
+ * container is not established, the container must agree with the packets to within 2 s, or the file is refused
+ * before any provider sees it.
+ *
+ * Ogg pages are read from offset 0 (RFC 3533): the capture pattern, version 0, the header type, the granule, the
+ * serial, the sequence, the CRC (not verified), the lacing table. Packets are rebuilt from the lacing values (255
+ * continues, across pages too). Only the stream of the first page counts; a second serial is refused. Packet 1 must be
+ * OpusHead (version 1, at least one channel, the pre-skip at offset 10); packet 2 OpusTags; every later packet's TOC
+ * byte gives its frames. Pure: no I/O, no clock, no configuration. PHP 7.4 compatible.
+ */
+final class VoiceDuration
+{
+    public const MAX_PAGES           = 20000;
+    public const MAX_PACKET_MS       = 120.0;   // RFC 6716 §3.2.5
+    public const MAX_MISMATCH_S      = 2.0;
+    private const OPUS_RATE          = 48000;
+
+    /**
+     * @return array{ok:bool, reason:string, detail:string, seconds:float, packets:int, granule_seconds:float}
+     *         reason '' when ok; otherwise unsupported_audio (not Ogg/Opus) or invalid_audio (malformed, or the
+     *         container disagreeing with its packets: detail duration_mismatch)
+     */
+    public static function measure(MediaBlob $b): array
+    {
+        $buf = (string)$b->bytes;
+        $len = strlen($buf);
+        if ($len < 27 || substr($buf, 0, 4) !== 'OggS') return self::no('unsupported_audio', 'not_ogg');
+
+        $off = 0; $pages = 0; $serial = null; $packets = []; $cur = ''; $open = false;
+        $lastGranule = null;
+        while ($off < $len) {
+            if (++$pages > self::MAX_PAGES) return self::no('invalid_audio', 'too_many_pages');
+            if ($off + 27 > $len || substr($buf, $off, 4) !== 'OggS') return self::no('invalid_audio', 'bad_page');
+            if (ord($buf[$off + 4]) !== 0) return self::no('invalid_audio', 'bad_version');
+            $granule = unpack('P', substr($buf, $off + 6, 8))[1];
+            $pageSerial = unpack('V', substr($buf, $off + 14, 4))[1];
+            $nseg = ord($buf[$off + 26]);
+            if ($off + 27 + $nseg > $len) return self::no('invalid_audio', 'truncated');
+            $lacing = substr($buf, $off + 27, $nseg);
+            $body = 0;
+            for ($i = 0; $i < $nseg; $i++) $body += ord($lacing[$i]);
+            $data = $off + 27 + $nseg;
+            if ($data + $body > $len) return self::no('invalid_audio', 'truncated');
+            if ($serial === null) $serial = $pageSerial;
+            elseif ($pageSerial !== $serial) return self::no('invalid_audio', 'second_stream');
+
+            $p = $data;
+            for ($i = 0; $i < $nseg; $i++) {
+                $l = ord($lacing[$i]);
+                $cur .= substr($buf, $p, $l);
+                $p += $l;
+                $open = true;
+                if ($l < 255) { $packets[] = $cur; $cur = ''; $open = false; }
+            }
+            if ($granule !== -1) $lastGranule = $granule;
+            $off = $data + $body;
+        }
+        if ($open) return self::no('invalid_audio', 'truncated');
+        if (count($packets) < 1) return self::no('invalid_audio', 'no_packets');
+
+        $head = $packets[0];
+        if (strlen($head) < 19 || substr($head, 0, 8) !== 'OpusHead') return self::no('unsupported_audio', 'not_opus');
+        if (ord($head[8]) !== 1 || ord($head[9]) < 1) return self::no('unsupported_audio', 'not_opus');
+        $preSkip = unpack('v', substr($head, 10, 2))[1];
+        if (count($packets) < 2 || substr($packets[1], 0, 8) !== 'OpusTags') return self::no('invalid_audio', 'no_tags');
+
+        $ms = 0.0; $n = 0;
+        for ($k = 2, $c = count($packets); $k < $c; $k++) {
+            $d = self::packetMs($packets[$k]);
+            if ($d === null) return self::no('invalid_audio', 'bad_packet');
+            $ms += $d; $n++;
+        }
+        if ($n === 0) return self::no('invalid_audio', 'no_audio');
+        if ($lastGranule === null) return self::no('invalid_audio', 'no_granule');
+
+        $seconds = max(0.0, $ms / 1000 - $preSkip / self::OPUS_RATE);
+        $granuleSeconds = ($lastGranule - $preSkip) / self::OPUS_RATE;
+        $out = ['ok' => true, 'reason' => '', 'detail' => '', 'seconds' => round($seconds, 3), 'packets' => $n,
+                'granule_seconds' => round((float)$granuleSeconds, 3)];
+        if (abs($granuleSeconds - $seconds) > self::MAX_MISMATCH_S) {
+            return ['ok' => false, 'reason' => 'invalid_audio', 'detail' => 'duration_mismatch'] + $out;
+        }
+        return $out;
+    }
+
+    /** One Opus packet's duration in ms from its TOC byte (RFC 6716 §3.1), or null when it is not a valid packet. */
+    private static function packetMs(string $pkt): ?float
+    {
+        $l = strlen($pkt);
+        if ($l < 1) return null;
+        $toc = ord($pkt[0]);
+        $config = $toc >> 3;
+        if ($config <= 11)      $frame = [10.0, 20.0, 40.0, 60.0][$config % 4];   // SILK
+        elseif ($config <= 15)  $frame = [10.0, 20.0][$config % 2];               // Hybrid
+        else                    $frame = [2.5, 5.0, 10.0, 20.0][$config % 4];     // CELT
+        $code = $toc & 3;
+        if ($code === 0)      $frames = 1;
+        elseif ($code <= 2)   $frames = 2;
+        else {
+            if ($l < 2) return null;
+            $frames = ord($pkt[1]) & 0x3F;
+            if ($frames < 1 || $frames > 48) return null;
+        }
+        $total = $frame * $frames;
+        if ($total > self::MAX_PACKET_MS) return null;
+        return $total;
+    }
+
+    private static function no(string $reason, string $detail): array
+    {
+        return ['ok' => false, 'reason' => $reason, 'detail' => $detail, 'seconds' => 0.0, 'packets' => 0, 'granule_seconds' => 0.0];
+    }
+}
