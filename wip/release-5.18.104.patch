+    }
+    $cols = [];
+    foreach (['followups' => ['kind', 'quote_key'], 'wa_auto_sends' => ['win_from', 'win_to', 'cap_day', 'cap_hour'], 'quote_list_sends' => ['sections']] as $t => $want) {
+        $got = [];
