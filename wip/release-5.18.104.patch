+function wsb_rows(\PDO $pdo, string $where = '1', array $a = []): array
+{
+    $st = $pdo->prepare("SELECT * FROM wa_auto_sends WHERE {$where} ORDER BY id");
+    $st->execute($a);
+    return $st->fetchAll(\PDO::FETCH_ASSOC);
+}
