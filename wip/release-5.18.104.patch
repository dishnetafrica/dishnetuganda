+function qa_verdict(\PDO $pdo): string
+{
+    try {
+        $r = $pdo->query("SELECT expected, found FROM _schema_checks WHERE migration = '089_quote_followups.sql'")->fetch(\PDO::FETCH_ASSOC);
+    } catch (\Throwable $e) {
