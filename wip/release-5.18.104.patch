diff --git a/dishnet-hybrid-sudan/lib/OfferAudience.php b/dishnet-hybrid-sudan/lib/OfferAudience.php
new file mode 100644
index 0000000..5368c3f
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/OfferAudience.php
@@ -0,0 +1,479 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/PhoneNumber.php';
+require_once __DIR__ . '/TenantProfile.php';
+require_once __DIR__ . '/StaffDirectory.php';
+require_once __DIR__ . '/InternalNumbers.php';
+require_once __DIR__ . '/EmailReplyPolicy.php';
+require_once __DIR__ . '/EvolutionApiService.php';
+require_once __DIR__ . '/HumanTakeover.php';
+require_once __DIR__ . '/QuoteChase.php';
+require_once __DIR__ . '/OfferText.php';
+require_once __DIR__ . '/OfferSwitch.php';
+require_once __DIR__ . '/OfferGateway.php';
+require_once __DIR__ . '/EvolutionOfferGateway.php';
+
+/**
+ * OfferAudience — who an offer may go to, from which handset, and why everyone else is left out (5.18.104 P6, root
+ * docs/73 §H.4.8, §H.4.9; rulings R3, R13, R18).
+ *
+ * STORE-FREE (ruling R13): it takes no store, builds none and opens none. Every list is read through the \PDO it is given
+ * (the switch tool's query_only $ro included); the two store collections the lists need come as arguments: the
+ * retailers.json rows and the store's kyc_config.json (storedRows() reads both straight from a connection), and the
+ * DishNet-number check is given reader(), a read-only object whose load() answers those two and wa_evo_numbers.json.
+ *
+ * ONE PHONE FORM (O-D17): digits() is PhoneNumber::international without its '+', or null. Every list is turned into it
+ * before any comparison; a row that cannot be is compared on its last nine digits, for EXCLUSION ONLY, and counted as
+ * <list>_loose. Over-excluding is the safe direction.
+ *
+ *   build()  the preview and the Start: every warm phone, its chosen conversation and handset, each left out by reason
+ *   judge()  one recipient just before its send, at its moment, under the offer's recorded warm_days and recent_days
+ *            (the sender passes them in $config): ok | skip(code) | defer(code, retry_at) | move(conversation)
+ *   lists()  the one list loader both call; OfferSwitch::checkLive() calls it for C-O2-9 at a recipient's judged_at
+ *
+ * The person rule is Part F's HumanTakeover alone (C7), and the quotation hold Part F's QuoteChase::offerHolds()/
+ * offerHold() (ruling R3); a read that fails stops the build with audience_unreadable:<list>, never "nobody to exclude".
+ * P6 reads nothing of Part V: an inbound voice note holds the phone for the whole warm window (ruling R3). PHP 7.4.
+ */
+final class OfferAudience
+{
+    const SIZES = ['100' => 100, '200' => 200, 'all' => 0];
+    /** On a tie of the latest customer message, the department order, then the channel id. */
+    const CHANNEL_ORDER = ['sales' => 0, 'support' => 1, 'account' => 2];
+    const HOLD_48H_S = 172800;
+    const PERSON_72H_S = 259200;
+    const AWAIT_REPLY_S = 7200;
+    const CHANNEL_WAIT_S = 1800;
+    /** The list exclusions in the order a phone is judged (and counted) by. */
+    const LIST_CODES = ['opted_out', 'offer_stop', 'stop_words', 'recent_voice_note', 'unread_inbound', 'colleague', 'dishnet_number',
+                        'partner_contact', 'quote_hold', 'followup_open', 'followup_recent', 'recent_offer', 'person_handling',
+                        'escalation_words', 'ambiguous_identity'];
+
+    // ── the one phone form ─────────────────────────────────────────────────────────────────────────────────────
+
+    /** International digits without '+', by the tenant's rule; null when the number does not normalise. */
+    public static function digits(string $raw, \TenantProfile $t): ?string
+    {
+        if (trim($raw) === '') return null;
+        $i = \PhoneNumber::international($raw, $t);
+        return $i === null ? null : ltrim($i, '+');
+    }
+
+    /** The last nine digits of whatever was typed, for the loose (exclusion-only) comparison; '' when fewer. */
+    private static function last9(string $raw): string
+    {
+        $d = (string)preg_replace('/\D+/', '', $raw);
+        return strlen($d) >= 9 ? substr($d, -9) : '';
+    }
+
+    // ── what the audience is given ─────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * The retailers.json rows and the stored kyc_config.json, read straight from a connection in the forms SqliteStore
+     * keeps them (a record table's rows by id; a flat table's one row, id 0). A missing table reads as nothing; any other
+     * failure throws audience_unreadable:retailers or audience_unreadable:kyc_config.
+     *
+     * @return array{retailers: array, kyc_config: array}
+     */
+    public static function storedRows(\PDO $pdo): array
+    {
+        $out = ['retailers' => [], 'kyc_config' => []];
+        foreach (['retailers' => 'SELECT data FROM [retailers] ORDER BY id', 'kyc_config' => 'SELECT data FROM [kyc_config] WHERE id = 0'] as $t => $sql) {
+            try {
+                $q = $pdo->prepare("SELECT name FROM sqlite_master WHERE type = 'table' AND name = ?");
+                $q->execute([$t]);
+                if ($q->fetchColumn() === false) continue;
+                $rows = $pdo->query($sql)->fetchAll(\PDO::FETCH_COLUMN);
+            } catch (\Throwable $e) {
+                throw new \RuntimeException('audience_unreadable:' . $t);
+            }
+            if ($t === 'retailers') {
+                foreach ($rows as $j) { $r = json_decode((string)$j, true); if (is_array($r)) $out['retailers'][] = $r; }
+            } else {
+                $r = $rows === [] ? [] : json_decode((string)$rows[0], true);
+                $out['kyc_config'] = is_array($r) ? $r : [];
+            }
+        }
+        return $out;
+    }
+
+    /** A read-only stand-in for the store: retailers.json, kyc_config.json and wa_evo_numbers.json; [] for any other file. */
+    public static function reader(\PDO $pdo, array $retailerRows, array $storedConfig)
+    {
+        return new class($pdo, $retailerRows, $storedConfig) {
+            private $pdo; private $retailers; private $kyc;
+            public function __construct(\PDO $pdo, array $r, array $k) { $this->pdo = $pdo; $this->retailers = $r; $this->kyc = $k; }
+            public function load(string $file): array
+            {
+                if ($file === 'retailers.json') return $this->retailers;
+                if ($file === 'kyc_config.json') return $this->kyc;
+                if ($file === \InternalNumbers::REPORTED_FILE) return \InternalNumbers::reader($this->pdo)->load($file);
+                return [];
+            }
+        };
+    }
+
+    // ── the lists ──────────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * Every exclusion list, each loaded once, for every phone or one ($phone, international digits). $atUtc bounds the
+     * one list with a storage time that C-O2-9 re-judges through here, the partner contacts (created_at at or before it);
+     * the store lists record no time and ignore it. $now is the moment the windows are counted back from: given by
+     * build() and judge(), else $atUtc, else the clock. The warm and recent windows are $config's offers_warm_days and
+     * offers_recent_days (the sender passes the offer's recorded values; ruling R18).
+     *
+     * @return array the sets, the loose last-nine sets, the two coded maps, the recent-offer ids, the DishNet numbers,
+     *               the tenant and the loose counts
+     */
+    public static function lists(\PDO $pdo, array $config, ?string $dataDir, array $retailerRows, array $storedConfig,
+                                 ?string $phone, ?string $atUtc = null, ?int $now = null): array
+    {
+        $m = $now ?? ($atUtc !== null && UtcClock::parse($atUtc) > 0 ? UtcClock::parse($atUtc) : time());
+        $t = \TenantProfile::current($config, $dataDir);
+        $set = OfferSwitch::settings($config);
+        $warm = (int)($set['offers_warm_days'] ?? OfferSwitch::SETTINGS['offers_warm_days'][0]);
+        $recent = (int)($set['offers_recent_days'] ?? OfferSwitch::SETTINGS['offers_recent_days'][0]);
+        $sinceWarm = UtcClock::stamp($m - $warm * 86400);
+        $since48 = UtcClock::stamp($m - self::HOLD_48H_S);
+        $sinceRecent = UtcClock::stamp($m - $recent * 86400);
+        $l9 = $phone === null ? '' : self::last9($phone);
+
+        $L = ['moment' => $m, 'tenant' => $t, 'sets' => [], 'loose' => [], 'maps' => [], 'recent_ids' => [], 'counts' => [],
+              'internal' => null];
+        foreach (self::LIST_CODES as $c) { $L['sets'][$c] = []; $L['loose'][$c] = []; }
+        $add = function (string $code, string $raw) use (&$L, $t, $phone): void {
+            $d = self::digits($raw, $t);
+            if ($d !== null) {
+                if ($phone === null || $d === $phone) $L['sets'][$code][$d] = true;
+                return;
+            }
+            $k = self::last9($raw);
+            if ($k === '') return;
+            if ($phone !== null && $k !== self::last9($phone)) return;
+            $L['loose'][$code][$k] = true;
+            $L['counts'][$code . '_loose'] = ($L['counts'][$code . '_loose'] ?? 0) + 1;
+        };
+        $col = function (string $list, string $sql, array $args = []) use ($pdo): array {
+            try {
+                $st = $pdo->prepare($sql);
+                $st->execute($args);
+                return array_map('strval', $st->fetchAll(\PDO::FETCH_COLUMN));
+            } catch (\Throwable $e) {
+                throw new \RuntimeException('audience_unreadable:' . $list, 0, $e);
+            }
+        };
+        // A conversation read limited to one phone's numbers: last nine digits in SQL, the one form in PHP.
+        $conv = $phone === null ? '' : ' AND substr(c.phone, -9) = :l9';
+        $convArgs = $phone === null ? [] : [':l9' => $l9];
+
+        foreach ($col('opted_out', 'SELECT phone FROM contact_optouts WHERE active = 1') as $p) $add('opted_out', $p);
+        foreach ($col('offer_stop', 'SELECT DISTINCT phone FROM wa_offer_recipients WHERE stop_at IS NOT NULL AND phone IS NOT NULL') as $p) $add('offer_stop', $p);
+        foreach ($col('unread_inbound', "SELECT phone FROM wa_seen_marks WHERE direction = 'in' AND phone <> '' AND seen_at >= :w",
+                      [':w' => $sinceWarm]) as $p) $add('unread_inbound', $p);
+        foreach ($retailerRows as $r) {
+            if (!is_array($r)) continue;
+            $raw = trim((string)($r['phone'] ?? ''));
+            if ($raw === '') continue;
+            $intl = \StaffDirectory::phoneOf($r, $t);
+            $add('colleague', $intl !== null ? $intl : $raw);
+        }
+        foreach ($col('colleague', "SELECT DISTINCT c.phone FROM wa_conversations c WHERE c.category = 'staff'{$conv}", $convArgs) as $p) $add('colleague', $p);
+        foreach ($col('partner_contact', 'SELECT phone FROM dist_contacts' . ($atUtc !== null ? ' WHERE created_at <= :at' : ''),
+                      $atUtc !== null ? [':at' => UtcClock::stamp(UtcClock::parse($atUtc))] : []) as $p) $add('partner_contact', $p);
+        foreach ($col('followup_open', 'SELECT DISTINCT phone FROM followups WHERE closed_at IS NULL') as $p) $add('followup_open', $p);
+        foreach ($col('followup_recent', 'SELECT DISTINCT phone FROM followup_sends WHERE sent_at >= :s', [':s' => $since48]) as $p) $add('followup_recent', $p);
+        foreach ($col('followup_recent', "SELECT DISTINCT phone FROM wa_auto_sends WHERE kind IN ('quote','enquiry')
+                                            AND (outcome IN ('sent','uncertain') OR outcome IS NULL) AND claimed_at >= :s AND phone IS NOT NULL",
+                      [':s' => $since48]) as $p) $add('followup_recent', $p);
+        try {
+            $st = $pdo->prepare("SELECT id, phone FROM wa_offer_recipients WHERE phone IS NOT NULL
+                                  AND ((state IN ('sent','uncertain') AND sent_at >= :r) OR state = 'claimed')");
+            $st->execute([':r' => $sinceRecent]);
+            foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+                $d = self::digits((string)$r['phone'], $t);
+                if ($d === null || ($phone !== null && $d !== $phone)) continue;
+                $L['sets']['recent_offer'][$d] = true;
+                $L['recent_ids'][$d][] = (int)$r['id'];
+            }
+        } catch (\Throwable $e) {
+            throw new \RuntimeException('audience_unreadable:recent_offer');
+        }
+        foreach ($col('ambiguous_identity', "SELECT DISTINCT c.phone FROM wa_conversations c WHERE c.crm_link_method = 'ambiguous'{$conv}", $convArgs) as $p) {
+            $add('ambiguous_identity', $p);
+        }
+
+        // Part F's two readers (ruling R3): the quotation hold and the person rule, at the moment, each phone in the one form.
+        $at = UtcClock::stamp($m);
+        try {
+            $holds = $phone === null ? QuoteChase::offerHolds($pdo, $at) : self::one($phone, QuoteChase::offerHold($pdo, $phone, $at));
+            $people = $phone === null ? HumanTakeover::phonesSince($pdo, UtcClock::stamp($m - self::PERSON_72H_S), $at)
+                                      : self::one($phone, (string)HumanTakeover::phoneSince($pdo, $phone, UtcClock::stamp($m - self::PERSON_72H_S), $at));
+        } catch (\Throwable $e) {
+            throw new \RuntimeException('audience_unreadable:partf');
+        }
+        foreach (['quote_hold' => $holds, 'person_handling' => $people] as $code => $map) {
+            foreach ($map as $p => $why) {
+                $d = self::digits((string)$p, $t);
+                if ($d === null || ($phone !== null && $d !== $phone)) continue;
+                $L['sets'][$code][$d] = true;
+                $L['maps'][$code][$d] = (string)$why;
+            }
+        }
+
+        // The streamed inbound read: the phone's own messages within the warm window, at any length (S2-07; ruling R3).
+        try {
+            $st = $pdo->prepare("SELECT c.phone, m.body, m.media_type FROM wa_messages m JOIN wa_conversations c ON c.id = m.conversation_id
+                                  WHERE m.direction = 'in' AND m.sent_at >= :w{$conv}");
+            $st->execute([':w' => $sinceWarm] + $convArgs);
+            while ($r = $st->fetch(\PDO::FETCH_ASSOC)) {
+                $d = self::digits((string)$r['phone'], $t);
+                if ($d === null || ($phone !== null && $d !== $phone)) continue;
+                $body = (string)($r['body'] ?? '');
+                if ((string)($r['media_type'] ?? '') === 'audio') $L['sets']['recent_voice_note'][$d] = true;
+                if ($body !== '' && OfferText::stopWordIn($body) !== '') $L['sets']['stop_words'][$d] = true;
+                if ($body !== '' && !empty(\EmailReplyPolicy::scanForEscalation($body)['escalate'])) $L['sets']['escalation_words'][$d] = true;
+            }
+        } catch (\Throwable $e) {
+            throw new \RuntimeException('audience_unreadable:inbound');
+        }
+
+        // DishNet's own lines, line owners and alert recipients: InternalNumbers over the read-only reader, never a store.
+        try {
+            $reader = self::reader($pdo, $retailerRows, $storedConfig);
+            $evo = \EvolutionApiService::forStore($config, $pdo, $dataDir);
+            $in = null;
+            if ($evo->registryOn()) {
+                $evo->useStaffStore($reader);
+                $in = $evo->automationPolicy()->internal();
+            }
+            if ($in === null) {
+                $in = \InternalNumbers::fromRows([], \EvolutionApiService::configInstanceMap($config), [], $config, $dataDir);
+                $in->useStore($reader);
+            }
+            $L['internal'] = $in;
+        } catch (\Throwable $e) {
+            throw new \RuntimeException('audience_unreadable:dishnet_number');
+        }
+        return $L;
+    }
+
+    /** A single-phone reader's answer as the bulk form's map. */
+    private static function one(string $phone, string $why): array
+    {
+        return $why === '' ? [] : [$phone => $why];
+    }
+
+    /**
+     * The first reason $digits is left out, in LIST_CODES order, after the number rule; '' when none. $exceptRecipient is
+     * the row judge() is deciding, whose own claim is not a recent offer.
+     */
+    public static function excludedBy(array $L, string $digits, int $exceptRecipient = 0): string
+    {
+        /** @var \TenantProfile $t */
+        $t = $L['tenant'];
+        $dial = (string)preg_replace('/\D+/', '', $t->dialCode());
+        if ($dial === '' || !preg_match('/^' . $dial . '\d{' . $t->nsnLength() . '}$/', $digits)) {
+            return strpos($digits, '211') === 0 ? 'south_sudan_number' : 'not_uganda_number';
+        }
+        $k = self::last9($digits);
+        foreach (self::LIST_CODES as $code) {
+            if ($code === 'dishnet_number') {
+                if ($L['internal'] !== null && $L['internal']->senderClass($digits, false) !== '') return $code;
+                continue;
+            }
+            if ($code === 'recent_offer') {
+                $ids = array_diff($L['recent_ids'][$digits] ?? [], [$exceptRecipient]);
+                if ($ids !== []) return $code;
+                continue;
+            }
+            if (isset($L['sets'][$code][$digits]) || ($k !== '' && isset($L['loose'][$code][$k]))) return $code;
+        }
+        return '';
+    }
+
+    // ── build ─────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * The audience at $now: every warm phone on an Evolution number, warmest first, cut to $size; and everyone left out,
+     * by reason (counts only). $gw: the gateway whose routing names the handsets (built over $pdo and reader() unless given).
+     *
+     * @return array{eligible: array, queued: int, left_out: array<string,int>, waiting: array<string,int>,
+     *               by_handset: array<string,int>, loose: array<string,int>, warm: int}
+     */
+    public static function build(\PDO $pdo, array $config, ?string $dataDir, array $retailerRows, array $storedConfig, string $size,
+                                 int $now, ?OfferGateway $gw = null): array
+    {
+        if (!array_key_exists($size, self::SIZES)) throw new \InvalidArgumentException('size');
+        $gw = $gw ?? new EvolutionOfferGateway($pdo, $config, $dataDir, self::reader($pdo, $retailerRows, $storedConfig));
+        $L = self::lists($pdo, $config, $dataDir, $retailerRows, $storedConfig, null, null, $now);
+        $set = OfferSwitch::settings($config);
+        $warm = (int)($set['offers_warm_days'] ?? OfferSwitch::SETTINGS['offers_warm_days'][0]);
+        $owned = (int)($set['offers_on_owned_numbers'] ?? 0) === 1;
+        $owners = self::ownerTypes($pdo);
+
+        $byPhone = [];
+        $left = [];
+        foreach (self::warmConversations($pdo, UtcClock::stamp($now - $warm * 86400), null) as $c) {
+            $d = self::digits((string)$c['phone'], $L['tenant']);
+            $key = $d ?? ('?' . (string)$c['phone']);
+            $h = $gw->handsetFor((string)$c['channel']);
+            if ($h === '') continue;                       // accounts, marketing, an unmapped channel: never a candidate
+            $c['handset'] = $h;
+            $byPhone[$key][] = $c;
+        }
+        $eligible = [];
+        $waiting = [];
+        foreach ($byPhone as $key => $convs) {
+            $key = (string)$key;                           // a digits key is stored as an int by PHP
+            $waitCode = '';
+            if ($key[0] === '?') { $left['not_uganda_number'] = ($left['not_uganda_number'] ?? 0) + 1; continue; }
+            $d = (string)$key;
+            $why = self::excludedBy($L, $d);
+            $ch = self::chosen($convs);
+            if ($why === '') $why = self::channelRule($gw, $owners, (string)$ch['channel'], $d, $owned, $waitCode);
+            if ($why !== '') { $left[$why] = ($left[$why] ?? 0) + 1; continue; }
+            if ($waitCode !== '') $waiting[$waitCode] = ($waiting[$waitCode] ?? 0) + 1;
+            $eligible[] = ['phone' => $d, 'conversation_id' => (int)$ch['id'], 'channel' => (string)$ch['channel'],
+                           'handset' => (string)$ch['handset'], 'last_in_at' => (string)$ch['last_customer_at']];
+        }
+        usort($eligible, function ($a, $b) {
+            return [UtcClock::parse($b['last_in_at']), $a['phone']] <=> [UtcClock::parse($a['last_in_at']), $b['phone']];
+        });
+        $n = self::SIZES[$size];
+        $cut = $n === 0 ? $eligible : array_slice($eligible, 0, $n);
+        $byH = [];
+        foreach ($cut as $e) $byH[$e['handset']] = ($byH[$e['handset']] ?? 0) + 1;
+        ksort($left);
+        return ['eligible' => $cut, 'queued' => count($cut), 'all_eligible' => count($eligible), 'left_out' => $left,
+                'waiting' => $waiting, 'by_handset' => $byH, 'loose' => $L['counts'], 'warm' => $warm];
+    }
+
+    // ── judge ─────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * One recipient, just before its send, at its moment $nowUtc (the sender's judged_at, under the book's write lock).
+     * $config carries the offer's recorded warm_days and recent_days as offers_warm_days and offers_recent_days.
+     *
+     * @return array{outcome:string, code:string, retry_at:?int, conversation_id?:int, channel?:string, handset?:string}
+     */
+    public static function judge(\PDO $pdo, array $config, ?string $dataDir, array $retailerRows, array $storedConfig, array $row,
+                                 string $nowUtc, ?OfferGateway $gw = null): array
+    {
+        $phone = $row['phone'] ?? null;
+        if ($phone === null || (string)$phone === '') return self::res('skip', 'erased');
+        $phone = (string)$phone;
+        $m = UtcClock::parse($nowUtc);
+        if ($m <= 0) return self::res('skip', 'unreadable_time');
+        $gw = $gw ?? new EvolutionOfferGateway($pdo, $config, $dataDir, self::reader($pdo, $retailerRows, $storedConfig));
+
+        // 1. every list exclusion, read fresh for this phone
+        $L = self::lists($pdo, $config, $dataDir, $retailerRows, $storedConfig, $phone, null, $m);
+        $why = self::excludedBy($L, $phone, (int)($row['id'] ?? 0));
+        if ($why !== '') return self::res('skip', $why);
+
+        // 2. cooled: no inbound on any Evolution conversation of the phone within the warm window
+        $set = OfferSwitch::settings($config);
+        $warm = (int)($set['offers_warm_days'] ?? OfferSwitch::SETTINGS['offers_warm_days'][0]);
+        $convs = [];
+        foreach (self::warmConversations($pdo, UtcClock::stamp($m - $warm * 86400), $phone) as $c) {
+            if (self::digits((string)$c['phone'], $L['tenant']) !== $phone) continue;
+            $h = $gw->handsetFor((string)$c['channel']);
+            if ($h === '') continue;
+            $c['handset'] = $h;
+            $convs[] = $c;
+        }
+        if ($convs === []) return self::res('skip', 'cooled');
+
+        // 3. moved: the customer wrote on another handset since; never sent from the old one
+        $ch = self::chosen($convs);
+        if ((int)$ch['id'] !== (int)($row['conversation_id'] ?? 0) || (string)$ch['handset'] !== (string)($row['handset'] ?? '')) {
+            return ['outcome' => 'move', 'code' => 'moved', 'retry_at' => null, 'conversation_id' => (int)$ch['id'],
+                    'channel' => (string)$ch['channel'], 'handset' => (string)$ch['handset']];
+        }
+
+        // 4. waiting for an answer: an offer never takes the place of one
+        $lastIn = UtcClock::parse((string)$ch['last_customer_at']);
+        $lastAgent = UtcClock::parse((string)($ch['last_agent_at'] ?? ''));
+        if ($lastIn > $lastAgent || $m - $lastIn < self::AWAIT_REPLY_S) {
+            $at = $lastIn + self::AWAIT_REPLY_S;
+            return self::res('defer', 'awaiting_reply', $at > $m ? $at : $m + self::CHANNEL_WAIT_S);
+        }
+
+        // 5. the channel: a partner's number, an owned number, the policy
+        $owned = (int)($set['offers_on_owned_numbers'] ?? 0) === 1;
+        $waitCode = '';
+        $why = self::channelRule($gw, self::ownerTypes($pdo), (string)$ch['channel'], $phone, $owned, $waitCode);
+        if ($why !== '') return self::res('skip', $why);
+        if ($waitCode !== '') return self::res('defer', $waitCode, $m + self::CHANNEL_WAIT_S);
+        return self::res('ok', '');
+    }
+
+    private static function res(string $outcome, string $code, ?int $retryAt = null): array
+    {
+        return ['outcome' => $outcome, 'code' => $code, 'retry_at' => $retryAt];
+    }
+
+    // ── the chosen conversation and its channel ────────────────────────────────────────────────────────────────
+
+    /** Conversations with a customer message since $since (UTC), every phone's or one phone's. */
+    private static function warmConversations(\PDO $pdo, string $since, ?string $phone): array
+    {
+        try {
+            $sql = 'SELECT c.id, c.phone, c.channel, c.category, c.crm_link_method, c.last_customer_at, c.last_agent_at
+                      FROM wa_conversations c
+                     WHERE c.last_customer_at >= :since_warm';
+            $args = [':since_warm' => $since];
+            if ($phone !== null) { $sql .= ' AND substr(c.phone, -9) = :l9'; $args[':l9'] = self::last9($phone); }
+            $st = $pdo->prepare($sql);
+            $st->execute($args);
+            return $st->fetchAll(\PDO::FETCH_ASSOC);
+        } catch (\Throwable $e) {
+            throw new \RuntimeException('audience_unreadable:conversations');
+        }
+    }
+
+    /** The conversation the customer last wrote on: the greatest last_customer_at; ties sales, support, account, then id. */
+    private static function chosen(array $convs): array
+    {
+        usort($convs, function ($a, $b) {
+            $ka = [-UtcClock::parse((string)$a['last_customer_at']), self::CHANNEL_ORDER[(string)$a['channel']] ?? 3, (string)$a['channel']];
+            $kb = [-UtcClock::parse((string)$b['last_customer_at']), self::CHANNEL_ORDER[(string)$b['channel']] ?? 3, (string)$b['channel']];
+            return $ka <=> $kb;
+        });
+        return $convs[0];
+    }
+
+    /** wa_channels' owner_type by channel id; [] without the registry table. */
+    private static function ownerTypes(\PDO $pdo): array
+    {
+        try {
+            $q = $pdo->query("SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'wa_channels'");
+            if ($q->fetchColumn() === false) return [];
+            $out = [];
+            foreach ($pdo->query('SELECT channel_id, owner_type FROM wa_channels')->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+                $out[(string)$r['channel_id']] = (string)$r['owner_type'];
+            }
+            return $out;
+        } catch (\Throwable $e) {
+            throw new \RuntimeException('audience_unreadable:wa_channels');
+        }
+    }
+
+    /**
+     * Whether the chosen channel may carry this offer: partner_number | owned_number | channel_refused:<code> (final), or
+     * '' with $waitCode channel_waiting:<code> when the policy's reason may clear by itself.
+     */
+    private static function channelRule(OfferGateway $gw, array $owners, string $channel, string $phone, bool $owned, ?string &$waitCode): string
+    {
+        $waitCode = '';
+        $type = $owners[$channel] ?? 'department';
+        if ($type === 'partner') return 'partner_number';
+        if ($type === 'staff' && !$owned) return 'owned_number';
+        $r = $gw->refusal($channel, $phone);
+        if ($r === '') return '';
+        if ($gw->transient($r)) { $waitCode = 'channel_waiting:' . $r; return ''; }
+        return 'channel_refused:' . $r;
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/OfferGateway.php b/dishnet-hybrid-sudan/lib/OfferGateway.php
new file mode 100644
index 0000000..ee90896
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/OfferGateway.php
@@ -0,0 +1,73 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * OfferGateway — how an offer leaves (5.18.104 P6, root docs/73 §H.4.11, D10). After ShopBot's WhatsAppGateway
+ * (root docs/12-shopbot-inspection.md:83-88): one interface, a driver per transport. EvolutionOfferGateway today; a Meta
+ * Cloud API driver when the official number exists, for offers only. The ledger claim and settle stay OUTSIDE the
+ * gateway (OfferSender), so every driver is paced by the same WaSendBudget. PHP 7.4 compatible.
+ *
+ * A Meta driver later (not built; recorded for D10): handsetFor() would return a ledger key for the official number,
+ * send() would map the offer to an approved marketing template, transient() would cover Meta's rate answers, and there
+ * is no echo to claim ('none').
+ */
+interface OfferGateway
+{
+    /** 'evolution' | later 'meta_cloud' — stored nowhere, printed by the tool. */
+    public function name(): string;
+
+    /** The ledger's key for this channel, WaSendBudget::handset(instance); '' = cannot send here. */
+    public function handsetFor(string $channel): string;
+
+    /** Why nothing may go to $phone on $channel now: '' | a fixed code. */
+    public function refusal(string $channel, string $phone): string;
+
+    /** Whether that code may clear by itself (defer) rather than end the attempt (skip). */
+    public function transient(string $code): bool;
+
+    /**
+     * One message, one attempt, never repeated inside. Where the transport echoes our own message back (Evolution
+     * does), the echo is claimed BEFORE this returns and the outcome is in the result. Throws nothing: a failure is a result.
+     */
+    public function send(OfferMessage $m): OfferSendResult;
+}
+
+final class OfferMessage
+{
+    /** @var string */ public $channel;
+    /** @var string digits */ public $phone;
+    /** @var string the wording and the STOP line */ public $text;
+    /** @var array|null ['payload' => base64, 'mime' => …] */ public $image;
+    /** @var string 'offer.send' | 'offer.test' */ public $echoEvent;
+    /** @var string ContactOptOut::CLASS_PROACTIVE | CLASS_STAFF */ public $class;
+
+    public function __construct(string $channel, string $phone, string $text, ?array $image, string $echoEvent, string $class)
+    {
+        $this->channel   = $channel;
+        $this->phone     = $phone;
+        $this->text      = $text;
+        $this->image     = $image;
+        $this->echoEvent = $echoEvent;
+        $this->class     = $class;
+    }
+}
+
+final class OfferSendResult
+{
+    const SENT = 'sent'; const MAYBE_SENT = 'maybe_sent'; const NOT_SENT = 'not_sent';
+    const REFUSED = 'refused'; const OPTED_OUT = 'opted_out';
+    /** @var string */ public $outcome;
+    /** @var string a fixed code, never transport text */ public $code;
+    /** @var string */ public $messageId;
+    /** @var bool */ public $transient;
+    /** @var string 'claimed' | 'late' | 'none' (O-D18) */ public $echo;
+
+    public function __construct(string $outcome, string $code = '', string $messageId = '', bool $transient = false, string $echo = 'none')
+    {
+        $this->outcome   = $outcome;
+        $this->code      = $code;
+        $this->messageId = $messageId;
+        $this->transient = $transient;
+        $this->echo      = $echo;
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/OfferImage.php b/dishnet-hybrid-sudan/lib/OfferImage.php
new file mode 100644
index 0000000..7ca096a
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/OfferImage.php
@@ -0,0 +1,78 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/FlyerAsset.php';
+
+/**
+ * OfferImage — an offer's optional image (5.18.104 P6, root docs/73 §H.4.7, §H.4.11).
+ *
+ * An upload is accepted by the type getimagesize() detects (JPEG, PNG or WebP), never by the client's file name, at most
+ * FlyerAsset::MAX_FILE_BYTES, into <data>/offer_images/offer-<id>.<ext> (folder 0750), with its sha256 recorded on the
+ * offer. It is never served by URL: Evolution gets base64 (FlyerAsset::payload, the path the AI's flyer takes) and the
+ * screen a data URI. payload() checks the bytes against the recorded sha256 every time it is read, so a file changed or
+ * removed after the tests is never sent. PHP 7.4.
+ */
+final class OfferImage
+{
+    const DIR = 'offer_images';
+    /** Detected type => [mime, extension]. */
+    const TYPES = [
+        IMAGETYPE_JPEG => ['image/jpeg', 'jpg'],
+        IMAGETYPE_PNG  => ['image/png', 'png'],
+        IMAGETYPE_WEBP => ['image/webp', 'webp'],
+    ];
+
+    /**
+     * Accept one upload ($_FILES['image']) for an offer. $move is move_uploaded_file unless a caller (a test) gives its own.
+     *
+     * @return array{ok:bool, code:string, file?:string, mime?:string, bytes?:int, sha256?:string}
+     */
+    public static function accept(array $upload, int $offerId, string $dataDir, ?callable $move = null): array
+    {
+        if ((int)($upload['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK) return ['ok' => false, 'code' => 'upload_error'];
+        $tmp = (string)($upload['tmp_name'] ?? '');
+        if ($tmp === '' || !is_file($tmp) || $offerId <= 0) return ['ok' => false, 'code' => 'upload_error'];
+        $bytes = (int)@filesize($tmp);
+        if ($bytes < 1) return ['ok' => false, 'code' => 'empty'];
+        if ($bytes > FlyerAsset::MAX_FILE_BYTES) return ['ok' => false, 'code' => 'too_large'];
+        $info = @getimagesize($tmp);
+        $type = is_array($info) ? (int)($info[2] ?? 0) : 0;
+        if (!isset(self::TYPES[$type])) return ['ok' => false, 'code' => 'not_an_image'];
+        [$mime, $ext] = self::TYPES[$type];
+        $dir = rtrim($dataDir, '/') . '/' . self::DIR;
+        if (!is_dir($dir) && !@mkdir($dir, 0750, true)) return ['ok' => false, 'code' => 'store_failed'];
+        @chmod($dir, 0750);
+        $name = 'offer-' . $offerId . '.' . $ext;
+        $dest = $dir . '/' . $name;
+        $mover = $move ?? 'move_uploaded_file';
+        if (!$mover($tmp, $dest) || !is_file($dest)) return ['ok' => false, 'code' => 'store_failed'];
+        @chmod($dest, 0640);
+        $sha = (string)hash_file('sha256', $dest);
+        return ['ok' => true, 'code' => '', 'file' => $name, 'mime' => $mime, 'bytes' => (int)filesize($dest), 'sha256' => $sha];
+    }
+
+    /**
+     * What goes into Evolution's media field: null when the offer has no image, '' when its file is missing or no longer
+     * the bytes the offer recorded (image_changed: nothing is sent), else the base64 of the file.
+     */
+    public static function payload(string $dataDir, array $offer): ?string
+    {
+        $file = (string)($offer['image_file'] ?? '');
+        if ($file === '') return null;
+        $p = FlyerAsset::payload(['kind' => 'file', 'path' => rtrim($dataDir, '/') . '/' . self::DIR . '/' . basename($file)]);
+        if ($p === '') return '';
+        $raw = base64_decode($p, true);
+        if ($raw === false || !hash_equals((string)($offer['image_sha256'] ?? ''), hash('sha256', $raw))) return '';
+        return $p;
+    }
+
+    /** The image as a data URI for the screen's preview; '' when there is none or it no longer matches. */
+    public static function thumbnailDataUri(string $dataDir, array $offer): string
+    {
+        $p = self::payload($dataDir, $offer);
+        if ($p === null || $p === '') return '';
+        $mime = (string)($offer['image_mime'] ?? '');
+        if (!in_array($mime, ['image/jpeg', 'image/png', 'image/webp'], true)) return '';
+        return 'data:' . $mime . ';base64,' . $p;
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/OfferSchema.php b/dishnet-hybrid-sudan/lib/OfferSchema.php
new file mode 100644
index 0000000..ff9bca5
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/OfferSchema.php
@@ -0,0 +1,66 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * OfferSchema — whether migration 091 is in place, object by object (5.18.104 P6, root docs/73 §H.4.5; ruling R9).
+ *
+ * check() returns a list of fixed problems; an empty list means sound. It never counts "N tables" on its own (R-12): it
+ * names each of 091's 25 objects with its type, reads each trigger's stored SQL for its END (the runner's splitter cuts a
+ * body short at any word ending in those letters), the columns the sender and the checks depend on, the self-check row
+ * 091 wrote into _schema_checks under its own filename, and the runner's record of the file. Read-only. PHP 7.4.
+ */
+final class OfferSchema
+{
+    const FILE = '091_wa_offers.sql';
+    const EXPECTED = 25;
+    const TABLES = ['wa_offers', 'wa_offer_recipients', 'wa_offer_tests', 'wa_offer_events'];
+    const INDEXES = ['idx_wo_live', 'idx_wo_state', 'idx_wor_once', 'idx_wor_next', 'idx_wor_phone', 'idx_wot_offer', 'idx_woe_offer'];
+    const TRIGGERS = ['wo_never_deleted', 'wo_content_fixed', 'wo_closed_is_final', 'wo_state_path',
+                      'wor_never_deleted', 'wor_final', 'wor_identity_fixed', 'wor_phone_erase_only', 'wor_outcome_fixed', 'wor_marks_once',
+                      'wot_never_deleted', 'wot_final', 'woe_never_deleted', 'woe_never_changed'];
+    const COLUMNS = ['wa_offer_recipients' => ['attempt', 'echo', 'judged_at', 'day_max'], 'wa_offer_tests' => ['echo', 'ledger']];
+
+    /** @return string[] missing:<name> | wrong_type:<name> | trigger_body:<name> | column_missing:<t>.<c> | schema_check_missing | schema_check_count | not_applied */
+    public static function check(\PDO $pdo): array
+    {
+        $bad = [];
+        try {
+            $st = $pdo->prepare('SELECT type, sql FROM sqlite_master WHERE name = ?');
+            foreach (['table' => self::TABLES, 'index' => self::INDEXES, 'trigger' => self::TRIGGERS] as $type => $names) {
+                foreach ($names as $n) {
+                    $st->execute([$n]);
+                    $r = $st->fetch(\PDO::FETCH_ASSOC);
+                    $st->closeCursor();
+                    if (!is_array($r)) { $bad[] = 'missing:' . $n; continue; }
+                    if ((string)$r['type'] !== $type) { $bad[] = 'wrong_type:' . $n; continue; }
+                    if ($type === 'trigger' && strtoupper(substr(rtrim((string)$r['sql']), -3)) !== 'END') $bad[] = 'trigger_body:' . $n;
+                }
+            }
+            foreach (self::COLUMNS as $t => $cols) {
+                $have = [];
+                foreach ($pdo->query('PRAGMA table_info(' . $t . ')')->fetchAll(\PDO::FETCH_ASSOC) as $c) $have[(string)$c['name']] = true;
+                foreach ($cols as $c) if (!isset($have[$c])) $bad[] = 'column_missing:' . $t . '.' . $c;
+            }
+        } catch (\Throwable $e) {
+            $bad[] = 'unreadable';
+            return $bad;
+        }
+        try {
+            $st = $pdo->prepare('SELECT expected, found FROM _schema_checks WHERE migration = ?');
+            $st->execute([self::FILE]);
+            $r = $st->fetch(\PDO::FETCH_ASSOC);
+            if (!is_array($r)) $bad[] = 'schema_check_missing';
+            elseif ((int)$r['expected'] !== self::EXPECTED || (int)$r['found'] !== self::EXPECTED) $bad[] = 'schema_check_count';
+        } catch (\Throwable $e) {
+            $bad[] = 'schema_check_missing';
+        }
+        try {
+            $st = $pdo->prepare('SELECT COUNT(*) FROM _migrations WHERE filename = ?');
+            $st->execute([self::FILE]);
+            if ((int)$st->fetchColumn() !== 1) $bad[] = 'not_applied';
+        } catch (\Throwable $e) {
+            $bad[] = 'not_applied';
+        }
+        return $bad;
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/OfferSender.php b/dishnet-hybrid-sudan/lib/OfferSender.php
new file mode 100644
index 0000000..78862bc
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/OfferSender.php
@@ -0,0 +1,666 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/StoreInterface.php';
+require_once __DIR__ . '/SqliteStore.php';
+require_once __DIR__ . '/PluginConfig.php';
+require_once __DIR__ . '/PluginLog.php';
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/timezone.php';
+require_once __DIR__ . '/TenantProfile.php';
+require_once __DIR__ . '/StaffDirectory.php';
+require_once __DIR__ . '/ContactOptOut.php';
+require_once __DIR__ . '/ConversationService.php';
+require_once __DIR__ . '/JobBudget.php';
+require_once __DIR__ . '/ReminderDay.php';
+require_once __DIR__ . '/WaSendBudget.php';
+require_once __DIR__ . '/HumanTakeover.php';
+require_once __DIR__ . '/QuoteChase.php';
+require_once __DIR__ . '/OfferSwitch.php';
+require_once __DIR__ . '/OfferText.php';
+require_once __DIR__ . '/OfferImage.php';
+require_once __DIR__ . '/OfferWindow.php';
+require_once __DIR__ . '/OfferAudience.php';
+require_once __DIR__ . '/OfferStore.php';
+require_once __DIR__ . '/OfferSchema.php';
+require_once __DIR__ . '/OfferGateway.php';
+require_once __DIR__ . '/EvolutionOfferGateway.php';
+
+/**
+ * OfferSender — the one place an offer leaves (5.18.104 P6, root docs/73 §H.4.10; contract C3; rulings R2, R8, R18, R19).
+ *
+ *   runOnce($deadline)  master's offers_send job (cron/offers_send.php): at most 35 s of starting sends, never past
+ *                       master's deadline, one recipient per handset per run, every claim decided on its own fresh read
+ *   sendTest(...)       the screen's test to the admin's own phone of record: class staff, recorded as ledger kind
+ *                       `other` after the send, never claimed
+ *
+ * Claim before the send, settle after (the contract): the recipient row's CAS, then the ledger claim under the stable ref
+ * offer:<offer_id>:<recipient_id> — idempotent per (kind, ref), the floor beneath the row's CAS — recorded on the row
+ * BEFORE the gateway is called, then the gateway (whose echo claim is inside it), then the ledger's settle, then the row.
+ * A crash can lose one recipient but never send twice: a claimed row with a ledger claim is settled `uncertain` by the
+ * next run's stale sweep and is never sent again; a may-have-been-sent is settled `failed` with maybe_sent, stored
+ * `uncertain`, counted, never retried. The ledger's answers are mapped by CODE (§H.4.10's table, P6's column of Part F's
+ * call contract); an unknown code ends the run (fail closed).
+ *
+ * Logging: counts and fixed codes only (§H.4.15) — never a phone, a name, a wording, a customer's text or transport text.
+ * Test seams (forInstall's $seams; production passes none): clock, gateway, budget, store, wait, nolock. PHP 7.4.
+ */
+final class OfferSender
+{
+    public const TZ = 'Africa/Kampala';
+    const LOCK_FILE = 'offers_send.lock';
+    const SAID_FILE = 'offers_send_said.json';
+    /** O-D8: the run's own budget, one send's client timeout, and the time below which a run only sweeps. */
+    const RUN_S = 35;
+    const SEND_S = 15;
+    const SHORT_S = 20;
+    /** O-D9: the longest a claimed send can take, claim to gateway's return (§H.4.10, the in-flight bound). */
+    const IN_FLIGHT_S = 50;
+    /** A claim this old is stale; the sweep settles or releases it (§H.4.10 step 4). */
+    const STALE_S = 900;
+    const RELEASE_S = 1800;
+    const MARKS_PER_RUN = 500;
+    const PAUSE_MIN_SENDS = 40;
+    const TEST_BUSY_S = 60;
+
+    /** The ledger's defers that carry a retry_at: release the row to it (§H.4.10's table). */
+    const DEFER_CODES = ['in_flight', 'window', 'handset_busy', 'spacing', 'hour_cap', 'day_cap', 'reserved', 'reminders_first'];
+    /** The ledger's final answers that settle the recipient skipped(<code>), the run going on. */
+    const SKIP_CODES = ['tries_exhausted', 'not_claimable', 'no_phone'];
+
+    /** @var string */ private $root;
+    /** @var string */ private $dataDir;
+    /** @var array */  private $config;
+    /** @var \StoreInterface */ private $store;
+    /** @var \PDO */ private $pdo;
+    /** @var callable */ private $clock;
+    /** @var callable */ private $gatewayOf;
+    /** @var callable */ private $budgetOf;
+    /** @var callable */ private $wait;
+    /** @var bool */ private $nolock = false;
+    /** @var array per run */ private $run = [];
+
+    private function __construct() {}
+
+    /**
+     * The sender for an install. $config is the job's start-time configuration (it decides only whether the run begins);
+     * every recipient is decided on a fresh read of the files (ruling R19).
+     *
+     * @param array $seams tests only: clock (fn(): int), gateway (fn(\PDO, array $f, ?string, $store): OfferGateway),
+     *                     budget (fn(array $f, ?string, $store, callable $clock): object), store (StoreInterface),
+     *                     wait (fn(int $realSecond): void), nolock (bool)
+     */
+    public static function forInstall(string $root, string $dataDir, array $config, array $seams = []): self
+    {
+        $s = new self();
+        $s->root    = $root;
+        $s->dataDir = $dataDir;
+        $s->config  = $config;
+        $s->store   = $seams['store'] ?? SqliteStore::create($dataDir);
+        $s->pdo     = $s->store->getPdo();
+        $s->clock   = $seams['clock'] ?? function (): int { return time(); };
+        $s->gatewayOf = $seams['gateway'] ?? function (\PDO $pdo, array $f, ?string $dataDir, $store): OfferGateway {
+            return new EvolutionOfferGateway($pdo, $f, $dataDir, $store);
+        };
+        $s->budgetOf = $seams['budget'] ?? function (array $f, ?string $dataDir, $store, callable $clock) {
+            return WaSendBudget::forInstall($f, $dataDir, $store, null, $clock);
+        };
+        // Step 4's commit waits until the real clock has left the second the judgement was read in (ruling R18).
+        $s->wait = $seams['wait'] ?? function (int $second): void { while (time() <= $second) usleep(20000); };
+        $s->nolock = !empty($seams['nolock']);
+        return $s;
+    }
+
+    private function now(): int
+    {
+        return (int)($this->clock)();
+    }
+
+    // ── the run ────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** @return array{sent:int, uncertain:int, failed:int, skipped:int, deferred:int, handsets:int, code:string} */
+    public function runOnce(?int $deadline): array
+    {
+        $this->run = ['sent' => 0, 'uncertain' => 0, 'failed' => 0, 'skipped' => 0, 'deferred' => 0, 'handsets' => 0, 'code' => ''];
+        // 1. the budget: at most 35 s, never past master's deadline
+        $t0 = $this->now();
+        $until = $t0 + JobBudget::seconds(self::RUN_S, $deadline, $t0);
+        // 2. preconditions, on the job's configuration
+        $why = $this->precondition($this->config);
+        if ($why !== '') return $this->end($why);
+        // 3. the lock, then the configuration read again (IO-8)
+        $fp = null;
+        if (!$this->nolock) {
+            $fp = @fopen(rtrim($this->dataDir, '/') . '/' . self::LOCK_FILE, 'c');
+            if ($fp === false || !flock($fp, LOCK_EX | LOCK_NB)) {
+                if (is_resource($fp)) fclose($fp);
+                return $this->end('busy');
+            }
+        }
+        try {
+            $c = $this->read();
+            if (!OfferSwitch::live($c, $this->dataDir)) return $this->end('offers_off');
+            if (!WaSendBudget::on($c, $this->dataDir)) return $this->end('ledger_off');
+            $budget = ($this->budgetOf)($c, $this->dataDir, $this->store, $this->clock);
+            // 4. the stale sweep: a run that cannot complete it ends here
+            try {
+                $this->sweep($budget);
+            } catch (\Throwable $e) {
+                return $this->end('sweep_failed');
+            }
+            // 5. the live-since guard (O-D19)
+            $this->liveSinceGuard($c);
+            // 6. short on time: only the sweep and the guard
+            if (JobBudget::seconds(self::RUN_S, $deadline, $this->now()) < self::SHORT_S) return $this->end('');
+            // 7. the reply and STOP marks
+            OfferStore::marksPass($this->pdo, \TenantProfile::current($c, $this->dataDir), $this->now(), self::MARKS_PER_RUN);
+            // 8. expiry and completion; 9. the stop rate
+            $this->expireAndComplete($c);
+            $this->stopRate($c);
+            // 10. the window (the run's pre-filter); 11. the reminder gate (ruling R8)
+            if (!OfferWindow::open($c, $this->now())) return $this->end('');
+            $schedule = $this->schedule();
+            if (!ReminderDay::done($schedule, $c, $this->dataDir, $this->now())) return $this->end('reminders_pending');
+            // 12. the handsets due, one recipient each while a send may still start
+            $offer = OfferStore::live($this->pdo);
+            if ($offer === null || (string)$offer['state'] !== 'running') return $this->end('');
+            $image = null;
+            if ((string)($offer['image_file'] ?? '') !== '') {
+                $p = OfferImage::payload($this->dataDir, $offer);
+                if ($p === null || $p === '') return $this->end('image_changed');
+                $image = ['payload' => $p, 'mime' => (string)$offer['image_mime']];
+            }
+            foreach ($this->handsetsDue((int)$offer['id']) as $h) {
+                if (!JobBudget::mayStart($until, self::SEND_S, $this->now())) break;
+                $this->run['handsets']++;
+                $stop = $this->sendNextOn($offer, $h, $schedule, $image);
+                if ($stop !== null) return $this->end($stop);
+            }
+            return $this->end('');
+        } catch (\Throwable $e) {
+            return $this->end('error');
+        } finally {
+            if (is_resource($fp)) { flock($fp, LOCK_UN); fclose($fp); }
+        }
+    }
+
+    /** Step 2: '' or the fixed code the run returns with. */
+    private function precondition(array $config): string
+    {
+        if (!OfferSwitch::live($config, $this->dataDir)) return 'offers_off';
+        if (dn_tz($config) !== self::TZ) return 'zone';
+        if (!self::partF($this->pdo)) return 'partf_missing';
+        foreach (OfferSchema::TABLES as $t) {
+            $q = $this->pdo->prepare("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?");
+            $q->execute([$t]);
+            if ($q->fetchColumn() === false) return 'schema_missing';
+        }
+        return '';
+    }
+
+    /** Part F's pieces (§H.4.14): loadable, with their tables. Nothing of Part V (ruling R3). */
+    public static function partF(\PDO $pdo): bool
+    {
+        foreach ([['WaSendBudget', 'claim'], ['WaSendBudget', 'settle'], ['WaSendBudget', 'record'], ['WaSendBudget', 'handset'],
+                  ['QuoteChase', 'offerHolds'], ['QuoteChase', 'offerHold'], ['HumanTakeover', 'phonesSince'],
+                  ['HumanTakeover', 'phoneSince'], ['ReminderDay', 'done'], ['JobBudget', 'seconds'], ['JobBudget', 'mayStart']] as [$c, $m]) {
+            if (!class_exists($c) || !method_exists($c, $m)) return false;
+        }
+        foreach (['wa_auto_sends', 'wa_seen_marks'] as $t) {
+            $q = $pdo->prepare("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?");
+            $q->execute([$t]);
+            if ($q->fetchColumn() === false) return false;
+        }
+        return true;
+    }
+
+    /** The files, read now: never the job's configuration, never the store's cached kyc_config.json (IO-8, ruling R19). */
+    private function read(): array
+    {
+        return PluginConfig::read($this->root, $this->dataDir);
+    }
+
+    private function schedule(): array
+    {
+        try {
+            return (array)($this->store->load('master_schedule.json') ?? []);
+        } catch (\Throwable $e) {
+            return [];   // unreadable: ReminderDay then holds offers until reminder_until_hour
+        }
+    }
+
+    private function end(string $code): array
+    {
+        $this->run['code'] = $code;
+        if ($code !== '') $this->sayOnceToday($code);
+        return $this->run;
+    }
+
+    /** A fixed code into the plugin log, once per Kampala day. */
+    private function sayOnceToday(string $code): void
+    {
+        try {
+            $f = rtrim($this->dataDir, '/') . '/' . self::SAID_FILE;
+            $day = WaSendBudget::localDay($this->now());
+            $said = is_file($f) ? (json_decode((string)@file_get_contents($f), true) ?: []) : [];
+            if (($said[$code] ?? '') === $day) return;
+            $said[$code] = $day;
+            @file_put_contents($f, json_encode($said), LOCK_EX);
+            PluginLog::write('offers_send', $code);
+        } catch (\Throwable $e) { /* a log line is never worth a send */ }
+    }
+
+    // ── steps 4, 5, 8 and 9 ────────────────────────────────────────────────────────────────────────────────────
+
+    /** Step 4: claims older than 15 minutes, and tests left sending as long. */
+    private function sweep($budget): void
+    {
+        $now = $this->now();
+        $at = UtcClock::stamp($now);
+        $stale = UtcClock::stamp($now - self::STALE_S);
+        // the gateway was never called: back to queued
+        $this->pdo->prepare("UPDATE wa_offer_recipients SET state = 'queued', not_before = :now
+                              WHERE state = 'claimed' AND claimed_at < :stale AND ledger_claim IS NULL")
+            ->execute([':now' => $at, ':stale' => $stale]);
+        // the message may have gone: settled uncertain, never sent again (ruling R2)
+        $st = $this->pdo->prepare("SELECT id, ledger_claim FROM wa_offer_recipients
+                                    WHERE state = 'claimed' AND claimed_at < ? AND ledger_claim IS NOT NULL");
+        $st->execute([$stale]);
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            $budget->settle((int)$r['ledger_claim'], 'failed', ['maybe_sent' => true]);
+            $this->pdo->prepare("UPDATE wa_offer_recipients SET state = 'uncertain', reason = 'stale_claim', sent_at = claimed_at,
+                                        settled_at = ? WHERE id = ? AND state = 'claimed'")
+                ->execute([$at, (int)$r['id']]);
+        }
+        $this->pdo->prepare("UPDATE wa_offer_tests SET state = 'uncertain', settled_at = ? WHERE state = 'sending' AND started_at < ?")
+            ->execute([$at, $stale]);
+    }
+
+    /** Step 5: a running offer whose latest Start or Resume is not later than offers_live_since is paused (O-D19). */
+    private function liveSinceGuard(array $c): void
+    {
+        $since = (int)OfferSwitch::liveSince($c);
+        foreach ($this->pdo->query("SELECT id FROM wa_offers WHERE state = 'running'")->fetchAll(\PDO::FETCH_COLUMN) as $id) {
+            if (OfferStore::lastStartOrResume($this->pdo, (int)$id) <= $since) {
+                OfferStore::pause($this->pdo, (int)$id, null, 'system', $this->now(), 'paused_by_switch');
+            }
+        }
+    }
+
+    /** Step 8: past offers_max_days → done/expired; nothing queued or claimed left → done. */
+    private function expireAndComplete(array $c): void
+    {
+        $max = (int)(OfferSwitch::settings($c)['offers_max_days'] ?? OfferSwitch::SETTINGS['offers_max_days'][0]);
+        $now = $this->now();
+        foreach ($this->pdo->query("SELECT id, state, started_at FROM wa_offers WHERE state IN ('running', 'paused')")->fetchAll(\PDO::FETCH_ASSOC) as $o) {
+            if (UtcClock::parse((string)$o['started_at']) + $max * 86400 <= $now) {
+                OfferStore::close($this->pdo, (int)$o['id'], 'expired', $now);
+                continue;
+            }
+            if ((string)$o['state'] !== 'running') continue;
+            $q = $this->pdo->prepare("SELECT COUNT(*) FROM wa_offer_recipients WHERE offer_id = ? AND state IN ('queued', 'claimed')");
+            $q->execute([(int)$o['id']]);
+            $left = (int)$q->fetchColumn();
+            $q->closeCursor();                    // no read left open on this connection before it writes
+            if ($left === 0) OfferStore::close($this->pdo, (int)$o['id'], 'done', $now);
+        }
+    }
+
+    /** Step 9: with at least 40 sent or may-have-been-sent, STOP at or above offers_stop_pause_pct of them pauses the offer (O-D13). */
+    private function stopRate(array $c): void
+    {
+        $pct = (int)(OfferSwitch::settings($c)['offers_stop_pause_pct'] ?? OfferSwitch::SETTINGS['offers_stop_pause_pct'][0]);
+        foreach ($this->pdo->query("SELECT id FROM wa_offers WHERE state = 'running'")->fetchAll(\PDO::FETCH_COLUMN) as $id) {
+            $q = $this->pdo->prepare("SELECT sum(state IN ('sent', 'uncertain')), sum(state IN ('sent', 'uncertain') AND stop_at IS NOT NULL)
+                                        FROM wa_offer_recipients WHERE offer_id = ?");
+            $q->execute([(int)$id]);
+            [$sent, $stops] = array_map('intval', $q->fetch(\PDO::FETCH_NUM) ?: [0, 0]);
+            $q->closeCursor();
+            if ($sent >= self::PAUSE_MIN_SENDS && $stops * 100 >= $pct * $sent) {
+                OfferStore::pause($this->pdo, (int)$id, null, 'system', $this->now(), 'paused_stop_rate', 'stops=' . $stops . ' sends=' . $sent);
+            }
+        }
+    }
+
+    /** Step 12: the handsets with a queued row due, oldest last offer send first. @return string[] */
+    private function handsetsDue(int $offerId): array
+    {
+        $now = UtcClock::stamp($this->now());
+        $st = $this->pdo->prepare("SELECT q.handset, (SELECT MAX(COALESCE(r.sent_at, r.claimed_at)) FROM wa_offer_recipients r
+                                                        WHERE r.handset = q.handset AND r.state IN ('sent', 'uncertain', 'claimed')) AS last
+                                     FROM wa_offer_recipients q
+                                    WHERE q.offer_id = ? AND q.state = 'queued' AND (q.not_before IS NULL OR q.not_before <= ?)
+                                    GROUP BY q.handset ORDER BY last IS NOT NULL, last, q.handset");
+        $st->execute([$offerId, $now]);
+        return array_map('strval', $st->fetchAll(\PDO::FETCH_COLUMN));
+    }
+
+    // ── one recipient ──────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * §H.4.10's sequence on one handset, ONCE: step 12 sends one recipient per handset per run (O-D8), and step 4's lock
+     * is held once per handset per run (§H.4.21: under a second before each claim). A row judged away ends the handset's
+     * turn as a send does: a skip is settled, a defer released to its not_before, a move re-pointed and released, and the
+     * next run takes the handset's next row. Returns null to go on to the next handset, or the fixed code that ends the run.
+     */
+    private function sendNextOn(array $offer, string $handset, array $schedule, ?array $image): ?string
+    {
+        $r = $this->oneRecipient($offer, $handset, $schedule, $image);
+        if ($r === 'next' || $r === 'turn') return null;   // the handset's one recipient this run: the next handset
+        return $r;                                          // a code that ends the run ('' included)
+    }
+
+    /** @return string 'next' | 'turn' | an ending code ('' = end quietly) */
+    private function oneRecipient(array $offer, string $handset, array $schedule, ?array $image): string
+    {
+        $pdo = $this->pdo;
+        $offerId = (int)$offer['id'];
+        // 1. the next row
+        $st = $pdo->prepare("SELECT * FROM wa_offer_recipients WHERE offer_id = ? AND handset = ? AND state = 'queued'
+                               AND (not_before IS NULL OR not_before <= ?) ORDER BY rank LIMIT 1");
+        $st->execute([$offerId, $handset, UtcClock::stamp($this->now())]);
+        $row = $st->fetch(\PDO::FETCH_ASSOC);
+        $st->closeCursor();                       // a read left open would make the CAS fail once another process writes (WAL)
+        if (!is_array($row)) return 'turn';
+        $id = (int)$row['id'];
+        // 2. the CAS claim, the per-recipient guard
+        $token = bin2hex(random_bytes(8));
+        $cas = $pdo->prepare("UPDATE wa_offer_recipients SET state = 'claimed', claim_token = ?, claimed_at = ?, attempt = attempt + 1
+                               WHERE id = ? AND state = 'queued'");
+        $cas->execute([$token, UtcClock::stamp($this->now()), $id]);
+        if ($cas->rowCount() !== 1) return 'turn';
+        // 3. the offer, read fresh
+        $o = OfferStore::find($pdo, $offerId);
+        if ($o === null || (string)$o['state'] !== 'running') {
+            if ($o !== null && (string)$o['state'] === 'paused') { $this->release($id, $token, null); return ''; }
+            $this->settleRow($id, $token, 'skipped', 'offer_stopped');
+            return 'next';
+        }
+        // 4. the recipient's own read, then judge() at its moment (rulings R18, R19)
+        $f = $this->read();
+        if (!OfferSwitch::live($f, $this->dataDir)) { $this->release($id, $token, null); return 'offers_off'; }
+        if (!WaSendBudget::on($f, $this->dataDir)) { $this->release($id, $token, null); return 'ledger_off'; }
+        if (OfferStore::lastStartOrResume($pdo, $offerId) <= (int)OfferSwitch::liveSince($f)) { $this->release($id, $token, null); return 'offers_off'; }
+        if (!OfferWindow::open($f, $this->now())) { $this->release($id, $token, null); return ''; }
+        if (!ReminderDay::done($schedule, $f, $this->dataDir, $this->now())) { $this->release($id, $token, null); return 'reminders_pending'; }
+        $fb = ($this->budgetOf)($f, $this->dataDir, $this->store, $this->clock);
+        $gw = ($this->gatewayOf)($pdo, $f, $this->dataDir, $this->store);
+        $judgeCfg = ['offers_warm_days' => (int)$o['warm_days'], 'offers_recent_days' => (int)$o['recent_days']] + $f;
+        $dayMax = (int)(OfferSwitch::settings($f)['offers_daily_max_per_handset'] ?? 0);
+        $j = $this->judgeAndWrite($row, $token, $judgeCfg, $gw, $dayMax);
+        if ($j === null) return '';                               // CAS lost, or the book's lock not had: nothing claimed
+        if ($j['outcome'] === 'skip') { $this->run['skipped']++; return 'next'; }
+        if ($j['outcome'] === 'defer' || $j['outcome'] === 'move') { $this->run['deferred']++; return 'next'; }
+        $row = array_merge($row, ['judged_at' => $j['judged_at'], 'day_max' => $dayMax]);
+
+        // 5. the handset today: the offers ceiling, and three certain failures in a row
+        $now = $this->now();
+        $tomorrow = OfferWindow::nextOpen($f, OfferWindow::nextDayStart($now));
+        if ($this->todayOnHandset($handset, $id, $now) >= $dayMax || $this->failingToday($handset, $now)) {
+            $this->release($id, $token, $tomorrow);
+            $this->run['deferred']++;
+            return 'turn';
+        }
+        // 6. the ledger claim, on this recipient's own ledger (ruling R19): the stable ref, the phone, the in-flight bound
+        $ref = 'offer:' . $offerId . ':' . $id;
+        $a = $fb->claim((string)$row['handset'], 'offer', $ref, ['phone' => (string)$row['phone'], 'in_flight_s' => self::IN_FLIGHT_S]);
+        if (empty($a['ok'])) return $this->onDefer($id, $token, $a, $f, $now);
+        $h = (int)$a['claim'];
+        // 7. the claim and the variant, recorded before the send
+        $words = OfferStore::wordingsOf($o);
+        $v = OfferText::variantFor(count($words), $this->priorOnHandset($offerId, $handset));
+        $rec = $pdo->prepare("UPDATE wa_offer_recipients SET ledger_claim = ?, variant = ? WHERE id = ? AND state = 'claimed' AND claim_token = ?");
+        $rec->bindValue(1, $h, \PDO::PARAM_INT);
+        $rec->bindValue(2, $v, \PDO::PARAM_INT);
+        $rec->bindValue(3, $id, \PDO::PARAM_INT);
+        $rec->bindValue(4, $token);
+        $rec->execute();
+        if ($rec->rowCount() !== 1) {
+            $fb->settle($h, 'failed');
+            $this->release($id, $token, null);
+            return 'turn';
+        }
+        // 8. the send; the echo is claimed inside the gateway, immediately after the POST returns
+        $text = OfferText::render($words[$v], (string)$o['stop_line']);
+        $res = $gw->send(new OfferMessage((string)$row['channel'], (string)$row['phone'], $text, $image, 'offer.send', ContactOptOut::CLASS_PROACTIVE));
+        $sentAt = UtcClock::stamp($this->now());
+        // 9. the ledger's settle (never throws into the sender)
+        if ($res->outcome === OfferSendResult::SENT) {
+            $fb->settle($h, 'sent', ['wa_message_id' => $res->messageId]);
+        } elseif ($res->outcome === OfferSendResult::MAYBE_SENT) {
+            $fb->settle($h, 'failed', ['maybe_sent' => true, 'wa_message_id' => $res->messageId]);
+        } else {
+            $fb->settle($h, 'failed');
+        }
+        // 10. the row
+        $this->settleSend($id, $token, $res, $sentAt, $now);
+        // 11. the message, in its conversation (SENT only): role agent, 'DishNet Plugin', event_key wa_offer (O-D12)
+        if ($res->outcome === OfferSendResult::SENT) {
+            try {
+                (new ConversationService($this->dataDir, $pdo))->storeMessage((int)$row['conversation_id'], [
+                    'direction' => 'out', 'role' => 'agent', 'body' => $text, 'media_type' => $image !== null ? 'image' : null,
+                    'agent_name' => 'DishNet Plugin', 'event_key' => 'wa_offer', 'wa_message_id' => $res->messageId,
+                    'sent_at' => $sentAt,
+                    'metadata' => ['source' => 'offer', 'offer_id' => $offerId, 'recipient_id' => $id, 'variant' => $v],
+                ]);
+            } catch (\Throwable $e) { /* the customer has it; bookkeeping changes no outcome */ }
+        }
+        return 'turn';
+    }
+
+    /**
+     * Step 4's transaction: judged at its moment under the book's write lock, the outcome written under the row's CAS,
+     * committed only once the clock has left the judgement's second. Null when the CAS changed nothing or the lock was not
+     * had: the row stays claimed with no ledger claim (the 2–6 crash window).
+     */
+    private function judgeAndWrite(array $row, string $token, array $cfg, OfferGateway $gw, int $dayMax): ?array
+    {
+        $pdo = $this->pdo;
+        $id = (int)$row['id'];
+        try {
+            if (!OfferStore::begin($pdo)) return null;
+        } catch (\Throwable $e) {
+            return null;
+        }
+        try {
+            $real = time();
+            $judged = UtcClock::stamp($this->now());
+            $stored = $this->store->load('retailers.json');
+            $kyc = $this->store->load('kyc_config.json');
+            $j = OfferAudience::judge($pdo, $cfg, $this->dataDir, (array)$stored, (array)$kyc, $row, $judged, $gw);
+            if ($j['outcome'] === 'skip') {
+                $st = $pdo->prepare("UPDATE wa_offer_recipients SET state = 'skipped', reason = ?, judged_at = ?, settled_at = ?
+                                      WHERE id = ? AND state = 'claimed' AND claim_token = ?");
+                $st->execute([$j['code'], $judged, $judged, $id, $token]);
+            } elseif ($j['outcome'] === 'defer') {
+                $st = $pdo->prepare("UPDATE wa_offer_recipients SET state = 'queued', not_before = ?, reason = ?, judged_at = ?
+                                      WHERE id = ? AND state = 'claimed' AND claim_token = ?");
+                $st->execute([UtcClock::stamp((int)$j['retry_at']), $j['code'], $judged, $id, $token]);
+            } elseif ($j['outcome'] === 'move') {
+                $st = $pdo->prepare("UPDATE wa_offer_recipients SET state = 'queued', not_before = NULL, conversation_id = ?, channel = ?,
+                                            handset = ?, reason = 'moved', judged_at = ? WHERE id = ? AND state = 'claimed' AND claim_token = ?");
+                $st->execute([(int)$j['conversation_id'], (string)$j['channel'], (string)$j['handset'], $judged, $id, $token]);
+            } else {
+                $st = $pdo->prepare("UPDATE wa_offer_recipients SET judged_at = ?, day_max = ?
+                                      WHERE id = ? AND state = 'claimed' AND claim_token = ?");
+                $st->execute([$judged, $dayMax, $id, $token]);
+            }
+            if ($st->rowCount() !== 1) { $pdo->exec('ROLLBACK'); return null; }
+            ($this->wait)($real);                                     // every row stored in this second was in judge()'s read
+            $pdo->exec('COMMIT');
+            return $j + ['judged_at' => $judged];
+        } catch (\Throwable $e) {
+            try { $pdo->exec('ROLLBACK'); } catch (\Throwable $e2) { /* none open */ }
+            if ($e instanceof \RuntimeException && strpos($e->getMessage(), 'audience_unreadable:') === 0) {
+                $this->sayOnceToday('audience_unreadable');
+            }
+            return null;
+        }
+    }
+
+    /** §H.4.10's table: the ledger's answer at step 6, by code. */
+    private function onDefer(int $id, string $token, array $a, array $f, int $now): string
+    {
+        $code = (string)($a['defer'] ?? '');
+        $retry = $a['retry_at'] ?? null;
+        if (in_array($code, self::DEFER_CODES, true) && is_int($retry)) {
+            $this->release($id, $token, $retry);
+            $this->run['deferred']++;
+            return 'turn';
+        }
+        if ($code === 'phone_today') {
+            $this->release($id, $token, OfferWindow::nextOpen($f, OfferWindow::nextDayStart($now)));
+            $this->run['deferred']++;
+            return 'turn';
+        }
+        if ($code === 'already_sent') {
+            $this->pdo->prepare("UPDATE wa_offer_recipients SET state = 'uncertain', reason = 'ledger_already_sent', sent_at = claimed_at,
+                                        settled_at = ? WHERE id = ? AND state = 'claimed' AND claim_token = ?")
+                ->execute([UtcClock::stamp($now), $id, $token]);
+            $this->run['uncertain']++;
+            return 'turn';
+        }
+        if (in_array($code, self::SKIP_CODES, true)) {
+            $this->settleRow($id, $token, 'skipped', $code);
+            $this->run['skipped']++;
+            return 'turn';
+        }
+        // ledger_error, ledger_off, zone, no_instance, and any code not named: the row released unchanged, the run ends
+        $this->release($id, $token, null);
+        return preg_match('/^[a-z_]{1,40}$/', $code) && !in_array($code, ['next', 'turn'], true) ? $code : 'ledger_unknown';
+    }
+
+    /** Step 10: the row, by the gateway's answer, under its CAS. */
+    private function settleSend(int $id, string $token, OfferSendResult $res, string $sentAt, int $now): void
+    {
+        $pdo = $this->pdo;
+        $w = ' WHERE id = :id AND state = \'claimed\' AND claim_token = :t';
+        $at = UtcClock::stamp($this->now());
+        if ($res->outcome === OfferSendResult::SENT) {
+            $pdo->prepare("UPDATE wa_offer_recipients SET state = 'sent', sent_at = :s, settled_at = :at, wa_message_id = :m, echo = :e" . $w)
+                ->execute([':s' => $sentAt, ':at' => $at, ':m' => $res->messageId, ':e' => $res->echo, ':id' => $id, ':t' => $token]);
+            $this->run['sent']++;
+        } elseif ($res->outcome === OfferSendResult::MAYBE_SENT) {
+            $pdo->prepare("UPDATE wa_offer_recipients SET state = 'uncertain', reason = :r, sent_at = :s, settled_at = :at,
+                                  wa_message_id = :m, echo = :e" . $w)
+                ->execute([':r' => $res->code, ':s' => $sentAt, ':at' => $at, ':m' => $res->messageId === '' ? null : $res->messageId,
+                           ':e' => $res->echo, ':id' => $id, ':t' => $token]);
+            $this->run['uncertain']++;
+        } elseif ($res->outcome === OfferSendResult::OPTED_OUT) {
+            $this->settleRow($id, $token, 'skipped', 'opted_out');
+            $this->run['skipped']++;
+        } elseif ($res->outcome === OfferSendResult::REFUSED && $res->transient) {
+            $this->release($id, $token, $now + self::RELEASE_S);
+            $this->run['deferred']++;
+        } elseif ($res->outcome === OfferSendResult::REFUSED) {
+            $this->settleRow($id, $token, 'skipped', 'refused:' . $res->code);
+            $this->run['skipped']++;
+        } else {
+            $this->settleRow($id, $token, 'failed', $res->code === '' ? 'send_failed' : $res->code);   // no automatic retry
+            $this->run['failed']++;
+        }
+    }
+
+    private function settleRow(int $id, string $token, string $state, string $reason): void
+    {
+        $this->pdo->prepare("UPDATE wa_offer_recipients SET state = ?, reason = ?, settled_at = ? WHERE id = ? AND state = 'claimed' AND claim_token = ?")
+            ->execute([$state, substr($reason, 0, 60), UtcClock::stamp($this->now()), $id, $token]);
+    }
+
+    /** Back to queued, due at $notBefore (null: due now). */
+    private function release(int $id, string $token, ?int $notBefore): void
+    {
+        $this->pdo->prepare("UPDATE wa_offer_recipients SET state = 'queued', not_before = ? WHERE id = ? AND state = 'claimed' AND claim_token = ?")
+            ->execute([$notBefore === null ? null : UtcClock::stamp($notBefore), $id, $token]);
+    }
+
+    /** The handset's offers today other than this row: sent, may have been sent, or in flight (step 5). */
+    private function todayOnHandset(string $handset, int $exceptId, int $now): int
+    {
+        $st = $this->pdo->prepare("SELECT COUNT(*) FROM wa_offer_recipients WHERE handset = ? AND id <> ? AND state IN ('sent', 'uncertain', 'claimed')
+                                     AND COALESCE(sent_at, claimed_at) >= ?");
+        $st->execute([$handset, $exceptId, UtcClock::stamp(OfferWindow::dayStart($now))]);
+        return (int)$st->fetchColumn();
+    }
+
+    /** Three certain failures in a row on the handset today: handset_failing. */
+    private function failingToday(string $handset, int $now): bool
+    {
+        $st = $this->pdo->prepare("SELECT state FROM wa_offer_recipients WHERE handset = ? AND settled_at >= ?
+                                     AND state IN ('sent', 'uncertain', 'failed') ORDER BY settled_at DESC, id DESC LIMIT 3");
+        $st->execute([$handset, UtcClock::stamp(OfferWindow::dayStart($now))]);
+        $s = $st->fetchAll(\PDO::FETCH_COLUMN);
+        return count($s) === 3 && $s === ['failed', 'failed', 'failed'];
+    }
+
+    /** The offer's earlier sends (and claims) on this handset that already chose a wording: for variants in turn. */
+    private function priorOnHandset(int $offerId, string $handset): int
+    {
+        $st = $this->pdo->prepare('SELECT COUNT(*) FROM wa_offer_recipients WHERE offer_id = ? AND handset = ? AND variant IS NOT NULL');
+        $st->execute([$offerId, $handset]);
+        return (int)$st->fetchColumn();
+    }
+
+    // ── the admin's test (O-D10) ───────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * One test of one wording of a draft to the admin's own phone of record, never a typed number; class staff; recorded
+     * after the send as ledger kind `other` (ref offer_test:<id>), never claimed. It decides on a fresh read taken
+     * immediately before it, on which the screen and the ledger must both be on (ruling R19), and records that moment as
+     * the test's started_at. Not stored in any conversation; no window or reminder gate (it goes to our own staff).
+     *
+     * @return array{ok:bool, code:string, test_id:int}
+     */
+    public function sendTest(int $offerId, int $variant, string $channel, array $adminRow): array
+    {
+        $no = function (string $code, int $tid = 0): array { return ['ok' => false, 'code' => $code, 'test_id' => $tid]; };
+        $o = OfferStore::find($this->pdo, $offerId);
+        if ($o === null || (string)$o['state'] !== 'draft') return $no('not_draft');
+        $t0 = $this->now();
+        $f = $this->read();
+        if (!OfferSwitch::screen($f, $this->dataDir)) return $no('offers_off');
+        if (!WaSendBudget::on($f, $this->dataDir)) return $no('ledger_off');
+        $words = OfferStore::wordingsOf($o);
+        if (!isset($words[$variant])) return $no('bad_variant');
+        $tenant = \TenantProfile::current($f, $this->dataDir);
+        $intl = \StaffDirectory::phoneOf($adminRow, $tenant);
+        if ($intl === null) return $no('no_phone_of_record');
+        $gw = ($this->gatewayOf)($this->pdo, $f, $this->dataDir, $this->store);
+        $handset = $gw->handsetFor($channel);
+        if ($handset === '') return $no('no_instance');
+        $cr = $gw->refusal($channel, '');                       // the number itself may send; the recipient is our own staff
+        if ($cr !== '') return $no('channel_refused:' . $cr);
+        $image = null;
+        if ((string)($o['image_file'] ?? '') !== '') {
+            $p = OfferImage::payload($this->dataDir, $o);
+            if ($p === null || $p === '') return $no('image_changed');
+            $image = ['payload' => $p, 'mime' => (string)$o['image_mime']];
+        }
+        $at = UtcClock::stamp($this->now());
+        $this->pdo->prepare("UPDATE wa_offer_tests SET state = 'uncertain', settled_at = ? WHERE offer_id = ? AND state = 'sending' AND started_at < ?")
+            ->execute([$at, $offerId, UtcClock::stamp($this->now() - self::STALE_S)]);
+        $q = $this->pdo->prepare("SELECT COUNT(*) FROM wa_offer_tests WHERE offer_id = ? AND state = 'sending' AND started_at >= ?");
+        $q->execute([$offerId, UtcClock::stamp($this->now() - self::TEST_BUSY_S)]);
+        $busy = (int)$q->fetchColumn();
+        $q->closeCursor();
+        if ($busy > 0) return $no('test_in_progress');
+        $this->pdo->prepare("INSERT INTO wa_offer_tests (offer_id, content_hash, variant, staff_id, channel, handset, state, started_at)
+                             VALUES (?, ?, ?, ?, ?, ?, 'sending', ?)")
+            ->execute([$offerId, (string)$o['content_hash'], $variant, (int)($adminRow['id'] ?? 0), $channel, $handset, UtcClock::stamp($t0)]);
+        $tid = (int)$this->pdo->lastInsertId();
+        $res = $gw->send(new OfferMessage($channel, ltrim($intl, '+'), OfferText::render($words[$variant], (string)$o['stop_line']),
+                                          $image, 'offer.test', ContactOptOut::CLASS_STAFF));
+        $budget = ($this->budgetOf)($f, $this->dataDir, $this->store, $this->clock);
+        $sent = $res->outcome === OfferSendResult::SENT;
+        $maybe = $res->outcome === OfferSendResult::MAYBE_SENT;
+        $ledger = $budget->record($handset, 'other', 'offer_test:' . $tid, $sent ? 'sent' : 'failed',
+                                  ['maybe_sent' => $maybe, 'wa_message_id' => $res->messageId]);
+        $state = $sent ? 'sent' : ($maybe ? 'uncertain' : 'failed');
+        $reason = $sent ? null : ($res->outcome === OfferSendResult::REFUSED ? 'refused:' . $res->code : ($res->code === '' ? 'send_failed' : $res->code));
+        $this->pdo->prepare("UPDATE wa_offer_tests SET state = ?, reason = ?, ledger = ?, echo = ?, wa_message_id = ?, settled_at = ?
+                              WHERE id = ? AND state = 'sending'")
+            ->execute([$state, $reason, (string)$ledger, $res->echo, $res->messageId === '' ? null : $res->messageId,
+                       UtcClock::stamp($this->now()), $tid]);
+        return ['ok' => $sent, 'code' => $sent ? '' : (string)$reason, 'test_id' => $tid];
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/OfferStore.php b/dishnet-hybrid-sudan/lib/OfferStore.php
new file mode 100644
index 0000000..3b85bb1
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/OfferStore.php
@@ -0,0 +1,394 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/OfferText.php';
+require_once __DIR__ . '/OfferSwitch.php';
+require_once __DIR__ . '/OfferAudience.php';
+
+/**
+ * OfferStore — the offer rows of migration 091 and their trail (5.18.104 P6, root docs/73 §H.4.5, §H.4.7, §H.4.12).
+ *
+ * create, edit and setImage change a draft only, and each recomputes content_hash, so tests of the old content no longer
+ * count; start freezes the audience as a snapshot in one BEGIN IMMEDIATE (O-D2), only with every wording tested and
+ * recorded in the ledger on the current content within 7 days (C-O1-1's count), and rolls the whole start back when nobody
+ * is eligible; pause and resume change the state only; stop skips the queued rows. Every act writes one wa_offer_events
+ * row carrying counts and fixed codes only, never a wording or a number. 091's triggers are the floor beneath each rule:
+ * an offer is never deleted, what it says is fixed once started, a closed offer is final. Every time is the caller's
+ * clock in UTC storage form. PHP 7.4.
+ */
+final class OfferStore
+{
+    /** A test proves its wording for this long before a Start (§H.4.7). */
+    const TEST_VALID_S = 604800;
+    /** The reply and STOP marks: within 72 h of the send (§H.4.12). */
+    const MARK_WINDOW_S = 259200;
+
+    // ── reads ──────────────────────────────────────────────────────────────────────────────────────────────────
+
+    public static function find(\PDO $pdo, int $id): ?array
+    {
+        $st = $pdo->prepare('SELECT * FROM wa_offers WHERE id = ?');
+        $st->execute([$id]);
+        $r = $st->fetch(\PDO::FETCH_ASSOC);
+        return is_array($r) ? $r : null;
+    }
+
+    /** The one live offer (running or paused), or null (O-D1). */
+    public static function live(\PDO $pdo): ?array
+    {
+        $r = $pdo->query('SELECT * FROM wa_offers WHERE live_slot = 1 LIMIT 1')->fetch(\PDO::FETCH_ASSOC);
+        return is_array($r) ? $r : null;
+    }
+
+    /** The offer's wordings, 1-based. @return array<int,string> */
+    public static function wordingsOf(array $offer): array
+    {
+        $w = [1 => (string)$offer['wording_1'], 2 => (string)$offer['wording_2']];
+        if ((string)($offer['wording_3'] ?? '') !== '') $w[3] = (string)$offer['wording_3'];
+        return $w;
+    }
+
+    /** How many of the offer's wordings have a sent test, recorded in the ledger, on the current content, within 7 days. */
+    public static function testedVariants(\PDO $pdo, array $offer, int $now): int
+    {
+        $st = $pdo->prepare("SELECT count(DISTINCT variant) FROM wa_offer_tests WHERE offer_id = ? AND state = 'sent' AND ledger = 'recorded'
+                               AND content_hash = ? AND started_at >= ?");
+        $st->execute([(int)$offer['id'], (string)$offer['content_hash'], UtcClock::stamp($now - self::TEST_VALID_S)]);
+        return (int)$st->fetchColumn();
+    }
+
+    // ── a draft ────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** @return array{ok:bool, id:int, errors:string[]} */
+    public static function create(\PDO $pdo, string $title, array $wordings, string $size, int $byId, string $byName, int $now): array
+    {
+        $bad = OfferText::validate($title, $wordings);
+        if (!array_key_exists($size, OfferAudience::SIZES)) $bad[] = 'size';
+        if ($bad !== []) return ['ok' => false, 'id' => 0, 'errors' => $bad];
+        $w = OfferText::wordings($wordings);
+        $id = 0;
+        self::tx($pdo, function () use ($pdo, $title, $w, $size, $byId, $byName, $now, &$id) {
+            $at = UtcClock::stamp($now);
+            $pdo->prepare('INSERT INTO wa_offers (title, wording_1, wording_2, wording_3, stop_line, content_hash, audience_size,
+                                                  created_by_id, created_by, created_at, updated_at)
+                           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)')
+                ->execute([trim($title), $w[0], $w[1], $w[2] ?? null, OfferText::STOP_LINE,
+                           OfferText::contentHash($w, OfferText::STOP_LINE, null), $size, $byId, $byName, $at, $at]);
+            $id = (int)$pdo->lastInsertId();
+            self::event($pdo, $id, 'created', $byId, $byName, 'wordings=' . count($w), $now);
+        });
+        return ['ok' => true, 'id' => $id, 'errors' => []];
+    }
+
+    /** A draft's title, wordings and size; the image is kept. @return array{ok:bool, errors:string[]} */
+    public static function edit(\PDO $pdo, int $id, string $title, array $wordings, string $size, int $byId, string $byName, int $now): array
+    {
+        $bad = OfferText::validate($title, $wordings);
+        if (!array_key_exists($size, OfferAudience::SIZES)) $bad[] = 'size';
+        if ($bad !== []) return ['ok' => false, 'errors' => $bad];
+        $w = OfferText::wordings($wordings);
+        $ok = false;
+        self::tx($pdo, function () use ($pdo, $id, $title, $w, $size, $byId, $byName, $now, &$ok) {
+            $o = self::find($pdo, $id);
+            if ($o === null || (string)$o['state'] !== 'draft') return;
+            $st = $pdo->prepare("UPDATE wa_offers SET title = ?, wording_1 = ?, wording_2 = ?, wording_3 = ?, content_hash = ?,
+                                        audience_size = ?, updated_at = ? WHERE id = ? AND state = 'draft'");
+            $st->execute([trim($title), $w[0], $w[1], $w[2] ?? null,
+                          OfferText::contentHash($w, (string)$o['stop_line'], $o['image_sha256'] === null ? null : (string)$o['image_sha256']),
+                          $size, UtcClock::stamp($now), $id]);
+            $ok = $st->rowCount() === 1;
+            if ($ok) self::event($pdo, $id, 'edited', $byId, $byName, 'wordings=' . count($w), $now);
+        });
+        return ['ok' => $ok, 'errors' => $ok ? [] : ['not_draft']];
+    }
+
+    /** Set (OfferImage::accept()'s answer) or clear (null) a draft's image. */
+    public static function setImage(\PDO $pdo, int $id, ?array $img, int $byId, string $byName, int $now): bool
+    {
+        $ok = false;
+        self::tx($pdo, function () use ($pdo, $id, $img, $byId, $byName, $now, &$ok) {
+            $o = self::find($pdo, $id);
+            if ($o === null || (string)$o['state'] !== 'draft') return;
+            $sha = $img === null ? null : (string)$img['sha256'];
+            $st = $pdo->prepare("UPDATE wa_offers SET image_file = ?, image_mime = ?, image_bytes = ?, image_sha256 = ?, content_hash = ?,
+                                        updated_at = ? WHERE id = ? AND state = 'draft'");
+            $st->execute([$img === null ? null : (string)$img['file'], $img === null ? null : (string)$img['mime'],
+                          $img === null ? null : (int)$img['bytes'], $sha,
+                          OfferText::contentHash(array_values(self::wordingsOf($o)), (string)$o['stop_line'], $sha),
+                          UtcClock::stamp($now), $id]);
+            $ok = $st->rowCount() === 1;
+            if ($ok) self::event($pdo, $id, 'edited', $byId, $byName, $img === null ? 'image=0' : 'image=1', $now);
+        });
+        return $ok;
+    }
+
+    /** A draft is closed as discarded: kept as history, never deleted. */
+    public static function discard(\PDO $pdo, int $id, int $byId, string $byName, int $now): bool
+    {
+        $ok = false;
+        self::tx($pdo, function () use ($pdo, $id, $byId, $byName, $now, &$ok) {
+            $at = UtcClock::stamp($now);
+            $st = $pdo->prepare("UPDATE wa_offers SET state = 'stopped', close_reason = 'discarded', closed_at = ?, closed_by = ?,
+                                        updated_at = ? WHERE id = ? AND state = 'draft'");
+            $st->execute([$at, $byName, $at, $id]);
+            $ok = $st->rowCount() === 1;
+            if ($ok) self::event($pdo, $id, 'discarded', $byId, $byName, null, $now);
+        });
+        return $ok;
+    }
+
+    // ── start, pause, resume, stop ─────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * Start a draft whose content is still $contentHash (what the admin confirmed), in one BEGIN IMMEDIATE: the state, the
+     * settings in force recorded (warm_days, recent_days), every wording tested, the audience built again inside the
+     * transaction and its first `size` eligible rows inserted, rank 1…n. Nothing is written when any of it fails.
+     *
+     * @return array{ok:bool, code:string, queued:int}
+     *         code: not_draft | settings_out_of_range | another_live | untested | nobody_eligible | audience_unreadable:<list>
+     */
+    public static function start(\PDO $pdo, array $config, ?string $dataDir, array $retailerRows, array $storedConfig, int $id,
+                                 string $contentHash, int $byId, string $byName, int $now, ?OfferGateway $gw = null): array
+    {
+        $set = OfferSwitch::settings($config);
+        if (in_array(null, $set, true)) return ['ok' => false, 'code' => 'settings_out_of_range', 'queued' => 0];
+        $own = self::begin($pdo);
+        $fail = function (string $code) use ($pdo, $own): array {
+            if ($own) $pdo->exec('ROLLBACK');
+            return ['ok' => false, 'code' => $code, 'queued' => 0];
+        };
+        try {
+            $at = UtcClock::stamp($now);
+            try {
+                $st = $pdo->prepare("UPDATE wa_offers SET state = 'running', live_slot = 1, started_at = ?, started_by = ?, warm_days = ?,
+                                            recent_days = ?, updated_at = ? WHERE id = ? AND state = 'draft' AND content_hash = ?");
+                $st->execute([$at, $byName, (int)$set['offers_warm_days'], (int)$set['offers_recent_days'], $at, $id, $contentHash]);
+            } catch (\PDOException $e) {
+                if (stripos($e->getMessage(), 'UNIQUE') !== false) return $fail('another_live');
+                throw $e;
+            }
+            if ($st->rowCount() !== 1) return $fail('not_draft');
+            $o = self::find($pdo, $id);
+            if ($o === null) return $fail('not_draft');
+            if (self::testedVariants($pdo, $o, $now) !== count(self::wordingsOf($o))) return $fail('untested');
+            try {
+                $a = OfferAudience::build($pdo, $config, $dataDir, $retailerRows, $storedConfig, (string)$o['audience_size'], $now, $gw);
+            } catch (\RuntimeException $e) {
+                return $fail(strpos($e->getMessage(), 'audience_unreadable:') === 0 ? $e->getMessage() : 'audience_unreadable:build');
+            }
+            if ($a['eligible'] === []) return $fail('nobody_eligible');
+            $ins = $pdo->prepare("INSERT INTO wa_offer_recipients (offer_id, phone, rank, conversation_id, channel, handset, last_in_at, state, created_at)
+                                  VALUES (?, ?, ?, ?, ?, ?, ?, 'queued', ?)");
+            foreach ($a['eligible'] as $i => $e) {
+                $ins->execute([$id, $e['phone'], $i + 1, $e['conversation_id'], $e['channel'], $e['handset'], $e['last_in_at'], $at]);
+            }
+            $pdo->prepare('UPDATE wa_offers SET queued_n = ? WHERE id = ?')->execute([count($a['eligible']), $id]);
+            self::event($pdo, $id, 'started', $byId, $byName, 'queued=' . count($a['eligible']) . ' handsets=' . count($a['by_handset']), $now);
+            if ($own) $pdo->exec('COMMIT');
+            return ['ok' => true, 'code' => '', 'queued' => count($a['eligible'])];
+        } catch (\Throwable $e) {
+            if ($own) { try { $pdo->exec('ROLLBACK'); } catch (\Throwable $e2) { /* none open */ } }
+            throw $e;
+        }
+    }
+
+    /** running → paused, with an event ('paused', or the system's paused_by_switch / paused_by_rollback / paused_stop_rate). */
+    public static function pause(\PDO $pdo, int $id, ?int $byId, string $byName, int $now, string $action = 'paused', ?string $detail = null): bool
+    {
+        return self::move($pdo, $id, 'running', 'paused', $action, $byId, $byName, $now, $detail);
+    }
+
+    public static function resume(\PDO $pdo, int $id, int $byId, string $byName, int $now): bool
+    {
+        return self::move($pdo, $id, 'paused', 'running', 'resumed', $byId, $byName, $now, null);
+    }
+
+    /** A live offer stops for good: its queued rows are skipped('offer_stopped'); claimed rows finish their own send. */
+    public static function stop(\PDO $pdo, int $id, int $byId, string $byName, int $now): bool
+    {
+        $ok = false;
+        self::tx($pdo, function () use ($pdo, $id, $byId, $byName, $now, &$ok) {
+            $at = UtcClock::stamp($now);
+            $st = $pdo->prepare("UPDATE wa_offers SET state = 'stopped', live_slot = NULL, close_reason = 'stopped', closed_at = ?,
+                                        closed_by = ?, updated_at = ? WHERE id = ? AND state IN ('running', 'paused')");
+            $st->execute([$at, $byName, $at, $id]);
+            $ok = $st->rowCount() === 1;
+            if (!$ok) return;
+            $q = $pdo->prepare("UPDATE wa_offer_recipients SET state = 'skipped', reason = 'offer_stopped', settled_at = ?
+                                 WHERE offer_id = ? AND state = 'queued'");
+            $q->execute([$at, $id]);
+            self::event($pdo, $id, 'stopped', $byId, $byName, 'skipped=' . $q->rowCount(), $now);
+        });
+        return $ok;
+    }
+
+    /** The system closes a live offer: done (nothing left) or expired (offers_max_days), the queued rows skipped. */
+    public static function close(\PDO $pdo, int $id, string $why, int $now): bool
+    {
+        $ok = false;
+        self::tx($pdo, function () use ($pdo, $id, $why, $now, &$ok) {
+            $at = UtcClock::stamp($now);
+            $skipped = 0;
+            if ($why === 'expired') {
+                $q = $pdo->prepare("UPDATE wa_offer_recipients SET state = 'skipped', reason = 'offer_expired', settled_at = ?
+                                     WHERE offer_id = ? AND state = 'queued'");
+                $q->execute([$at, $id]);
+                $skipped = $q->rowCount();
+            }
+            $st = $pdo->prepare("UPDATE wa_offers SET state = 'done', live_slot = NULL, close_reason = ?, closed_at = ?, closed_by = 'system',
+                                        updated_at = ? WHERE id = ? AND state IN ('running', 'paused')");
+            $st->execute([$why, $at, $at, $id]);
+            $ok = $st->rowCount() === 1;
+            if ($ok) self::event($pdo, $id, $why === 'expired' ? 'expired' : 'done', null, 'system', 'skipped=' . $skipped, $now);
+        });
+        return $ok;
+    }
+
+    private static function move(\PDO $pdo, int $id, string $from, string $to, string $action, ?int $byId, string $byName, int $now, ?string $detail): bool
+    {
+        $ok = false;
+        self::tx($pdo, function () use ($pdo, $id, $from, $to, $action, $byId, $byName, $now, $detail, &$ok) {
+            $st = $pdo->prepare('UPDATE wa_offers SET state = ?, updated_at = ? WHERE id = ? AND state = ?');
+            $st->execute([$to, UtcClock::stamp($now), $id, $from]);
+            $ok = $st->rowCount() === 1;
+            if ($ok) self::event($pdo, $id, $action, $byId, $byName, $detail, $now);
+        });
+        return $ok;
+    }
+
+    // ── the trail ──────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** One event: counts and fixed codes only in $detail, never a wording, a name of a customer or a number. */
+    public static function event(\PDO $pdo, int $offerId, string $action, ?int $byId, string $byName, ?string $detail, int $now): void
+    {
+        $d = $detail === null ? null : substr((string)preg_replace('/[^A-Za-z0-9_=:., -]/', '', $detail), 0, 200);
+        $pdo->prepare('INSERT INTO wa_offer_events (offer_id, action, by_id, by_name, detail, at) VALUES (?, ?, ?, ?, ?, ?)')
+            ->execute([$offerId, $action, $byId, $byId === null ? 'system' : $byName, $d, UtcClock::stamp($now)]);
+    }
+
+    /** The moment of the offer's latest Start or Resume (O-D19), or 0. */
+    public static function lastStartOrResume(\PDO $pdo, int $offerId): int
+    {
+        $st = $pdo->prepare("SELECT MAX(at) FROM wa_offer_events WHERE offer_id = ? AND action IN ('started', 'resumed')");
+        $st->execute([$offerId]);
+        return UtcClock::parse((string)$st->fetchColumn());
+    }
+
+    // ── counts ─────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** §H.4.12: queued, sent, maybe_sent, failed, skipped, replied_72h, stop_72h, echo_late. @return array<string,int> */
+    public static function counts(\PDO $pdo, int $offerId): array
+    {
+        $st = $pdo->prepare("SELECT sum(state IN ('queued', 'claimed'))                                       AS queued,
+                                    sum(state = 'sent')                                                       AS sent,
+                                    sum(state = 'uncertain')                                                  AS maybe_sent,
+                                    sum(state = 'failed')                                                     AS failed,
+                                    sum(state = 'skipped')                                                    AS skipped,
+                                    sum(state IN ('sent', 'uncertain') AND replied_at IS NOT NULL AND stop_at IS NULL) AS replied_72h,
+                                    sum(state IN ('sent', 'uncertain') AND stop_at IS NOT NULL)               AS stop_72h,
+                                    sum(echo = 'late')                                                        AS echo_late
+                               FROM wa_offer_recipients WHERE offer_id = ?");
+        $st->execute([$offerId]);
+        $r = $st->fetch(\PDO::FETCH_ASSOC) ?: [];
+        $out = [];
+        foreach (['queued', 'sent', 'maybe_sent', 'failed', 'skipped', 'replied_72h', 'stop_72h', 'echo_late'] as $k) $out[$k] = (int)($r[$k] ?? 0);
+        return $out;
+    }
+
+    /** Skipped rows by their fixed reason. @return array<string,int> */
+    public static function skippedByReason(\PDO $pdo, int $offerId): array
+    {
+        $st = $pdo->prepare("SELECT reason, COUNT(*) FROM wa_offer_recipients WHERE offer_id = ? AND state = 'skipped' GROUP BY reason ORDER BY reason");
+        $st->execute([$offerId]);
+        $out = [];
+        foreach ($st->fetchAll(\PDO::FETCH_NUM) as $r) $out[(string)$r[0]] = (int)$r[1];
+        return $out;
+    }
+
+    /** Today's offers (sent, may have been sent, or in flight) per handset, by the Kampala day of $now. @return array<string,int> */
+    public static function todayPerHandset(\PDO $pdo, int $dayStart): array
+    {
+        $st = $pdo->prepare("SELECT handset, COUNT(*) FROM wa_offer_recipients WHERE state IN ('sent', 'uncertain', 'claimed')
+                               AND COALESCE(sent_at, claimed_at) >= ? GROUP BY handset ORDER BY handset");
+        $st->execute([UtcClock::stamp($dayStart)]);
+        $out = [];
+        foreach ($st->fetchAll(\PDO::FETCH_NUM) as $r) $out[(string)$r[0]] = (int)$r[1];
+        return $out;
+    }
+
+    // ── the reply and STOP marks (§H.4.12) ─────────────────────────────────────────────────────────────────────
+
+    /**
+     * Up to $limit rows sent or may-have-been-sent in the last 73 h with a mark still empty: replied_at is the first inbound
+     * from the phone, on any conversation, in (sent_at, sent_at + 72 h]; stop_at the first opt-out created for the phone in
+     * that window (any channel, scope or source, in the one form) or the first inbound there that stopWordIn() matches.
+     * Each mark is written once (wor_marks_once). Returns the number of marks written.
+     */
+    public static function marksPass(\PDO $pdo, \TenantProfile $t, int $now, int $limit = 500): int
+    {
+        $st = $pdo->prepare("SELECT id, phone, sent_at, replied_at, stop_at FROM wa_offer_recipients
+                              WHERE state IN ('sent', 'uncertain') AND phone IS NOT NULL AND sent_at >= ?
+                                AND (replied_at IS NULL OR stop_at IS NULL) ORDER BY id LIMIT " . (int)$limit);
+        $st->execute([UtcClock::stamp($now - self::MARK_WINDOW_S - 3600)]);
+        $rows = $st->fetchAll(\PDO::FETCH_ASSOC);
+        if ($rows === []) return 0;
+        $optouts = [];
+        foreach ($pdo->query('SELECT phone, created_at FROM contact_optouts')->fetchAll(\PDO::FETCH_ASSOC) as $o) {
+            $d = OfferAudience::digits((string)$o['phone'], $t);
+            if ($d !== null) $optouts[$d][] = (string)$o['created_at'];
+        }
+        $in = $pdo->prepare("SELECT m.body, m.sent_at FROM wa_messages m JOIN wa_conversations c ON c.id = m.conversation_id
+                              WHERE c.phone = ? AND m.direction = 'in' AND m.sent_at > ? AND m.sent_at <= ? ORDER BY m.sent_at, m.id");
+        $upd = $pdo->prepare('UPDATE wa_offer_recipients SET replied_at = COALESCE(replied_at, ?), stop_at = COALESCE(stop_at, ?) WHERE id = ?');
+        $n = 0;
+        foreach ($rows as $r) {
+            $from = (string)$r['sent_at'];
+            $to = UtcClock::stamp(UtcClock::parse($from) + self::MARK_WINDOW_S);
+            $in->execute([(string)$r['phone'], $from, $to]);
+            $reply = null; $stop = null;
+            foreach ($in->fetchAll(\PDO::FETCH_ASSOC) as $m) {
+                if ($reply === null) $reply = (string)$m['sent_at'];
+                if ($stop === null && OfferText::stopWordIn((string)($m['body'] ?? '')) !== '') $stop = (string)$m['sent_at'];
+            }
+            foreach ($optouts[(string)$r['phone']] ?? [] as $c) {
+                if ($c > $from && $c <= $to && ($stop === null || $c < $stop)) $stop = $c;
+            }
+            $reply = $r['replied_at'] !== null ? null : $reply;
+            $stop = $r['stop_at'] !== null ? null : $stop;
+            if ($reply === null && $stop === null) continue;
+            $upd->execute([$reply, $stop, (int)$r['id']]);
+            $n += ($reply !== null ? 1 : 0) + ($stop !== null ? 1 : 0);
+        }
+        return $n;
+    }
+
+    /** Run $fn in one BEGIN IMMEDIATE, or inside the caller's transaction when one is open. */
+    private static function tx(\PDO $pdo, callable $fn): void
+    {
+        $own = self::begin($pdo);
+        try {
+            $fn();
+            if ($own) $pdo->exec('COMMIT');
+        } catch (\Throwable $e) {
+            if ($own) { try { $pdo->exec('ROLLBACK'); } catch (\Throwable $e2) { /* none open */ } }
+            throw $e;
+        }
+    }
+
+    /**
+     * BEGIN IMMEDIATE, true; or false when the caller already holds a transaction on this connection (SQLite refuses a
+     * nested BEGIN; PDO::inTransaction() does not see a BEGIN made through exec()).
+     */
+    public static function begin(\PDO $pdo): bool
+    {
+        try {
+            if ($pdo->exec('BEGIN IMMEDIATE') !== false) return true;
+            $msg = (string)($pdo->errorInfo()[2] ?? '');
+        } catch (\PDOException $e) {
+            $msg = $e->getMessage();
+        }
+        if (stripos($msg, 'within a transaction') !== false) return false;
+        throw new \RuntimeException('offers: the book could not be locked');
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/OfferSwitch.php b/dishnet-hybrid-sudan/lib/OfferSwitch.php
