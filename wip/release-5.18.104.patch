+                  'an R1 row given a turn' => function ($c) { vp_turn($c, $c['notes'][6], $c['notes'][6]['upd'] + 1); }] as $label => $plant) {
+            $c = va_copy($ctx, $b) + ['notes' => $b['notes']];
