+                                             AND EXISTS (SELECT 1 FROM wa_conversations c WHERE c.phone = w.phone
+                                                          AND c.channel = w.channel AND {$staffOut})"
+                                         . self::notOursMark($hasLedger), $args);
+        }
+        $eub = $until === null ? '' : ' AND e.created_at <= :until';
+        $found['escalated'] = $q("SELECT DISTINCT c.phone FROM wa_conversations c
+                                   WHERE {$staffOut} AND c.state = 'needs_human'
+                                     AND EXISTS (SELECT 1 FROM events e WHERE e.event_type = 'wa.escalation'
+                                                  AND e.entity_type = 'conversation' AND e.entity_id = c.id
+                                                  AND e.created_at > :since{$eub})", $args);
+        $out = [];
+        foreach (['team_message', 'inbox_reply', 'handset_media', 'escalated'] as $code) {
+            foreach ($found[$code] as $p) if (!isset($out[$p])) $out[$p] = $code;
+        }
+        return $out;
+    }
+
+    // ── the clauses ─────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** The four clauses in order over $convIds, the lower bound each clause's own, the upper on storage time. */
+    private static function judge(\PDO $pdo, string $phone, array $convIds, string $since, ?string $until): ?string
+    {
+        if ($convIds === []) return null;
+        [$hasLedger, $hasMarks] = self::tables($pdo);
+        $in = implode(',', $convIds);
+        $notOurs = self::notOursMessage($hasLedger);
+        $ub = $until === null ? '' : ' AND m.created_at <= :until';
+        $args = [':since' => $since] + ($until === null ? [] : [':until' => $until]);
+
+        $hit = function (string $sql, array $a) use ($pdo): bool {
+            $st = $pdo->prepare($sql . ' LIMIT 1');
+            $st->execute($a);
+            return $st->fetchColumn() !== false;
+        };
+
+        if ($hit("SELECT 1 FROM wa_messages m WHERE m.conversation_id IN ({$in}) AND m.direction = 'out' AND m.role = 'agent'
+                   AND m.agent_name = 'Team' AND m.sent_at > :since{$ub}{$notOurs}", $args)) {
+            return 'team_message';
+        }
+        if ($hit("SELECT 1 FROM wa_messages m WHERE m.conversation_id IN ({$in}) AND m.direction = 'out' AND m.role = 'agent'
+                   AND ((m.event_key IN ('wa_staff_reply','wa_send_document') AND m.sent_at > :since)
+                     OR (m.event_key IN ('wa_image_send','wa_media_send') AND m.sent_at > :since_local))
+                   AND " . self::notAutomation('m') . "{$ub}{$notOurs}", $args + [':since_local' => self::kampala($since)])) {
+            return 'inbox_reply';
+        }
+        if ($hasMarks) {
+            $st = $pdo->query("SELECT DISTINCT channel FROM wa_conversations WHERE id IN ({$in})");
+            $chans = array_map('strval', $st->fetchAll(\PDO::FETCH_COLUMN));
+            if ($chans !== []) {
+                $ph = [];
+                $a = [':since' => $since, ':phone' => $phone] + ($until === null ? [] : [':until' => $until]);
+                foreach ($chans as $i => $c) { $ph[] = ':c' . $i; $a[':c' . $i] = $c; }
+                $mub = $until === null ? '' : ' AND w.seen_at <= :until';
+                if ($hit("SELECT 1 FROM wa_seen_marks w WHERE w.direction = 'out' AND w.phone = :phone
+                           AND w.channel IN (" . implode(',', $ph) . ") AND w.seen_at > :since{$mub}"
+                         . self::notOursMark($hasLedger), $a)) {
+                    return 'handset_media';
+                }
+            }
+        }
+        $eub = $until === null ? '' : ' AND e.created_at <= :until';
+        if ($hit("SELECT 1 FROM wa_conversations c WHERE c.id IN ({$in}) AND c.state = 'needs_human'
+                   AND EXISTS (SELECT 1 FROM events e WHERE e.event_type = 'wa.escalation' AND e.entity_type = 'conversation'
+                                AND e.entity_id = c.id AND e.created_at > :since{$eub})", $args)) {
+            return 'escalated';
+        }
+        return null;
+    }
+
+    /** "Not ours" for a wa_messages row, NULL-safe (S2-02, K2-12); no ledger table means no automation id exists. */
+    private static function notOursMessage(bool $hasLedger): string
+    {
+        if (!$hasLedger) return '';
+        return ' AND (m.wa_message_id IS NULL OR m.wa_message_id NOT IN'
+             . ' (SELECT a.wa_message_id FROM wa_auto_sends a WHERE a.wa_message_id IS NOT NULL))';
+    }
+
+    /** "Not ours" for a mark: not a ledger id, and not the id of an assistant's or an automation-labelled row. */
+    private static function notOursMark(bool $hasLedger): string
+    {
+        $sql = '';
+        if ($hasLedger) {
+            $sql .= ' AND w.wa_message_id NOT IN (SELECT a.wa_message_id FROM wa_auto_sends a WHERE a.wa_message_id IS NOT NULL)';
+        }
+        return $sql . ' AND NOT EXISTS (SELECT 1 FROM wa_messages x WHERE x.wa_message_id = w.wa_message_id'
+             . " AND (x.role = 'assistant' OR " . self::isAutomation('x') . '))';
+    }
+
+    /** A row's label is not one of the automation labels (a NULL label is the empty one). */
+    private static function notAutomation(string $alias): string
+    {
+        return 'NOT ' . self::isAutomation($alias);
+    }
+
+    private static function isAutomation(string $alias): string
+    {
+        $labels = array_merge(self::AUTOMATION_LABELS, [self::AUTO_REPLY]);
+        $q = implode(',', array_map(function ($l) { return "'" . str_replace("'", "''", $l) . "'"; }, $labels));
+        return "COALESCE({$alias}.agent_name, '') IN ({$q})";
+    }
+
+    /** [wa_auto_sends present, wa_seen_marks present]: 089's tables; an absent one reads as empty (A11-02). */
+    private static function tables(\PDO $pdo): array
+    {
+        $names = $pdo->query("SELECT name FROM sqlite_master WHERE type = 'table' AND name IN ('wa_auto_sends','wa_seen_marks')")
+                     ->fetchAll(\PDO::FETCH_COLUMN);
+        return [in_array('wa_auto_sends', $names, true), in_array('wa_seen_marks', $names, true)];
+    }
+
+    /** A time argument in the storage form ('Y-m-d H:i:s' UTC), or null when it cannot be read. */
+    private static function norm(string $s): ?string
+    {
+        $t = UtcClock::parse($s);
+        return $t === 0 ? null : UtcClock::stamp($t);
+    }
+
+    /** The same moment as a Kampala wall-clock stamp: how the Inbox's image and media rows are dated (never "+3"). */
+    private static function kampala(string $utcStamp): string
+    {
+        return (new \DateTime('@' . UtcClock::parse($utcStamp)))->setTimezone(new \DateTimeZone(self::TZ))->format('Y-m-d H:i:s');
+    }
+
+    /** @return int[] */
+    private static function ids(array $ids): array
+    {
+        $out = [];
+        foreach ($ids as $i) { $i = (int)$i; if ($i > 0) $out[$i] = $i; }
+        return array_values($out);
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/InboundMedia.php b/dishnet-hybrid-sudan/lib/InboundMedia.php
new file mode 100644
index 0000000..a91e19b
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/InboundMedia.php
@@ -0,0 +1,165 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/MediaPolicy.php';
+
+/**
+ * InboundMedia — one shape for every piece of media a customer sends (Batch 1, docs/55 §9; 5.18.104, root docs/73
+ * §H.3.2, §H.3.4: ported from the development tree; record() also writes ptt; conversationFor() and wasWrapped() are new).
+ *
+ * Evolution's messages.upsert envelope carries media under one of five keys, each with its own fields. This reads
+ * them into a single normalised array the webhook records and the media worker fetches by:
+ *
+ *   kind           audio | image | document | video | sticker
+ *   mimetype       as announced (e.g. "audio/ogg; codecs=opus"), '' when absent
+ *   file_name      documents only
+ *   caption        the caption, '' when none — the webhook already answers it as text; it is kept here for Batch 2+
+ *   declared_bytes fileLength when announced, else null
+ *   seconds        audio duration when announced, else null
+ *   ptt            audio: a voice note rather than an audio file
+ *   key            remote_jid | id | from_me — what getBase64FromMediaMessage needs
+ *   message_type   the envelope key, for the log
+ *
+ * Nothing here fetches, stores or decides. PHP 7.4 compatible.
+ */
+final class InboundMedia
+{
+    public const KINDS = ['audio', 'image', 'document', 'video', 'sticker'];
+
+    /**
+     * The wrappers Evolution puts around a message, each carrying the real message under 'message': a captioned document
+     * arrives as documentWithCaptionMessage; disappearing and view-once messages wrap anything. Batch 4 (docs/58 §2.1,
+     * D-11): unwrapped up to MAX_WRAP_DEPTH levels, here and in ConversationService::importEvoMessage and the webhook's text
+     * extraction, through unwrap() — one list, one rule. Before that a wrapped document was dropped before it was stored.
+     */
+    public const WRAPPERS       = ['documentWithCaptionMessage', 'ephemeralMessage', 'viewOnceMessage', 'viewOnceMessageV2'];
+    public const MAX_WRAP_DEPTH = 3;
+
+    private const TYPE_KEYS = [
+        'audioMessage'    => 'audio',
+        'imageMessage'    => 'image',
+        'documentMessage' => 'document',
+        'videoMessage'    => 'video',
+        'stickerMessage'  => 'sticker',
+    ];
+
+    /** @return array|null null when the envelope carries no media */
+    public static function fromEvoMessage(array $msg): ?array
+    {
+        $m = $msg['message'] ?? null;
+        if (!is_array($m)) return null;
+        $m = self::unwrap($m);
+        $type = ''; $kind = '';
+        foreach (self::TYPE_KEYS as $k => $v) {
+            if (isset($m[$k]) && is_array($m[$k])) { $type = $k; $kind = $v; break; }
+        }
+        if ($kind === '') return null;
+        $part = $m[$type];
+        $key  = is_array($msg['key'] ?? null) ? $msg['key'] : [];
+        $len  = $part['fileLength'] ?? null;
+        $secs = $part['seconds'] ?? null;
+        return [
+            'kind'           => $kind,
+            'mimetype'       => trim((string)($part['mimetype'] ?? '')),
+            'file_name'      => $kind === 'document' ? trim((string)($part['fileName'] ?? '')) : '',
+            'caption'        => trim((string)($part['caption'] ?? '')),
+            'declared_bytes' => is_numeric($len) ? (int)$len : null,
+            'seconds'        => is_numeric($secs) ? (int)$secs : null,
+            'ptt'            => $kind === 'audio' && !empty($part['ptt']),
+            'key'            => [
+                'remote_jid' => (string)($key['remoteJid'] ?? ''),
+                'id'         => (string)($key['id'] ?? ''),
+                'from_me'    => !empty($key['fromMe']),
+            ],
+            'message_type'   => $type,
+        ];
+    }
+
+    /**
+     * The real message inside Evolution's wrappers, up to MAX_WRAP_DEPTH levels deep (an ephemeral message wrapping a
+     * captioned document is two). A message with no wrapper comes back exactly as it was.
+     */
+    public static function unwrap(array $m): array
+    {
+        for ($depth = 0; $depth < self::MAX_WRAP_DEPTH; $depth++) {
+            $inner = null;
+            foreach (self::WRAPPERS as $wrap) {
+                if (isset($m[$wrap]['message']) && is_array($m[$wrap]['message'])) { $inner = $m[$wrap]['message']; break; }
+            }
+            if ($inner === null) break;
+            $m = $inner;
+        }
+        return $m;
+    }
+
+    /** The body the conversation store writes for a captionless media message (unchanged since 5.18.x). */
+    public static function placeholder(string $kind): string
+    {
+        return '[' . strtoupper($kind) . ']';
+    }
+
+    /**
+     * Record a media message once. INSERT OR IGNORE on the UNIQUE wa_message_id: the second delivery of the same
+     * message, or a second pass over the same envelope, returns null and changes nothing.
+     *
+     * @return int|null the wa_media id when this call created the row; null when it already existed or could not be written
+     */
+    public static function record(\PDO $pdo, int $conversationId, array $media, string $instance, string $channel,
+                                  string $waMessageId): ?int
+    {
+        if ($waMessageId === '' || $conversationId <= 0) return null;
+        $msgRowId = null;
+        try {
+            $q = $pdo->prepare('SELECT id FROM wa_messages WHERE wa_message_id = ? LIMIT 1');
+            $q->execute([$waMessageId]);
+            $r = $q->fetchColumn();
+            if ($r !== false) $msgRowId = (int)$r;
+        } catch (\Throwable $e) { /* the placeholder row is optional context */ }
+
+        $st = $pdo->prepare('INSERT OR IGNORE INTO wa_media
+            (conversation_id, message_id, wa_message_id, instance, channel, remote_jid, from_me, kind, mimetype,
+             file_name, caption, declared_bytes, seconds, status, ptt)
+            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)');
+        $kind   = (string)$media['kind'];
+        $status = MediaPolicy::kindSupported($kind) ? 'pending' : 'unsupported';
+        $st->execute([
+            $conversationId, $msgRowId, $waMessageId, $instance, $channel,
+            (string)($media['key']['remote_jid'] ?? ''), !empty($media['key']['from_me']) ? 1 : 0,
+            $kind, (string)($media['mimetype'] ?? '') ?: null, (string)($media['file_name'] ?? '') ?: null,
+            (string)($media['caption'] ?? '') ?: null, $media['declared_bytes'] ?? null, $media['seconds'] ?? null,
+            $status, $kind === 'audio' ? (!empty($media['ptt']) ? 1 : 0) : null,
+        ]);
+        if ($st->rowCount() !== 1) return null;   // ignored: already recorded
+        $id = (int)$pdo->lastInsertId();
+        if ($status === 'unsupported') {
+            $pdo->prepare("UPDATE wa_media SET failure_reason = 'unsupported_kind', updated_at = datetime('now') WHERE id = ?")->execute([$id]);
+        }
+        return $id;
+    }
+
+    /**
+     * 5.18.104 (root docs/73 §H.3.4 (b), R-18): the conversation an inbound message was stored under, when the webhook's
+     * own import returned none — cron_evo_sync may have stored it first, and the import then dedupes to null. Only a row
+     * of THIS phone on THIS channel: one the sync filed under another channel answers null, and the note is not recorded.
+     */
+    public static function conversationFor(\PDO $pdo, string $waMessageId, string $phone, string $channel): ?int
+    {
+        if ($waMessageId === '' || $phone === '' || $channel === '') return null;
+        $q = $pdo->prepare("SELECT m.conversation_id FROM wa_messages m JOIN wa_conversations c ON c.id = m.conversation_id
+                             WHERE m.wa_message_id = ? AND m.direction = 'in' AND c.phone = ? AND c.channel = ? LIMIT 1");
+        $q->execute([$waMessageId, $phone, $channel]);
+        $id = $q->fetchColumn();
+        return ($id === false || (int)$id <= 0) ? null : (int)$id;
+    }
+
+    /** 5.18.104 (root docs/73 §H.3.4 (b)): the message came inside one of Evolution's wrappers — for the log word only. */
+    public static function wasWrapped(array $msg): bool
+    {
+        $m = $msg['message'] ?? null;
+        if (!is_array($m)) return false;
+        foreach (self::WRAPPERS as $w) {
+            if (array_key_exists($w, $m)) return true;
+        }
+        return false;
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/JobBudget.php b/dishnet-hybrid-sudan/lib/JobBudget.php
new file mode 100644
index 0000000..35dbca7
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/JobBudget.php
@@ -0,0 +1,21 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * JobBudget — a job's wall-clock budget against master's deadline (5.18.104, root docs/73 §H.2.13.3). Pure.
+ *
+ * cron/master.php stops dispatching once time() passes $_m_deadline, but never stops a job already running, and its
+ * per-job set_time_limit counts CPU time, not waiting. So each 5.18.104 job asks here before it starts a piece of work
+ * that waits on the network, and never carries a cycle past master_budget_seconds. Run by hand, the deadline is null.
+ * PHP 7.4.
+ */
+final class JobBudget
+{
+    /** Seconds this run may spend: its own budget, cut to what master's cycle has left; 0 = do not start. */
+    public static function seconds(int $own, ?int $masterDeadline, int $now): int
+    { return max(0, min($own, $masterDeadline === null ? $own : $masterDeadline - $now)); }
+
+    /** May work that can take $inflight seconds start now and still end by $until? */
+    public static function mayStart(int $until, int $inflight, ?int $now = null): bool
+    { return ($now === null ? time() : $now) + $inflight <= $until; }
+}
diff --git a/dishnet-hybrid-sudan/lib/MediaBlob.php b/dishnet-hybrid-sudan/lib/MediaBlob.php
new file mode 100644
index 0000000..707e5e3
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/MediaBlob.php
@@ -0,0 +1,48 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * MediaBlob — fetched media, in memory only (Batch 1, docs/55 §9).
+ *
+ * The bytes exist for the length of one worker turn. Nothing here writes them anywhere, nothing logs them, and
+ * wipe() is called by the worker when it is done, whatever the outcome. What survives the turn is on the wa_media
+ * row: size, media type and sha256. PHP 7.4 compatible.
+ */
+final class MediaBlob
+{
+    /** @var string */
+    public $bytes;
+    /** @var string */
+    public $mimetype;
+    /** @var int */
+    public $size;
+    /** @var string */
+    public $sha256;
+    /** @var string */
+    public $kind;
+    /** @var string */
+    public $fileName;
+
+    public function __construct(string $bytes, string $mimetype, string $kind, string $fileName = '')
+    {
+        $this->bytes    = $bytes;
+        $this->mimetype = $mimetype;
+        $this->size     = strlen($bytes);
+        $this->sha256   = hash('sha256', $bytes);
+        $this->kind     = $kind;
+        $this->fileName = $fileName;
+    }
+
+    /** Forget the bytes. The hash and size stay, which is all a record may keep. */
+    public function wipe(): void
+    {
+        $this->bytes = '';
+    }
+
+    /** Never the bytes: what a log line may say about this blob. */
+    public function describe(): string
+    {
+        return sprintf('%s %s %d bytes sha256=%s…', $this->kind, MediaPolicy::baseMime($this->mimetype), $this->size,
+                       substr($this->sha256, 0, 12));
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/MediaFetcher.php b/dishnet-hybrid-sudan/lib/MediaFetcher.php
new file mode 100644
index 0000000..d60aad1
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/MediaFetcher.php
@@ -0,0 +1,96 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/MediaPolicy.php';
+require_once __DIR__ . '/MediaBlob.php';
+
+/**
+ * MediaFetcher — get a customer's media from Evolution, in memory, or say precisely why not (Batch 1, docs/55 §9).
+ *
+ * Uses the EXISTING Evolution integration: POST /chat/getBase64FromMediaMessage/{instance} with the message key the
+ * webhook recorded. The webhook itself stays registered with base64 off — a payload carrying media bytes would meet the
+ * webhook's 512 KB body cap — so the bytes are fetched here, by the media worker, never in the request path.
+ *
+ * Order of checks, cheapest first and before any network call: the key is complete; the kind is one Batch 1 handles;
+ * the size the webhook announced is within the limit. Then the fetch, with its own timeout. Then the type Evolution
+ * reports against the allow-list, a strict base64 decode, the actual size against the limit, and a sha256. The bytes
+ * are returned in a MediaBlob and nowhere else: no file, no log line, no exception message carries them.
+ *
+ * Every refusal is a fixed code (REASONS) with a retryable flag: a timeout or a 5xx is worth another attempt, a wrong
+ * type or an oversized file is not. PHP 7.4 compatible.
+ */
+final class MediaFetcher
+{
+    public const REASONS = [
+        'missing_identifier' => false,   // no message key to fetch by
+        'unsupported_kind'   => false,   // video, sticker
+        'unsupported_mime'   => false,   // not in MediaPolicy::ALLOWED
+        'too_large'          => false,   // announced or actual size over the limit
+        'fetch_failed'       => true,    // Evolution answered with an error, or no answer (see detail)
+        'timeout'            => true,    // the fetch did not complete in time
+        'malformed'          => true,    // the answer was not a decodable base64 payload
+    ];
+
+    /** @var EvolutionApiService */
+    private $evo;
+    /** @var array */
+    private $config;
+
+    public function __construct($evo, array $config)
+    {
+        $this->evo    = $evo;
+        $this->config = $config;
+    }
+
+    /**
+     * @param array $row a wa_media row (kind, mimetype, declared_bytes, channel, remote_jid, wa_message_id, from_me, file_name)
+     * @return array ['ok' => true, 'blob' => MediaBlob] or ['ok' => false, 'reason' => string, 'retryable' => bool, 'detail' => string]
+     */
+    public function fetch(array $row): array
+    {
+        $kind = (string)($row['kind'] ?? '');
+        if (!MediaPolicy::kindSupported($kind)) return self::refuse('unsupported_kind', $kind);
+
+        $id  = (string)($row['wa_message_id'] ?? '');
+        $jid = (string)($row['remote_jid'] ?? '');
+        if ($id === '' || $jid === '') return self::refuse('missing_identifier', 'no message key');
+
+        $max = MediaPolicy::maxBytes($this->config);
+        $declared = $row['declared_bytes'] ?? null;
+        if (is_numeric($declared) && (int)$declared > $max) {
+            return self::refuse('too_large', sprintf('announced %d bytes, limit %d', (int)$declared, $max));
+        }
+
+        $res = $this->evo->getBase64FromMediaMessage((string)($row['channel'] ?? ''), [
+            'remoteJid' => $jid, 'id' => $id, 'fromMe' => !empty($row['from_me']),
+        ]);
+        if (empty($res['ok'])) {
+            $err  = (string)($res['error'] ?? 'no answer');
+            $http = (int)($res['http'] ?? 0);
+            if ($http >= 400 && $http < 500) return self::refuse('fetch_failed', 'HTTP ' . $http, false);
+            if (stripos($err, 'timed out') !== false || stripos($err, 'timeout') !== false) return self::refuse('timeout', 'HTTP ' . $http);
+            return self::refuse('fetch_failed', $http > 0 ? 'HTTP ' . $http : 'no connection', true);
+        }
+        $data = is_array($res['data'] ?? null) ? $res['data'] : [];
+        $mime = trim((string)($data['mimetype'] ?? ''));
+        if ($mime === '') $mime = (string)($row['mimetype'] ?? '');
+        if (!MediaPolicy::allowed($kind, $mime)) {
+            return self::refuse('unsupported_mime', MediaPolicy::baseMime($mime) ?: 'none announced');
+        }
+        $b64 = $data['base64'] ?? null;
+        if (!is_string($b64) || $b64 === '') return self::refuse('malformed', 'no base64 in the answer');
+        // Over the limit before decoding: base64 is 4/3 of the bytes, so a payload this long cannot fit.
+        if (strlen($b64) > (int)ceil($max * 4 / 3) + 4) return self::refuse('too_large', sprintf('payload over %d bytes', $max));
+        $bytes = base64_decode($b64, true);
+        if ($bytes === false || $bytes === '') return self::refuse('malformed', 'base64 did not decode');
+        if (strlen($bytes) > $max) return self::refuse('too_large', sprintf('%d bytes, limit %d', strlen($bytes), $max));
+
+        return ['ok' => true, 'blob' => new MediaBlob($bytes, $mime, $kind, (string)($data['fileName'] ?? ($row['file_name'] ?? '')))];
+    }
+
+    private static function refuse(string $reason, string $detail, ?bool $retryable = null): array
+    {
+        return ['ok' => false, 'reason' => $reason,
+                'retryable' => $retryable ?? (self::REASONS[$reason] ?? false), 'detail' => $detail];
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/MediaPolicy.php b/dishnet-hybrid-sudan/lib/MediaPolicy.php
new file mode 100644
index 0000000..a07c3ce
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/MediaPolicy.php
@@ -0,0 +1,211 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * MediaPolicy — the limits a customer's voice note must satisfy before a byte of it is fetched or kept, and the voice
+ * ladder's runtime predicates (5.18.104, root docs/73 §H.3.2, §H.3.5; ported from the development tree, trimmed to audio).
+ *
+ * Uganda only and OFF unless switched on: every predicate requires StaffJobsGate::applies($config, $dataDir), the
+ * assistant (ai_enabled) and ai_media_enabled, and each higher rung requires every rung below it, whoever set the keys
+ * (R-14). The rungs, the one word the webhook, the worker and the tool agree on:
+ *
+ *   off        — not Uganda, or ai_enabled / ai_media_enabled off: nothing is recorded, nothing fetched;
+ *   fetch_only — R1, voice-measure: the note is fetched into memory, hashed, sized, its Opus packets counted, then wiped;
+ *   dry_run    — R2: transcribed, and nothing is said or kept but counts (and a spoken STOP);
+ *   handover   — R3: every voice note handed to a person, the transcript readable in the Inbox; the body stays [AUDIO];
+ *   reply      — R4, per number: the assistant answers the transcript in text.
+ *
+ * Every limit lives here and nowhere else, clamped to the range the switch tool's `set` allows (§H.3.5), so a value
+ * planted by hand can only narrow what the code does. Photos and documents are not handled in this release (D8). PHP 7.4.
+ */
+final class MediaPolicy
+{
+    /** Kampala's calendar decides "not after today" for the dates the ladder records (R-16). */
+    public const TZ = 'Africa/Kampala';
+
+    public const DEFAULT_MAX_BYTES = 2097152;   // 2 MiB: a two-minute voice note is well under it
+    public const MIN_MAX_BYTES     = 65536;
+    public const CAP_MAX_BYTES     = 8388608;
+    public const DEFAULT_TIMEOUT_S = 20;        // the Evolution fetch
+    public const MIN_TIMEOUT_S     = 3;
+    public const CAP_TIMEOUT_S     = 25;
+
+    /** What this release fetches: voice notes and other audio. Photos, documents, video and stickers are never recorded. */
+    public const SUPPORTED_KINDS = ['audio'];
+
+    public const VOICE_DEFAULT_MAX_SECONDS  = 120;   // longer than this is handed to a person (at R3/R4), not transcribed
+    public const VOICE_MIN_SECONDS          = 10;
+    public const VOICE_CAP_SECONDS          = 300;
+    public const VOICE_DEFAULT_TIMEOUT_S    = 30;    // the provider's whole answer
+    public const VOICE_MIN_TIMEOUT_S        = 5;
+    public const VOICE_CAP_TIMEOUT_S        = 30;
+    public const VOICE_MAX_TRANSCRIPT_CHARS = 4000;  // a transcript is cut here
+    public const VOICE_DEFAULT_DAILY_MINUTES = 120;  // every attempt counted; 0 = no call at all
+    public const VOICE_CAP_DAILY_MINUTES     = 600;
+    public const VOICE_DEFAULT_CONV_DAILY    = 10;   // distinct voice notes per conversation per Kampala day
+    public const VOICE_MIN_CONV_DAILY        = 1;
+    public const VOICE_CAP_CONV_DAILY        = 50;
+
+    /** The transcription models the owner may choose (D2: Whisper). A change of model is the owner's decision. */
+    public const STT_MODELS        = ['whisper-1', 'gpt-transcribe', 'gpt-4o-mini-transcribe', 'gpt-4o-transcribe'];
+    public const STT_DEFAULT_MODEL = 'whisper-1';
+
+    public const MODES = ['off', 'fetch_only', 'dry_run', 'handover', 'reply'];
+
+    /**
+     * The base media types accepted (the part before any ';' — WhatsApp announces a voice note as
+     * "audio/ogg; codecs=opus"). Only Ogg/Opus is transcribed (VoiceTranscription); the others are fetched at R1 so the
+     * mix is measured, and refused as unsupported_audio above it.
+     */
+    public const ALLOWED = [
+        'audio' => ['audio/ogg', 'audio/opus', 'audio/mpeg', 'audio/mp3', 'audio/mp4', 'audio/aac', 'audio/amr',
+                    'audio/wav', 'audio/x-wav', 'audio/webm'],
+    ];
+
+    /** R1 and above: Uganda, the assistant on, ai_media_enabled on. */
+    public static function enabled(array $config, ?string $dataDir): bool
+    {
+        if (!self::flag($config['ai_enabled'] ?? null) || !self::flag($config['ai_media_enabled'] ?? null)) return false;
+        if (!class_exists('StaffJobsGate')) require_once __DIR__ . '/StaffJobsGate.php';
+        return StaffJobsGate::applies($config, $dataDir);
+    }
+
+    /** R2 and above: R1, ai_media_voice, the provider openai, the Privacy Policy line published (a date ≤ today), the key set. */
+    public static function voiceEnabled(array $config, ?string $dataDir): bool
+    {
+        return self::enabled($config, $dataDir)
+            && self::flag($config['ai_media_voice'] ?? null)
+            && strtolower(trim((string)($config['ai_transcription_provider'] ?? ''))) === 'openai'
+            && self::privacyLineOk($config)
+            && self::keySet($config);
+    }
+
+    /** R3 and above: R2 and ai_media_voice_handover. */
+    public static function voiceHandoverEnabled(array $config, ?string $dataDir): bool
+    {
+        return self::voiceEnabled($config, $dataDir) && self::flag($config['ai_media_voice_handover'] ?? null);
+    }
+
+    /**
+     * R4 on this number: R3, the explicit switch ai_media_voice_reply (S2-11: a stale channel list or approval date can
+     * never arm R4 on its own), the owner's approval date (≤ today), and the number in the list (or the list `all`).
+     */
+    public static function voiceReplyEnabled(array $config, ?string $dataDir, string $channel): bool
+    {
+        return self::voiceHandoverEnabled($config, $dataDir)
+            && self::flag($config['ai_media_voice_reply'] ?? null)
+            && self::dateNotAfterToday($config['ai_media_voice_reply_approved'] ?? null)
+            && self::channelListed($config['ai_media_voice_reply_channels'] ?? null, $channel);
+    }
+
+    /** off | fetch_only | dry_run | handover | reply — the one word the webhook, the worker and the tool agree on. */
+    public static function voiceMode(array $config, ?string $dataDir, string $channel): string
+    {
+        if (!self::enabled($config, $dataDir)) return 'off';
+        if (self::voiceReplyEnabled($config, $dataDir, $channel)) return 'reply';
+        if (self::voiceHandoverEnabled($config, $dataDir)) return 'handover';
+        if (self::voiceEnabled($config, $dataDir)) return 'dry_run';
+        return 'fetch_only';
+    }
+
+    /** The Privacy Policy line naming OpenAI is published: ai_media_voice_privacy_line a parseable date not after today. */
+    public static function privacyLineOk(array $config): bool
+    {
+        return self::dateNotAfterToday($config['ai_media_voice_privacy_line'] ?? null);
+    }
+
+    /** Whether an OpenAI key is stored. A boolean only: the key itself never leaves PluginConfig's array (C9). */
+    public static function keySet(array $config): bool
+    {
+        return trim((string)($config['openai_api_key'] ?? '')) !== '';
+    }
+
+    public static function maxBytes(array $config): int
+    {
+        return self::intIn($config['ai_media_max_bytes'] ?? null, self::DEFAULT_MAX_BYTES, self::MIN_MAX_BYTES, self::CAP_MAX_BYTES);
+    }
+
+    public static function timeoutSeconds(array $config): int
+    {
+        return self::intIn($config['ai_media_timeout_s'] ?? null, self::DEFAULT_TIMEOUT_S, self::MIN_TIMEOUT_S, self::CAP_TIMEOUT_S);
+    }
+
+    public static function voiceMaxSeconds(array $config): int
+    {
+        return self::intIn($config['ai_media_voice_max_seconds'] ?? null, self::VOICE_DEFAULT_MAX_SECONDS, self::VOICE_MIN_SECONDS, self::VOICE_CAP_SECONDS);
+    }
+
+    public static function voiceTimeoutSeconds(array $config): int
+    {
+        return self::intIn($config['ai_media_voice_timeout_s'] ?? null, self::VOICE_DEFAULT_TIMEOUT_S, self::VOICE_MIN_TIMEOUT_S, self::VOICE_CAP_TIMEOUT_S);
+    }
+
+    public static function voiceDailyMinutes(array $config): int
+    {
+        return self::intIn($config['ai_media_voice_daily_minutes'] ?? null, self::VOICE_DEFAULT_DAILY_MINUTES, 0, self::VOICE_CAP_DAILY_MINUTES);
+    }
+
+    public static function voiceConversationDailyMax(array $config): int
+    {
+        return self::intIn($config['ai_media_voice_conversation_daily_max'] ?? null, self::VOICE_DEFAULT_CONV_DAILY, self::VOICE_MIN_CONV_DAILY, self::VOICE_CAP_CONV_DAILY);
+    }
+
+    /** The configured model, or '' when the stored value is not on the allow-list (no call is made with it). */
+    public static function sttModel(array $config): string
+    {
+        $m = trim((string)($config['ai_media_openai_stt_model'] ?? ''));
+        if ($m === '') return self::STT_DEFAULT_MODEL;
+        return in_array($m, self::STT_MODELS, true) ? $m : '';
+    }
+
+    /** "audio/ogg; codecs=opus" → "audio/ogg"; lower-cased, trimmed. */
+    public static function baseMime(string $mime): string
+    {
+        $m = strtolower(trim((string)explode(';', $mime)[0]));
+        return $m;
+    }
+
+    public static function kindSupported(string $kind): bool
+    {
+        return in_array($kind, self::SUPPORTED_KINDS, true);
+    }
+
+    public static function allowed(string $kind, string $mime): bool
+    {
+        $base = self::baseMime($mime);
+        if ($base === '') return false;
+        return in_array($base, self::ALLOWED[$kind] ?? [], true);
+    }
+
+    /** 1/true/on/yes are on; unset, empty and everything else are off. */
+    private static function flag($v): bool
+    {
+        if ($v === null || $v === '') return false;
+        if (is_bool($v)) return $v;
+        return in_array(strtolower(trim((string)$v)), ['1', 'true', 'on', 'yes'], true);
+    }
+
+    /** A YYYY-MM-DD date that is real and not after today in Kampala; anything else is false. */
+    private static function dateNotAfterToday($v): bool
+    {
+        $s = trim((string)$v);
+        if (!preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', $s, $m) || !checkdate((int)$m[2], (int)$m[3], (int)$m[1])) return false;
+        $today = (new \DateTime('now', new \DateTimeZone(self::TZ)))->format('Y-m-d');
+        return strcmp($s, $today) <= 0;
+    }
+
+    /** `all`, or a comma-separated list of channel ids that names this one. */
+    private static function channelListed($v, string $channel): bool
+    {
+        $list = array_values(array_filter(array_map('trim', explode(',', strtolower(trim((string)$v)))), 'strlen'));
+        if ($list === []) return false;
+        if ($list === ['all']) return true;
+        return $channel !== '' && in_array(strtolower(trim($channel)), $list, true);
+    }
+
+    private static function intIn($v, int $default, int $min, int $max): int
+    {
+        $n = (is_int($v) || (is_string($v) && preg_match('/^\s*\d{1,9}\s*$/', $v))) ? (int)$v : $default;
+        return max($min, min($max, $n));
+    }
+}
