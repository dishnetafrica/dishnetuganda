+}
+
+/** The read-only connection the switch tool gives a check (ruling R13): query_only, its own handle on the book. */
+function va_ro(array $b): \PDO
+{
+    $ro = new \PDO('sqlite:' . $b['data'] . '/plugin.sqlite3');
