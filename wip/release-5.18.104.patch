+$VM_SECTIONS['C'] = ['title' => 'The worker at R1: fetched, measured, recorded, wiped — and nobody told', 'run' => function (QfCtx $ctx): void {
+    vm_load($ctx);
+    vm_voiceack($ctx);
+    require_once $ctx->tree() . '/lib/ChannelContext.php';
