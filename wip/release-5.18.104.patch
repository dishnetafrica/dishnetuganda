+            'quoted "a,b"' => '"a,b"@agents.example.test', 'quoted, escaped CR LF + a header' => "\"a\\\r\nBcc: x\"@agents.example.test",
+            'a parenthesis' => 'a(b)@agents.example.test', 'a square bracket' => 'a@[127.0.0.1]', 'a backslash' => 'a\\b@agents.example.test',
