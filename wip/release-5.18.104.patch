+        $c2 = WaSendBudget::forInstall($b['cfg'], $b['data'], $b['store'], null, function () use ($t): int { return $t - 3600; })
+              ->claim('Sales-UG', 'voice_ack', 'ack:VA-B07-CONTROL');
