+    /** VN-ON4 (step 9): each understood note on a listed number is one turn, judged as the reply worker could know it. */
+    private static function vnOn4(\PDO $ro, array $config, int $since, int $now, array $notes): array
+    {
+        $c = [];
+        $fail = [];
+        $sinceS = UtcClock::stamp($since);
+        $bound = max($since, $now - self::EVENT_WINDOW_S);
+        $margin = $since + self::SWITCH_MARGIN_S;
+        $aiOff = !self::flag($config['ai_enabled'] ?? null);
+        $listed = function (string $ch) use ($config): bool {
+            $v = strtolower(trim((string)($config['ai_media_voice_reply_channels'] ?? '')));
+            $list = array_values(array_filter(array_map('trim', explode(',', $v)), 'strlen'));
+            return $list === ['all'] || ($ch !== '' && in_array(strtolower(trim($ch)), $list, true));
+        };
+        $owned = self::escalationOwners($ro, $sinceS);
+        foreach (self::all($ro, "SELECT * FROM wa_media WHERE kind = 'audio' AND voice_rung = 'reply' AND created_at >= ? ORDER BY id", [$sinceS]) as $r) {
+            $made = UtcClock::parse((string)$r['created_at']);
+            if ($made < $margin) { self::inc($c, 'inside_switch_margin'); continue; }
+            $turns = self::voiceTurns($ro, (int)$r['id']);
+            if (!$listed((string)$r['channel'])) {
+                // Scope: no voice turn answered on an unlisted number.
+                foreach ($turns as $t) if (self::turnAnswered($ro, $t)) { self::inc($c, 'scope_answered_unlisted'); $fail[] = 'scope'; }
+                continue;
+            }
+            if ($made < $bound) { self::inc($c, 'outside_event_window'); continue; }
+            if ($r['status'] === 'understood') {
+                if (count($turns) !== 1) { self::inc($c, 'turns_mismatch'); $fail[] = 'turns_mismatch'; continue; }
+                $t = $turns[0];
+                if ($t['status'] !== 'done' && $t['status'] !== 'dead') { self::inc($c, $aiOff ? 'undecided ai_enabled_off' : 'undecided ai_enabled_on'); continue; }
+                if ($t['status'] === 'dead') {
+                    $told = (int)self::one($ro, "SELECT COUNT(*) FROM events WHERE event_type = 'wa.escalation' AND created_by = 'ai_reply_worker'
+                                                   AND entity_type = 'conversation' AND entity_id = ? AND created_at >= ?",
+                                           [(int)$r['conversation_id'], (string)$t['processed_at']]);
+                    if ($told > 0) self::inc($c, 'dead_handed_over'); else { self::inc($c, 'turn_dead_untold'); $fail[] = 'turn_dead'; }
+                    continue;
+                }
+                if (self::turnAnswered($ro, $t)) { self::inc($c, 'answered'); continue; }
+                self::inc($c, self::unansweredCause($ro, $t, $r));
+                continue;
+            }
+            if ($turns !== []) { self::inc($c, 'turns_mismatch'); $fail[] = 'turns_mismatch'; continue; }
+            // A failure, handed over once its own event is decided.
+            if ($r['status'] === 'dead' && $r['failure_reason'] === 'switched_off') { self::inc($c, 'dead_switched_off'); continue; }
+            if (!in_array((string)$r['status'], ['failed', 'dead', 'unsupported'], true)) continue;
+            if (!self::mediaDecided($ro, (int)$r['id'])) { self::inc($c, $aiOff ? 'scope undecided ai_enabled_off' : 'scope undecided ai_enabled_on'); continue; }
+            if (!in_array((int)$r['id'], $owned, true)) { self::inc($c, 'failure_not_handed_over'); $fail[] = 'failure_not_handed_over'; }
+        }
+        // P5 on those numbers: no acknowledgement for a note stored past the switch margin.
+        foreach (self::all($ro, "SELECT a.channel, m.created_at AS note_at FROM wa_voice_acks a JOIN wa_messages m ON m.wa_message_id = a.wa_message_id
+                                  WHERE a.outcome IN ('sent','uncertain') AND a.created_at >= ?", [$sinceS]) as $a) {
+            if (!$listed((string)$a['channel'])) continue;
+            if (UtcClock::parse((string)$a['note_at']) < $margin) { self::inc($c, 'inside_switch_margin'); continue; }
+            self::inc($c, 'ack_on_reply_number'); $fail[] = 'ack_on_reply_number';
+        }
+        $c['r13_handovers'] = (int)self::one($ro, "SELECT COUNT(*) FROM events WHERE event_type = 'wa.escalation' AND created_by = 'ai_reply_worker'
+                                                     AND payload LIKE '%that is off now%' AND created_at >= ?", [$sinceS]);
+        $c['out_of_order_handovers'] = (int)self::one($ro, "SELECT COUNT(*) FROM events WHERE event_type = 'wa.escalation' AND created_by = 'ai_reply_worker'
+                                                     AND payload LIKE '%already been answered%' AND created_at >= ?", [$sinceS]);
+        $c['f20_text_deferrals'] = (int)self::one($ro, "SELECT COUNT(*) FROM events WHERE event_type = 'ai.reply' AND error LIKE 'voice: an earlier voice note%' AND created_at >= ?", [$sinceS]);
+        return self::verdict($fail, $c, $notes);
+    }
+
+    // ── off-hooks ──────────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * Rows 2 ('ack') and 5 ('voice-measure'), on the tool's $rw, after the step's keys clear (ruling R7). Returns counts;
+     * throws on failure (the tool prints FAIL off_hook <step>, the keys stay cleared, the sequence goes on).
+     *
+     * @return array<string,int>
+     */
+    public static function offHook(\PDO $rw, array $config, string $dataDir, string $step, string $why): array
+    {
+        if ($step === 'ack') {
+            // Wait, bounded, while the reply worker records each pending acknowledgement switched_off on its own fresh read
+            // (step 13); then count what remains (VN-RB2, VN-RB4).
+            $c = ['ack_events_at_start' => self::ackEvents($rw)];
+            $c['waited_s'] = self::drain(function () use ($rw): int { return self::ackEvents($rw); });
+            $c['ack_events_left'] = self::ackEvents($rw);
+            $c['ack_events_left_processing'] = (int)self::one($rw, "SELECT COUNT(*) FROM events WHERE event_type = 'ai.voice_ack' AND status = 'processing'");
+            return $c;
+        }
+        if ($step === 'voice-measure') {
+            if (!self::hasTable($rw, 'wa_media')) return ['settled' => 0, 'voice_turns_left' => 0, 'waited_s' => 0];
+            $st = $rw->prepare("UPDATE wa_media SET status = 'skipped', failure_reason = 'switched_off', updated_at = datetime('now')
+                                 WHERE kind = 'audio' AND status = 'pending'");
+            $st->execute();
+            $c = ['settled' => $st->rowCount()];
+            // Drain the voice turns (ruling R14): the reply worker hands each to a person on its own fresh read (R-13).
+            $c['waited_s'] = self::drain(function () use ($rw): int { return self::voiceTurnsPending($rw); });
+            $c['voice_turns_left'] = self::voiceTurnsPending($rw);
+            $c['ai_media_events_pending'] = (int)self::one($rw, "SELECT COUNT(*) FROM events WHERE event_type = 'ai.media' AND status IN ('pending','failed','processing')");
+            if ($why === 'rollback') {
+                $left = (int)self::one($rw, "SELECT COUNT(*) FROM wa_media WHERE kind = 'audio' AND status = 'pending'");
+                if ($left > 0) throw new \RuntimeException('voice-measure off-hook: pending audio rows remain');
+            }
+            return $c;
+        }
+        throw new \RuntimeException('no Part V off-hook for this step');
+    }
+
+    /** Poll $left() until it reads 0 or the bound passes; the seconds waited. */
+    private static function drain(callable $left): int
+    {
+        $t0 = time();
+        while ($left() > 0 && time() - $t0 < self::$drainBoundS) usleep(max(10000, (int)self::$drainPollUs));
+        return time() - $t0;
+    }
+
+    private static function ackEvents(\PDO $pdo): int
+    {
+        return (int)self::one($pdo, "SELECT COUNT(*) FROM events WHERE event_type = 'ai.voice_ack' AND status IN ('pending', 'processing')");
+    }
+
+    private static function voiceTurnsPending(\PDO $pdo): int
+    {
+        return (int)self::one($pdo, "SELECT COUNT(*) FROM events WHERE event_type = 'ai.reply' AND status IN ('pending', 'processing')
+                                       AND payload LIKE '%\"origin\":\"voice\"%'");
+    }
+
+    // ── shared reads ───────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * Which row each media_worker hand-over is (§H.3.20): its event names its conversation and no row, so it is the row the
+     * worker settled last on that conversation at or before the event's created_at; on a tie in the second, a handover or
+     * reply row. Returns the media ids that own at least one such event.
+     *
+     * @return int[]
+     */
+    private static function escalationOwners(\PDO $ro, string $sinceS): array
+    {
+        $out = [];
+        foreach (self::all($ro, "SELECT id FROM events WHERE event_type = 'wa.escalation' AND created_by = 'media_worker'
+                                  AND entity_type = 'conversation' AND created_at >= ?", [$sinceS]) as $e) {
+            $o = self::ownerOf($ro, (int)$e['id']);
+            if ($o !== null) $out[$o] = $o;
+        }
+        return array_values($out);
+    }
+
+    private static function ownerOf(\PDO $ro, int $eventId): ?int
+    {
+        $v = self::one($ro, "SELECT m.id FROM events e JOIN wa_media m ON m.conversation_id = e.entity_id
+                              WHERE e.id = ? AND m.updated_at <= e.created_at
+                              ORDER BY m.updated_at DESC, (m.voice_rung IN ('handover', 'reply')) DESC, m.id DESC LIMIT 1", [$eventId]);
+        return ($v === null || $v === false) ? null : (int)$v;
+    }
+
+    /** The note's own body is no longer [AUDIO]. */
+    private static function bodyChanged(\PDO $ro, array $r): bool
+    {
+        $b = self::one($ro, 'SELECT body FROM wa_messages WHERE wa_message_id = ?', [(string)$r['wa_message_id']]);
+        return is_string($b) && $b !== '[AUDIO]';
+    }
+
+    /** The row's own voice turns: ai.reply events whose payload names it (voice.media_id). */
+    private static function voiceTurns(\PDO $ro, int $mediaId): array
+    {
+        $out = [];
+        foreach (self::all($ro, "SELECT * FROM events WHERE event_type = 'ai.reply' AND payload LIKE '%\"origin\":\"voice\"%'") as $e) {
+            $p = json_decode((string)$e['payload'], true);
+            if (is_array($p) && (int)($p['voice']['media_id'] ?? 0) === $mediaId) $out[] = $e;
+        }
+        return $out;
+    }
+
+    /** The row's own ai.media event is done or dead (or gone: a row whose event is missing is judged). */
+    private static function mediaDecided(\PDO $ro, int $mediaId): bool
+    {
+        $evs = self::all($ro, "SELECT status, attempts, max_attempts FROM events WHERE event_type = 'ai.media' AND entity_type = 'media' AND entity_id = ?", [$mediaId]);
+        if ($evs === []) return true;
+        foreach ($evs as $e) {
+            $decided = $e['status'] === 'done' || $e['status'] === 'dead';
+            if (!$decided) return false;
+        }
+        return true;
+    }
+
+    /** A voice_ack hand-over on the row's conversation within 30 min of the row. */
+    private static function ackEscalationNear(\PDO $ro, array $r): bool
+    {
+        $t = UtcClock::parse((string)$r['created_at']);
+        return (int)self::one($ro, "SELECT COUNT(*) FROM events WHERE event_type = 'wa.escalation' AND created_by = 'voice_ack'
+                                      AND entity_type = 'conversation' AND entity_id = ? AND created_at >= ? AND created_at <= ?",
+                              [(int)$r['conversation_id'], UtcClock::stamp($t - 1800), UtcClock::stamp($t + 1800)]) > 0;
+    }
+
+    private static function holdingLines(\PDO $ro, string $sinceS): array
+    {
+        return self::all($ro, "SELECT id, conversation_id, created_at FROM wa_messages WHERE direction = 'out' AND role = 'assistant'
+                                 AND " . VoiceAck::metaHas('metadata', '"handover":true') . " AND created_at >= ? ORDER BY id", [$sinceS]);
+    }
+
+    /**
+     * R-19 for one line given to one row: an acknowledgement of the conversation stored in an earlier second than the row's
+     * updated_at (the worker could read it), within 10 min before the line. One stored later is a count.
+     */
+    private static function lineAfterKnownAck(\PDO $ro, array $row, int $lineT, array &$c): bool
+    {
+        $upd = UtcClock::parse((string)$row['updated_at']);
+        foreach (self::all($ro, "SELECT created_at FROM wa_voice_acks WHERE conversation_id = ? AND outcome IN ('claimed','sent','uncertain')
+                                  AND created_at <= ? AND created_at >= ?",
+                           [(int)$row['conversation_id'], UtcClock::stamp($lineT), UtcClock::stamp($lineT - self::ACK_LINE_S)]) as $a) {
+            if (UtcClock::parse((string)$a['created_at']) < $upd) return true;
+            self::inc($c, 'ack_after_row_decided');
+        }
+        return false;
+    }
+
+    /** A DishNet AI assistant row of the turn's conversation, not a hand-over line or an acknowledgement, after its event. */
+    private static function turnAnswered(\PDO $ro, array $t): bool
+    {
+        $until = $t['processed_at'] !== null && $t['processed_at'] !== '' ? (string)$t['processed_at'] : '9999-12-31 23:59:59';
+        return (int)self::one($ro, "SELECT COUNT(*) FROM wa_messages WHERE conversation_id = ? AND direction = 'out' AND role = 'assistant'
+                                      AND agent_name = 'DishNet AI' AND created_at >= ? AND created_at <= ?
+                                      AND NOT " . VoiceAck::metaHas("COALESCE(metadata, '')", '"handover":true') . "
+                                      AND NOT " . VoiceAck::metaHas("COALESCE(metadata, '')", '"source":"voice_ack"') . "",
+                              [(int)$t['entity_id'], (string)$t['created_at'], $until]) > 0;
+    }
+
+    /** Why a done turn was not answered, by the first recorded cause (§H.3.20 VN-ON4); never FAIL. */
+    private static function unansweredCause(\PDO $ro, array $t, array $r): string
+    {
+        $conv = (int)$t['entity_id'];
+        $until = $t['processed_at'] !== null && $t['processed_at'] !== '' ? (string)$t['processed_at'] : '9999-12-31 23:59:59';
+        if ((int)self::one($ro, "SELECT COUNT(*) FROM events WHERE event_type = 'wa.escalation' AND created_by = 'ai_reply_worker'
+                                   AND entity_type = 'conversation' AND entity_id = ? AND created_at >= ? AND created_at <= ?",
+                           [$conv, (string)$t['created_at'], $until]) > 0) {
+            return 'handed_over';
+        }
+        $labels = "'', 'DishNet AI', 'DishNet Plugin', 'WhatsApp auto-reply'";
+        foreach (self::all($ro, "SELECT event_key, agent_name FROM wa_messages WHERE conversation_id = ? AND direction = 'out' AND role = 'agent'
+                                  AND COALESCE(agent_name, '') NOT IN ({$labels}) AND created_at > ? AND created_at <= ? ORDER BY id",
+                           [$conv, (string)$r['created_at'], $until]) as $m) {
+            if (in_array((string)$m['event_key'], HumanTakeover::personEvents(), true)) return 'meanwhile_row inbox_reply';
+            if ((string)$m['agent_name'] === 'Team') return 'meanwhile_row team_row';
+            return 'meanwhile_row other';
+        }
+        if (strpos((string)($t['error'] ?? ''), 'parked:') === 0) return 'parked_dropped';
+        return 'no_recorded_cause';
+    }
+
+    /** ai_media's last duration from the store's master_schedule row (a note, never judged; §H.3.20). */
+    private static function durationNote(\PDO $ro): string
+    {
+        if (!self::hasTable($ro, 'master_schedule')) return 'ai_media last run: no master_schedule row';
+        $raw = self::one($ro, 'SELECT data FROM master_schedule WHERE id = 0');
+        $d = is_string($raw) ? json_decode($raw, true) : null;
+        if (!is_array($d) || !isset($d['ai_media']) || !is_array($d['ai_media'])) return 'ai_media last run: no ai_media entry';
+        return 'ai_media last run: duration_ms ' . (int)($d['ai_media']['duration_ms'] ?? -1);
+    }
+
+    /** The plugin's log files a key could have landed in (VN-K1): the data folder's and the code folder's. */
+    private static function logFiles(string $dataDir): array
+    {
+        $out = [];
+        foreach ([$dataDir, dirname(__DIR__) . '/data'] as $dir) {
+            if ($dir === '' || !is_dir($dir)) continue;
+            foreach (glob(rtrim($dir, '/') . '/*.log') ?: [] as $f) $out[] = $f;
+            foreach (glob(rtrim($dir, '/') . '/*log*.json') ?: [] as $f) $out[] = $f;
+        }
+        return array_values(array_unique($out));
+    }
+
+    private static function schemaRow(\PDO $ro, string $migration): bool
+    {
+        if (!self::hasTable($ro, '_schema_checks')) return false;
+        return (int)self::one($ro, 'SELECT COUNT(*) FROM _schema_checks WHERE migration = ? AND found = expected', [$migration]) > 0;
+    }
+
+    // ── small helpers ──────────────────────────────────────────────────────────────────────────────────────────
+
+    private static function verdict(array $fail, array $c, array $notes): array
+    {
+        return self::res($fail === [] ? 'PASS' : 'FAIL ' . $fail[0], $c, $notes);
+    }
+
+    private static function res(string $status, array $counts, array $notes): array
+    {
+        ksort($counts);
+        return ['status' => $status, 'counts' => $counts, 'notes' => array_values($notes)];
+    }
+
+    private static function inc(array &$c, string $k, int $n = 1): void
+    {
+        $c[$k] = ($c[$k] ?? 0) + $n;
+    }
+
+    /** A since-stamp as the other parts read theirs: a unix time in digits, or a UTC stamp (UtcClock); null otherwise. */
+    private static function sinceOf($v): ?int
+    {
+        if (is_bool($v) || !is_scalar($v)) return null;
+        $s = trim((string)$v);
+        if ($s === '') return null;
+        $t = ctype_digit($s) ? (int)$s : UtcClock::parse($s);
+        return $t > 0 ? $t : null;
+    }
+
+    private static function pct(array $vals, int $q): int
+    {
+        if ($vals === []) return 0;
+        sort($vals);
+        return (int)$vals[(int)min(count($vals) - 1, (int)ceil($q / 100 * count($vals)) - 1)];
+    }
+
+    private static function token(string $s): string
+    {
+        $t = (string)preg_replace('/[^A-Za-z0-9_\/.-]/', '', $s);
+        return $t === '' ? 'none' : substr($t, 0, 40);
+    }
+
+    private static function hasTable(\PDO $pdo, string $name): bool
+    {
+        $st = $pdo->prepare("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?");
+        $st->execute([$name]);
+        return $st->fetchColumn() !== false;
+    }
+
+    private static function all(\PDO $pdo, string $sql, array $args = []): array
+    {
+        $st = $pdo->prepare($sql);
+        $st->execute($args);
+        return $st->fetchAll(\PDO::FETCH_ASSOC);
+    }
+
+    /** @return mixed the first column of the first row, or null */
+    private static function one(\PDO $pdo, string $sql, array $args = [])
+    {
+        $st = $pdo->prepare($sql);
+        $st->execute($args);
+        $v = $st->fetchColumn();
+        return $v === false ? null : $v;
+    }
+
+    private static function flag($v): bool
+    {
+        if ($v === null || $v === '') return false;
+        if (is_bool($v)) return $v;
+        return in_array(strtolower(trim((string)$v)), ['1', 'true', 'on', 'yes'], true);
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/VoiceTranscription.php b/dishnet-hybrid-sudan/lib/VoiceTranscription.php
new file mode 100644
index 0000000..13f4c39
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/VoiceTranscription.php
@@ -0,0 +1,327 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/MediaPolicy.php';
+require_once __DIR__ . '/MediaBlob.php';
+require_once __DIR__ . '/Transcriber.php';
+require_once __DIR__ . '/EventBus.php';
+require_once __DIR__ . '/ContactOptOut.php';
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/PluginConfig.php';
+require_once __DIR__ . '/VoiceDuration.php';
+require_once __DIR__ . '/VoiceBudget.php';
+
+/**
+ * VoiceTranscription — a fetched voice note, transcribed, per rung (Batch 2 of the AI communication layer, docs/55 §9,
+ * docs/56; 5.18.104, root docs/73 §H.3.7: ported from the development tree and split per rung).
+ *
+ * MediaWorker calls process() with the audio in memory and the rung its event read (dry_run, handover or reply):
+ *
+ *   1. the kind and the fetched type — Ogg/Opus only in this release; anything else is unsupported_audio;
+ *   2. the duration counted from the Opus packets (VoiceDuration): malformed, the container disagreeing with its
+ *      packets, a bit rate above 64 kbit/s, or longer than ai_media_voice_max_seconds is refused before any call; the
+ *      announced `seconds` is recorded only, never trusted;
+ *   3. the configuration read again, immediately before the provider is asked (ruling R19): voice off on that read is
+ *      `switched_off`, no provider is `provider_missing`;
+ *   4. the budget (VoiceBudget) reserves the call, or refuses it;
+ *   5. the one call; the calls row is settled with its outcome, status, ms and billed seconds;
+ *   6. the text normalised (empty is a failure);
+ *   7. complete(), in one transaction guarded by `status <> 'understood'`: at dry_run the row records counts only and
+ *      `understanding` stays NULL; at handover the transcript is kept for staff and the body stays [AUDIO] (F10); at reply
+ *      the body becomes the labelled transcript and ONE ai.reply event is queued with origin voice. A spoken STOP is
+ *      recorded from R2, exactly as the webhook reads typed text.
+ *
+ * It never sends a message and never keeps audio. Every failure is a fixed reason code with a retryable flag (REASONS);
+ * the worker records it and, at R3/R4, hands the conversation to a person. An exception's class is kept, never its
+ * message. PHP 7.4 compatible.
+ */
+final class VoiceTranscription
+{
+    /** What the assistant reads before the transcript, and what the stored message says (R4 only). */
+    public const LABEL = '[voice message, transcribed]';
+
+    /** Reason code => retried by the EventBus? */
+    public const REASONS = [
+        'too_long'             => false,   // longer than ai_media_voice_max_seconds, counted from the packets
+        'unsupported_audio'    => false,   // not Ogg/Opus (MP3, M4A, WAV, WebM, Vorbis, Speex)
+        'invalid_audio'        => false,   // malformed, the container disagreeing with its packets, or the bit rate
+        'empty_transcript'     => false,   // nothing recognised
+        'conversation_missing' => false,   // the row names a conversation that no longer exists
+        'provider_missing'     => false,   // no usable provider on the configuration read before the call
+        'provider_auth'        => false,   // 401 / 403
+        'provider_quota'       => false,   // 429 insufficient_quota
+        'provider_model'       => false,   // 404: the model is not served
+        'provider_rejected'    => false,   // 400: the file was refused
+        'too_large'            => false,   // 413
+        'budget_daily'         => false,   // the day's minutes are used up (or set to 0)
+        'budget_conversation'  => false,   // this conversation's notes today are at the cap
+        'switched_off'         => false,   // voice switched off between the fetch and the call
+        'provider_error'       => true,    // a 5xx, a malformed answer, a transport failure
+        'provider_busy'        => true,    // a 429 that is not the quota
+        'timeout'              => true,    // no answer in time
+    ];
+
+    public const MODES = ['dry_run', 'handover', 'reply'];
+
+    /** 64 kbit/s plus a page of slack: a voice note above it is not what it says it is. */
+    private const BYTES_PER_SECOND = 8000;
+    private const BYTES_SLACK      = 4096;
+
+    /** @var \PDO */
+    private $pdo;
+    private $store;
+    /** @var array */
+    private $config;
+    /** @var TranscriberPort|null */
+    private $transcriber;
+    /** @var bool */
+    private $injected;
+    /** @var callable */
+    private $log;
+    /** @var EventBus */
+    private $bus;
+    /** @var string */
+    private $dataDir;
+    /** @var int|null */
+    private $now;
+
+    /**
+     * @param TranscriberPort|null $transcriber a provider injected by a test; with $injected false the provider is built
+     *                                          from the configuration read before the call
+     */
+    public function __construct(\PDO $pdo, $store, array $config, ?TranscriberPort $transcriber, callable $log,
+                                string $dataDir = '', bool $injected = false, ?int $now = null)
+    {
+        $this->pdo         = $pdo;
+        $this->store       = $store;
+        $this->config      = $config;
+        $this->transcriber = $transcriber;
+        $this->injected    = $injected;
+        $this->log         = $log;
+        $this->bus         = new EventBus($pdo);
+        $this->dataDir     = $dataDir;
+        $this->now         = $now;
+    }
+
+    /**
+     * @param array     $row   the wa_media row, freshly read (kind, seconds, channel, instance, conversation_id, attempts, …)
+     * @param MediaBlob $audio the fetched bytes, in memory
+     * @param string    $mode  the rung the event read: dry_run | handover | reply
+     * @return array ['outcome' => 'recorded'|'handover'|'understood', 'chars' => int, 'event_id' => int (reply)]
+     *               | ['outcome' => 'already_understood'] | ['outcome' => 'duplicate']
+     *               | ['outcome' => 'failed', 'reason' => string, 'retryable' => bool, 'detail' => string]
+     */
+    public function process(array $row, MediaBlob $audio, string $mode): array
+    {
+        if (!in_array($mode, self::MODES, true)) return self::fail('switched_off', 'rung ' . $mode);
+        $id     = (int)($row['id'] ?? 0);
+        $convId = (int)($row['conversation_id'] ?? 0);
+
+        // 1. The kind and the fetched type.
+        if ((string)($row['kind'] ?? '') !== 'audio') return self::fail('unsupported_audio', 'not an audio message');
+        $base = MediaPolicy::baseMime((string)$audio->mimetype);
+        if ($base !== 'audio/ogg' && $base !== 'audio/opus') return self::fail('unsupported_audio', $base !== '' ? $base : 'no type');
+
+        // 2. The duration, from the packets; the announced seconds are recorded only.
+        $d = VoiceDuration::measure($audio);
+        if (empty($d['ok'])) return self::fail((string)$d['reason'], (string)$d['detail']);
+        $secs = (int)ceil((float)$d['seconds']);
+        if ((int)$audio->size > $secs * self::BYTES_PER_SECOND + self::BYTES_SLACK) return self::fail('invalid_audio', 'bitrate');
+        $announced = $row['seconds'] ?? null;
+        if (is_numeric($announced) && abs((int)$announced - (float)$d['seconds']) > 2) {
+            ($this->log)('info', sprintf('media #%d: announced_mismatch', $id));
+        }
+
+        // 3. The provider, on a configuration read afresh (ruling R19).
+        try {
+            $fresh = PluginConfig::read(dirname(__DIR__), $this->dataDir !== '' ? $this->dataDir : dirname(__DIR__) . '/data');
+            $on = MediaPolicy::voiceEnabled($fresh, $this->dataDir !== '' ? $this->dataDir : null);
+        } catch (\Throwable $e) {
+            $fresh = []; $on = false;
+        }
+        if (!$on) return self::fail('switched_off', 'voice off on the read before the call');
+        if ($secs > MediaPolicy::voiceMaxSeconds($fresh)) {
+            return self::fail('too_long', sprintf('%d s, limit %d s', $secs, MediaPolicy::voiceMaxSeconds($fresh)));
+        }
+        $tr = $this->injected ? $this->transcriber : TranscriberFactory::fromConfig($fresh);
+        if ($tr === null) return self::fail('provider_missing', 'no provider');
+        $model = MediaPolicy::sttModel($fresh);
+        if ($model === '') return self::fail('provider_missing', 'model not on the allow-list');
+
+        // 4. The budget, before the call.
+        $budget  = new VoiceBudget($this->pdo, $fresh, $this->now);
+        $attempt = max(1, (int)($row['attempts'] ?? 1));
+        $res = $budget->reserve($id, $convId, $attempt, $secs, $model, $mode);
+        if (empty($res['ok'])) {
+            if (($res['reason'] ?? '') === 'duplicate') return ['outcome' => 'duplicate'];
+            return self::fail((string)$res['reason'], 'reserved ' . $secs . ' s');
+        }
+        $callId = (int)$res['id'];
+
+        // 5. The call.
+        $this->setStatus($id, 'transcribing');
+        $t0 = microtime(true);
+        try {
+            $ans = $tr->transcribe($audio, [
+                'mimetype' => (string)$audio->mimetype, 'seconds' => $secs, 'language' => '',
+                'channel'  => (string)($row['channel'] ?? ''),
+            ], MediaPolicy::voiceTimeoutSeconds($fresh));
+        } catch (\Throwable $e) {
+            $ans = ['ok' => false, 'reason' => 'provider_error', 'retryable' => true, 'detail' => get_class($e)];
+        }
+        $ms   = (int)round((microtime(true) - $t0) * 1000);
+        $http = is_array($ans) ? (int)($ans['http'] ?? 0) : 0;
+        $ok   = is_array($ans) && !empty($ans['ok']);
+        $billed = $secs;
+        if ($ok && isset($ans['duration_s']) && is_numeric($ans['duration_s'])) $billed = (int)ceil((float)$ans['duration_s']);
+        if (!$ok) {
+            $reason = (string)(is_array($ans) ? ($ans['reason'] ?? '') : '');
+            if (!array_key_exists($reason, self::REASONS)) $reason = 'provider_error';
+            $retry = is_array($ans) && array_key_exists('retryable', $ans) ? (bool)$ans['retryable'] : self::REASONS[$reason];
+            $budget->settle($callId, 'failed', $http, $ms, $secs, $reason);
+            return ['outcome' => 'failed', 'reason' => $reason, 'retryable' => $retry,
+                    'detail' => self::safeDetail((string)(is_array($ans) ? ($ans['detail'] ?? '') : 'no answer'))];
+        }
+        $budget->settle($callId, 'ok', $http, $ms, $billed);
+
+        // 6. Normalise.
+        $text = self::normalise((string)($ans['text'] ?? ''));
+        if ($text === '') return self::fail('empty_transcript', 'nothing recognised');
+
+        // 7. The rung's own record.
+        return $this->complete($row, $text, [
+            'provider' => 'openai', 'model' => $model, 'ms' => $ms,
+            'provider_seconds' => isset($ans['duration_s']) && is_numeric($ans['duration_s']) ? (int)ceil((float)$ans['duration_s']) : null,
+            'seconds' => $secs,
+        ], $mode);
+    }
+
+    /**
+     * The transcript's record, once, at the rung given. One transaction: the row is marked understood only if it was
+     * not already (a retry, or a duplicate event, finds the guard and does nothing); at reply the stored message is
+     * rewritten and the ai.reply event queued; from R2 a STOP is recorded. A database failure rolls all of it back and
+     * is thrown, so the worker retries the whole thing.
+     */
+    public function complete(array $row, string $transcript, array $meta, string $mode): array
+    {
+        if (!in_array($mode, self::MODES, true)) return self::fail('switched_off', 'rung ' . $mode);
+        $id     = (int)($row['id'] ?? 0);
+        $convId = (int)($row['conversation_id'] ?? 0);
+        $q = $this->pdo->prepare('SELECT phone, display_name, crm_client_id FROM wa_conversations WHERE id = ?');
+        $q->execute([$convId]);
+        $conv = $q->fetch(\PDO::FETCH_ASSOC);
+        if (!is_array($conv) || (string)($conv['phone'] ?? '') === '') return self::fail('conversation_missing', 'conversation ' . $convId);
+
+        $chars    = mb_strlen($transcript);
+        $keep     = $mode === 'dry_run' ? null : $transcript;
+        $secs     = max(0, (int)($meta['seconds'] ?? 0));
+        $eventId  = 0;
+        $this->pdo->beginTransaction();
+        try {
+            $u = $this->pdo->prepare("UPDATE wa_media SET status = 'understood', voice_rung = ?, understanding = ?,
+                                      understanding_kind = ?, provider = ?, provider_model = ?, provider_ms = ?,
+                                      provider_seconds = ?, transcript_chars = ?, failure_reason = NULL,
+                                      updated_at = datetime('now') WHERE id = ? AND status <> 'understood'");
+            $u->execute([$mode, $keep, $keep === null ? null : 'transcript', (string)($meta['provider'] ?? ''),
+                         (string)($meta['model'] ?? ''), (int)($meta['ms'] ?? 0), $meta['provider_seconds'] ?? null, $chars, $id]);
+            if ($u->rowCount() !== 1) {
+                $this->pdo->rollBack();
+                return ['outcome' => 'already_understood'];
+            }
+
+            // STOP, exactly as evo_webhook.php reads it off typed text (step 8b), from R2: a proactive opt-out.
+            $stop = ContactOptOut::detect($transcript);
+            if ($stop['stop']) {
+                $oo  = ContactOptOut::fromStore($this->store);
+                $res = $oo->add((string)$conv['phone'], [
+                    'channel'       => '*',
+                    'scope'         => ContactOptOut::SCOPE_PROACTIVE,
+                    'reason'        => 'customer_request',
+                    'source'        => 'voice_keyword',
+                    'evidence'      => mb_substr($transcript, 0, 40),
+                    'crm_client_id' => (int)($conv['crm_client_id'] ?? 0),
+                ]);
+                if (!empty($res['created'])) {
+                    ($this->log)('info', sprintf('media #%d: opt-out recorded from the transcript (matched "%s")', $id, $stop['matched']));
+                }
+            }
+
+            if ($mode === 'reply') {
+                // The stored "[AUDIO]" message says what was said: the inbox reads it, and so does the model's history.
+                $labelled = self::label($transcript);
+                $msgId = (int)($row['message_id'] ?? 0);
+                if ($msgId > 0) {
+                    $m = $this->pdo->prepare("SELECT metadata FROM wa_messages WHERE id = ? AND media_type = 'audio'");
+                    $m->execute([$msgId]);
+                    $metaRaw = $m->fetchColumn();
+                    if ($metaRaw !== false) {
+                        $md = json_decode((string)$metaRaw, true);
+                        $md = is_array($md) ? $md : [];
+                        $md['voice'] = ['media_id' => $id, 'seconds' => $secs, 'provider' => (string)($meta['provider'] ?? ''),
+                                        'transcribed_at' => gmdate('Y-m-d H:i:s')];
+                        $this->pdo->prepare("UPDATE wa_messages SET body = ?, metadata = ? WHERE id = ? AND media_type = 'audio'")
+                                  ->execute([$labelled, json_encode($md, JSON_UNESCAPED_UNICODE), $msgId]);
+                    }
+                }
+                // The one ai.reply event: the shape evo_webhook.php queues for a typed message, plus where it came from.
+                $received = UtcClock::parse((string)($row['created_at'] ?? ''));
+                $eventId  = (int)$this->bus->emit('ai.reply', 'conversation', $convId, [
+                    'channel'           => (string)($row['channel'] ?? ''),
+                    'whatsapp_instance' => (string)($row['instance'] ?? ''),
+                    'customer_phone'    => (string)$conv['phone'],
+                    'message'           => $labelled,
+                    'push_name'         => (string)($conv['display_name'] ?? ''),
+                    'wa_message_id'     => (string)($row['wa_message_id'] ?? ''),
+                    'remote_jid'        => (string)($row['remote_jid'] ?? ''),
+                    'received_at'       => gmdate('c', $received > 0 ? $received : time()),
+                    'location'          => null,
+                    'origin'            => 'voice',
+                    'voice'             => ['media_id' => $id, 'seconds' => $secs, 'chars' => $chars],
+                ], 3, 'media_worker');
+            }
+            $this->pdo->commit();
+        } catch (\Throwable $e) {
+            if ($this->pdo->inTransaction()) $this->pdo->rollBack();
+            throw $e;   // the worker retries: the row is not understood, nothing was queued
+        }
+        if ($mode === 'reply') return ['outcome' => 'understood', 'event_id' => $eventId, 'chars' => $chars];
+        return ['outcome' => $mode === 'handover' ? 'handover' : 'recorded', 'chars' => $chars];
+    }
+
+    /** Control characters out, whitespace collapsed, trimmed, cut at the policy's limit. */
+    public static function normalise(string $text): string
+    {
+        $t = preg_replace('/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/u', ' ', $text);
+        if ($t === null) $t = preg_replace('/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/', ' ', $text) ?? $text;
+        $t = preg_replace('/[ \t]+/u', ' ', $t) ?? $t;
+        $t = preg_replace('/\s*\n\s*/u', "\n", $t) ?? $t;
+        $t = trim($t);
+        if (mb_strlen($t) > MediaPolicy::VOICE_MAX_TRANSCRIPT_CHARS) {
+            $t = rtrim(mb_substr($t, 0, MediaPolicy::VOICE_MAX_TRANSCRIPT_CHARS)) . '…';
+        }
+        return $t;
+    }
+
+    /** The message the assistant reads at R4, and the stored body there: labelled as a transcript, never bare. */
+    public static function label(string $transcript): string
+    {
+        return self::LABEL . ' ' . $transcript;
+    }
+
+    private function setStatus(int $id, string $status): void
+    {
+        $this->pdo->prepare("UPDATE wa_media SET status = ?, updated_at = datetime('now') WHERE id = ?")->execute([$status, $id]);
+    }
+
+    private static function fail(string $reason, string $detail): array
+    {
+        return ['outcome' => 'failed', 'reason' => $reason, 'retryable' => self::REASONS[$reason] ?? false,
+                'detail' => self::safeDetail($detail)];
+    }
+
+    /** A detail is a short code, status or class name — cut, and never a transcript. */
+    private static function safeDetail(string $detail): string
+    {
+        return mb_substr(trim(preg_replace('/\s+/', ' ', $detail) ?? $detail), 0, 120);
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/WaSeenMarks.php b/dishnet-hybrid-sudan/lib/WaSeenMarks.php
new file mode 100644
index 0000000..4d0af78
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/WaSeenMarks.php
@@ -0,0 +1,90 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * WaSeenMarks — a content-free mark for a WhatsApp message the webhook cannot store (5.18.104, root docs/73 §H.2.7.2;
+ * R-01, R-07).
+ *
+ *   in  — a customer wrote inside a wrapper the store cannot read (a disappearing or view-once message): the chase
+ *         treats it as a reply, and offers leave the phone out, since nobody could read what was said;
+ *   out — a colleague answered from the handset with a voice note, a photo or a document without a caption: a person
+ *         wrote to this customer, so a quote chase and the voice-note acknowledgement stop (HumanTakeover);
+ *   lid_no_number — an inbound @lid message with no number: counted only.
+ *
+ * A mark holds no text and no file: direction, the customer's digits, the channel and instance, the envelope's key and
+ * the message id. Our own sends are told apart when a mark is read (HumanTakeover), not here. note() tests the ledger
+ * switch first, then StaffJobsGate, then kindOf(); it never throws into the webhook. On South Sudan the switch is
+ * never set, so nothing is written and nothing else is required. PHP 7.4.
+ */
+final class WaSeenMarks
+{
+    const WRAPPERS = ['ephemeralMessage','viewOnceMessage','viewOnceMessageV2','viewOnceMessageV2Extension','documentWithCaptionMessage'];
+    const MEDIA    = ['audioMessage','imageMessage','documentMessage','videoMessage','stickerMessage'];
+
+    /**
+     * Pure. in → a WRAPPERS key of the message; out → a WRAPPERS or MEDIA key; anything else (a reaction, a protocol
+     * message, an edit, a poll) → null. The keys are looked for, never taken from array_keys()[0], which can be
+     * messageContextInfo.
+     */
+    public static function kindOf(array $msg, string $direction): ?string
+    {
+        $m = $msg['message'] ?? null;
+        if (!is_array($m)) return null;
+        foreach (self::WRAPPERS as $k) if (array_key_exists($k, $m)) return $k;
+        if ($direction === 'out') {
+            foreach (self::MEDIA as $k) if (array_key_exists($k, $m)) return $k;
+        }
+        return null;
+    }
+
+    /** A mark for one message, with the ledger on, on Uganda, for a key kindOf() names. Never throws. */
+    public static function note(\PDO $pdo, array $config, ?string $dataDir, string $direction, string $phone, string $channel,
+                                string $instance, string $waMessageId, array $msg): void
+    {
+        try {
+            if ((string)($config['wa_send_ledger'] ?? '') !== 'on') return;
+            if (!self::uganda($config, $dataDir)) return;
+            if (($direction !== 'in' && $direction !== 'out') || $waMessageId === '') return;
+            $kind = self::kindOf($msg, $direction);
+            if ($kind === null) return;
+            self::insert($pdo, $direction, $phone, $channel, $instance, $kind, $waMessageId);
+        } catch (\Throwable $e) {
+            self::lost();
+        }
+    }
+
+    /** An inbound @lid message with no number: counted only (phone '', kind lid_no_number). Never throws. */
+    public static function noNumber(\PDO $pdo, array $config, ?string $dataDir, string $channel, string $instance, string $waMessageId): void
+    {
+        try {
+            if ((string)($config['wa_send_ledger'] ?? '') !== 'on') return;
+            if (!self::uganda($config, $dataDir)) return;
+            if ($waMessageId === '') return;
+            self::insert($pdo, 'in', '', $channel, $instance, 'lid_no_number', $waMessageId);
+        } catch (\Throwable $e) {
+            self::lost();
+        }
+    }
+
+    private static function insert(\PDO $pdo, string $direction, string $phone, string $channel, string $instance,
+                                   string $kind, string $waMessageId): void
+    {
+        $pdo->prepare('INSERT OR IGNORE INTO wa_seen_marks (direction, phone, channel, instance, kind, wa_message_id)
+                       VALUES (?, ?, ?, ?, ?, ?)')
+            ->execute([$direction, (string)preg_replace('/\D+/', '', $phone), $channel, $instance, $kind, $waMessageId]);
+    }
+
+    private static function uganda(array $config, ?string $dataDir): bool
+    {
+        if (!class_exists('StaffJobsGate')) require_once __DIR__ . '/StaffJobsGate.php';
+        return \StaffJobsGate::applies($config, $dataDir);
+    }
+
+    private static function lost(): void
+    {
+        try {
+            if (!class_exists('PluginLog')) require_once __DIR__ . '/PluginLog.php';
+            \PluginLog::write('wa_seen_marks', 'mark_write_lost');
+        } catch (\Throwable $e) { /* the webhook matters more than its mark */ }
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/WaSendBudget.php b/dishnet-hybrid-sudan/lib/WaSendBudget.php
new file mode 100644
index 0000000..f61f163
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/WaSendBudget.php
@@ -0,0 +1,791 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/StaffJobsGate.php';
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/PluginLog.php';
+require_once __DIR__ . '/VoiceAckLimits.php';
+require_once __DIR__ . '/ReminderDay.php';
+
+/**
+ * WaSendBudget — the one send ledger, one budget per HANDSET (5.18.104, root docs/73 §H.2.5; contract C3; rulings R2,
+ * R4, R18).
+ *
+ * A handset is an Evolution instance: support and account share one, and a channel id is never a handset. Every
+ * automated send that leaves a handset through the plugin goes into `wa_auto_sends` (migration 089) — except AI replies
+ * (D12: replies are not counted). The senders 5.18.104 adds CLAIM before they send and SETTLE after; the existing
+ * automated senders (the reminders, win-back, staff briefs, alerts, transactional messages) RECORD after they send:
+ * counted, never deferred, never refused (the hooks below).
+ *
+ *   claim(handset, kind, ref, o)  → ['ok'=>true,'claim'=>id] | ['ok'=>false,'defer'=>code,'retry_at'=>?int,'final'=>bool]
+ *   settle(claim, 'sent'|'failed', o)   — o: maybe_sent, wa_message_id, detail; never throws
+ *   record(handset, kind, ref, 'sent'|'failed', o) → recorded | ledger_off | not_uganda | no_table | error; never throws
+ *   counts(handset)               — for the tool, the checks and the report; needs no store
+ *
+ * One claim runs in one BEGIN IMMEDIATE, reads its clock once after taking the lock, and writes that moment as the
+ * row's claimed_at with the window and caps it applied (ruling R18). It fails closed: any exception is `ledger_error`
+ * and nothing is sent. Every handset argument is normalised here (handset()), every phone too (international digits,
+ * no '+', the tenant's rule; NULL when unreadable), so all callers land on the same rows.
+ *
+ * Inert unless on() — Uganda (StaffJobsGate, with the data directory) and `wa_send_ledger` = on. South Sudan never sets
+ * the key: every hook tests it first and does nothing at all. PHP 7.4.
+ */
+final class WaSendBudget
+{
+    /** The literal zone every window and day is computed in (R-16); dn_tz() must agree or a claim answers `zone`. */
+    public const TZ = 'Africa/Kampala';
+    /** The ten kinds, as 089's CHECK lists them. */
+    const KINDS = ['quote', 'enquiry', 'staff_list', 'offer', 'reminder', 'winback', 'brief', 'voice_ack', 'handover_alert', 'other'];
+    /** Counted against the daily and hourly caps, and kept apart by the spacing. */
+    const PROACTIVE = ['quote', 'enquiry', 'staff_list', 'offer', 'reminder', 'winback', 'brief'];
+    /** What may be claimed; everything else is recorded after the send. */
+    const CLAIMABLE = ['quote', 'enquiry', 'staff_list', 'offer', 'voice_ack'];
+    /** A claim of these needs the customer's phone (ruling R2: no_phone, final). */
+    const PHONE_KINDS = ['quote', 'enquiry', 'offer'];
+    /** The kinds the one-message-per-person-per-Kampala-day rule compares (R-06, S2-08). */
+    const PERSON_KINDS = ['quote', 'enquiry', 'offer', 'reminder', 'winback'];
+    /** C3's priority when the day's budget is short: quote > staff_list > enquiry > reminder/winback/brief > offer. */
+    const PRIORITY = ['quote' => 1, 'staff_list' => 2, 'enquiry' => 3, 'reminder' => 4, 'winback' => 4, 'brief' => 4, 'offer' => 5];
+    /** A claim in flight this long is an orphan: settled `uncertain`, counted as sent, never re-sent (F3, S2-17). */
+    const IN_FLIGHT_S = 900;
+    /** The proactive settings and their defaults (D12, D3); the tool's `set` holds their ranges (§H.2.5.6). */
+    const DEFAULTS = [
+        'wa_send_daily_cap'  => 60,
+        'wa_send_hourly_cap' => 15,
+        'wa_send_gap_min_s'  => 60,
+        'wa_send_gap_max_s'  => 180,
+        'wa_send_hour_from'  => 8,
+        'wa_send_hour_to'    => 20,
+    ];
+    /** The test seam for the channel-to-handset map (ruling R2: a callable is accepted for tests only). */
+    const TEST_SEAM_ENV = 'DN_WA_LEDGER_TEST_HANDSETS';
+
+    /**
+     * NotificationService events => the kind the record-only hook files them as (§H.2.6.1). Every other event is
+     * `other`: receipts, quotations, invoice, quotation and delivery PDFs, welcomes, admins' alerts, login codes,
+     * wa_media_ack. A test asserts each event below occurs as a literal at a send call in the tree.
+     */
+    const NOTIFY_KINDS = [
+        'ops_pre_due_d7'         => 'reminder',
+        'ops_pre_due_d3'         => 'reminder',
+        'ops_pre_due_d1'         => 'reminder',
+        'ops_overdue_d1'         => 'reminder',
+        'ops_overdue_d3'         => 'reminder',
+        'ops_overdue_d5'         => 'reminder',
+        'ops_low_balance'        => 'reminder',
+        'ops_win_back'           => 'winback',
+        'staff_jobs_summary'     => 'brief',
+        'staff_daily_report'     => 'brief',
+        'bidal_morning_summary'  => 'brief',
+        'cashbook_daily_summary' => 'brief',
+        'cash_carry_reminder'    => 'brief',
+    ];
+
+    /** @var \PDO|null */ private $pdo;
+    /** @var array */     private $config;
+    /** @var string|null */ private $dataDir;
+    /** @var object|null */ private $store;
+    /** @var callable|null */ private $handsetOf;
+    /** @var callable */  private $now;
+    /** @var callable */  private $rand;
+    /** @var bool */      private $connOnly = false;
+    /** @var array<string,string> */ private $chanMemo = [];
+    /** @var object|null */ private $evoMemo = null;
+    /** @var bool|null */ private $hasKindMemo = null;
+
+    private function __construct() {}
+
+    // ── construction ───────────────────────────────────────────────────────────────────────────────────────────
+
+    /** Uganda (StaffJobsGate, with the data directory) and `wa_send_ledger` = on. */
+    public static function on(array $config, ?string $dataDir): bool
+    {
+        return (string)($config['wa_send_ledger'] ?? '') === 'on' && StaffJobsGate::applies($config, $dataDir);
+    }
+
+    /** Idempotent: strip a leading 'i:', strtolower(trim()), re-prefix 'i:'; '' when blank. Never a channel id. */
+    public static function handset(string $instance): string
+    {
+        $s = strtolower(trim($instance));
+        if (strpos($s, 'i:') === 0) $s = trim(substr($s, 2));
+        return $s === '' ? '' : 'i:' . $s;
+    }
+
+    /**
+     * The ledger for an install: its store's connection, its master_schedule.json for ReminderDay, and the
+     * channel-to-handset map it derives itself (handset(EvolutionApiService::forStore(...)->instanceFor($ch))).
+     * $handsetOf, $now and $rand are test seams; $handsetOf is honoured only under TEST_SEAM_ENV (ruling R2).
+     */
+    public static function forInstall(array $config, ?string $dataDir, StoreInterface $store, ?callable $handsetOf = null,
+                                      ?callable $now = null, ?callable $rand = null): self
+    {
+        $b = new self();
+        $b->config  = $config;
+        $b->dataDir = ($dataDir !== null && $dataDir !== '') ? $dataDir : null;
+        $b->store   = $store;
+        $b->pdo     = method_exists($store, 'getPdo') ? $store->getPdo() : null;
+        $b->handsetOf = (getenv(self::TEST_SEAM_ENV) === '1') ? $handsetOf : null;
+        $b->now  = $now  ?? function (): int { return time(); };
+        $b->rand = $rand ?? function (int $a, int $b): int { return random_int($a, $b); };
+        return $b;
+    }
+
+    /**
+     * Over a connection the caller already holds, for a caller with no store (the tool's $ro and $rw, the report, the
+     * Starlink hook). counts(), settle() and record() work on it; claim() answers not_claimable, final, and inserts
+     * nothing — it holds no store for ReminderDay or the reservation.
+     */
+    public static function onConnection(\PDO $pdo, array $config, ?string $dataDir): self
+    {
+        $b = new self();
+        $b->config   = $config;
+        $b->dataDir  = ($dataDir !== null && $dataDir !== '') ? $dataDir : null;
+        $b->pdo      = $pdo;
+        $b->connOnly = true;
+        $b->now  = function (): int { return time(); };
+        $b->rand = function (int $a, int $b): int { return random_int($a, $b); };
+        return $b;
+    }
+
+    // ── settings ───────────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * The proactive window: [hour_from, hour_to] in Kampala, Monday to Saturday (Sunday is never open, D3). The values
+     * stored are returned as they are; 089's CHECK holds them to A19's narrow-only ranges (8-19, from+1-20), so a
+     * widened setting fails the claim's insert (`ledger_error`) and nothing is sent. An unreadable value reads 0.
+     *
+     * @return array{0:int,1:int}
+     */
+    public static function window(array $config): array
+    {
+        return [self::setting($config, 'wa_send_hour_from'), self::setting($config, 'wa_send_hour_to')];
+    }
+
+    /** voice_ack's window, gap and ceiling: a thin delegate to the one holder (ruling R4). Null = invalid. */
+    public static function ackPolicy(array $config): ?array
+    {
+        return VoiceAckLimits::of($config);
+    }
+
+    /** Whether enquiry follow-ups claim (the chase or offers is on) or record (§H.2.6.4). */
+    public static function enquiryClaims(array $config): bool
+    {
+        foreach (['quote_chase_enabled', 'offers_test_enabled', 'offers_live_enabled'] as $k) {
+            if (in_array(strtolower(trim((string)($config[$k] ?? ''))), ['1', 'true', 'on', 'yes'], true)) return true;
+        }
+        return false;
+    }
+
+    /** A proactive setting: its default when absent, the stored integer, or 0 when it cannot be read (fails closed). */
+    private static function setting(array $config, string $key): int
+    {
+        $raw = $config[$key] ?? null;
+        if ($raw === null || (is_string($raw) && trim($raw) === '')) return self::DEFAULTS[$key];
+        if (is_int($raw)) return $raw;
+        if (is_string($raw) && preg_match('/^\s*\d{1,6}\s*$/', $raw)) return (int)trim($raw);
+        return 0;
+    }
+
+    // ── claim ──────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * Ask before a send. Idempotent per (kind, ref). §H.2.5.3's steps, in one BEGIN IMMEDIATE.
+     *
+     * @param array $o phone (quote|enquiry|offer, required), in_flight_s (int 0-900, proactive kinds only)
+     * @return array ['ok'=>true,'claim'=>int] | ['ok'=>false,'defer'=>string,'retry_at'=>?int,'final'=>bool]
+     */
+    public function claim(string $handset, string $kind, string $ref, array $o = []): array
+    {
+        // 0. Refusals before anything else.
+        if ($this->connOnly) return self::no('not_claimable', null, true);
+        if (!self::on($this->config, $this->dataDir)) return self::no('ledger_off', null, true);
+        if (!in_array($kind, self::CLAIMABLE, true) || $ref === '') return self::no('not_claimable', null, true);
+        $inflight = 0;
+        if (array_key_exists('in_flight_s', $o)) {
+            $v = $o['in_flight_s'];
+            if ($kind === 'voice_ack' || !is_int($v) || $v < 0 || $v > self::IN_FLIGHT_S) return self::no('not_claimable', null, true);
+            $inflight = $v;
+        }
+        $h = self::handset($handset);
+        if ($h === '') return self::no('no_instance', null, true);
+        if (!function_exists('dn_tz')) require_once __DIR__ . '/timezone.php';
+        if (dn_tz($this->config) !== self::TZ) return self::no('zone', null, true);
+        $phone = null;
+        if (in_array($kind, self::PHONE_KINDS, true)) {
+            $phone = $this->phone((string)($o['phone'] ?? ''));
+            if ($phone === null) return self::no('no_phone', null, true);
+        }
+        if ($this->pdo === null) return self::no('ledger_error', time() + 300, false);
+
+        $pdo = $this->pdo;
+        $tx = false;
+        $now = time();
+        try {
+            $schedule = [];
+            if ($this->store !== null && in_array($kind, self::PHONE_KINDS, true)) {
+                $schedule = (array)($this->store->load('master_schedule.json') ?? []);
+            }
+            $this->txBegin(); $tx = true;
+            $now = (int)($this->now)();           // the claim's moment, read once with the lock held (ruling R18)
+            $day = self::localDay($now);
+            $proactive = in_array($kind, self::PROACTIVE, true);
+
+            // 1. Idempotency on the rows for (kind, ref).
+            $st = $pdo->prepare('SELECT id, outcome, claimed_at FROM wa_auto_sends WHERE kind = ? AND ref = ? ORDER BY try');
+            $st->execute([$kind, $ref]);
+            $notSent = 0;
+            foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+                $out = $r['outcome'];
+                if ($out === 'sent' || $out === 'uncertain') return $this->end(self::no('already_sent', null, true));
+                if ($out === null) {
+                    $at = UtcClock::parse($r['claimed_at']);
+                    if ($now - $at < self::IN_FLIGHT_S) return $this->end(self::no('in_flight', $at + self::IN_FLIGHT_S, false));
+                    $pdo->prepare("UPDATE wa_auto_sends SET outcome = 'uncertain', settled_at = ?, detail = 'stale'
+                                    WHERE id = ? AND outcome IS NULL")->execute([UtcClock::stamp($now), (int)$r['id']]);
+                    $this->txCommit(); $tx = false;
+                    return self::no('already_sent', null, true);
+                }
+                $notSent++;
+            }
+            $try = 1 + $notSent;
+            if ($try > 3) return $this->end(self::no('tries_exhausted', null, true));
+
+            // 2. The window, in a literal Africa/Kampala.
+            $pol = null;
+            if ($proactive) {
+                [$from, $to] = self::window($this->config);
+                $close = ReminderDay::todayAt($now, $to);
+                if (!self::inWindow($now, $from, $to) || $now + $inflight > $close) {
+                    return $this->end(self::no('window', self::nextOpening($now, $from), false));
+                }
+            } else {
+                $pol = self::ackPolicy($this->config);
+                if ($pol === null || !VoiceAckLimits::inWindow($pol, $now)) return $this->end(self::no('window', null, true));
+                [$from, $to] = [$pol['hour_from'], $pol['hour_to']];
+            }
+
+            // 3. Orphans on the handset, whatever their kind and ref; then one claim at a time.
+            $pdo->prepare("UPDATE wa_auto_sends SET outcome = 'uncertain', settled_at = ?, detail = 'stale_orphan'
+                            WHERE handset = ? AND outcome IS NULL AND claimed_at <= ?")
+                ->execute([UtcClock::stamp($now), $h, UtcClock::stamp($now - self::IN_FLIGHT_S)]);
+            $st = $pdo->prepare('SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND outcome IS NULL');
+            $st->execute([$h]);
+            if ((int)$st->fetchColumn() > 0) return $this->end(self::no('handset_busy', $now + 60, false));
+
+            // 4. Spacing, over every row on the handset of any kind and mode that is not `not_sent`.
+            if ($proactive) {
+                $st = $pdo->prepare("SELECT MAX(CAST(strftime('%s', claimed_at) AS INTEGER) + gap_s) FROM wa_auto_sends
+                                      WHERE handset = ? AND (outcome IS NULL OR outcome <> 'not_sent')");
+                $st->execute([$h]);
+                $until = (int)$st->fetchColumn();
+            } else {
+                $st = $pdo->prepare("SELECT MAX(CAST(strftime('%s', claimed_at) AS INTEGER)) FROM wa_auto_sends
+                                      WHERE handset = ? AND (outcome IS NULL OR outcome <> 'not_sent')");
+                $st->execute([$h]);
+                $last = $st->fetchColumn();
+                $until = $last === null || $last === false ? 0 : (int)$last + (int)$pol['gap_s'];
+            }
+            if ($now < $until) return $this->end(self::no('spacing', $until, false));
+
+            $capDay = null; $capHour = null;
+            if ($kind === 'voice_ack') {
+                // 5. voice_ack's own ceiling; the proactive caps, the reservation and the per-person rule do not apply.
+                $capDay = (int)$pol['daily_max'];
+                $st = $pdo->prepare("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND kind = 'voice_ack'
+                                      AND local_day = ? AND (outcome IS NULL OR outcome <> 'not_sent')");
+                $st->execute([$h, $day]);
+                if ((int)$st->fetchColumn() >= $capDay) return $this->end(self::no('ack_ceiling', null, true));
+            } else {
+                // 6. The hourly cap: proactive rows of any mode in the last 3,600 s.
+                $capHour = self::setting($this->config, 'wa_send_hourly_cap');
+                $st = $pdo->prepare("SELECT COUNT(*), MIN(CAST(strftime('%s', claimed_at) AS INTEGER)) FROM wa_auto_sends
+                                      WHERE handset = ? AND proactive = 1 AND claimed_at > ?
+                                        AND (outcome IS NULL OR outcome <> 'not_sent')");
+                $st->execute([$h, UtcClock::stamp($now - 3600)]);
+                $hr = $st->fetch(\PDO::FETCH_NUM);
+                if ((int)$hr[0] >= $capHour) return $this->end(self::no('hour_cap', (int)$hr[1] + 3600, false));
+
+                // 7. The daily cap, with the priority: what the kinds above this one still need today is reserved.
+                $capDay = self::setting($this->config, 'wa_send_daily_cap');
+                $st = $pdo->prepare("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND proactive = 1 AND local_day = ?
+                                       AND (outcome IS NULL OR outcome <> 'not_sent')");
+                $st->execute([$h, $day]);
+                $used = (int)$st->fetchColumn();
+                $reserve = $this->reserve($kind, $h, $now, $day);
+                if ($used + $reserve + 1 > $capDay) {
+                    return $this->end(self::no($reserve > 0 ? 'reserved' : 'day_cap', self::nextDayOpening($now, $from), false));
+                }
+
+                // 8. One automated customer message per person per Kampala day, both ways.
+                if (in_array($kind, self::PHONE_KINDS, true)) {
+                    $st = $pdo->prepare("SELECT COUNT(*) FROM wa_auto_sends WHERE phone = ? AND local_day = ?
+                                           AND kind IN ('quote','enquiry','offer','reminder','winback')
+                                           AND (outcome IS NULL OR outcome <> 'not_sent')
+                                           AND NOT (kind = ? AND ref = ?)");
+                    $st->execute([$phone, $day, $kind, $ref]);
+                    if ((int)$st->fetchColumn() > 0) return $this->end(self::no('phone_today', self::nextDayOpening($now, $from), false));
+                    if (!ReminderDay::done($schedule, $this->config, $this->dataDir, $now)) {
+                        [, $until2] = ReminderDay::hours($this->config);
+                        return $this->end(self::no('reminders_first', min($now + 600, ReminderDay::todayAt($now, $until2)), false));
+                    }
+                }
+            }
+
+            // 9. The row: the claim's moment and the limits it applied (ruling R18).
+            $gapMin = self::setting($this->config, 'wa_send_gap_min_s');
+            $gapMax = self::setting($this->config, 'wa_send_gap_max_s');
+            if ($gapMin < 30 || $gapMin > 600 || $gapMax < $gapMin || $gapMax > 900) {
+                return $this->end(self::no('ledger_error', $now + 300, false));   // spacing narrower than A19 allows
+            }
+            $gap = $proactive ? (int)($this->rand)($gapMin, $gapMax) : $gapMin;
+            try {
+                $pdo->prepare('INSERT INTO wa_auto_sends (handset, kind, ref, try, mode, proactive, phone, local_day, gap_s,
+                                                          claimed_at, win_from, win_to, cap_day, cap_hour)
+                               VALUES (?, ?, ?, ?, \'claim\', ?, ?, ?, ?, ?, ?, ?, ?, ?)')
+                    ->execute([$h, $kind, $ref, $try, $proactive ? 1 : 0, $phone, $day, $gap, UtcClock::stamp($now),
+                               $from, $to, $capDay, $capHour]);
+            } catch (\PDOException $e) {
+                if (stripos($e->getMessage(), 'UNIQUE constraint') !== false) return $this->end(self::no('in_flight', $now + 60, false));
+                throw $e;
+            }
+            $id = (int)$pdo->lastInsertId();
+            $this->txCommit(); $tx = false;
+            return ['ok' => true, 'claim' => $id];
+        } catch (\Throwable $e) {
+            if ($tx) { try { $pdo->exec('ROLLBACK'); } catch (\Throwable $e2) { /* nothing held */ } }
+            $this->inTx = false;
+            return self::no('ledger_error', $now + 300, false);
+        }
+    }
+
+    /** @var bool */ private $inTx = false;
+
+    private function txBegin(): void
+    {
+        $this->pdo->exec('BEGIN IMMEDIATE'); $this->inTx = true;
+    }
+
+    private function txCommit(): void
+    {
+        if ($this->inTx) { $this->inTx = false; $this->pdo->exec('COMMIT'); }
+    }
+
+    /** Leave the transaction without writing, and answer. */
+    private function end(array $answer): array
+    {
+        if ($this->inTx) { $this->inTx = false; $this->pdo->exec('ROLLBACK'); }
+        return $answer;
+    }
+
+    private static function no(string $code, ?int $retryAt, bool $final): array
+    {
+        return ['ok' => false, 'defer' => $code, 'retry_at' => $final ? null : $retryAt, 'final' => $final];
+    }
+
+    // ── settle and record ──────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * After the send. 'sent' → sent; 'failed' with maybe_sent → uncertain (counted, never retried; ruling R2);
+     * 'failed' → not_sent (the next claim of the ref takes try + 1). A row already settled — by the orphan sweep —
+     * matches nothing: one `late_settle` line, and the earlier `uncertain` stands. Never throws into the sender.
+     */
+    public function settle(int $claim, string $result, array $o = []): void
+    {
+        $n = -1;
+        try {
+            if ($this->pdo === null) return;
+            $outcome = self::outcomeOf($result, $o);
+            $now = (int)($this->now)();
+            $st = $this->pdo->prepare('UPDATE wa_auto_sends SET outcome = ?, settled_at = ?, wa_message_id = ?, detail = ?
+                                        WHERE id = ? AND outcome IS NULL');
+            $st->execute([$outcome, UtcClock::stamp($now), self::waId($o), self::detail($o), $claim]);
+            $n = $st->rowCount();
+        } catch (\Throwable $e) {
+            PluginLog::write('wa_send_ledger', 'settle_lost');
+            return;
+        }
+        if ($n === 0) PluginLog::write('wa_send_ledger', 'late_settle');   // already settled (the sweep's uncertain stands)
+    }
+
+    /**
+     * After a send the hook did not claim: an INSERT OR IGNORE of a settled row, mode `record`, none of the four limits.
+     * Takes $result and $o exactly as settle() does, plus $o['phone'] (normalised here). Never throws, never refuses.
+     *
+     * @return string recorded | ledger_off | not_uganda | no_table | error
+     */
+    public function record(string $handset, string $kind, string $ref, string $result, array $o = []): string
+    {
+        $lineKind = in_array($kind, self::KINDS, true) ? $kind : 'other';
+        try {
+            if ((string)($this->config['wa_send_ledger'] ?? '') !== 'on') return 'ledger_off';
+            if (!StaffJobsGate::applies($this->config, $this->dataDir)) return 'not_uganda';
+            if ($this->pdo === null || !self::hasTable($this->pdo, 'wa_auto_sends')) return 'no_table';
+            $h = self::handset($handset);
+            if ($h === '' || $lineKind !== $kind || $ref === '') return 'error';
+            $now = (int)($this->now)();
+            $phone = isset($o['phone']) ? $this->phone((string)$o['phone']) : null;
+            $gap = self::setting($this->config, 'wa_send_gap_min_s');
+            if ($gap < 0 || $gap > self::IN_FLIGHT_S) $gap = self::DEFAULTS['wa_send_gap_min_s'];
+            $st = $this->pdo->prepare('INSERT OR IGNORE INTO wa_auto_sends (handset, kind, ref, try, mode, proactive, phone,
+                                          local_day, gap_s, claimed_at, outcome, settled_at, wa_message_id, detail)
+                                       VALUES (?, ?, ?, 1, \'record\', ?, ?, ?, ?, ?, ?, ?, ?, ?)');
+            $st->execute([$h, $kind, $ref, in_array($kind, self::PROACTIVE, true) ? 1 : 0, $phone, self::localDay($now), $gap,
+                          UtcClock::stamp($now), self::outcomeOf($result, $o), UtcClock::stamp($now), self::waId($o), self::detail($o)]);
+            if ($st->rowCount() === 1) return 'recorded';
+            $chk = $this->pdo->prepare('SELECT COUNT(*) FROM wa_auto_sends WHERE kind = ? AND ref = ? AND handset = ?');
+            $chk->execute([$kind, $ref, $h]);
+            if ((int)$chk->fetchColumn() > 0) return 'recorded';   // the same message, recorded once already
+            PluginLog::write('wa_send_ledger', 'hook_write_lost ' . $lineKind);
+            return 'error';
+        } catch (\Throwable $e) {
+            PluginLog::write('wa_send_ledger', 'hook_write_lost ' . $lineKind);
+            return 'error';
+        }
+    }
+
+    private static function outcomeOf(string $result, array $o): string
+    {
+        if ($result === 'sent') return 'sent';
+        if ($result === 'failed') return !empty($o['maybe_sent']) ? 'uncertain' : 'not_sent';
+        return 'uncertain';   // an unknown result is never read as not sent
+    }
+
+    private static function waId(array $o): ?string
+    {
+        $id = trim((string)($o['wa_message_id'] ?? ''));
+        return $id === '' ? null : mb_substr($id, 0, 200);
+    }
+
+    private static function detail(array $o): ?string
+    {
+        $d = (string)preg_replace('/[^A-Za-z0-9_:.-]/', '', (string)($o['detail'] ?? ''));
+        return $d === '' ? null : substr($d, 0, 60);
+    }
+
+    // ── counts ─────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** Per handset: what §H.2.5.7 lists. Reads only; needs no store. */
+    public function counts(string $handset): array
+    {
+        $h = self::handset($handset);
+        $now = (int)($this->now)();
+        $day = self::localDay($now);
+        [$from, $to] = self::window($this->config);
+        $pol = self::ackPolicy($this->config);
+        $out = [
+            'table' => 0, 'proactive_today' => 0, 'cap_day' => self::setting($this->config, 'wa_send_daily_cap'),
+            'proactive_hour' => 0, 'cap_hour' => self::setting($this->config, 'wa_send_hourly_cap'),
+            'record_proactive_today' => 0, 'voice_ack_today' => 0, 'voice_ack_ceiling' => $pol === null ? 0 : (int)$pol['daily_max'],
+            'internal_today' => 0, 'total_today' => 0, 'in_flight' => 0, 'orphans_today' => 0, 'next_proactive_at' => 0,
+        ];
+        if ($this->pdo === null || $h === '' || !self::hasTable($this->pdo, 'wa_auto_sends')) return $out;
+        $out['table'] = 1;
+        $live = "(outcome IS NULL OR outcome <> 'not_sent')";
+        $one = function (string $sql, array $args) {
+            $st = $this->pdo->prepare($sql);
+            $st->execute($args);
+            return $st->fetchColumn();
+        };
+        $out['proactive_today'] = (int)$one("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND proactive = 1 AND local_day = ? AND {$live}", [$h, $day]);
+        $out['proactive_hour']  = (int)$one("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND proactive = 1 AND claimed_at > ? AND {$live}", [$h, UtcClock::stamp($now - 3600)]);
+        $out['record_proactive_today'] = (int)$one("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND proactive = 1 AND mode = 'record' AND local_day = ? AND {$live}", [$h, $day]);
+        $out['voice_ack_today'] = (int)$one("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND kind = 'voice_ack' AND local_day = ? AND {$live}", [$h, $day]);
+        $out['internal_today']  = (int)$one("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND kind IN ('handover_alert','other') AND local_day = ? AND {$live}", [$h, $day]);
+        $out['total_today']     = (int)$one("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND local_day = ? AND {$live}", [$h, $day]);
+        $out['in_flight']       = (int)$one('SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND outcome IS NULL', [$h]);
+        $out['orphans_today']   = (int)$one("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND detail = 'stale_orphan' AND settled_at >= ?", [$h, UtcClock::stamp(ReminderDay::todayAt($now, 0))]);
+        // The next allowed proactive moment: the window, the spacing and the two caps.
+        $next = $now;
+        $space = (int)$one("SELECT MAX(CAST(strftime('%s', claimed_at) AS INTEGER) + gap_s) FROM wa_auto_sends WHERE handset = ? AND {$live}", [$h]);
+        $next = max($next, $space);
+        if ($out['proactive_hour'] >= $out['cap_hour']) {
+            $oldest = (int)$one("SELECT MIN(CAST(strftime('%s', claimed_at) AS INTEGER)) FROM wa_auto_sends WHERE handset = ? AND proactive = 1 AND claimed_at > ? AND {$live}", [$h, UtcClock::stamp($now - 3600)]);
+            $next = max($next, $oldest + 3600);
+        }
+        if ($out['proactive_today'] >= $out['cap_day']) $next = max($next, self::nextDayOpening($now, $from));
+        if (!self::inWindow($next, $from, $to)) $next = self::nextOpening($next, $from);
+        $out['next_proactive_at'] = $next;
+        return $out;
+    }
+
+    // ── the priority (C3, §H.2.5.4) ────────────────────────────────────────────────────────────────────────────
+
+    /** The demand, on this handset today, of every kind above $kind. */
+    private function reserve(string $kind, string $h, int $now, string $day): int
+    {
+        $p = self::PRIORITY[$kind] ?? 0;
+        $sum = 0;
+        if ($p > 1) $sum += $this->demandQuote($h, $now);
+        if ($p > 2) $sum += $this->demandList($h, $now);
+        if ($p > 3) $sum += $this->demandEnquiry($h);
+        if ($p > 4) $sum += $this->demandRecorded($h, $now, $day);
+        return $sum;
+    }
+
+    /** Open quote follow-ups due by the window's close today, on a channel of this handset. */
+    private function demandQuote(string $h, int $now): int
+    {
+        if (!$this->hasKind()) return 0;
+        [, $to] = self::window($this->config);
+        $st = $this->pdo->prepare("SELECT channel, COUNT(*) AS n FROM followups
+                                    WHERE closed_at IS NULL AND kind = 'quote' AND due_at IS NOT NULL AND due_at <= ?
+                                    GROUP BY channel");
+        $st->execute([UtcClock::stamp(ReminderDay::todayAt($now, $to))]);
+        $n = 0;
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            if ($this->handsetOfChannel((string)$r['channel']) === $h) $n += (int)$r['n'];
+        }
+        return $n;
+    }
+
+    /**
+     * On the sales handset, before 11:00 with the list on: the owners still to be sent today. Asked of
+     * QuoteDailyList::pendingToday(\PDO, array $config, ?string $dataDir, int $now): array, once that class exists.
+     */
+    private function demandList(string $h, int $now): int
+    {
+        if ($this->handsetOfChannel('sales') !== $h) return 0;
+        if (!in_array(strtolower(trim((string)($this->config['quote_daily_list_enabled'] ?? ''))), ['1', 'true', 'on', 'yes'], true)) return 0;
+        if ((int)self::local($now)->format('G') >= 11) return 0;
+        if (!class_exists('QuoteDailyList')) {
+            if (!is_file(__DIR__ . '/QuoteDailyList.php')) return 0;
+            require_once __DIR__ . '/QuoteDailyList.php';
+        }
+        if (!method_exists('QuoteDailyList', 'pendingToday')) return 0;
+        $p = \QuoteDailyList::pendingToday($this->pdo, $this->config, $this->dataDir, $now);
+        return is_array($p) ? count($p) : max(0, (int)$p);
+    }
+
+    /** Approved enquiry drafts on this handset, while enquiry claims. */
+    private function demandEnquiry(string $h): int
+    {
+        if (!self::enquiryClaims($this->config)) return 0;
+        $kind = $this->hasKind() ? " AND COALESCE(f.kind,'enquiry') = 'enquiry'" : '';
+        $st = $this->pdo->query("SELECT f.channel, COUNT(*) AS n FROM followup_drafts d JOIN followups f ON f.id = d.followup_id
+                                  WHERE d.status = 'approved' AND f.closed_at IS NULL{$kind} GROUP BY f.channel");
+        $n = 0;
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            if ($this->handsetOfChannel((string)$r['channel']) === $h) $n += (int)$r['n'];
+        }
+        return $n;
+    }
+
+    /**
+     * Reserved for offers only: before reminder_until_hour, and with none of reminder, winback or brief recorded today on
+     * this handset, the largest daily count of them over the previous 7 Kampala days; otherwise 0.
+     */
+    private function demandRecorded(string $h, int $now, string $day): int
+    {
+        [, $until] = ReminderDay::hours($this->config);
+        if ((int)self::local($now)->format('G') >= $until) return 0;
+        $st = $this->pdo->prepare("SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND local_day = ?
+                                     AND kind IN ('reminder','winback','brief')");
+        $st->execute([$h, $day]);
+        if ((int)$st->fetchColumn() > 0) return 0;
+        $days = [];
+        for ($i = 1; $i <= 7; $i++) $days[] = self::localDay($now - $i * 86400);
+        $in = implode(',', array_fill(0, count($days), '?'));
+        $st = $this->pdo->prepare("SELECT MAX(n) FROM (SELECT local_day, COUNT(*) AS n FROM wa_auto_sends
+                                     WHERE handset = ? AND kind IN ('reminder','winback','brief') AND local_day IN ({$in})
+                                       AND (outcome IS NULL OR outcome <> 'not_sent')
+                                     GROUP BY local_day)");
+        $st->execute(array_merge([$h], $days));
+        return (int)$st->fetchColumn();
+    }
+
+    /** The handset a channel's sends leave from: derived here, never taken from a caller outside tests (ruling R2). */
+    private function handsetOfChannel(string $channel): string
+    {
+        if (isset($this->chanMemo[$channel])) return $this->chanMemo[$channel];
+        if ($this->handsetOf !== null) {
+            return $this->chanMemo[$channel] = self::handset((string)($this->handsetOf)($channel));
+        }
+        if ($this->evoMemo === null) {
+            if (!class_exists('EvolutionApiService')) require_once __DIR__ . '/EvolutionApiService.php';
+            $this->evoMemo = \EvolutionApiService::forStore($this->config, $this->pdo, $this->dataDir);
+        }
+        return $this->chanMemo[$channel] = self::handset((string)$this->evoMemo->instanceFor($channel));
+    }
+
+    private function hasKind(): bool
+    {
+        if ($this->hasKindMemo === null) {
+            $this->hasKindMemo = false;
+            foreach ($this->pdo->query('PRAGMA table_info(followups)')->fetchAll(\PDO::FETCH_ASSOC) as $c) {
+                if (($c['name'] ?? '') === 'kind') $this->hasKindMemo = true;
+            }
+        }
+        return $this->hasKindMemo;
+    }
+
+    // ── the phone, the day, the window ─────────────────────────────────────────────────────────────────────────
+
+    /** International digits, no '+', by the tenant's rule (PhoneNumber::international); null when it does not normalise. */
+    private function phone(string $raw): ?string
+    {
+        if (trim($raw) === '') return null;
+        try {
+            if (!class_exists('PhoneNumber')) require_once __DIR__ . '/PhoneNumber.php';
+            if (!class_exists('TenantProfile')) require_once __DIR__ . '/TenantProfile.php';
+            $intl = \PhoneNumber::international($raw, \TenantProfile::current($this->config, $this->dataDir));
+            return $intl === null ? null : ltrim($intl, '+');
+        } catch (\Throwable $e) {
+            return null;
+        }
+    }
+
+    private static function local(int $t): \DateTime
+    {
+        return (new \DateTime('@' . $t))->setTimezone(new \DateTimeZone(self::TZ));
+    }
+
+    /** The Kampala date of $t. */
+    public static function localDay(int $t): string
+    {
+        return self::local($t)->format('Y-m-d');
+    }
+
+    /** Monday to Saturday, from <= hour < to, in a literal Africa/Kampala. */
+    private static function inWindow(int $t, int $from, int $to): bool
+    {
+        $l = self::local($t);
+        if ((int)$l->format('N') === 7) return false;
+        $hour = (int)$l->format('G');
+        return $hour >= $from && $hour < $to;
+    }
+
+    /** The next opening: today's hour_from if it is still to come on an open day, else the next open day's. */
+    private static function nextOpening(int $t, int $from): int
+    {
+        $l = self::local($t);
+        if ((int)$l->format('N') !== 7 && (int)$l->format('G') < $from) return ReminderDay::todayAt($t, $from);
+        return self::nextDayOpening($t, $from);
+    }
+
+    /** hour_from on the next open day after today (Sunday is never open). */
+    private static function nextDayOpening(int $t, int $from): int
+    {
+        $d = ReminderDay::todayAt($t, 0);
+        for ($i = 1; $i <= 8; $i++) {
+            $day = $d + $i * 86400;
+            if ((int)self::local($day + 3600)->format('N') !== 7) return $day + $from * 3600;
+        }
+        return $d + 86400 + $from * 3600;
+    }
+
+    private static function hasTable(\PDO $pdo, string $name): bool
+    {
+        $st = $pdo->prepare("SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = ?");
+        $st->execute([$name]);
+        return (int)$st->fetchColumn() > 0;
+    }
+
+    // ── the record-only hooks (§H.2.6) ─────────────────────────────────────────────────────────────────────────
+
+    /**
+     * NotificationService's three hooks, after an Evolution send. A person's event (the Inbox's) returns at once: a
+     * person's send is never filed as automation. The handset is evo_instance_<channel>, the one the send used; the
+     * phone is kept for reminder and winback only. record()'s answer is ignored; a lost write leaves one line.
+     */
+    public static function recordNotify($store, array $config, string $channel, string $event, string $to, bool $success,
+                                        string $error, string $raw): void
+    {
+        if (!class_exists('HumanTakeover')) require_once __DIR__ . '/HumanTakeover.php';
+        if (in_array($event, HumanTakeover::personEvents(), true)) return;
+        $kind = self::NOTIFY_KINDS[$event] ?? 'other';
+        try {
+            if ((string)($config['wa_send_ledger'] ?? '') !== 'on') return;
+            $dataDir = (is_object($store) && method_exists($store, 'getDataDir')) ? (string)$store->getDataDir() : null;
+            if (!StaffJobsGate::applies($config, $dataDir)) return;
+            $res = json_decode($raw, true);
+            $waId = is_array($res) ? (string)($res['data']['key']['id'] ?? ($res['key']['id'] ?? '')) : '';
+            $ref = $waId !== '' ? 'n:' . $waId : 'n:x' . sha1($event . '|' . $to . '|' . microtime(true) . '|' . bin2hex(random_bytes(8)));
+            if (!class_exists('EvolutionApiService')) require_once __DIR__ . '/EvolutionApiService.php';
+            $o = ['wa_message_id' => $waId, 'maybe_sent' => !$success && \EvolutionApiService::mayHaveBeenSent($error)];
+            if ($kind === 'reminder' || $kind === 'winback') $o['phone'] = $to;
+            $b = self::onConnection($store->getPdo(), $config, $dataDir);
+            $b->record((string)($config['evo_instance_' . $channel] ?? ''), $kind, $ref, $success ? 'sent' : 'failed', $o);
+        } catch (\Throwable $e) {
+            PluginLog::write('wa_send_ledger', 'hook_write_lost ' . $kind);
+        }
+    }
+
+    /**
+     * A send WASender carried (no handset, so no ledger row): one more on the day's content-free count
+     * `wasender:<local_day>:<kind>` in quote_followup_state, in one statement, for L-ON to tell the transports apart.
+     */
+    public static function countWasender($store, array $config, string $event): void
+    {
+        if (!class_exists('HumanTakeover')) require_once __DIR__ . '/HumanTakeover.php';
+        if (in_array($event, HumanTakeover::personEvents(), true)) return;
+        $kind = self::NOTIFY_KINDS[$event] ?? 'other';
+        try {
+            if ((string)($config['wa_send_ledger'] ?? '') !== 'on') return;
+            $dataDir = (is_object($store) && method_exists($store, 'getDataDir')) ? (string)$store->getDataDir() : null;
+            if (!StaffJobsGate::applies($config, $dataDir)) return;
+            self::bump($store->getPdo(), 'wasender:' . self::localDay(time()) . ':' . $kind);
+        } catch (\Throwable $e) {
+            PluginLog::write('wa_send_ledger', 'hook_write_lost ' . $kind);
+        }
+    }
+
+    /**
+     * AlertService's hook, after sendText on `sales`. handover_alert for an `escalate:` key, other for every other. No
+     * phone is kept. A blank sales instance cannot hold a row (089's CHECK): then no record(), and, when the answer
+     * carries `http`, one more on `noinstance:<local_day>:<kind>`.
+     */
+    public static function recordAlert($store, array $config, $evo, string $key, $r): void
+    {
+        $kind = strpos($key, 'escalate:') === 0 ? 'handover_alert' : 'other';
+        try {
+            if ((string)($config['wa_send_ledger'] ?? '') !== 'on') return;
+            $dataDir = (is_object($store) && method_exists($store, 'getDataDir')) ? (string)$store->getDataDir() : null;
+            if (!StaffJobsGate::applies($config, $dataDir)) return;
+            $inst = (is_object($evo) && method_exists($evo, 'instanceFor')) ? (string)$evo->instanceFor('sales') : '';
+            if (self::handset($inst) === '') {
+                if (is_array($r) && array_key_exists('http', $r)) self::bump($store->getPdo(), 'noinstance:' . self::localDay(time()) . ':' . $kind);
+                return;
+            }
+            $waId = is_array($r) ? (string)($r['data']['key']['id'] ?? ($r['key']['id'] ?? '')) : '';
+            $ref = $waId !== '' ? 'a:' . $waId : 'a:x' . sha1($key . '|' . microtime(true) . '|' . bin2hex(random_bytes(8)));
+            $ok = is_array($r) && !empty($r['ok']);
+            if (!class_exists('EvolutionApiService')) require_once __DIR__ . '/EvolutionApiService.php';
+            $o = ['wa_message_id' => $waId, 'maybe_sent' => !$ok && is_array($r) && \EvolutionApiService::mayHaveBeenSent($r)];
+            self::onConnection($store->getPdo(), $config, $dataDir)->record($inst, $kind, $ref, $ok ? 'sent' : 'failed', $o);
+        } catch (\Throwable $e) {
+            PluginLog::write('wa_send_ledger', 'hook_write_lost ' . $kind);
+        }
+    }
+
+    /**
+     * A sender that holds no store and sends with $evo->sendText itself (StarlinkMailWorker): the ledger over its own
+     * PDO, record() only. $dataDir is how the sender finds it; StaffJobsGate needs it to read the tenant.
+     */
+    public static function recordDirect(\PDO $pdo, array $config, ?string $dataDir, $evo, string $channel, string $kind,
+                                        string $prefix, $r): void
+    {
+        $lineKind = in_array($kind, self::KINDS, true) ? $kind : 'other';
+        try {
+            if ((string)($config['wa_send_ledger'] ?? '') !== 'on') return;
+            if (!StaffJobsGate::applies($config, $dataDir)) return;
+            $inst = (is_object($evo) && method_exists($evo, 'instanceFor')) ? (string)$evo->instanceFor($channel) : '';
+            $waId = is_array($r) ? (string)($r['data']['key']['id'] ?? ($r['key']['id'] ?? '')) : '';
+            $ref = $prefix . ':' . ($waId !== '' ? $waId : 'x' . sha1($channel . '|' . microtime(true) . '|' . bin2hex(random_bytes(8))));
+            $ok = is_array($r) ? (!empty($r['ok']) || (!isset($r['ok']) && empty($r['error']) && empty($r['suppressed']))) : (bool)$r;
+            if (!class_exists('EvolutionApiService')) require_once __DIR__ . '/EvolutionApiService.php';
+            $o = ['wa_message_id' => $waId, 'maybe_sent' => !$ok && is_array($r) && \EvolutionApiService::mayHaveBeenSent($r)];
+            self::onConnection($pdo, $config, $dataDir)->record($inst, $kind, $ref, $ok ? 'sent' : 'failed', $o);
+        } catch (\Throwable $e) {
+            PluginLog::write('wa_send_ledger', 'hook_write_lost ' . $lineKind);
+        }
+    }
+
+    /** One more on a content-free count in quote_followup_state, in one statement (two processes never lose one). */
+    private static function bump(\PDO $pdo, string $k): void
+    {
+        if (!self::hasTable($pdo, 'quote_followup_state')) return;
+        $pdo->prepare("INSERT INTO quote_followup_state (k, v) VALUES (?, '1')
+                       ON CONFLICT(k) DO UPDATE SET v = CAST(CAST(v AS INTEGER) + 1 AS TEXT), updated_at = datetime('now')")
+            ->execute([$k]);
+    }
+}
