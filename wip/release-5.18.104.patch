+                  $state($b, $v['conv']) === 'needs_human', count(vm_texts($evo))], ['dead', 'dead', 0, false, 0],
+                 'C06 R1: the event dead, the row dead, nobody told, no needs_human');
+        $b3 = vm_book($ctx, vm_cfg($evo, vm_rung('handover')));
+        $v3 = vm_voice($b3, '256771300116');
