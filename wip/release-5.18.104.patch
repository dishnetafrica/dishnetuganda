+<?php
+declare(strict_types=1);
+/**
+ * Section I of tests/test_quote_followup.php — the templates (5.18.104, root docs/73 §H.2.10.4, §H.2.10.8, §H.2.14 I; root
+ * docs/72 §H.1, D9; K2-20, gate B-1). TEST ONLY.
