+    $ctx->eq(array_slice($nc, -5), array_merge(array_map('trim', MS_LINES), ['];']), 'A05 they are the last four non-comment lines of $_m_jobs before its close (what OfferSwitch\'s P-O1-6 reads)');
+    foreach (MS_JOBS as $i => $j) {
+        $l = (string)($jobs[$j] ?? '');
