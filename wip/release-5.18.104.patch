+        $vLine = "        if(m.voice_transcript){ body+='<div class=\"wai-voice-tx\"><b>[voice message \\u2014 machine transcript for staff, check it against the audio]</b> '+esc(m.voice_transcript).replace(/\\n/g,'<br>')+'</div>'; }\n";
