+        $found['team_message'] = $q("SELECT DISTINCT c.phone FROM wa_messages m JOIN wa_conversations c ON c.id = m.conversation_id
+                                      WHERE {$staffOut} AND m.direction = 'out' AND m.role = 'agent' AND m.agent_name = 'Team'
