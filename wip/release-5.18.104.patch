+                  ['HumanTakeover', 'phoneSince'], ['ReminderDay', 'done'], ['JobBudget', 'seconds'], ['JobBudget', 'mayStart']] as [$cl, $m]) {
+            if (!class_exists($cl) || !method_exists($cl, $m)) return $cl . '::' . $m;
