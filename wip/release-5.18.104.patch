+/** A PDO whose exec() answers 089's self-check INSERT with an error of a class the test names (the class 089 cannot raise). */
+final class QaClassPdo extends \PDO
+{
+    public $raise = '';
+    #[\ReturnTypeWillChange]
+    public function exec($statement)
