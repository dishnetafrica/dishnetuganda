+<?php
+declare(strict_types=1);
+/**
+ * Section H of tests/test_quote_followup.php — STOP, the kill switch and the enquiry engine (5.18.104, root docs/73
+ * §H.2.10.7, §H.2.3 (b), (f), (g), §H.2.14 H; F1, R-11, R104-02, K2-22, S2-19). TEST ONLY.
