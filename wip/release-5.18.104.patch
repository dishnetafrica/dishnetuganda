+                $r = $m(ogg_opus(['seconds' => $secs, 'frame_ms' => $ms, 'toc' => $toc]));
+                $ctx->eq([$r['ok'], $r['seconds']], [true, round($secs - 312 / 48000, 3)], 'A02 ' . $label);
