+            $ctx->eq([$rc, $svc->get((int)$e['id'])['close_reason'], $q > 0 ? $svc->get($q)['closed_at'] : null, $quoteEvents],
+                     [0, 'cancelled', null, $q > 0 ? ['created'] : []],
