diff --git a/dishnet-hybrid-sudan/lib/QuoteAgentCopy.php b/dishnet-hybrid-sudan/lib/QuoteAgentCopy.php
new file mode 100644
index 0000000..003f971
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/QuoteAgentCopy.php
@@ -0,0 +1,720 @@
+<?php
+declare(strict_types=1);
+/**
+ * QuoteAgentCopy — 5.18.104 Part P (P7, decision D16; root docs/73 §H.5): the agent who made a quote gets a visible
+ * copy (Cc) of the quotation e-mail the PLUGIN sends — in the same message, never a second one.
+ *
+ * Uganda only, behind its own switch (quote_agent_cc_enabled, OFF until `tools/sales_followup.php on agent-cc`). Every
+ * caller asks StaffJobsGate before it loads this file, so South Sudan never loads it; state() asks again (the second
+ * lock). Every caller wraps every call in its own try/catch and falls back to 5.18.103's values, and this class still
+ * catches inside: a P7 fault can never stop, change or double a quotation e-mail (P-D8).
+ *
+ *   the gate        state(), on(): the switch, the administrators' setting and automatic quoting, on the read the
+ *                   send takes there (PluginConfig::read; ruling R19). False on any doubt.
+ *   plugin mail     mailSetting(), preconditions(): email_settings.json alone, never MailService (which would ask uCRM).
+ *   the rules       usableAddress(), toOf(), lineFits(), decide(), mergeCc(), skipped(), rcptOutcome(), afterSend(),
+ *                   kycInFlight(), notesMark(), webhookAgent(), accountCounts(): pure, no I/O.
+ *   resolution      forActor() (the app path), forWebhook() (the webhook path): reads only; null while P7 is off.
+ *   records         markMaking(), markResult() (the maker hand-off, §H.5.5) and record() (one decision per composed
+ *                   e-mail): ids, quote numbers, fixed codes and times only — never an address, a name or a phone.
+ *   the check       check(): AC-ON, read-only over the tool's read-only connection (ruling R13), judging each decision
+ *                   only by what its own row recorded (ruling R18).
+ *
+ * "The agent" of a KYC quote is Part F's owner rule 1, QuoteSendEvidence::kycAgent() (IP-1): one function, so the
+ * daily list and the copy mean the same account. PHP 7.4.
+ */
+final class QuoteAgentCopy
+{
+    public const KEY    = 'quote_agent_cc_enabled';
+    public const SINCE  = 'quote_agent_cc_since';
+    public const ADMINS = 'quote_agent_cc_admins';
+
+    /** KycService::QUOTE_CLAIM_SECONDS (lib/KycService.php:2043); quote_agent_copy A6 asserts the two equal. */
+    public const IN_FLIGHT_SECONDS = 900;
+    /** RFC 5322's line limit: extra headers go out raw and unfolded (lib/MailService.php:630-633). */
+    public const CC_LINE_MAX = 998;
+
+    public const MAKERS    = 'quote_agent_makers.json';
+    public const DECISIONS = 'quote_agent_copies.json';
+
+    public const CODES = ['added', 'already_copied', 'no_agent', 'agent_ambiguous', 'agent_unknown_id', 'agent_inactive',
+        'admin_account', 'agent_no_email', 'agent_email_invalid', 'customer_unread', 'same_as_customer', 'header_too_long',
+        'not_composed', 'error'];
+    public const FLOOR_CODES = ['agent_email_invalid', 'same_as_customer', 'already_copied', 'header_too_long', 'error'];
+    public const SOURCES = ['actor', 'first_decision', 'maker', 'maker_in_flight', 'kyc', 'kyc_in_flight', 'in_flight', 'none'];
+    public const RULES   = ['', 'kyc_sales_person', 'kyc_submitter'];
+    public const RCPTS   = ['accepted', 'refused', 'none', 'excluded'];
+    public const PATHS   = ['plugin', 'webhook'];
+
+    /** AC-ON's margins around the window (§H.5.10.4 rule 3). */
+    private const MARGIN = 300;
+
+    // ── the gate ─────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** @return array{on:bool, admins:bool, auto_quote:bool} */
+    public static function state(string $pluginRoot, string $dataDir): array
+    {
+        $off = ['on' => false, 'admins' => false, 'auto_quote' => false];
+        try {
+            if (!class_exists('PluginConfig'))  require_once __DIR__ . '/PluginConfig.php';
+            if (!class_exists('StaffJobsGate')) require_once __DIR__ . '/StaffJobsGate.php';
+            $cfg = PluginConfig::read($pluginRoot, $dataDir);          // the three files, merged; writes nothing
+            if (!StaffJobsGate::applies($cfg, $dataDir) || (string)($cfg[self::KEY] ?? '') !== '1') return $off;
+            return [
+                'on'         => true,
+                // D16: an administrator who makes a quote is the agent. Only a stored value other than 1 narrows it (PQ1).
+                'admins'     => !array_key_exists(self::ADMINS, $cfg) || (string)$cfg[self::ADMINS] === '1',
+                'auto_quote' => ($cfg['kyc_auto_quote_enabled'] ?? true) !== false,   // lib/KycCrmSync.php:312, lib/KycService.php:1050
+            ];
+        } catch (\Throwable $e) {
+            return $off;
+        }
+    }
+
+    public static function on(string $pluginRoot, string $dataDir): bool
+    {
+        return self::state($pluginRoot, $dataDir)['on'];
+    }
+
+    // ── plugin mail, from the file alone ─────────────────────────────────────────────────────────────────────────
+
+    /**
+     * email_settings.json as MailService reads it (lib/MailService.php:139-176), and nothing else — never uCRM.
+     * use_ucrm_email on → 'ucrm_not_asked' (MailService would ask uCRM first, falling back to plugin SMTP); else
+     * smtp_host set → 'plugin', the sender smtp_from, else smtp_user, else 'not read'; neither → 'none'; a file that exists
+     * but cannot be read → 'unreadable'. The sender serves only accountCounts()'s information line (PQ4).
+     *
+     * @return array{configured:bool, via:string, sender:string}
+     */
+    public static function mailSetting(string $dataDir): array
+    {
+        try {
+            $f = rtrim($dataDir, '/') . '/email_settings.json';
+            $ec = [];
+            if (is_file($f)) {
+                $raw = is_readable($f) ? @file_get_contents($f) : false;
+                if ($raw === false) return ['configured' => false, 'via' => 'unreadable', 'sender' => 'not read'];
+                $d = json_decode((string)$raw, true);
+                $ec = is_array($d) ? $d : [];                                   // MailService: json_decode(...) ?: []
+            }
+            if (!empty($ec['use_ucrm_email'])) return ['configured' => true, 'via' => 'ucrm_not_asked', 'sender' => 'not read'];
+            if (trim((string)($ec['smtp_host'] ?? '')) !== '') {
+                $s = trim((string)($ec['smtp_from'] ?? ''));
+                if ($s === '') $s = trim((string)($ec['smtp_user'] ?? ''));
+                return ['configured' => true, 'via' => 'plugin', 'sender' => $s !== '' ? $s : 'not read'];
+            }
+            return ['configured' => false, 'via' => 'none', 'sender' => 'not read'];
+        } catch (\Throwable $e) {
+            return ['configured' => false, 'via' => 'unreadable', 'sender' => 'not read'];
+        }
+    }
+
+    /**
+     * Row 1b's own precondition, in ruling R13's shape — the one place mailSetting() is mapped (A11-07). The code is
+     * `on agent-cc`'s refusal only; AC-ON prints the same one line as a note, never a status (ruling R18).
+     *
+     * @return array{ok:bool, code:?string, lines:list<string>}
+     */
+    public static function preconditions(string $dataDir): array
+    {
+        try {
+            $m = self::mailSetting($dataDir);
+        } catch (\Throwable $e) {
+            $m = ['configured' => false, 'via' => 'unreadable', 'sender' => 'not read'];
+        }
+        $line = [
+            'plugin'         => 'plugin mail: plugin SMTP',
+            'ucrm_not_asked' => "plugin mail: uCRM's mailer, not asked",
+            'none'           => 'plugin mail is not configured (Settings → System → Email)',
+            'unreadable'     => 'plugin mail is not configured (email_settings.json cannot be read)',
+        ][$m['via']] ?? 'plugin mail is not configured (email_settings.json cannot be read)';
+        $ok = $m['configured'] === true;
+        return ['ok' => $ok, 'code' => $ok ? null : 'mail_not_configured', 'lines' => [$line]];
+    }
+
+    // ── the rules (pure) ─────────────────────────────────────────────────────────────────────────────────────────
+
+    public static function usableAddress(string $raw): string
+    {
+        $a = strtolower(trim($raw));
+        if ($a === '' || strlen($a) > 254) return '';
+        if (preg_match('/[\x00-\x20\x7F,;<>"()\[\]\\\\]/', $a)) return '';   // no CR, LF, space, list, quoted or display form
+        if (substr_count($a, '@') !== 1) return '';
+        return filter_var($a, FILTER_VALIDATE_EMAIL) !== false ? $a : '';
+    }
+
+    /** The To both paths choose: the billing contact's e-mail, else the first contact's (QuotationService :1356-1366, dispatcher :463-475). */
+    public static function toOf(array $client): string
+    {
+        $contacts = is_array($client['contacts'] ?? null) ? $client['contacts'] : [];
+        foreach ($contacts as $c) if (!empty($c['isBilling']) && !empty($c['email'])) return (string)$c['email'];
+        foreach ($contacts as $c) if (!empty($c['email'])) return (string)$c['email'];
+        return '';
+    }
+
+    /** Whether "Cc: " and the list, joined as both paths join it, stays within RFC 5322's 998 octets. */
+    public static function lineFits(array $cc): bool
+    {
+        return strlen('Cc: ' . implode(', ', array_map('strval', $cc))) <= self::CC_LINE_MAX;
+    }
+
+    /** @return array{address:string, code:string, source:string, rule:string, agent_id:?int} */
+    public static function decide(?array $row, ?int $agentId, string $source, string $rule, string $to, array $alreadyCc,
+                                  bool $admins): array
+    {
+        $skip = function (string $code) use ($agentId, $source, $rule): array {
+            return ['address' => '', 'code' => $code, 'source' => $source, 'rule' => $rule, 'agent_id' => $agentId];
+        };
+        if (!class_exists('StaffDirectory')) require_once __DIR__ . '/StaffDirectory.php';
+        if ($row === null) return $skip('agent_unknown_id');
+        if (!StaffDirectory::isActive($row)) return $skip('agent_inactive');
+        if (StaffDirectory::isAdmin($row) && !$admins) return $skip('admin_account');
+        if (StaffDirectory::email($row) === '') return $skip('agent_no_email');
+        $addr = self::usableAddress(StaffDirectory::email($row));
+        if ($addr === '') return $skip('agent_email_invalid');
+        $toLc = strtolower(trim($to));
+        if ($toLc === '') return $skip('customer_unread');
+        if ($addr === $toLc) return $skip('same_as_customer');
+        foreach ($alreadyCc as $c) if ($addr === strtolower(trim((string)$c))) return $skip('already_copied');
+        if (!self::lineFits(array_merge(array_values($alreadyCc), [$addr]))) return $skip('header_too_long');
+        return ['address' => $addr, 'code' => 'added', 'source' => $source, 'rule' => $rule, 'agent_id' => $agentId];
+    }
+
+    /**
+     * @return array{0:array<int,string>,1:string} the client's own copies exactly as given, plus the agent once — code '' —
+     *  or the list unchanged and the FLOOR_CODES code it left the agent out for. Never the To.
+     */
+    public static function mergeCc(array $cc, string $agent, string $to): array
+    {
+        if (!class_exists('MailService')) require_once __DIR__ . '/MailService.php';
+        $own = array_values($cc);
+        $a = self::usableAddress($agent);
+        if ($a === '') return [$own, 'agent_email_invalid'];
+        if ($a === strtolower(trim(MailService::bareAddress($to)))) return [$own, 'same_as_customer'];
+        foreach ($own as $x) if ($a === strtolower(trim(MailService::bareAddress((string)$x)))) return [$own, 'already_copied'];
+        $out = array_merge($own, [$a]);
+        return self::lineFits($out) ? [$out, ''] : [$own, 'header_too_long'];
+    }
+
+    /** A decision turned into a skip with the given code (the floor's, or the app path's own mergeCc). */
+    public static function skipped(array $p7, string $code): array
+    {
+        $p7['address'] = '';
+        $p7['code'] = in_array($code, self::CODES, true) ? $code : 'error';
+        return $p7;
+    }
+
+    /** Whether the relay took the agent's RCPT, from MailService's own log steps (lib/MailService.php:481-483); never the address out. */
+    public static function rcptOutcome(array $log, string $address): string
+    {
+        if ($address === '') return 'none';
+        foreach ($log as $s) {
+            if (!is_array($s) || ($s['step'] ?? '') !== 'rcpt_cc') continue;
+            $m = (string)($s['msg'] ?? '');
+            if ($m === 'cc ' . $address) return 'accepted';
+            if (strpos($m, 'cc ' . $address . ' refused:') === 0) return 'refused';
+        }
+        return 'none';
+    }
+
+    /** The webhook's decision as the dispatcher carried it out. @return array{0:array,1:string} [decision, rcpt] */
+    public static function afterSend(array $p7, array $r): array
+    {
+        if ((string)($p7['address'] ?? '') === '') return [$p7, 'none'];
+        $rc = (string)($r['agent_rcpt'] ?? '');
+        if ($rc === '') return [self::skipped($p7, 'not_composed'), 'none'];           // returned before composing
+        if ($rc === 'excluded') {                                                    // the floor dropped it
+            $c = (string)($r['agent_code'] ?? '');
+            return [self::skipped($p7, in_array($c, self::FLOOR_CODES, true) ? $c : 'error'), 'excluded'];
+        }
+        return [$p7, in_array($rc, ['accepted', 'refused', 'none'], true) ? $rc : 'none'];
+    }
+
+    /** Positive evidence that the plugin is making a quote for this KYC application now (§H.5.4.3 step 4, §H.5.5). */
+    public static function kycInFlight(array $a, int $now, bool $autoQuote): bool
+    {
+        $qid = strtoupper(trim((string)($a['quote_id'] ?? '')));
+        if (!in_array($qid, ['', '0', 'PENDING'], true)) return false;
+        if (!empty($a['quote_created'])) return false;
+        // Make the quotation's claim: stamped after any refusal (KycService :2263-2264), possibly ahead of time(); posts while
+        // an older quote_error is still set (cleared after the POST, :2213). It outweighs both, on either side of now.
+        $c = $a['quote_make_claim_ts'] ?? null;
+        if (is_numeric($c) && abs($now - (int)$c) < self::IN_FLIGHT_SECONDS) return true;
+        // The form and the uCRM retry: only with the marks of a quote about to be made.
+        if (!$autoQuote) return false;                                              // KycService :2450, KycCrmSync :366
+        if (!empty($a['quote_refused']) || !empty($a['quote_error'])) return false;
+        if (!empty($a['quote_debug']) || !empty($a['crm_linked_existing'])) return false;   // KycService :1262,:1269,:2464; KycCrmSync :477
+        if (trim((string)($a['quote_ref'] ?? '')) === '') return false;             // 'PENDING' from save means "to be quoted" (:2780-2781)
+        foreach (['submitted_at', 'crm_synced_at'] as $k) {                         // both written by date() on this server
+            $t = is_string($a[$k] ?? null) ? strtotime((string)$a[$k]) : false;
+            if ($t !== false && $now - (int)$t >= 0 && $now - (int)$t < self::IN_FLIGHT_SECONDS) return true;
+        }
+        return false;
+    }
+
+    /** Where the entity carries adminNotes (null = not carried): whether they hold the plugin's mark for this candidate. */
+    public static function notesMark(?string $adminNotes, string $kind, int $id): bool
+    {
+        if ($adminNotes === null) return true;
+        if ($kind === 'maker') return strpos($adminNotes, 'Plugin ref:') !== false;                     // QuotationService :754, :762
+        return $id > 0 && (bool)preg_match('/(?:application|App) #' . $id . '(?!\d)/', $adminNotes);   // KycService :419, :1877, :2177
+    }
+
+    /** @return array{0:?int,1:string,2:string,3:string} [agent id, source, rule, code — '' when an agent was found] */
+    public static function webhookAgent(?array $first, array $makersByQuote, array $appsByQuote, array $makersOfClient,
+                                        array $appsOfClient, array $retailers, int $now, bool $autoQuote, ?string $adminNotes): array
+    {
+        if (!class_exists('QuoteSendEvidence')) require_once __DIR__ . '/QuoteSendEvidence.php';
+        $found = function (?int $id, string $source, string $rule): array {
+            return [$id, $source, $rule, ($id !== null && $id > 0) ? '' : 'no_agent'];
+        };
+        if ($first !== null) {                                                       // 1. the quote's first decision (P-D16)
+            $id = (int)($first['agent_id'] ?? 0);
+            if ($id > 0) return [$id, 'first_decision', in_array($first['rule'] ?? '', self::RULES, true) ? (string)$first['rule'] : '', ''];
+            return [null, 'first_decision', '', (($first['code'] ?? '') === 'agent_ambiguous') ? 'agent_ambiguous' : 'no_agent'];
+        }
+        $made = array_values(array_filter($makersByQuote, function ($m) { return is_array($m) && ($m['state'] ?? '') === 'made'; }));
+        if (count($made) > 1) return [null, 'maker', '', 'agent_ambiguous'];
+        if (count($made) === 1) return $found((int)($made[0]['maker_id'] ?? 0) ?: null, 'maker', '');
+        $apps = array_values(array_filter($appsByQuote, function ($a) {
+            return is_array($a) && strtoupper(trim((string)($a['quote_id'] ?? ''))) !== 'PENDING';
+        }));
+        if (count($apps) > 1) return [null, 'kyc', '', 'agent_ambiguous'];
+        if (count($apps) === 1) {
+            $k = QuoteSendEvidence::kycAgent($apps[0], $retailers);                      // Part F's rule 1 (IP-1)
+            return $found($k['id'], 'kyc', $k['id'] !== null ? (string)$k['source'] : '');
+        }
+        $mf = array_values(array_filter($makersOfClient, function ($m) use ($now, $adminNotes) {
+            return is_array($m) && ($m['state'] ?? '') === 'making' && is_numeric($m['at'] ?? null)
+                && $now - (int)$m['at'] >= 0 && $now - (int)$m['at'] < self::IN_FLIGHT_SECONDS
+                && self::notesMark($adminNotes, 'maker', 0);
+        }));
+        $af = array_values(array_filter($appsOfClient, function ($a) use ($now, $autoQuote, $adminNotes) {
+            return is_array($a) && self::kycInFlight($a, $now, $autoQuote) && self::notesMark($adminNotes, 'kyc', (int)($a['id'] ?? 0));
+        }));
+        if (count($mf) + count($af) > 1) return [null, 'in_flight', '', 'agent_ambiguous'];
+        if (count($mf) === 1) return $found((int)($mf[0]['maker_id'] ?? 0) ?: null, 'maker_in_flight', '');
+        if (count($af) === 1) {
+            $k = QuoteSendEvidence::kycAgent($af[0], $retailers);
+            return $found($k['id'], 'kyc_in_flight', $k['id'] !== null ? (string)$k['source'] : '');
+        }
+        return [null, 'none', '', 'no_agent'];
+    }
+
+    /**
+     * Counts only, for `on`, `show` and AC-N1: active accounts with a usable address, active accounts without one,
+     * active administrators (copied unless `set agent-cc-admins 0`), and active accounts whose usable address equals the
+     * configured Reply-To or the sender read from the file (information for PQ4). $company: ['reply_to' => …, 'sender' => …].
+     *
+     * @return array{active_usable:int, active_unusable:int, administrators:int, company_mailbox:int}
+     */
+    public static function accountCounts(array $retailers, array $company): array
+    {
+        if (!class_exists('StaffDirectory')) require_once __DIR__ . '/StaffDirectory.php';
+        $mine = [];
+        foreach (['reply_to', 'sender'] as $k) {
+            $a = self::usableAddress((string)($company[$k] ?? ''));
+            if ($a !== '') $mine[$a] = true;
+        }
+        $out = ['active_usable' => 0, 'active_unusable' => 0, 'administrators' => 0, 'company_mailbox' => 0];
+        foreach ($retailers as $r) {
+            if (!is_array($r) || !StaffDirectory::isActive($r)) continue;
+            $a = self::usableAddress(StaffDirectory::email($r));
+            if ($a === '') $out['active_unusable']++;
+            else $out['active_usable']++;
+            if (StaffDirectory::isAdmin($r)) $out['administrators']++;
+            if ($a !== '' && isset($mine[$a])) $out['company_mailbox']++;
+        }
+        return $out;
+    }
+
+    // ── resolution (reads only; null while P7 is off; never throws) ───────────────────────────────────────────────
+
+    /**
+     * The app path (§H.5.4.1): the account the quote was made as, re-read by id — never the session's copy.
+     *
+     * @return array{address:string, code:string, source:string, rule:string, agent_id:?int, decided_at:string}|null
+     */
+    public static function forActor($store, string $pluginRoot, string $dataDir, array $retailer, string $to, array $alreadyCc): ?array
+    {
+        $state = self::state($pluginRoot, $dataDir);
+        if (!$state['on']) return null;
+        $at = gmdate('Y-m-d H:i:s');                                                // the moment P7 decides (ruling R18)
+        $id = 0;
+        try {
+            $id = (int)($retailer['id'] ?? 0);
+            if ($id <= 0) return ['address' => '', 'code' => 'no_agent', 'source' => 'actor', 'rule' => '', 'agent_id' => null, 'decided_at' => $at];
+            $row = $store->findOne('retailers.json', 'id', $id);
+            $d = self::decide(is_array($row) ? $row : null, $id, 'actor', '', $to, $alreadyCc, $state['admins']);
+            $d['decided_at'] = $at;
+            return $d;
+        } catch (\Throwable $e) {
+            return ['address' => '', 'code' => 'error', 'source' => 'actor', 'rule' => '', 'agent_id' => $id > 0 ? $id : null, 'decided_at' => $at];
+        }
+    }
+
+    /**
+     * The webhook path (§H.5.4.3): the quote's first decision, a maker record, a KYC application holding the quote id,
+     * exactly one quote positively in flight for this client, else none. It builds no MailService and reads no sender.
+     *
+     * @return array{address:string, code:string, source:string, rule:string, agent_id:?int, decided_at:string}|null
+     */
+    public static function forWebhook($store, string $pluginRoot, string $dataDir, array $config, int $quoteId, int $clientId,
+                                      array $client, array $quote): ?array
+    {
+        $state = self::state($pluginRoot, $dataDir);
+        if (!$state['on']) return null;
+        $at = gmdate('Y-m-d H:i:s');                                                // the moment P7 decides (ruling R18)
+        try {
+            $first = $store->findAll(self::DECISIONS, 'quote_id', $quoteId)[0] ?? null;
+            $makersByQuote  = $store->findAll(self::MAKERS, 'quote_id', $quoteId);
+            $appsByQuote    = $store->findAll('kyc_applications.json', 'quote_id', $quoteId);
+            $makersOfClient = $clientId > 0 ? $store->findAll(self::MAKERS, 'client_id', $clientId) : [];
+            $appsOfClient   = $clientId > 0 ? $store->findAll('kyc_applications.json', 'crm_client_id', $clientId) : [];
+            $retailers      = $store->load('retailers.json');
+            [$id, $source, $rule, $code] = self::webhookAgent(is_array($first) ? $first : null, $makersByQuote, $appsByQuote,
+                $makersOfClient, $appsOfClient, is_array($retailers) ? $retailers : [], time(),
+                $state['auto_quote'] && (($config['kyc_auto_quote_enabled'] ?? true) !== false),     // both readings must say on
+                is_string($quote['adminNotes'] ?? null) ? $quote['adminNotes'] : null);
+            if ($code !== '') {
+                return ['address' => '', 'code' => $code, 'source' => $source, 'rule' => $rule, 'agent_id' => $id, 'decided_at' => $at];
+            }
+            if (!class_exists('CustomerEmailDispatcher')) require_once __DIR__ . '/CustomerEmailDispatcher.php';
+            if (!class_exists('EmailRecipients')) require_once __DIR__ . '/EmailRecipients.php';
+            $to = self::toOf($client);
+            $already = CustomerEmailDispatcher::ccEnabled($config) ? EmailRecipients::ccFor($client, $to) : [];
+            $row = $store->findOne('retailers.json', 'id', (int)$id);
+            $d = self::decide(is_array($row) ? $row : null, $id, $source, $rule, $to, $already, $state['admins']);
+            $d['decided_at'] = $at;
+            return $d;
+        } catch (\Throwable $e) {
+            return ['address' => '', 'code' => 'error', 'source' => 'none', 'rule' => '', 'agent_id' => null, 'decided_at' => $at];
+        }
+    }
+
+    // ── records (writes; never throw) ────────────────────────────────────────────────────────────────────────────
+
+    /** The hand-off (§H.5.5): who is making a quote for which client, just before the POST. Its row id, or 0. */
+    public static function markMaking($store, string $pluginRoot, string $dataDir, int $clientId, array $retailer): int
+    {
+        try {
+            $maker = (int)($retailer['id'] ?? 0);
+            if ($clientId <= 0 || $maker <= 0 || !self::state($pluginRoot, $dataDir)['on']) return 0;
+            $row = $store->appendWithId(self::MAKERS, ['client_id' => $clientId, 'maker_id' => $maker, 'quote_id' => null,
+                'state' => 'making', 'at' => time(), 'settled_at' => null]);
+            return (int)($row['id'] ?? 0);
+        } catch (\Throwable $e) {
+            self::lost('maker', $e);
+            return 0;
+        }
+    }
+
+    /** A row still 'making' becomes 'made' (quote id above 0) or 'failed' (0); any other state is left alone. */
+    public static function markResult($store, int $rowId, int $quoteId): void
+    {
+        if ($rowId <= 0) return;
+        try {
+            $row = $store->findOne(self::MAKERS, 'id', $rowId);
+            if (!is_array($row) || ($row['state'] ?? '') !== 'making') return;
+            $store->updateOne(self::MAKERS, 'id', $rowId, ['state' => $quoteId > 0 ? 'made' : 'failed',
+                'quote_id' => $quoteId > 0 ? $quoteId : null, 'settled_at' => time()]);
+        } catch (\Throwable $e) {
+            self::lost('maker result', $e);
+        }
+    }
+
+    /** One decision, after the send: exactly the eleven declared fields beside the store's id — no address, name or phone. */
+    public static function record($store, string $path, int $quoteId, string $number, array $p7, bool $sentOk, string $rcpt): void
+    {
+        try {
+            $code = (string)($p7['code'] ?? 'error');
+            $agent = isset($p7['agent_id']) && (int)$p7['agent_id'] > 0 ? (int)$p7['agent_id'] : null;
+            $store->appendWithId(self::DECISIONS, [
+                'quote_id'   => $quoteId,
+                'number'     => $number,
+                'path'       => $path,
+                'outcome'    => $code === 'added' ? 'added' : 'skipped',
+                'code'       => $code,
+                'source'     => (string)($p7['source'] ?? ''),
+                'rule'       => (string)($p7['rule'] ?? ''),
+                'agent_id'   => $agent,
+                'rcpt'       => $rcpt,
+                'send_ok'    => $sentOk ? 1 : 0,
+                'decided_at' => (string)($p7['decided_at'] ?? ''),
+            ]);
+        } catch (\Throwable $e) {
+            self::lost('decision', $e);
+        }
+    }
+
+    /** One fixed line for a lost write: what, and the exception's class — never its message. */
+    private static function lost(string $what, \Throwable $e): void
+    {
+        try {
+            if (!class_exists('PluginLog')) require_once __DIR__ . '/PluginLog.php';
+            PluginLog::write('quote_agent_copy', $what . ' not written (' . get_class($e) . ')');
+        } catch (\Throwable $e2) {
+        }
+    }
+
+    // ── the check, AC-ON (read-only; ruling R13's row P) ─────────────────────────────────────────────────────────
+
+    /**
+     * AC-ON (§H.5.10.4). Reads the book through $ro alone (tables checked in sqlite_master first, never created), the
+     * settings files and quote_mail.log; writes nothing. Each decision is judged only by what its own row recorded and
+     * placed by its decided_at (ruling R18); what P7 could not have known is printed, never a FAIL.
+     *
+     * @return array{status:string, counts:array<string,int>, notes:list<string>}
+     *  status: 'PASS' | 'FAIL <code>' | 'NOT_YET too_soon|no_traffic'
+     */
+    public static function check(\PDO $ro, string $pluginRoot, string $dataDir, int $now): array
+    {
+        $counts = [];
+        $notes = [];
+        try {
+            if (!class_exists('PluginConfig')) require_once __DIR__ . '/PluginConfig.php';
+            $cfg = PluginConfig::read($pluginRoot, $dataDir);
+            // Rule 2: plugin mail as it reads now — a note, never a status.
+            $notes[] = self::preconditions($dataDir)['lines'][0];
+            $notes[] = 'kyc_quote_send_via_crm: ' . self::viaCrmState($cfg);
+            // Rule 1 (root docs/73 §H.5.10.4; rulings R3, R18): the since-stamp read as the other parts read theirs (sinceOf).
+            $since = self::sinceOf($cfg[self::SINCE] ?? null);
+            if ($since === null) return ['status' => 'FAIL since_unreadable', 'counts' => $counts, 'notes' => $notes];
+            // Rule 3: the window.
+            $lo = $since + self::MARGIN;
+            $hi = $now - self::MARGIN;
+            if ($lo > $hi) return ['status' => 'NOT_YET too_soon', 'counts' => $counts, 'notes' => $notes];
+            $inWin = function (int $t) use ($lo, $hi): bool { return $t >= $lo && $t <= $hi; };
+
+            // Rule 4: the e-mails and the decisions.
+            $lines = self::mailLines($dataDir);                                    // [[t, number], …]
+            $rows = self::sentRows($ro);                                           // [[t, quote id, status], …] (every quotation row)
+            $decs = self::decisionRows($ro);                                       // decoded rows
+            $p1Lines = [];
+            $p1Since = [];
+            foreach ($lines as [$t, $n]) {
+                if ($inWin($t)) $p1Lines[$n] = ($p1Lines[$n] ?? 0) + 1;
+                if ($t >= $since) $p1Since[$n] = ($p1Since[$n] ?? 0) + 1;
+            }
+            $p3Rows = [];
+            $rowStatus = [];
+            foreach ($rows as [$t, $qid, $status]) {
+                $rowStatus[$qid] = $status;
+                if ($status === 'sent' && $t !== null && $inWin($t)) $p3Rows[] = $qid;
+            }
+            $bad = false;
+            $placed = [];                                                          // decisions with a readable decided_at
+            foreach ($decs as $d) {
+                $t = self::stampOf($d['decided_at'] ?? null);
+                if ($t === null) { $bad = true; continue; }                         // rule 9: never drops out of the counts
+                $d['_t'] = $t;
+                $placed[] = $d;
+            }
+            $fromSince = array_values(array_filter($placed, function ($d) use ($since) { return $d['_t'] >= $since; }));
+            $inWindow  = array_values(array_filter($placed, function ($d) use ($inWin) { return $inWin($d['_t']); }));
+
+            // Rule 5.
+            $emails = array_sum($p1Lines) + count($p3Rows);
+            if ($emails === 0 && $inWindow === [] && !$bad) {
+                return ['status' => 'NOT_YET no_traffic', 'counts' => $counts, 'notes' => $notes];
+            }
+
+            // The printed counts, per path (decisions placed in the window).
+            foreach (self::PATHS as $path) {
+                $px = $path === 'plugin' ? 'p1_' : 'p3_';
+                $mine = array_values(array_filter($inWindow, function ($d) use ($path) { return ($d['path'] ?? '') === $path; }));
+                $counts[$px . 'decisions'] = count($mine);
+                $counts[$px . 'added'] = 0;
+                $counts[$px . 'skipped'] = 0;
+                foreach (['accepted', 'refused', 'none', 'excluded'] as $rc) $counts[$px . 'rcpt_' . $rc] = 0;
+                $counts[$px . 'sent_carrying_copy'] = 0;
+                foreach (['none', 'accepted', 'refused'] as $rc) $counts[$px . 'failed_carrying_copy_rcpt_' . $rc] = 0;
+                $counts[$px . 'failed_without_copy'] = 0;
+                foreach ($mine as $d) {
+                    $added = ($d['outcome'] ?? '') === 'added';
+                    $code = (string)($d['code'] ?? '');
+                    if ($added) $counts[$px . 'added']++;
+                    else {
+                        $counts[$px . 'skipped']++;
+                        if (in_array($code, self::CODES, true)) $counts[$px . 'skipped_' . $code] = ($counts[$px . 'skipped_' . $code] ?? 0) + 1;
+                    }
+                    $rc = (string)($d['rcpt'] ?? '');
+                    if (in_array($rc, self::RCPTS, true) && ($added || $rc === 'excluded')) $counts[$px . 'rcpt_' . $rc]++;
+                    $src = (string)($d['source'] ?? '');
+                    if (in_array($src, self::SOURCES, true)) $counts[$px . 'source_' . $src] = ($counts[$px . 'source_' . $src] ?? 0) + 1;
+                    $ok = (int)($d['send_ok'] ?? 0) === 1;
+                    if ($added && $ok) $counts[$px . 'sent_carrying_copy']++;
+                    // Rule 7: a copy that rode on a failed send — a count with its path's line, never a status.
+                    if ($added && !$ok && in_array($rc, ['none', 'accepted', 'refused'], true)) $counts[$px . 'failed_carrying_copy_rcpt_' . $rc]++;
+                    if (!$added && !$ok) $counts[$px . 'failed_without_copy']++;
+                }
+                $failed = $counts[$px . 'failed_carrying_copy_rcpt_none'] + $counts[$px . 'failed_carrying_copy_rcpt_accepted']
+                        + $counts[$px . 'failed_carrying_copy_rcpt_refused'];
+                if ($failed > 0) {
+                    $notes[] = ($path === 'plugin' ? 'path 1' : 'path 3') . ': failed carrying a copy ' . $failed
+                        . ($path === 'plugin' ? " — handed to uCRM's /send" : ' — a lost e-mail: resend with tools/quote_email_send.php');
+                }
+                if ($counts[$px . 'failed_without_copy'] > 0) {
+                    $notes[] = ($path === 'plugin' ? 'path 1' : 'path 3') . ': failed without a copy ' . $counts[$px . 'failed_without_copy']
+                        . ($path === 'plugin' ? " — handed to uCRM's /send" : ' — a lost e-mail: resend with tools/quote_email_send.php');
+                }
+            }
+
+            // Printed, never a FAIL: forgotten, sent again, row not settled, no log line.
+            $forgotten = 0; $unsettled = 0; $okByQuote = []; $noLine = 0; $p1InWin = [];
+            foreach ($inWindow as $d) {
+                if ((int)($d['send_ok'] ?? 0) !== 1) continue;
+                $qid = (int)($d['quote_id'] ?? 0);
+                if (($d['path'] ?? '') === 'webhook') {
+                    if (!array_key_exists($qid, $rowStatus)) $forgotten++;
+                    elseif ($rowStatus[$qid] !== 'sent') $unsettled++;
+                } elseif (($d['path'] ?? '') === 'plugin') {
+                    $n = (string)($d['number'] ?? '');
+                    $p1InWin[$n] = ($p1InWin[$n] ?? 0) + 1;
+                }
+            }
+            foreach ($fromSince as $d) {
+                if ((int)($d['send_ok'] ?? 0) === 1) {
+                    $k = (string)($d['path'] ?? '') . '|' . (int)($d['quote_id'] ?? 0);
+                    $okByQuote[$k] = ($okByQuote[$k] ?? 0) + 1;
+                }
+            }
+            foreach ($p1InWin as $n => $k) $noLine += max(0, $k - ($p1Since[$n] ?? 0));
+            $again = count(array_filter($okByQuote, function ($k) { return $k > 1; }));
+            $counts['forgotten_resend_tool'] = $forgotten;
+            $counts['sent_again'] = $again;
+            $counts['row_not_settled'] = $unsettled;
+            $counts['no_log_line'] = $noLine;
+            if ($forgotten > 0) $notes[] = 'forgotten (resend tool): ' . $forgotten;
+            if ($again > 0) $notes[] = 'sent again: ' . $again;
+            if ($unsettled > 0) $notes[] = 'row not settled: ' . $unsettled;
+            if ($noLine > 0) $notes[] = 'no log line: ' . $noLine;
+
+            // Rule 6: the positive control on the hooks, paired — e-mails windowed, decisions taken from since on.
+            $p3Ok = []; $p1Ok = [];
+            foreach ($fromSince as $d) {
+                if ((int)($d['send_ok'] ?? 0) !== 1) continue;
+                if (($d['path'] ?? '') === 'webhook') $p3Ok[(int)($d['quote_id'] ?? 0)] = true;
+                if (($d['path'] ?? '') === 'plugin') {
+                    $n = (string)($d['number'] ?? '');
+                    $p1Ok[$n] = ($p1Ok[$n] ?? 0) + 1;
+                }
+            }
+            foreach ($p3Rows as $qid) {
+                if (empty($p3Ok[$qid])) return ['status' => 'FAIL decision_missing', 'counts' => $counts, 'notes' => $notes];
+            }
+            foreach ($p1Lines as $n => $k) {
+                if ($k > ($p1Ok[$n] ?? 0)) return ['status' => 'FAIL decision_missing', 'counts' => $counts, 'notes' => $notes];
+            }
+            // Rule 8: an added row that names no agent — the row alone, never today's accounts or setting.
+            foreach ($fromSince as $d) {
+                if (($d['outcome'] ?? '') !== 'added') continue;
+                $src = (string)($d['source'] ?? '');
+                if ((int)($d['agent_id'] ?? 0) <= 0 || in_array($src, ['in_flight', 'none'], true) || !in_array($src, self::SOURCES, true)) {
+                    return ['status' => 'FAIL added_without_agent', 'counts' => $counts, 'notes' => $notes];
+                }
+            }
+            // Rule 9: a value outside its fixed list, or a decided_at that is not a stamp.
+            if ($bad) return ['status' => 'FAIL unknown_code', 'counts' => $counts, 'notes' => $notes];
+            foreach ($fromSince as $d) {
+                if (!in_array((string)($d['code'] ?? ''), self::CODES, true) || !in_array((string)($d['path'] ?? ''), self::PATHS, true)
+                    || !in_array((string)($d['source'] ?? ''), self::SOURCES, true) || !in_array((string)($d['rule'] ?? ''), self::RULES, true)
+                    || !in_array((string)($d['rcpt'] ?? ''), self::RCPTS, true) || !in_array((string)($d['outcome'] ?? ''), ['added', 'skipped'], true)) {
+                    return ['status' => 'FAIL unknown_code', 'counts' => $counts, 'notes' => $notes];
+                }
+            }
+            return ['status' => 'PASS', 'counts' => $counts, 'notes' => $notes];
+        } catch (\Throwable $e) {
+            $notes[] = 'the check could not read (' . get_class($e) . ')';
+            return ['status' => 'FAIL check_error', 'counts' => $counts, 'notes' => $notes];
+        }
+    }
+
+    /**
+     * quote_agent_cc_since as unix time, read as every other part reads the since-stamp the tool writes for it: through
+     * UtcClock::parse (a bare 'Y-m-d H:i:s' or 'Y-m-d' as UTC; ISO 8601 with 'Z' or an offset, or a trailing UTC/GMT,
+     * honoured as written — lib/QuoteDailyList.php's quote_daily_list_since), or unix seconds in digits, as
+     * lib/QuoteTracker.php reads quote_tracking_since. Null when neither gives a positive time (rule 1, since_unreadable).
+     * A correct switch-on must never read FAIL for its stamp's form (root docs/73 §H.5.10.4 rule 1; ruling R18); decided_at,
+     * which P7 writes itself, keeps stampOf's one strict form (rule 9).
+     */
+    private static function sinceOf($v): ?int
+    {
+        if (is_bool($v) || !is_scalar($v)) return null;
+        $s = trim((string)$v);
+        if ($s === '') return null;
+        if (!class_exists('UtcClock')) require_once __DIR__ . '/UtcClock.php';
+        $t = ctype_digit($s) ? (int)$s : UtcClock::parse($s);
+        return $t > 0 ? $t : null;
+    }
+
+    /** A UTC stamp in the storage form 'Y-m-d H:i:s' (UtcClock::stamp), as unix time; null when it is not one. */
+    private static function stampOf($s): ?int
+    {
+        if (!is_string($s) || !preg_match('/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/', $s)) return null;
+        $t = strtotime($s . ' UTC');
+        return ($t === false || gmdate('Y-m-d H:i:s', $t) !== $s) ? null : $t;
+    }
+
+    private static function viaCrmState(array $cfg): string
+    {
+        if (!array_key_exists('kyc_quote_send_via_crm', $cfg)) return 'unset';
+        $v = $cfg['kyc_quote_send_via_crm'];
+        return ($v === 0 || $v === '0' || $v === false) ? '0' : 'on';
+    }
+
+    /** quote_mail.log's sent lines: their stamp and the quote's number only (the text between '] ' and the first ' -> '). */
+    private static function mailLines(string $dataDir): array
+    {
+        $f = rtrim($dataDir, '/') . '/quote_mail.log';
+        $out = [];
+        if (!is_file($f) || !is_readable($f)) return $out;
+        $h = @fopen($f, 'rb');
+        if ($h === false) return $out;
+        while (($l = fgets($h)) !== false) {
+            $l = rtrim($l, "\r\n");
+            if (substr($l, -5) !== ' sent' || !preg_match('/^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\] /', $l, $m)) continue;
+            $rest = substr($l, strlen($m[0]));
+            $p = strpos($rest, ' -> ');
+            if ($p === false) continue;
+            $t = self::stampOf($m[1]);
+            if ($t === null) continue;
+            $out[] = [$t, substr($rest, 0, $p)];
+        }
+        fclose($h);
+        return $out;
+    }
+
+    private static function hasTable(\PDO $ro, string $t): bool
+    {
+        $st = $ro->prepare("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?");
+        $st->execute([$t]);
+        return $st->fetchColumn() !== false;
+    }
+
+    /** customer_email_log's quotation rows: [created_at as unix time or null, quote id, status]. */
+    private static function sentRows(\PDO $ro): array
+    {
+        if (!self::hasTable($ro, 'customer_email_log')) return [];
+        $out = [];
+        $st = $ro->query("SELECT dedupe_key, status, created_at FROM customer_email_log WHERE template = 'quotation' AND dedupe_key LIKE 'quotation:%'");
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            $id = substr((string)$r['dedupe_key'], strlen('quotation:'));
+            if (!ctype_digit($id)) continue;
+            $out[] = [self::stampOf((string)$r['created_at']), (int)$id, (string)$r['status']];
+        }
+        return $out;
+    }
+
+    /** quote_agent_copies' rows, decoded (a store collection: id + data). */
+    private static function decisionRows(\PDO $ro): array
+    {
+        if (!self::hasTable($ro, 'quote_agent_copies')) return [];
+        $out = [];
+        foreach ($ro->query('SELECT data FROM quote_agent_copies ORDER BY id')->fetchAll(\PDO::FETCH_COLUMN) as $j) {
+            $d = json_decode((string)$j, true);
+            $out[] = is_array($d) ? $d : ['decided_at' => null];
+        }
+        return $out;
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/QuoteChase.php b/dishnet-hybrid-sudan/lib/QuoteChase.php
new file mode 100644
index 0000000..38c015e
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/QuoteChase.php
@@ -0,0 +1,648 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/StaffJobsGate.php';
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/JobBudget.php';
+require_once __DIR__ . '/WaSendBudget.php';
+require_once __DIR__ . '/QuoteSendEvidence.php';
+require_once __DIR__ . '/QuoteTracker.php';
+require_once __DIR__ . '/QuoteChasePolicy.php';
+require_once __DIR__ . '/QuoteChaseText.php';
+require_once __DIR__ . '/FollowUpService.php';
+
+/**
+ * QuoteChase — the quote chase, P2b (5.18.104, Uganda, root docs/73 §H.2.10; contract C3, C7, C9; rulings R3, R13, R18,
+ * R19). Day 1, 3 and 7 after a quotation, in the approved wording (D9), from the number the customer spoke to.
+ *
+ *   on()            Uganda, quote_tracking_enabled, quote_chase_enabled, the ledger on, dn_tz() Africa/Kampala (§H.2.10.1)
+ *   open()          cron/quote_chase.php: one chase per open tracker row, holds first, then in one BEGIN IMMEDIATE the
+ *                   phone's open enquiries closed `superseded`, the follow-up opened, the tracker linked (§H.2.10.3)
+ *   draftDue()      cron/quote_chase.php: stale drafts expired; each due row (inside the window, no draft pending) checked
+ *                   in uCRM (3 GETs at most, 3 s / 5 s), drafted from the template and approved as quote_chase (§H.2.10.5)
+ *   preSendCheck()  cron/followup_send.php's quote pass, item 2: local reads only; a failure closes or expires (§H.2.10.6)
+ *   afterClaimStop() the same pass, item 4: the three customer stops read again after an ok claim (ruling R18; A14-08)
+ *   demand()        the chases due today by handset: what `on chase` prints and the ledger reserves for (§H.2.5.4)
+ *   offHook()       row 6's rollback hook, on the tool's $rw (ruling R13; §H.2.16 item 2)
+ *   offerHolds()/offerHold()  "a quotation is in play": the one meaning Part O reads (§H.2.10.10; ruling R3)
+ *
+ * Inert unless on(); South Sudan never reaches any of it (StaffJobsGate, and the ledger cannot be on there). A read
+ * failure throws: nothing here ever answers "no stop" or "no hold" because a read failed. No uCRM call but one GET per
+ * drafted row (C9). Every Kampala date and hour is computed in a literal Africa/Kampala zone. PHP 7.4.
+ */
+final class QuoteChase
+{
+    /** The literal zone every Kampala date and hour here is computed in (R-16). */
+    public const TZ = 'Africa/Kampala';
+
+    /** uCRM status reads per quote_chase run (§H.2.10.5), each started only with this many seconds left. */
+    const UCRM_GETS = 3;
+    const UCRM_GET_S = 5;
+    /** The fixed code a stale or edited quote draft is expired with (§H.2.10.6 item 2). */
+    const NOT_TEMPLATE = 'quote_chase_not_template';
+    /** How a chase is stored (A15, R-10): never 'DishNet', which humanRepliedSince counts as a colleague. */
+    const AGENT = 'DishNet Plugin';
+    /** The echo claim's event (§H.2.10.6 item 7). */
+    const ECHO_SOURCE = 'quote.chase';
+    /** Who approves a templated draft: quote_chase_enabled is the operator's approval (F8). */
+    const DECIDED_BY = 'auto:quote_chase';
+    /** A claim the stops ended before the send (ruling R18; A14-08). */
+    const STOPPED_AFTER_CLAIM = 'stopped_after_claim';
+    /** The escalation scan reads p's inbound rows from this many days before the quotation (F8). */
+    const ESCALATION_DAYS = 30;
+    /** The offers hold's two 48-hour clauses (§H.2.10.10). */
+    const HOLD_S = 48 * 3600;
+    /** The quote pass's lock, under the data directory (B11-02). */
+    const LOCK_FILE = 'quote_send.lock';
+
+    // ── the switch ─────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** §H.2.10.1: Uganda, tracking on, the chase on, the ledger on, and the install's zone Africa/Kampala. */
+    public static function on(array $config, ?string $dataDir): bool
+    {
+        if (!self::truthy($config['quote_tracking_enabled'] ?? null) || !self::truthy($config['quote_chase_enabled'] ?? null)) return false;
+        if (!StaffJobsGate::applies($config, $dataDir)) return false;
+        if (!WaSendBudget::on($config, $dataDir)) return false;
+        if (!function_exists('dn_tz')) require_once __DIR__ . '/timezone.php';
+        return dn_tz($config) === self::TZ;
+    }
+
+    /** The cold chase (step 10): quote_chase_cold too. */
+    public static function cold(array $config): bool
+    {
+        return self::truthy($config['quote_chase_cold'] ?? null);
+    }
+
+    // ── opening (§H.2.10.3) ────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * Open a chase for each open tracker row sent at or after quote_chase_not_before, not backfilled, with no follow-up
+     * and no hold. Holds are set first: colleague and ambiguous (QuoteTracker::openingHold), escalation (F8), before
+     * switch-on, and what QuoteTracker::number() holds (owned_number, partner_number, never_wrote, channel_refused:…);
+     * a transient refusal waits for a later run. Then, in one BEGIN IMMEDIATE: every open enquiry follow-up of the phone,
+     * on every conversation, is closed `superseded` (R-06); openQuote(); quote_tracker.followup_id set.
+     *
+     * @return array<string,int> counts only
+     */
+    public static function open(\PDO $pdo, array $config, ?string $dataDir, $store, int $now, int $until): array
+    {
+        $c = ['opened' => 0, 'held' => 0, 'waiting' => 0, 'superseded' => 0, 'failed' => 0, 'cut' => 0];
+        if (!self::on($config, $dataDir)) return $c;
+        $notBefore = UtcClock::parse($config['quote_chase_not_before'] ?? '');
+        if ($notBefore <= 0) return $c;   // the switch writes it; without it nothing is opened
+
+        if (!class_exists('OwnedNumberHold')) require_once __DIR__ . '/OwnedNumberHold.php';
+        if (!class_exists('AutomationPolicy')) require_once __DIR__ . '/AutomationPolicy.php';
+        $owned = \OwnedNumberHold::forInstall($config, $dataDir, $pdo);
+        $policy = \AutomationPolicy::forInstall($config, $dataDir, $pdo, $store);
+        $window = WaSendBudget::window($config);
+        $svc = new \FollowUpService($pdo);
+
+        $rows = $pdo->query("SELECT * FROM quote_tracker WHERE status = 'open' AND followup_id IS NULL AND chase_hold IS NULL
+                              ORDER BY sent_at, quote_key")->fetchAll(\PDO::FETCH_ASSOC);
+        $hold = $pdo->prepare("UPDATE quote_tracker SET chase_hold = ? WHERE quote_key = ? AND status = 'open'
+                                 AND chase_hold IS NULL AND followup_id IS NULL");
+        foreach ($rows as $row) {
+            if (time() >= $until) { $c['cut'] = 1; break; }
+            $why = QuoteTracker::openingHold($pdo, $config, $dataDir, $row, $store);
+            if ($why === null && self::escalationWord($pdo, $row)) $why = 'escalation';
+            if ($why === null && ((int)$row['backfilled'] === 1 || UtcClock::parse($row['sent_at']) < $notBefore)) $why = 'before_switch_on';
+            $n = null;
+            if ($why === null) {
+                $n = QuoteTracker::number($pdo, $config, $dataDir, $row, $owned, $policy);
+                if ($n['hold'] !== null) {
+                    $why = $n['hold'];
+                } elseif ($n['wait'] !== null) {
+                    $c['waiting']++;
+                    continue;
+                }
+            }
+            $due = null;
+            if ($why === null) {
+                $d = QuoteChasePolicy::next(1, UtcClock::parse($row['sent_at']), (string)$row['valid_until'], null, $window);
+                if ($d['step'] === 1) $due = (int)$d['at'];
+                else $why = 'past_validity';
+            }
+            if ($why !== null) {
+                $hold->execute([$why, (string)$row['quote_key']]);
+                if ($hold->rowCount() === 1) $c['held']++;
+                continue;
+            }
+            $conv = self::conversation($pdo, (int)$n['conv_id']);
+            if ($conv === null) { $c['failed']++; continue; }
+            // The Evolution channel it leaves through: a conversation filed under `accounts` sends from `account`, never
+            // `accounts`, which has no instance (§H.2.10.2; lib/NotificationService.php:127-129).
+            $conv['channel'] = (string)$n['channel'] === 'accounts' ? 'account' : (string)$n['channel'];
+
+            $pdo->exec('BEGIN IMMEDIATE');
+            try {
+                $c['superseded'] += self::supersede($pdo, $svc, $row);
+                $fid = $svc->openQuote($conv, [
+                    'quote_key' => (string)$row['quote_key'], 'ref' => (string)$row['quote_ref'],
+                    'valid_until' => (string)$row['valid_until'], 'sent_at' => (string)$row['sent_at'],
+                    'due_at' => UtcClock::stamp($due), 'crm_client_id' => $row['crm_client_id'],
+                ]);
+                $link = $pdo->prepare("UPDATE quote_tracker SET followup_id = ? WHERE quote_key = ? AND followup_id IS NULL AND status = 'open'");
+                $link->execute([$fid, (string)$row['quote_key']]);
+                if ($link->rowCount() !== 1) throw new \RuntimeException('the tracker row moved');
+                $pdo->exec('COMMIT');
+                $c['opened']++;
+            } catch (\Throwable $e) {
+                try { $pdo->exec('ROLLBACK'); } catch (\Throwable $e2) { /* nothing held */ }
+                $c['failed']++;
+            }
+        }
+        return $c;
+    }
+
+    /** Close every open enquiry follow-up of the quotation's phone, on every conversation of it, as superseded (R-06). */
+    private static function supersede(\PDO $pdo, \FollowUpService $svc, array $row): int
+    {
+        $convs = QuoteTracker::convIds($pdo, (string)$row['phone'], (int)($row['sent_conv_id'] ?? 0));
+        if ($convs === []) return 0;
+        $kind = $svc->hasKind() ? " AND COALESCE(kind,'enquiry') = 'enquiry'" : '';
+        $st = $pdo->query('SELECT id FROM followups WHERE closed_at IS NULL AND conversation_id IN (' . implode(',', $convs) . ')' . $kind);
+        $n = 0;
+        foreach ($st->fetchAll(\PDO::FETCH_COLUMN) as $id) {
+            if ($svc->close((int)$id, 'superseded', 'a quotation was sent; its chase replaces this follow-up', 'quote_chase')) $n++;
+        }
+        return $n;
+    }
+
+    /** An escalation word in p's own inbound rows, on every conversation of p, from sent_at − 30 days (F8). */
+    private static function escalationWord(\PDO $pdo, array $row): bool
+    {
+        $convs = QuoteTracker::convIds($pdo, (string)$row['phone'], (int)($row['sent_conv_id'] ?? 0));
+        if ($convs === []) return false;
+        if (!class_exists('EmailReplyPolicy')) require_once __DIR__ . '/EmailReplyPolicy.php';
+        $from = UtcClock::stamp(UtcClock::parse($row['sent_at']) - self::ESCALATION_DAYS * 86400);
+        $st = $pdo->prepare('SELECT body FROM wa_messages WHERE conversation_id IN (' . implode(',', $convs) . ")
+                              AND direction = 'in' AND (sent_at > ? OR created_at > ?)");
+        $st->execute([$from, $from]);
+        foreach ($st->fetchAll(\PDO::FETCH_COLUMN) as $body) {
+            if (\EmailReplyPolicy::scanForEscalation((string)$body)['escalate']) return true;
+        }
+        return false;
+    }
+
+    // ── drafting (§H.2.10.5) ───────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * Expire the stale drafts, then draft each due row: due_at reached, now inside the window, no pending or approved
+     * draft, and the budget allowing. Per row: the uCRM status (one GET, at most UCRM_GETS a run, each only when
+     * JobBudget::mayStart($until, 5); accepted or declined stops it); the template (the alternating variant on its
+     * handset, the salesperson form where the line is one's); approve(draft, auto:quote_chase).
+     *
+     * @param object|null $crm a uCRM client (get(), withTimeouts()); null builds CrmApiClient::fromUcrm(). Only get() is
+     *                         ever called on it (C9).
+     * @return array<string,int> counts only
+     */
+    public static function draftDue(\PDO $pdo, array $config, ?string $dataDir, $store, int $now, int $until, $crm = null): array
+    {
+        $c = ['expired' => 0, 'drafted' => 0, 'approved' => 0, 'persona_held' => 0, 'skipped_floor' => 0, 'stopped' => 0,
+              'ucrm_gets' => 0, 'ucrm_wait' => 0, 'outside_window' => 0, 'exhausted' => 0, 'cut' => 0];
+        if (!self::on($config, $dataDir)) return $c;
+        $svc = new \FollowUpService($pdo);
+        $c['expired'] = $svc->expireQuoteDrafts(WaSendBudget::localDay($now));
+        $window = WaSendBudget::window($config);
+        if (!QuoteChasePolicy::inWindow($now, $window)) { $c['outside_window'] = 1; return $c; }
+
+        $st = $pdo->prepare("SELECT f.id AS fid, f.channel, f.attempts, f.last_sent_at, f.conversation_id, t.*
+                               FROM followups f JOIN quote_tracker t ON t.followup_id = f.id
+                              WHERE f.kind = 'quote' AND f.closed_at IS NULL AND f.due_at IS NOT NULL AND f.due_at <= ?
+                                AND t.status = 'open'
+                                AND NOT EXISTS (SELECT 1 FROM followup_drafts d WHERE d.followup_id = f.id AND d.status IN ('pending','approved'))
+                              ORDER BY f.due_at, f.id");
+        $st->execute([UtcClock::stamp($now)]);
+        $rows = $st->fetchAll(\PDO::FETCH_ASSOC);
+        if ($rows === []) return $c;
+
+        $client = null;
+        $evo = self::evo($config, $dataDir, $pdo);
+        $confirmed = QuoteChaseText::personaConfirmed($config);
+        foreach ($rows as $r) {
+            if (time() >= $until) { $c['cut'] = 1; break; }
+            $fid = (int)$r['fid'];
+            $step = (int)$r['attempts'] + 1;
+            if ($step > 3) { $svc->close($fid, 'exhausted', 'the chase has no step left', 'quote_chase'); $c['exhausted']++; continue; }
+            $cut = QuoteChasePolicy::validEnd((string)$r['valid_until']);
+            if ($cut === null || $now >= $cut) continue;   // the tracker's expiry closes it
+
+            // 1. The uCRM status: one GET, inside the run's budget (C9: get() only).
+            if ($r['quote_id'] !== null && (int)$r['quote_id'] > 0) {
+                if ($c['ucrm_gets'] >= self::UCRM_GETS || !JobBudget::mayStart($until, self::UCRM_GET_S)) { $c['ucrm_wait']++; continue; }
+                if ($client === null) {
+                    if ($crm === null) {
+                        if (!class_exists('CrmApiClient')) require_once __DIR__ . '/CrmApiClient.php';
+                        $crm = \CrmApiClient::fromUcrm(dirname(__DIR__), $config);
+                    }
+                    $client = $crm->withTimeouts(3, 5);
+                }
+                $c['ucrm_gets']++;
+                $q = null;
+                try { $q = $client->get('billing/quotes/' . (int)$r['quote_id']); } catch (\Throwable $e) { $q = null; }
+                $s = QuoteTracker::ucrmStatus(is_array($q) ? ($q['status'] ?? null) : null);
+                if ($s !== null) {
+                    if (QuoteTracker::setStatus($pdo, (string)$r['quote_key'], $s, 'ucrm_status', $now, 'quote_chase')) $c['stopped']++;
+                    continue;
+                }
+            }
+
+            // 2. The template.
+            $chan = (string)$r['channel'];
+            $persona = self::persona($config, $dataDir, $pdo, $store, $chan, $evo);
+            $variant = self::nextVariant($pdo, $config, $dataDir, $evo, $chan);
+            $form = QuoteChaseText::form($step, $variant, $persona, $confirmed);
+            if ($form['held'] !== null) {
+                $c[self::skipStep($pdo, $svc, $r, $step, $form['held'], $now, $window)]++;
+                continue;
+            }
+            $v = substr($form['key'], -1);
+            $body = QuoteChaseText::render($step, $v, (string)$r['quote_ref'], (string)$r['valid_until'], $form['persona'] ? $persona : null, $confirmed);
+            if ($body === null) { $c[self::skipStep($pdo, $svc, $r, $step, QuoteChaseText::PERSONA_PENDING, $now, $window)]++; continue; }
+            $d = $svc->draftTemplate($fid, $body, QuoteChaseText::templateId($step, $v, $form['persona']), 'quotation chase step ' . $step);
+            if (empty($d['ok'])) continue;
+            $c['drafted']++;
+
+            // 3. quote_chase_enabled is the operator's approval to send these templated messages unread (F8).
+            $a = $svc->approve((int)$d['id'], self::DECIDED_BY, '', 'quote_chase_enabled');
+            if (!empty($a['ok'])) $c['approved']++;
+        }
+        return $c;
+    }
+
+    /**
+     * A step held on this line (the composed day-3 form before sf_persona_confirmed): it is passed over, logged with its
+     * code (the salesperson's list shows it as theirs to call), and the next step armed from the previous send; with none
+     * left the row closes as exhausted. Returns the count's key.
+     */
+    private static function skipStep(\PDO $pdo, \FollowUpService $svc, array $r, int $step, string $code, int $now, array $window): string
+    {
+        $fid = (int)$r['fid'];
+        $prev = trim((string)($r['last_sent_at'] ?? '')) !== '' ? UtcClock::parse($r['last_sent_at']) : null;
+        $n = QuoteChasePolicy::next($step + 1, UtcClock::parse($r['sent_at']), (string)$r['valid_until'], $prev, $window);
+        $svc->log($fid, (int)$r['conversation_id'], 'skipped', 'step ' . $step . ' held: ' . $code, 'quote_chase');
+        if ($n['step'] === null) {
+            $pdo->prepare('UPDATE followups SET attempts = ?, due_at = NULL WHERE id = ? AND closed_at IS NULL')->execute([$step, $fid]);
+            $svc->close($fid, 'exhausted', 'the chase has no step left', 'quote_chase');
+            return 'exhausted';
+        }
+        $pdo->prepare('UPDATE followups SET attempts = ?, due_at = ? WHERE id = ? AND closed_at IS NULL')
+            ->execute([(int)$n['step'] - 1, UtcClock::stamp((int)$n['at']), $fid]);
+        return $code === QuoteChaseText::PERSONA_PENDING ? 'persona_held' : 'skipped_floor';
+    }
+
+    /**
+     * The variant a step takes on a handset: the opposite of the latest quote draft on that handset, A when there is
+     * none (§H.2.10.4). The handset is the Evolution instance the channel sends through, normalised by the ledger's rule.
+     */
+    public static function nextVariant(\PDO $pdo, array $config, ?string $dataDir, $evo, string $channel): string
+    {
+        $h = WaSendBudget::handset((string)$evo->instanceFor($channel));
+        $st = $pdo->query("SELECT f.channel, d.model FROM followup_drafts d JOIN followups f ON f.id = d.followup_id
+                            WHERE f.kind = 'quote' AND d.model LIKE 'template:%' ORDER BY d.id DESC LIMIT 500");
+        $seen = [];
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $d) {
+            $ch = (string)$d['channel'];
+            if (!array_key_exists($ch, $seen)) $seen[$ch] = WaSendBudget::handset((string)$evo->instanceFor($ch));
+            if ($seen[$ch] !== $h) continue;
+            $p = QuoteChaseText::parseId((string)$d['model']);
+            if ($p !== null) return $p[1] === 'A' ? 'B' : 'A';
+        }
+        return 'A';
+    }
+
+    /**
+     * The persona of a channel: the owner's first name on a salesperson's own number (LineOwner::of); '' on such a
+     * number with no usable first name (the department wording); null on a department or partner line.
+     */
+    public static function persona(array $config, ?string $dataDir, \PDO $pdo, $store, string $channel, $evo = null): ?string
+    {
+        try {
+            if ($evo === null) $evo = self::evo($config, $dataDir, $pdo);
+            if (!method_exists($evo, 'channelContext')) return null;
+            $cx = $evo->channelContext($channel);
+            if ($cx === null) return null;
+            if (!class_exists('LineOwner')) require_once __DIR__ . '/LineOwner.php';
+            $lo = \LineOwner::of($cx, $store, $config, $dataDir);
+            if ($lo !== null) return $lo->firstName();
+            return $cx->ownerType() === 'staff' ? '' : null;
+        } catch (\Throwable $e) {
+            return null;
+        }
+    }
+
+    // ── sending: what cron/followup_send.php's quote pass asks (§H.2.10.6) ──────────────────────────────────────
+
+    /**
+     * Item 2, all local reads: the tracker still open; the draft decided today (Kampala); its body exactly the template
+     * render() gives now; now before 20:00 on valid_until; §H.2.9.7's opted_out, answered (marks included) and taken
+     * across all of p's conversations (a live opt-out on any channel among them); no escalation word in p's inbound rows.
+     * A failure closes the follow-up and sets the tracker (setStatus), or expires the draft with NOT_TEMPLATE.
+     *
+     * @param array $draft an approvedQuoteDrafts() row
+     * @return array{ok:bool, code:?string, cold:bool, step:int}
+     */
+    public static function preSendCheck(\PDO $pdo, array $config, ?string $dataDir, array $draft, int $now, $store = null): array
+    {
+        $fail = function (string $code): array { return ['ok' => false, 'code' => $code, 'cold' => false, 'step' => 0]; };
+        $svc = new \FollowUpService($pdo);
+        $fid = (int)$draft['followup_id'];
+        $tr = self::trackerOf($pdo, (string)($draft['quote_key'] ?? ''));
+        if ($tr === null || (string)$tr['status'] !== 'open') {
+            $svc->close($fid, $tr === null ? 'cancelled' : (QuoteTracker::STATUS_TO_CLOSE[(string)$tr['status']] ?? 'cancelled'),
+                        'the quotation is no longer open', 'sender');
+            return $fail('tracker_closed');
+        }
+        $decided = UtcClock::parse($draft['decided_at'] ?? '');
+        if ($decided <= 0 || WaSendBudget::localDay($decided) !== WaSendBudget::localDay($now)) {
+            $svc->expireDraft((int)$draft['id'], self::NOT_TEMPLATE);
+            return $fail(self::NOT_TEMPLATE);
+        }
+        $id = QuoteChaseText::parseId((string)($draft['model'] ?? ''));
+        $body = trim((string)($draft['edited_body'] ?? '')) !== '' ? (string)$draft['edited_body'] : (string)$draft['body'];
+        $persona = null;
+        if ($id !== null && $id[2]) $persona = (string)self::persona($config, $dataDir, $pdo, $store, (string)$draft['channel']);
+        if ($id === null || $id[0] !== (int)$draft['attempt'] || ($id[2] && $persona === '')
+            || !QuoteChaseText::matches($body, $id[0], $id[1], (string)$tr['quote_ref'], (string)$tr['valid_until'], $persona,
+                                        QuoteChaseText::personaConfirmed($config))) {
+            $svc->expireDraft((int)$draft['id'], self::NOT_TEMPLATE);
+            return $fail(self::NOT_TEMPLATE);
+        }
+        $cut = QuoteChasePolicy::validEnd((string)$tr['valid_until']);
+        if ($cut === null || $now >= $cut) {
+            QuoteTracker::setStatus($pdo, (string)$tr['quote_key'], 'expired', 'valid_until', $now, 'sender');
+            return $fail('expired');
+        }
+        $s = QuoteTracker::customerStop($pdo, $config, $dataDir, $tr, $now);
+        if ($s !== null) {
+            QuoteTracker::setStatus($pdo, (string)$tr['quote_key'], $s[0], $s[1], $now, 'sender');
+            return $fail($s[0]);
+        }
+        if (self::escalationWord($pdo, $tr)) {
+            QuoteTracker::setStatus($pdo, (string)$tr['quote_key'], 'taken', 'escalation_word', $now, 'sender');
+            return $fail('taken');
+        }
+        return ['ok' => true, 'code' => null, 'cold' => (int)($tr['spoke_conv_id'] ?? 0) <= 0, 'step' => $id[0]];
+    }
+
+    /** Item 4 (B11-02): the draft still approved and its follow-up still open, read again by id. */
+    public static function stillApproved(\PDO $pdo, int $draftId, int $followupId): bool
+    {
+        $st = $pdo->prepare("SELECT 1 FROM followup_drafts d JOIN followups f ON f.id = d.followup_id
+                              WHERE d.id = ? AND d.status = 'approved' AND f.id = ? AND f.closed_at IS NULL");
+        $st->execute([$draftId, $followupId]);
+        return $st->fetchColumn() !== false;
+    }
+
+    /**
+     * Item 4, after an ok claim (ruling R18; A14-08): opted_out, answered (marks included) and taken read again on the
+     * connection the claim committed on. One found closes the follow-up and sets the tracker as preSendCheck would, and
+     * its code is returned (the caller settles the claim failed, detail STOPPED_AFTER_CLAIM, and sends nothing).
+     */
+    public static function afterClaimStop(\PDO $pdo, array $config, ?string $dataDir, array $draft, int $now): ?string
+    {
+        $tr = self::trackerOf($pdo, (string)($draft['quote_key'] ?? ''));
+        if ($tr === null) return 'tracker_closed';
+        if ((string)$tr['status'] !== 'open') return (string)$tr['status'];
+        $s = QuoteTracker::customerStop($pdo, $config, $dataDir, $tr, $now);
+        if ($s === null) return null;
+        QuoteTracker::setStatus($pdo, (string)$tr['quote_key'], $s[0], $s[1], $now, 'sender');
+        return $s[0];
+    }
+
+    /** What a sent chase is stored as (§H.2.10.6 item 10; R-10): role agent, 'DishNet Plugin', its metadata. */
+    public static function storedRow(string $body, string $waId, int $followupId, array $draft): array
+    {
+        $id = QuoteChaseText::parseId((string)($draft['model'] ?? ''));
+        return [
+            'direction' => 'out', 'role' => 'agent', 'body' => $body,
+            'agent_name' => self::AGENT, 'wa_message_id' => $waId !== '' ? $waId : null,
+            'metadata' => ['source' => 'quote_chase', 'followup_id' => $followupId, 'step' => $id === null ? 0 : $id[0],
+                           'template' => (string)($draft['model'] ?? '')],
+        ];
+    }
+
+    /**
+     * The oldest draft per handset, at most $max handsets (§H.2.10.6, the lists): one claim per handset per run, the
+     * spacing would defer the rest anyway.
+     *
+     * @param callable $handsetOf channel => handset
+     */
+    public static function perHandset(array $drafts, callable $handsetOf, int $max): array
+    {
+        $out = []; $seen = [];
+        foreach ($drafts as $d) {
+            $h = WaSendBudget::handset((string)$handsetOf((string)$d['channel']));
+            if (isset($seen[$h])) continue;
+            $seen[$h] = true;
+            $out[] = $d;
+            if (count($out) >= $max) break;
+        }
+        return $out;
+    }
+
+    /** Take the quote pass's lock without waiting (LOCK_EX|LOCK_NB): a handle, or null while another holds it. */
+    public static function passLock(string $dataDir, int $waitSeconds = 0)
+    {
+        $fp = @fopen(rtrim($dataDir, '/') . '/' . self::LOCK_FILE, 'c');
+        if ($fp === false) return null;
+        $until = time() + max(0, $waitSeconds);
+        do {
+            if (flock($fp, LOCK_EX | LOCK_NB)) return $fp;
+            if ($waitSeconds <= 0) break;
+            usleep(200000);
+        } while (time() < $until);
+        fclose($fp);
+        return null;
+    }
+
+    /** Release the quote pass's lock. */
+    public static function passUnlock($fp): void
+    {
+        if (is_resource($fp)) { @flock($fp, LOCK_UN); @fclose($fp); }
+    }
+
+    // ── what the tool, the checks and the ledger read ──────────────────────────────────────────────────────────
+
+    /**
+     * The chases due today by handset: open quote follow-ups whose due_at falls by the window's close today, keyed by the
+     * handset their channel sends through (§H.2.5.4's quote demand; what `on chase` prints). Reads only.
+     *
+     * @return array<string,int>
+     */
+    public static function demand(\PDO $pdo, array $config, ?string $dataDir, int $now, $evo = null): array
+    {
+        if (!(new \FollowUpService($pdo))->hasKind()) return [];
+        [, $to] = WaSendBudget::window($config);
+        $close = (new \DateTime(WaSendBudget::localDay($now) . ' ' . sprintf('%02d', $to) . ':00:00', new \DateTimeZone(self::TZ)))->getTimestamp();
+        $st = $pdo->prepare("SELECT channel, COUNT(*) AS n FROM followups WHERE closed_at IS NULL AND kind = 'quote'
+                              AND due_at IS NOT NULL AND due_at <= ? GROUP BY channel");
+        $st->execute([UtcClock::stamp($close)]);
+        if ($evo === null) $evo = self::evo($config, $dataDir, $pdo);
+        $out = [];
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            $h = WaSendBudget::handset((string)$evo->instanceFor((string)$r['channel']));
+            if ($h === '') continue;
+            $out[$h] = ($out[$h] ?? 0) + (int)$r['n'];
+        }
+        ksort($out);
+        return $out;
+    }
+
+    /**
+     * Row 6's off-hook, its rollback form only (ruling R13; §H.2.16 item 2), on the tool's $rw and nothing else: every
+     * open quote follow-up closed `rollback` and its pending or approved drafts expired. 5.18.103's followup_run has no
+     * kind filter, so it would otherwise draft AI messages about quotations: it throws unless 0 remain. A plain
+     * `off chase` (why = switch) runs no hook.
+     *
+     * @return array<string,int>
+     */
+    public static function offHook(\PDO $rw, array $config, string $dataDir, string $step, string $why): array
+    {
+        if ($step !== 'chase' || $why !== 'rollback') return [];
+        $svc = new \FollowUpService($rw);
+        if (!$svc->hasKind()) return ['closed' => 0, 'expired' => 0, 'remaining' => 0];
+        $out = ['closed' => 0, 'expired' => 0, 'remaining' => 0];
+        $ids = $rw->query("SELECT id FROM followups WHERE kind = 'quote' AND closed_at IS NULL ORDER BY id")->fetchAll(\PDO::FETCH_COLUMN);
+        foreach ($ids as $id) {
+            $st = $rw->prepare("SELECT id FROM followup_drafts WHERE followup_id = ? AND status IN ('pending','approved')");
+            $st->execute([(int)$id]);
+            foreach ($st->fetchAll(\PDO::FETCH_COLUMN) as $did) {
+                if ($svc->expireDraft((int)$did, 'rollback')) $out['expired']++;
+            }
+            if ($svc->close((int)$id, 'rollback', 'rolled back', 'sales_followup')) $out['closed']++;
+        }
+        $out['remaining'] = (int)$rw->query("SELECT COUNT(*) FROM followups WHERE kind = 'quote' AND closed_at IS NULL")->fetchColumn();
+        if ($out['remaining'] !== 0) throw new \RuntimeException('quote_rows_remain');
+        return $out;
+    }
+
+    // ── the offers hold (§H.2.10.10; ruling R3) ────────────────────────────────────────────────────────────────
+
+    /**
+     * International digits ⇒ the reason an offer must not go to that phone at $nowUtc. Read-only. The reasons, in
+     * order: quote_open, quote_followup_open, quote_sent_48h, quote_text_48h. An unreadable $nowUtc maps every phone of
+     * every conversation outside category staff to 'unreadable_time'. A read failure throws, never "no hold".
+     *
+     * @return array<string,string>
+     */
+    public static function offerHolds(\PDO $pdo, string $nowUtc): array
+    {
+        $m = self::moment($nowUtc);
+        if ($m === null) {
+            $out = [];
+            foreach ($pdo->query("SELECT DISTINCT phone FROM wa_conversations WHERE COALESCE(category, '') <> 'staff'")->fetchAll(\PDO::FETCH_COLUMN) as $p) {
+                if ((string)$p !== '') $out[(string)$p] = 'unreadable_time';
+            }
+            return $out;
+        }
+        $found = self::holdSets($pdo, $m, null);
+        $out = [];
+        foreach (['quote_open', 'quote_followup_open', 'quote_sent_48h', 'quote_text_48h'] as $why) {
+            foreach ($found[$why] as $p) if ($p !== '' && !isset($out[$p])) $out[$p] = $why;
+        }
+        ksort($out);
+        return $out;
+    }
+
+    /** The same for one phone: the reason, or '' when there is none. */
+    public static function offerHold(\PDO $pdo, string $phone, string $nowUtc): string
+    {
+        $m = self::moment($nowUtc);
+        if ($m === null) return 'unreadable_time';
+        $p = trim($phone);
+        if ($p === '' || $p === 'erased') return '';
+        $found = self::holdSets($pdo, $m, $p);
+        foreach (['quote_open', 'quote_followup_open', 'quote_sent_48h', 'quote_text_48h'] as $why) {
+            if (in_array($p, $found[$why], true)) return $why;
+        }
+        return '';
+    }
+
+    /**
+     * The four clauses at the moment $m (storage form), each bounded on both sides by its source's storage time (ruling
+     * R18): a tracker row by created_at and sent_at at or before $m and open then (status open, or status_at after $m);
+     * a quote follow-up opened at or before $m and not closed by then; a quote claim within the 48 h before $m, unless
+     * settled not_sent at or before $m; the quotation's own outbound row stored at or before $m and sent within the 48 h
+     * before it. Matched on the conversation's phone exactly, never the last nine digits.
+     *
+     * @return array<string,string[]>
+     */
+    private static function holdSets(\PDO $pdo, string $m, ?string $phone): array
+    {
+        $since = UtcClock::stamp(UtcClock::parse($m) - self::HOLD_S);
+        $one = $phone === null ? '' : ' AND %s = :phone';
+        $a = [':m' => $m] + ($phone === null ? [] : [':phone' => $phone]);
+        $q = function (string $sql, array $args) use ($pdo): array {
+            $st = $pdo->prepare($sql);
+            $st->execute($args);
+            return array_map('strval', $st->fetchAll(\PDO::FETCH_COLUMN));
+        };
+        $staffOut = "COALESCE(c.category, '') <> 'staff'";
+        $out = [];
+        $out['quote_open'] = $q("SELECT DISTINCT t.phone FROM quote_tracker t
+                                  WHERE t.created_at <= :m AND t.sent_at <= :m
+                                    AND (t.status = 'open' OR (t.status_at IS NOT NULL AND t.status_at > :m))" . sprintf($one, 't.phone'), $a);
+        $out['quote_followup_open'] = $q("SELECT DISTINCT c.phone FROM followups f JOIN wa_conversations c ON c.id = f.conversation_id
+                                           WHERE f.kind = 'quote' AND {$staffOut} AND f.opened_at <= :m
+                                             AND (f.closed_at IS NULL OR f.closed_at > :m)" . sprintf($one, 'c.phone'), $a);
+        $out['quote_sent_48h'] = $q("SELECT DISTINCT w.phone FROM wa_auto_sends w
+                                      WHERE w.kind = 'quote' AND w.phone IS NOT NULL AND w.claimed_at <= :m AND w.claimed_at > :since
+                                        AND NOT (w.outcome = 'not_sent' AND w.settled_at IS NOT NULL AND w.settled_at <= :m)"
+                                    . sprintf($one, 'w.phone'), $a + [':since' => $since]);
+        $ev = [];
+        foreach (QuoteSendEvidence::EVENTS as $i => $e) { $ev[] = ':e' . $i; $a[':e' . $i] = $e; }
+        $st = $pdo->prepare("SELECT c.phone, m.direction, m.event_key, m.body FROM wa_messages m JOIN wa_conversations c ON c.id = m.conversation_id
+                              WHERE m.direction = 'out' AND m.event_key IN (" . implode(',', $ev) . ") AND {$staffOut}
+                                AND m.created_at <= :m AND m.sent_at <= :m AND m.sent_at > :since" . sprintf($one, 'c.phone'));
+        $st->execute($a + [':since' => $since]);
+        $out['quote_text_48h'] = [];
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            if (QuoteSendEvidence::read($r) !== null) $out['quote_text_48h'][(string)$r['phone']] = (string)$r['phone'];
+        }
+        $out['quote_text_48h'] = array_values($out['quote_text_48h']);
+        return $out;
+    }
+
+    /** $nowUtc in the storage form, normalised as HumanTakeover normalises (§H.2.7.1); null when it cannot be read. */
+    private static function moment(string $nowUtc): ?string
+    {
+        $t = UtcClock::parse($nowUtc);
+        return $t === 0 ? null : UtcClock::stamp($t);
+    }
+
+    // ── reads ──────────────────────────────────────────────────────────────────────────────────────────────────
+
+    private static function trackerOf(\PDO $pdo, string $quoteKey): ?array
+    {
+        if ($quoteKey === '') return null;
+        $st = $pdo->prepare('SELECT * FROM quote_tracker WHERE quote_key = ?');
+        $st->execute([$quoteKey]);
+        $r = $st->fetch(\PDO::FETCH_ASSOC);
+        return is_array($r) ? $r : null;
+    }
+
+    private static function conversation(\PDO $pdo, int $id): ?array
+    {
+        if ($id <= 0) return null;
+        $st = $pdo->prepare('SELECT * FROM wa_conversations WHERE id = ?');
+        $st->execute([$id]);
+        $r = $st->fetch(\PDO::FETCH_ASSOC);
+        return is_array($r) ? $r : null;
+    }
+
+    /** The install's Evolution service (the registry's channels when it is on), for channel → instance. */
+    private static function evo(array $config, ?string $dataDir, \PDO $pdo)
+    {
+        if (!class_exists('EvolutionApiService')) require_once __DIR__ . '/EvolutionApiService.php';
+        return \EvolutionApiService::forStore($config, $pdo, $dataDir);
+    }
+
+    private static function truthy($v): bool
+    {
+        if (is_bool($v)) return $v;
+        if (is_int($v)) return $v === 1;
+        return in_array(strtolower(trim((string)$v)), ['1', 'true', 'on', 'yes'], true);
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/QuoteChasePolicy.php b/dishnet-hybrid-sudan/lib/QuoteChasePolicy.php
new file mode 100644
index 0000000..ff30454
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/QuoteChasePolicy.php
@@ -0,0 +1,162 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * QuoteChasePolicy — when each step of a quote chase is due (5.18.104, Uganda, root docs/73 §H.2.10.1). Pure.
+ *
+ * Three steps, 24, 72 and 168 hours from the quotation's own send (`sent_at`, never the customer's last message):
+ *
+ *   - steps 1 and 2 move FORWARD to the next opening of the proactive window (WaSendBudget::window(), default Monday to
+ *     Saturday 08:00-20:00 Kampala; Sunday is never open);
+ *   - floors: after a late send, step 2 is never sooner than 48 h after it, and step 3 never sooner than 96 h;
+ *   - step 3 is T = min(sent_at + 168 h, 16:00 Kampala on valid_until). Out of hours, after 16:00 or on a Sunday, it
+ *     moves BACK to 16:00 on the last open day at or before T; if that breaks the 96 h floor it is not sent
+ *     (`skipped_floor`);
+ *   - validity: nothing is drafted or sent after 20:00 Kampala on valid_until (`past_validity`).
+ *
+ * Every time computation uses a literal Africa/Kampala zone, never dn_tz() (R-16). A step-3 hour that a narrowed window
+ * puts outside it is the window's last hour (min(16, hour_to - 1)), so the moved-back moment is always inside it.
+ * PHP 7.4.
+ */
+final class QuoteChasePolicy
+{
+    /** The literal zone every computation here uses. */
+    public const TZ = 'Africa/Kampala';
+
+    /** Hours from sent_at, per step (D9's day 1, 3 and 7). */
+    const SCHEDULE = [1 => 24, 2 => 72, 3 => 168];
+    /** The day of each step, as the approved wording names it. */
+    const DAY = [1 => 1, 2 => 3, 3 => 7];
+    /** Never sooner than this after the previous step's own send. */
+    const FLOOR_S = [2 => 48 * 3600, 3 => 96 * 3600];
+    /** Step 3's hour on valid_until (before a narrowed window). */
+    const STEP3_HOUR = 16;
+    /** Nothing after this hour on valid_until. */
+    const VALID_CUT_HOUR = 20;
+
+    /**
+     * When $step is due, or why it is not sent.
+     *
+     * @param int      $sentAt     the quotation's send, unix time
+     * @param string   $validUntil the Kampala date Y-m-d
+     * @param int|null $prevSentAt the previous step's own send (or claim, for an uncertain one); null for step 1
+     * @param array    $window     [hour_from, hour_to] (WaSendBudget::window())
+     * @return array{at:?int, code:?string} at = unix time; code = skipped_floor | past_validity | bad_step | bad_date
+     */
+    public static function dueAt(int $step, int $sentAt, string $validUntil, ?int $prevSentAt, array $window): array
+    {
+        if (!isset(self::SCHEDULE[$step])) return ['at' => null, 'code' => 'bad_step'];
+        $cut = self::validEnd($validUntil);
+        if ($cut === null) return ['at' => null, 'code' => 'bad_date'];
+        [$from, $to] = self::hours($window);
+        $floor = ($prevSentAt !== null && isset(self::FLOOR_S[$step])) ? $prevSentAt + self::FLOOR_S[$step] : null;
+        $t = $sentAt + self::SCHEDULE[$step] * 3600;
+
+        if ($step < 3) {
+            if ($floor !== null && $t < $floor) $t = $floor;
+            $t = self::forward($t, $from, $to);
+            if ($t >= $cut) return ['at' => null, 'code' => 'past_validity'];
+            return ['at' => $t, 'code' => null];
+        }
+
+        $h3 = min(self::STEP3_HOUR, $to - 1);
+        $t = min($t, self::at($validUntil, $h3));
+        $t = self::back($t, $from, $to, $h3);
+        if ($floor !== null && $t < $floor) return ['at' => null, 'code' => 'skipped_floor'];
+        if ($t >= $cut) return ['at' => null, 'code' => 'past_validity'];
+        return ['at' => $t, 'code' => null];
+    }
+
+    /**
+     * The first step from $step on that is due, with the codes of those passed over; null when none is left.
+     *
+     * @return array{step:?int, at:?int, skipped:array<int,string>}
+     */
+    public static function next(int $step, int $sentAt, string $validUntil, ?int $prevSentAt, array $window): array
+    {
+        $skipped = [];
+        for ($s = $step; $s <= 3; $s++) {
+            $d = self::dueAt($s, $sentAt, $validUntil, $prevSentAt, $window);
+            if ($d['at'] !== null) return ['step' => $s, 'at' => $d['at'], 'skipped' => $skipped];
+            $skipped[$s] = (string)$d['code'];
+            if ($d['code'] === 'past_validity') {
+                for ($r = $s + 1; $r <= 3; $r++) $skipped[$r] = 'past_validity';
+                break;
+            }
+        }
+        return ['step' => null, 'at' => null, 'skipped' => $skipped];
+    }
+
+    /** 20:00 Kampala on valid_until (unix), or null when the date cannot be read. */
+    public static function validEnd(string $validUntil): ?int
+    {
+        if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', trim($validUntil))) return null;
+        return self::at(trim($validUntil), self::VALID_CUT_HOUR);
+    }
+
+    /** Is $t inside the window: Monday to Saturday, hour_from <= hour < hour_to, Kampala? */
+    public static function inWindow(int $t, array $window): bool
+    {
+        [$from, $to] = self::hours($window);
+        $l = self::local($t);
+        if ((int)$l->format('N') === 7) return false;
+        $h = (int)$l->format('G');
+        return $h >= $from && $h < $to;
+    }
+
+    // ── internals ──────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** [from, to] as ints; anything unreadable reads as the default 8-20 narrowed to nothing wider. */
+    private static function hours(array $window): array
+    {
+        $from = isset($window[0]) ? (int)$window[0] : 8;
+        $to   = isset($window[1]) ? (int)$window[1] : 20;
+        if ($from < 0 || $from > 23) $from = 8;
+        if ($to <= $from || $to > 24) $to = $from + 1;
+        return [$from, $to];
+    }
+
+    /** $t, or the next opening of the window after it. */
+    private static function forward(int $t, int $from, int $to): int
+    {
+        if (self::inWindow($t, [$from, $to])) return $t;
+        $l = self::local($t);
+        if ((int)$l->format('N') !== 7 && (int)$l->format('G') < $from) return self::dayAt($l, $from);
+        for ($i = 1; $i <= 8; $i++) {
+            $d = (clone $l)->modify('+' . $i . ' day');
+            if ((int)$d->format('N') !== 7) return self::dayAt($d, $from);
+        }
+        return $t;
+    }
+
+    /** $t when it is in the window and at or before $h3:00; else $h3:00 on the last open day at or before $t. */
+    private static function back(int $t, int $from, int $to, int $h3): int
+    {
+        $l = self::local($t);
+        $dayH3 = self::dayAt($l, $h3);
+        if ((int)$l->format('N') !== 7 && self::inWindow($t, [$from, $to]) && $t <= $dayH3) return $t;
+        if ((int)$l->format('N') !== 7 && $t > $dayH3) return $dayH3;       // after 16:00 (or out of hours late): that day
+        for ($i = 1; $i <= 8; $i++) {
+            $d = (clone $l)->modify('-' . $i . ' day');
+            if ((int)$d->format('N') !== 7) return self::dayAt($d, $h3);
+        }
+        return $t;
+    }
+
+    private static function local(int $t): \DateTime
+    {
+        return (new \DateTime('@' . $t))->setTimezone(new \DateTimeZone(self::TZ));
+    }
+
+    /** $hour:00 Kampala on the date of $l. */
+    private static function dayAt(\DateTime $l, int $hour): int
+    {
+        return self::at($l->format('Y-m-d'), $hour);
+    }
+
+    /** $hour:00 Kampala on the date Y-m-d. */
+    private static function at(string $ymd, int $hour): int
+    {
+        return (new \DateTime($ymd . ' ' . sprintf('%02d', $hour) . ':00:00', new \DateTimeZone(self::TZ)))->getTimestamp();
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/QuoteChaseText.php b/dishnet-hybrid-sudan/lib/QuoteChaseText.php
new file mode 100644
index 0000000..1a0b810
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/QuoteChaseText.php
@@ -0,0 +1,141 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * QuoteChaseText — the approved wording of the quote chase (5.18.104, Uganda, root docs/73 §H.2.10.4; root docs/72 §H.1,
+ * D9; K2-20, gate B-1). Pure.
+ *
+ * The six department wordings are root docs/72 §H.1's, byte for byte. `{ref}` is the quotation's number and `{date}` its
+ * valid_until written `j F` (in English: "20 November"). No price, plan or customer name; STOP in each.
+ *
+ * On a salesperson's own number the first words become "Hello, this is {first name}'s assistant at DishNet." (§H.1):
+ *   - LITERAL forms (1A, 1B, 7B): the approved text opens with a stand-alone greeting naming DishNet and nothing else,
+ *     and that sentence is replaced; no other word changes. Approved by D9, they ship enabled;
+ *   - COMPOSED forms (3A, 3B, 7A): words are added or dropped. They are proposals, held until the owner confirms them:
+ *     the dated setting `sf_persona_confirmed` (written only by `tools/sales_followup.php set persona-confirmed <date>`).
+ *     Until it is set, day 3 is held there (`persona_wording_pending`) and day 7 always uses B. Their bytes change only by
+ *     the owner's B-1 answer (R104-13).
+ *   - an owner line with no usable first name is given the department wording, whatever the date.
+ *
+ * A step here is the chase's step, 1, 2 or 3 (QuoteChasePolicy); the wording is named by its day, 1, 3 or 7. A template
+ * id is `template:quote_chase_v1:<day><A|B>[p]`, `p` for the salesperson form; it goes in followup_drafts.model.
+ * PHP 7.4.
+ */
+final class QuoteChaseText
+{
+    const VERSION = 'quote_chase_v1';
+    /** The day each step's wording is named by. */
+    const DAY = [1 => 1, 2 => 3, 3 => 7];
+    /** A held day-3 step on a salesperson's number, before sf_persona_confirmed. */
+    const PERSONA_PENDING = 'persona_wording_pending';
+
+    /** root docs/72 §H.1, byte for byte. */
+    const DEPARTMENT = [
+        '1A' => 'Hello, this is DishNet. Do you have any questions about quotation {ref}? Reply here and we will help, or we can book your installation. Reply STOP if you do not want these messages.',
+        '1B' => 'Hello from DishNet. We sent you quotation {ref}. Is anything unclear, or shall we book your installation? Just reply here. Reply STOP to stop these messages.',
+        '3A' => 'Hello, a quick follow-up on quotation {ref} from DishNet. We can answer any question about the kit, the plan or the installation — just reply here. Reply STOP to stop these messages.',
+        '3B' => 'Hello, DishNet here about quotation {ref}. If you would like to compare options or need help deciding, reply here and we will guide you. Reply STOP to stop these messages.',
+        '7A' => 'Hello, quotation {ref} is valid until {date}. If you would like to go ahead, or need another option, reply here and we will take care of it. Reply STOP to stop these messages.',
+        '7B' => 'Hello from DishNet. Your quotation {ref} is valid until {date}. Reply here to go ahead or to ask for a different option. Reply STOP to stop these messages.',
+    ];
+
+    /** The salesperson's greeting sentence (§H.1). */
+    const PERSONA_SENTENCE = "Hello, this is {first name}'s assistant at DishNet.";
+
+    /** Literal forms: the department greeting replaced, nothing else (docs/73 §H.2.10.4). Approved; enabled. */
+    const LITERAL = [
+        '1A' => "Hello, this is {first name}'s assistant at DishNet. Do you have any questions about quotation {ref}? Reply here and we will help, or we can book your installation. Reply STOP if you do not want these messages.",
+        '1B' => "Hello, this is {first name}'s assistant at DishNet. We sent you quotation {ref}. Is anything unclear, or shall we book your installation? Just reply here. Reply STOP to stop these messages.",
+        '7B' => "Hello, this is {first name}'s assistant at DishNet. Your quotation {ref} is valid until {date}. Reply here to go ahead or to ask for a different option. Reply STOP to stop these messages.",
+    ];
+
+    /** Composed forms (docs/73 §H.2.10.4): PROPOSED, held until sf_persona_confirmed (gate B-1; QM48). */
+    const COMPOSED = [
+        '3A' => "Hello, this is {first name}'s assistant at DishNet. A quick follow-up on quotation {ref}. We can answer any question about the kit, the plan or the installation — just reply here. Reply STOP to stop these messages.",
+        '3B' => "Hello, this is {first name}'s assistant at DishNet, about quotation {ref}. If you would like to compare options or need help deciding, reply here and we will guide you. Reply STOP to stop these messages.",
+        '7A' => "Hello, this is {first name}'s assistant at DishNet. Quotation {ref} is valid until {date}. If you would like to go ahead, or need another option, reply here and we will take care of it. Reply STOP to stop these messages.",
+    ];
+
+    /** sf_persona_confirmed holds: a Y-m-d date. */
+    public static function personaConfirmed(array $config): bool
+    {
+        return (bool)preg_match('/^\d{4}-\d{2}-\d{2}$/', trim((string)($config['sf_persona_confirmed'] ?? '')));
+    }
+
+    /**
+     * The form a step sends, or null when the step is held on this line.
+     *
+     * @param string|null $persona null on a department line; the owner's first name on a salesperson's own line ('' when
+     *                             it has none usable: the department wording)
+     * @return array{key:string, persona:bool, held:?string}
+     */
+    public static function form(int $step, string $variant, ?string $persona, bool $confirmed): array
+    {
+        $day = self::DAY[$step] ?? 0;
+        $v = $variant === 'B' ? 'B' : 'A';
+        if ($persona === null || $persona === '') return ['key' => $day . $v, 'persona' => false, 'held' => null];
+        if ($confirmed) return ['key' => $day . $v, 'persona' => true, 'held' => null];
+        if ($day === 3) return ['key' => $day . $v, 'persona' => true, 'held' => self::PERSONA_PENDING];
+        if ($day === 7) $v = 'B';
+        return ['key' => $day . $v, 'persona' => true, 'held' => null];
+    }
+
+    /**
+     * The text of a step, or null when it is held (a composed form before sf_persona_confirmed) or the step is unknown.
+     *
+     * @param string $validUntil the Kampala date Y-m-d
+     */
+    public static function render(int $step, string $variant, string $ref, string $validUntil, ?string $persona, bool $confirmed = false): ?string
+    {
+        $day = self::DAY[$step] ?? 0;
+        if ($day === 0) return null;
+        $key = $day . ($variant === 'B' ? 'B' : 'A');
+        if ($persona === null || $persona === '') {
+            $tpl = self::DEPARTMENT[$key];
+        } elseif (isset(self::LITERAL[$key])) {
+            $tpl = self::LITERAL[$key];
+        } elseif ($confirmed && isset(self::COMPOSED[$key])) {
+            $tpl = self::COMPOSED[$key];
+        } else {
+            return null;
+        }
+        return strtr($tpl, ['{first name}' => (string)$persona, '{ref}' => $ref, '{date}' => self::date($validUntil)]);
+    }
+
+    /** Does $body equal the rendered text, after CRLF and outer whitespace? */
+    public static function matches(string $body, int $step, string $variant, string $ref, string $validUntil, ?string $persona, bool $confirmed = false): bool
+    {
+        $want = self::render($step, $variant, $ref, $validUntil, $persona, $confirmed);
+        return $want !== null && self::same($body, $want);
+    }
+
+    /** The comparison approve() and preSendCheck make: \r\n becomes \n, both sides trimmed. */
+    public static function same(string $a, string $b): bool
+    {
+        return trim(str_replace("\r\n", "\n", $a)) === trim(str_replace("\r\n", "\n", $b));
+    }
+
+    /** template:quote_chase_v1:<day><A|B>[p] */
+    public static function templateId(int $step, string $variant, bool $persona): string
+    {
+        return 'template:' . self::VERSION . ':' . (self::DAY[$step] ?? 0) . ($variant === 'B' ? 'B' : 'A') . ($persona ? 'p' : '');
+    }
+
+    /** A template id read back: [step, variant, persona], or null when it is not one of this version's. */
+    public static function parseId(string $model): ?array
+    {
+        if (!preg_match('/^template:' . preg_quote(self::VERSION, '/') . ':([137])([AB])(p?)$/', trim($model), $m)) return null;
+        $step = array_search((int)$m[1], self::DAY, true);
+        return $step === false ? null : [(int)$step, $m[2], $m[3] === 'p'];
+    }
+
+    /** valid_until written `j F`, English month names (the plugin's locale is never asked). */
+    public static function date(string $ymd): string
+    {
+        $months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
+        if (!preg_match('/^(\d{4})-(\d{2})-(\d{2})$/', trim($ymd), $m)) return '';
+        $mo = (int)$m[2];
+        if ($mo < 1 || $mo > 12) return '';
+        return (int)$m[3] . ' ' . $months[$mo - 1];
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/QuoteDailyList.php b/dishnet-hybrid-sudan/lib/QuoteDailyList.php
new file mode 100644
index 0000000..23af439
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/QuoteDailyList.php
@@ -0,0 +1,788 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/StaffJobsGate.php';
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/JobBudget.php';
+require_once __DIR__ . '/StaffDirectory.php';
+require_once __DIR__ . '/QuoteTracker.php';
+
+/**
+ * QuoteDailyList — the daily list and the staff page, P3 (5.18.104, Uganda, root docs/73 §H.2.11; contract C3, C8;
+ * rulings R18, R19).
+ *
+ * Every Monday to Saturday between 08:00 and 11:00 Kampala, each salesperson who owns open quotations, or quotations
+ * answered this week, gets one WhatsApp list of them from the sales number: quote numbers and counts only, never a name,
+ * a phone or an amount (C8). What a salesperson cannot be sent — quotations with no owner, an owner made inactive, one
+ * with no phone, one outside the pilot ids — goes on the central list, to alert_whatsapp. The names are on the staff
+ * page, tabs/sales/my_quotes.php, own quotations only (D13).
+ *
+ *   on()            Uganda (StaffJobsGate), quote_daily_list_enabled and quote_tracking_enabled
+ *   pageOpen()      Uganda and the list on: the page's route and its one menu entry (§H.2.11.5)
+ *   pendingToday()  the owner keys still to be sent today — due, and no row today other than not_sent; the ledger's
+ *                   staff_list reservation asks it too (WaSendBudget, §H.2.5.4; coordinator.md item 3)
+ *   build()         one owner's list, read at one moment: its text, its sections (count and listed keys) and its refs
+ *   digitRunFree()  the privacy guard: with the listed refs taken out, no run of 9 or more digits (§H.2.11.3 step 0)
+ *   run()           one run of cron/quote_daily_list.php: the 11:00 sweep, or at most one list sent (§H.2.11.1, §H.2.11.3)
+ *   sweep()         the once-a-day sweep that writes the owners still due `missed`, with their last code
+ *   pageRows()      the staff page's rows, with the customer's name, for one salesperson or (seesAll) for everyone
+ *
+ * A list is built under BEGIN IMMEDIATE on the store's connection, writing nothing there: its moment, $built, is taken
+ * once the lock is held, and becomes the row's created_at (ruling R18). The claim is decided on a fresh read of the
+ * files taken just before it (ruling R19). Every Kampala date and hour is computed in a literal Africa/Kampala zone.
+ * Inert unless on(); South Sudan never reaches any of it. Read failures throw: the job then sends nothing. PHP 7.4.
+ */
+final class QuoteDailyList
+{
+    /** The literal zone every Kampala date and hour here is computed in (R-16). */
+    public const TZ = 'Africa/Kampala';
+
+    /** The sections, in the text's order (§H.2.11.4); `quote_list_sends.sections` records them in this order. */
+    const SECTIONS = ['due', 'call', 'replied', 'stop', 'expiring', 'maybe_sent'];
+    const LABELS = [
+        'due'        => 'Reminder due today (sent automatically)',
+        'call'       => 'Yours to call (no automatic reminder)',
+        'replied'    => 'Replied, not yet paid — call them',
+        'stop'       => 'Asked us to stop — do not message',
+        'expiring'   => 'Expiring today',
+        'maybe_sent' => 'May have been sent — check the chat',
+    ];
+    /** The words a ref carries in brackets in the text (§H.2.11.4); fixed, never data. */
+    const NOTES = [
+        'never_wrote' => 'never wrote',
+        'own_number'  => 'your own number',
+        'chase_off'   => 'chase is off',
+        'unread'      => 'open WhatsApp — the reply could not be read here',
+    ];
+    /** The central list's totals line: one short word per section. */
+    const TOTAL_WORDS = ['due' => 'due', 'call' => 'to call', 'replied' => 'replied', 'stop' => 'stop', 'expiring' => 'expiring',
+                         'maybe_sent' => 'may have gone'];
+    /** At most this many refs per section, then "and n more" (§H.2.11.4). */
+    const MAX_REFS = 15;
+    /** The window: Monday to Saturday, from 08:00 to 11:00 Kampala (§H.2.11.1). */
+    const HOUR_FROM = 8;
+    const HOUR_TO   = 11;
+    /** One send: started only with this many seconds left (§H.2.13.4); the job's own budget is one more. */
+    const SEND_S = 20;
+    const OWN_S  = 21;
+    /** AlertService's cooldown on a list's key: one a day (§H.2.11.3 step 2). */
+    const COOLDOWN_MIN = 1440;
+    /** The central list's owner key. */
+    const CENTRAL = 'central';
+    /** "This week": today and the six Kampala days before it. */
+    const WEEK_DAYS = 7;
+    /** The skipped step the chase records for a held persona form (lib/QuoteChase.php skipStep): theirs to call. */
+    const PERSONA_HELD = 'persona_wording_pending';
+    /**
+     * The ledger's final answers that bind one owner's list alone (its ref's tries spent, §H.2.5.3 step 1): kept as that
+     * owner's list_last code, after which run() goes on to the next owner still due and leaves this one to the sweep,
+     * which writes it `missed` with this code, the true one (§H.2.11.1, §H.2.11.3; as Part O's sender goes on past a
+     * spent row, OM84). `already_sent` writes its own row. The other final codes (ledger_off, not_claimable, no_instance,
+     * zone) are the same for every owner on the handset.
+     */
+    const OWNER_FINAL = ['tries_exhausted'];
+
+    // ── the switches ────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** Uganda, the list on and tracking on (§H.2.11.1). */
+    public static function on(array $config, ?string $dataDir): bool
+    {
+        return self::truthy($config['quote_daily_list_enabled'] ?? null) && self::truthy($config['quote_tracking_enabled'] ?? null)
+            && StaffJobsGate::applies($config, $dataDir);
+    }
+
+    /** The staff page and its menu entry: Uganda and the list on (§H.2.11.5). */
+    public static function pageOpen(array $config, ?string $dataDir): bool
+    {
+        return self::truthy($config['quote_daily_list_enabled'] ?? null) && StaffJobsGate::applies($config, $dataDir);
+    }
+
+    /** Monday to Saturday, 08:00 <= hour < 11:00 Kampala. */
+    public static function inWindow(int $t): bool
+    {
+        $l = self::local($t);
+        if ((int)$l->format('N') === 7) return false;
+        $h = (int)$l->format('G');
+        return $h >= self::HOUR_FROM && $h < self::HOUR_TO;
+    }
+
+    /** The sweep's moment: Monday to Saturday, at or after 11:00 Kampala, and not yet swept today (§H.2.11.1). */
+    public static function sweepDue(\PDO $pdo, int $t): bool
+    {
+        $l = self::local($t);
+        if ((int)$l->format('N') === 7 || (int)$l->format('G') < self::HOUR_TO) return false;
+        return self::state($pdo, 'list_swept') !== self::localDay($t);
+    }
+
+    // ── who is due, and with what ───────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * The owner keys still to be sent today: those with something to list, and no `quote_list_sends` row today other than
+     * not_sent — the central list included. Staff keys by id, the central list last. Reads only; the ledger's claim asks
+     * it inside its own transaction.
+     *
+     * @return string[]
+     */
+    public static function pendingToday(\PDO $pdo, array $config, ?string $dataDir, int $now): array
+    {
+        if (!self::hasTable($pdo, 'quote_tracker') || !self::hasTable($pdo, 'quote_list_sends')) return [];
+        $st = $pdo->prepare("SELECT DISTINCT owner_key FROM quote_list_sends WHERE list_date = ? AND outcome <> 'not_sent'");
+        $st->execute([self::localDay($now)]);
+        $done = array_flip(array_map('strval', $st->fetchAll(\PDO::FETCH_COLUMN)));
+        $out = [];
+        foreach (self::dueKeys($pdo, $config, $dataDir, $now) as $k) {
+            if (!isset($done[$k])) $out[] = $k;
+        }
+        return $out;
+    }
+
+    /** The owner keys with at least one quotation to list at $at, staff by id, the central list last. */
+    private static function dueKeys(\PDO $pdo, array $config, ?string $dataDir, int $at): array
+    {
+        $all = self::scope($pdo, $config, $dataDir, $at);
+        $keys = [];
+        foreach ($all['keys'] as $k => $rows) {
+            $listable = array_filter($rows, function ($r) { return !empty($r['_listable']); });
+            if ($listable === []) continue;
+            $c = self::classify($pdo, $config, $dataDir, array_values($listable), $at);
+            if ($c['keys'] !== []) $keys[] = $k;
+        }
+        usort($keys, function ($a, $b) {
+            if ($a === self::CENTRAL) return 1;
+            if ($b === self::CENTRAL) return -1;
+            return (int)substr($a, 6) <=> (int)substr($b, 6);
+        });
+        return $keys;
+    }
+
+    /**
+     * The rows each owner key holds at $at: the tracker rows that are open, or that left open this week (for the week's
+     * counts and the answered and opted-out sections), each assigned to `staff:<id>` when its owner is active, has a
+     * phone and is inside the pilot ids (quote_daily_list_staff, when set), else to the central list. A row whose owner
+     * is still `pending` (under 1 h, §H.2.9.4) is on no list yet.
+     *
+     * @return array{keys: array<string,array>, phones: array<string,string>}
+     */
+    private static function scope(\PDO $pdo, array $config, ?string $dataDir, int $at): array
+    {
+        $ws = UtcClock::stamp(self::weekStart($at));
+        $st = $pdo->prepare("SELECT * FROM quote_tracker WHERE (status = 'open' OR sent_at >= ? OR status_at >= ?)
+                                AND owner_source <> 'pending' ORDER BY sent_at, quote_key");
+        $st->execute([$ws, $ws]);
+        $rows = $st->fetchAll(\PDO::FETCH_ASSOC);
+        $staff = self::retailers($pdo);
+        $pilot = self::pilotIds($config);
+        $tenant = null;
+        try {
+            if (!class_exists('TenantProfile')) require_once __DIR__ . '/TenantProfile.php';
+            $tenant = \TenantProfile::current($config, $dataDir);
+        } catch (\Throwable $e) { $tenant = null; }
+        $keys = []; $phones = [];
+        foreach ($rows as $r) {
+            $status = (string)$r['status'];
+            $r['_listable'] = $status === 'open'
+                || (in_array($status, ['answered', 'opted_out'], true) && (string)($r['status_at'] ?? '') >= $ws);
+            $k = self::CENTRAL;
+            $id = $r['owner_staff_id'] === null ? 0 : (int)$r['owner_staff_id'];
+            if ($id > 0 && isset($staff[$id]) && StaffDirectory::isActive($staff[$id]) && ($pilot === null || in_array($id, $pilot, true))) {
+                $ph = $tenant === null ? null : StaffDirectory::phoneOf($staff[$id], $tenant);
+                if ($ph !== null && $ph !== '') { $k = 'staff:' . $id; $phones[$k] = $ph; }
+            }
+            $keys[$k][] = $r;
+        }
+        return ['keys' => $keys, 'phones' => $phones];
+    }
+
+    /**
+     * Each listed row's sections at $at (§H.2.11.4). A row whose phone has a live opt-out (any channel, any scope), or
+     * that is opted_out, goes under `stop` and nowhere else (S2-20). Otherwise: answered → replied; open with its chase
+     * due today → due; open with no automatic reminder (no chase or a held one, the chase off, a held persona step) → call;
+     * and, besides, open and valid only until today → expiring; open with a chase step that may have gone this week →
+     * maybe_sent. An open row whose chase sends its next step on a later day is on no section.
+     *
+     * @return array{sections: array<string,string[]>, notes: array<string,string>, refs: array<string,string>, keys: array<string,bool>}
+     */
+    private static function classify(\PDO $pdo, array $config, ?string $dataDir, array $rows, int $at): array
+    {
+        if (!class_exists('QuoteChase')) require_once __DIR__ . '/QuoteChase.php';
+        $chaseOn = \QuoteChase::on($config, $dataDir);
+        $cold = $chaseOn && \QuoteChase::cold($config);
+        $today = self::localDay($at);
+        $tomorrow = UtcClock::stamp(self::dayStart($at) + 86400);
+        $wsDay = self::localDay(self::weekStart($at));
+        $hasLedger = self::hasTable($pdo, 'wa_auto_sends');
+        $hasOpt = self::hasTable($pdo, 'contact_optouts');
+        $out = ['sections' => array_fill_keys(self::SECTIONS, []), 'notes' => [], 'refs' => [], 'keys' => []];
+        $fu = $pdo->prepare('SELECT closed_at, due_at FROM followups WHERE id = ?');
+        $held = $pdo->prepare("SELECT 1 FROM followup_events WHERE followup_id = ? AND event = 'skipped' AND detail LIKE ? LIMIT 1");
+        $maybe = $hasLedger ? $pdo->prepare("SELECT 1 FROM wa_auto_sends WHERE kind = 'quote' AND ref LIKE ? AND outcome = 'uncertain'
+                                                AND local_day >= ? LIMIT 1") : null;
+        foreach ($rows as $r) {
+            $key = (string)$r['quote_key'];
+            $status = (string)$r['status'];
+            $put = function (string $sec) use (&$out, $key): void { $out['sections'][$sec][] = $key; };
+            $out['refs'][$key] = (string)$r['quote_ref'];
+            $out['keys'][$key] = true;
+            if ($status === 'opted_out' || ($hasOpt && self::optedOut($pdo, $r))) { $put('stop'); continue; }
+            if ($status === 'answered') {
+                $put('replied');
+                if ((string)($r['status_reason'] ?? '') === 'unread_inbound') $out['notes'][$key] = 'unread';
+                continue;
+            }
+            if ($status !== 'open') { unset($out['keys'][$key]); continue; }
+            $fid = (int)($r['followup_id'] ?? 0);
+            $f = null;
+            if ($fid > 0) { $fu->execute([$fid]); $f = $fu->fetch(\PDO::FETCH_ASSOC) ?: null; }
+            $chased = $chaseOn && $f !== null && $f['closed_at'] === null;
+            if ($chased && $f['due_at'] !== null && (string)$f['due_at'] < $tomorrow) {
+                $put('due');
+            } elseif ($chased) {
+                $held->execute([$fid, '%' . self::PERSONA_HELD . '%']);
+                if ($held->fetchColumn() !== false) $put('call');
+            } else {
+                $put('call');
+                $hold = (string)($r['chase_hold'] ?? '');
+                if ($hold === 'never_wrote' || ((int)($r['spoke_conv_id'] ?? 0) <= 0 && !$cold)) $out['notes'][$key] = 'never_wrote';
+                elseif ($hold === 'owned_number') $out['notes'][$key] = 'own_number';
+                elseif (!$chaseOn) $out['notes'][$key] = 'chase_off';
+            }
+            if ((string)$r['valid_until'] === $today) $put('expiring');
+            if ($maybe !== null && $fid > 0) {
+                $maybe->execute(['fu:' . $fid . ':%', $wsDay]);
+                if ($maybe->fetchColumn() !== false) $put('maybe_sent');
+            }
+            $listed = false;
+            foreach (self::SECTIONS as $s) if (in_array($key, $out['sections'][$s], true)) $listed = true;
+            if (!$listed) unset($out['keys'][$key]);
+        }
+        return $out;
+    }
+
+    /** A live opt-out (active = 1, any channel, any scope) for the row's phone, matched as the tracker matches it. */
+    private static function optedOut(\PDO $pdo, array $r): bool
+    {
+        $p = (string)$r['phone'];
+        if ($p === '' || $p === 'erased') return false;
+        $phones = [$p => $p];
+        foreach (QuoteTracker::convIds($pdo, $p, (int)($r['sent_conv_id'] ?? 0)) as $id) {
+            $st = $pdo->prepare('SELECT phone FROM wa_conversations WHERE id = ?');
+            $st->execute([$id]);
+            $d = (string)preg_replace('/\D+/', '', (string)$st->fetchColumn());
+            if ($d !== '') $phones[$d] = $d;
+        }
+        $in = implode(',', array_fill(0, count($phones), '?'));
+        $st = $pdo->prepare("SELECT 1 FROM contact_optouts WHERE active = 1 AND phone IN ({$in}) LIMIT 1");
+        $st->execute(array_values($phones));
+        return $st->fetchColumn() !== false;
+    }
+
+    /** The week's counts over $rows: sent, replied, reminded (chase sends that went or may have) and paid (§H.2.11.4). */
+    private static function week(\PDO $pdo, array $rows, int $at): array
+    {
+        $ws = UtcClock::stamp(self::weekStart($at));
+        $wsDay = self::localDay(self::weekStart($at));
+        $n = ['sent' => 0, 'replied' => 0, 'reminded' => 0, 'paid' => 0];
+        $st = self::hasTable($pdo, 'wa_auto_sends')
+            ? $pdo->prepare("SELECT COUNT(*) FROM wa_auto_sends WHERE kind = 'quote' AND ref LIKE ? AND outcome IN ('sent','uncertain')
+                               AND local_day >= ?") : null;
+        foreach ($rows as $r) {
+            if ((string)$r['sent_at'] >= $ws) $n['sent']++;
+            $sa = (string)($r['status_at'] ?? '');
+            if ((string)$r['status'] === 'answered' && $sa >= $ws) $n['replied']++;
+            if ((string)$r['status'] === 'paid' && $sa >= $ws) $n['paid']++;
+            if ($st !== null && (int)($r['followup_id'] ?? 0) > 0) {
+                $st->execute(['fu:' . (int)$r['followup_id'] . ':%', $wsDay]);
+                $n['reminded'] += (int)$st->fetchColumn();
+            }
+        }
+        return $n;
+    }
+
+    // ── one owner's list ────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * One owner's list at $built (the caller holds BEGIN IMMEDIATE and took $built once it held it).
+     *
+     * @return array{text:string, sections:array, items:int, refs:string[], phone:?string}
+     *   sections: one entry per section in SECTIONS' order — ['section' => …, 'n' => count, 'keys' => the listed quote_keys,
+     *   at most 15]; no name, phone or text (ruling R18)
+     */
+    public static function build(\PDO $pdo, array $config, ?string $dataDir, string $ownerKey, int $built): array
+    {
+        $all = self::scope($pdo, $config, $dataDir, $built);
+        $rows = $all['keys'][$ownerKey] ?? [];
+        $listable = array_values(array_filter($rows, function ($r) { return !empty($r['_listable']); }));
+        $c = self::classify($pdo, $config, $dataDir, $listable, $built);
+        $sections = []; $refs = [];
+        foreach (self::SECTIONS as $s) {
+            $keys = $c['sections'][$s];
+            $shown = array_slice($keys, 0, self::MAX_REFS);
+            $sections[] = ['section' => $s, 'n' => count($keys), 'keys' => $shown];
+            foreach ($shown as $k) $refs[$k] = substr($k, 4);   // the listed refs: each key's own number ('ref:' + number)
+        }
+        $team = null; $weekRows = $rows;
+        if ($ownerKey === self::CENTRAL) {
+            $team = array_fill_keys(self::SECTIONS, 0);
+            $weekRows = [];
+            foreach ($all['keys'] as $rs) {
+                $weekRows = array_merge($weekRows, $rs);
+                $l = array_values(array_filter($rs, function ($r) { return !empty($r['_listable']); }));
+                if ($l === []) continue;
+                $tc = self::classify($pdo, $config, $dataDir, $l, $built);
+                foreach (self::SECTIONS as $s) $team[$s] += count($tc['sections'][$s]);
+            }
+        }
+        $text = self::render($ownerKey, $c, $sections, self::week($pdo, $weekRows, $built), $team, $built);
+        return ['text' => $text, 'sections' => $sections, 'items' => count($c['keys']), 'refs' => array_values($refs),
+                'phone' => $all['phones'][$ownerKey] ?? null];
+    }
+
+    /** The text (§H.2.11.4): quote numbers and counts only — no customer name, phone or amount, and no staff name. */
+    private static function render(string $ownerKey, array $c, array $sections, array $week, ?array $team, int $at): string
+    {
+        $date = self::local($at)->format('l j F');
+        $lines = [$ownerKey === self::CENTRAL
+            ? '📋 DishNet — open quotations with no salesperson to list them, ' . $date
+            : '📋 DishNet — your open quotations, ' . $date];
+        foreach ($sections as $sec) {
+            if ($sec['n'] === 0) continue;
+            $sep = in_array($sec['section'], ['call', 'replied'], true) ? ' · ' : ', ';
+            $items = [];
+            foreach ($sec['keys'] as $k) {
+                $ref = (string)($c['refs'][$k] ?? substr($k, 4));
+                $note = in_array($sec['section'], ['call', 'replied'], true) ? ($c['notes'][$k] ?? '') : '';
+                $items[] = $note !== '' ? $ref . ' (' . self::NOTES[$note] . ')' : $ref;
+            }
+            $more = $sec['n'] > count($sec['keys']) ? ' and ' . ($sec['n'] - count($sec['keys'])) . ' more' : '';
+            $lines[] = self::LABELS[$sec['section']] . ': ' . $sec['n'] . ' — ' . implode($sep, $items) . $more;
+        }
+        if ($team !== null) {
+            $t = [];
+            foreach (self::SECTIONS as $s) $t[] = self::TOTAL_WORDS[$s] . ' ' . (int)$team[$s];
+            $lines[] = 'Team totals: ' . implode(' · ', $t);
+        }
+        $lines[] = ($team !== null ? 'This week (everyone): ' : 'This week: ') . 'sent ' . $week['sent'] . ' · replied ' . $week['replied']
+                 . ' · reminded ' . $week['reminded'] . ' · paid ' . $week['paid'];
+        $lines[] = 'Names and details: Sales → My quotations';
+        return implode("\n", $lines);
+    }
+
+    /**
+     * The privacy guard (C8; A11-03): with each listed ref taken out where it stands as a whole token, the text holds no
+     * run of 9 or more digits. Pure.
+     *
+     * @param string[] $refs
+     */
+    public static function digitRunFree(string $text, array $refs): bool
+    {
+        usort($refs, function ($a, $b) { return strlen((string)$b) <=> strlen((string)$a); });
+        foreach ($refs as $ref) {
+            $ref = (string)$ref;
+            if ($ref === '') continue;
+            $text = preg_replace('/(?<![^\s])' . preg_quote($ref, '/') . '(?![^\s,(])/u', ' ', $text);
+            if (!is_string($text)) return false;   // a text the guard cannot read is never sent
+        }
+        return !preg_match('/\d{9,}/', $text);
+    }
+
+    // ── one run of the job ──────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * One run of cron/quote_daily_list.php. The sweep comes first, as its own branch ahead of the window's return
+     * (A13-03); otherwise, inside the window, at most one list: the next owner still due, passing over any whose list
+     * the ledger refused for good today (OWNER_FINAL, counted as tries_spent), built under the lock, guarded, claimed on
+     * the fresh read, sent, settled, recorded (§H.2.11.3). $clock is the run's clock (time(), or a test's).
+     *
+     * @return array<string,int> counts only
+     */
+    public static function run(\PDO $pdo, array $config, string $dataDir, $store, string $pluginRoot, callable $clock, int $until): array
+    {
+        $c = ['swept' => 0, 'missed' => 0, 'outside_window' => 0, 'none_due' => 0, 'built' => 0, 'digit_run' => 0,
+              'held_fresh_read' => 0, 'deferred' => 0, 'already_sent' => 0, 'sent' => 0, 'uncertain' => 0, 'not_sent' => 0,
+              'row_lost' => 0, 'cut' => 0, 'tries_spent' => 0];
+        $now = (int)$clock();
+        if (self::sweepDue($pdo, $now)) {
+            if (!JobBudget::mayStart($until, self::SEND_S, $now)) { $c['cut'] = 1; return $c; }
+            $s = self::sweep($pdo, $config, $dataDir, $now);
+            $c['swept'] = 1; $c['missed'] = $s['missed'];
+            return $c;
+        }
+        if (!self::inWindow($now)) { $c['outside_window'] = 1; return $c; }
+        if (!JobBudget::mayStart($until, self::SEND_S, $now)) { $c['cut'] = 1; return $c; }
+        $pending = self::pendingToday($pdo, $config, $dataDir, $now);
+        $day = self::localDay($now);
+        // The next owner still due whose list the ledger has not refused for good (OWNER_FINAL): an owner whose tries are
+        // spent stays due, so the sweep writes it missed with that code, but never holds back the owners after it.
+        $key = null;
+        foreach ($pending as $k) {
+            if (in_array(self::state($pdo, 'list_last:' . $day . ':' . $k), self::OWNER_FINAL, true)) { $c['tries_spent']++; continue; }
+            $key = $k;
+            break;
+        }
+        if ($key === null) { $c['none_due'] = $pending === [] ? 1 : 0; return $c; }
+
+        // The build (ruling R18): under BEGIN IMMEDIATE, writing nothing; its moment taken once the lock is held.
+        $pdo->exec('BEGIN IMMEDIATE');
+        try {
+            $built = (int)$clock();
+            $b = self::build($pdo, $config, $dataDir, $key, $built);
+            $pdo->exec('COMMIT');
+        } catch (\Throwable $e) {
+            try { $pdo->exec('ROLLBACK'); } catch (\Throwable $e2) { /* nothing held */ }
+            throw $e;
+        }
+        $c['built'] = 1;
+        if ($b['items'] === 0) { $c['none_due'] = 1; return $c; }
+        $createdAt = UtcClock::stamp($built);
+        $sections = json_encode($b['sections'], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+
+        // 0. The privacy guard, before the claim: a text that fails is never claimed or sent, and is missed at once.
+        if (!self::digitRunFree($b['text'], $b['refs'])) {
+            if (self::writeRow($pdo, $day, $key, 'missed', 0, 'digit_run', null, UtcClock::stamp($now))) $c['digit_run'] = 1;
+            else $c['row_lost'] = 1;
+            return $c;
+        }
+
+        // 1. The fresh read the claim decides on (ruling R19), and the claim.
+        if (!JobBudget::mayStart($until, self::SEND_S, (int)$clock())) { $c['cut'] = 1; return $c; }
+        if (!class_exists('PluginConfig')) require_once __DIR__ . '/PluginConfig.php';
+        $lc = \PluginConfig::read($pluginRoot, $dataDir);
+        if (!class_exists('WaSendBudget')) require_once __DIR__ . '/WaSendBudget.php';
+        if (!self::truthy($lc['quote_daily_list_enabled'] ?? null) || !self::truthy($lc['quote_tracking_enabled'] ?? null)
+            || !\WaSendBudget::on($lc, $dataDir)) {
+            $c['held_fresh_read'] = 1;
+            return $c;
+        }
+        if (!class_exists('EvolutionApiService')) require_once __DIR__ . '/EvolutionApiService.php';
+        $inst = (string)(new \EvolutionApiService($lc))->instanceFor('sales');
+        $ledger = \WaSendBudget::forInstall($lc, $dataDir, $store, null, $clock);
+        $ref = 'list:' . $day . ':' . $key;
+        $cl = $ledger->claim($inst, 'staff_list', $ref);
+        if (empty($cl['ok'])) {
+            $code = (string)($cl['defer'] ?? 'ledger_unknown');
+            if ($code === 'already_sent') {
+                // A try of this list today went or may have gone: recorded uncertain with this run's build, never again.
+                if (self::writeRow($pdo, $day, $key, 'uncertain', $b['items'], 'already_sent', $sections, $createdAt)) $c['already_sent'] = 1;
+                else $c['row_lost'] = 1;
+                return $c;
+            }
+            self::setState($pdo, 'list_last:' . $day . ':' . $key, $code);
+            $c['deferred'] = 1;
+            return $c;
+        }
+        $claim = (int)$cl['claim'];
+
+        // 2. The send, on the job's own AlertService; the raw answer read back.
+        if (!class_exists('AlertService')) require_once __DIR__ . '/AlertService.php';
+        $al = new \AlertService($store, $lc);
+        $alertKey = 'quote_list:' . $day . ':' . ($key === self::CENTRAL ? self::CENTRAL : substr($key, 6));
+        $res = $key === self::CENTRAL ? $al->notify($alertKey, $b['text'], self::COOLDOWN_MIN)
+                                      : $al->notifyTo((string)$b['phone'], $alertKey, $b['text'], self::COOLDOWN_MIN);
+        $r = $al->lastResult();
+
+        // 3. The settle, from the raw answer (A11-01), then the list's row with the outcome the settle asked for.
+        if ($r !== null) {
+            $waId = (string)($r['data']['key']['id'] ?? ($r['key']['id'] ?? ''));
+            if (!empty($r['ok'])) {
+                $ledger->settle($claim, 'sent', ['wa_message_id' => $waId]);
+                $outcome = 'sent'; $detail = null;
+            } else {
+                $maybe = \EvolutionApiService::mayHaveBeenSent($r);
+                $ledger->settle($claim, 'failed', ['maybe_sent' => $maybe, 'wa_message_id' => $waId, 'detail' => $maybe ? 'maybe_sent' : 'send_failed']);
+                $outcome = $maybe ? 'uncertain' : 'not_sent'; $detail = $maybe ? 'maybe_sent' : 'send_failed';
+            }
+        } elseif ((string)($res['reason'] ?? '') === 'cooldown') {
+            $ledger->settle($claim, 'failed', ['maybe_sent' => true, 'detail' => 'alert_cooldown']);
+            $outcome = 'uncertain'; $detail = 'alert_cooldown';
+        } else {
+            $ledger->settle($claim, 'failed', ['detail' => 'no_answer']);
+            $outcome = 'not_sent'; $detail = 'no_answer';
+        }
+        if (self::writeRow($pdo, $day, $key, $outcome, $b['items'], $detail, $sections, $createdAt)) $c[$outcome] = 1;
+        else $c['row_lost'] = 1;
+        if ($outcome === 'not_sent') self::setState($pdo, 'list_last:' . $day . ':' . $key, 'not_sent');
+        return $c;
+    }
+
+    /**
+     * The once-a-day sweep (§H.2.11.3, "Missed lists"; A13-03): in one transaction, every owner still due today is written
+     * `missed` with its last code (list_last:<date>:<owner_key>) or no_attempt; list_swept is set to today and every
+     * list_last key dated today or earlier is removed. An owner whose ref holds a staff_list ledger row in flight, sent or
+     * uncertain is left out: that try may have gone (Q18-F03). A list switched on after today's window wrote no list today
+     * and sweeps nothing.
+     *
+     * @return array{missed:int, left_out:int}
+     */
+    public static function sweep(\PDO $pdo, array $config, ?string $dataDir, int $now): array
+    {
+        $out = ['missed' => 0, 'left_out' => 0];
+        $day = self::localDay($now);
+        $since = UtcClock::parse($config['quote_daily_list_since'] ?? '');
+        $lateStart = $since > 0 && $since >= self::dayStart($now) + self::HOUR_TO * 3600;
+        $pdo->exec('BEGIN IMMEDIATE');
+        try {
+            if (!$lateStart) {
+                $hasLedger = self::hasTable($pdo, 'wa_auto_sends');
+                $tried = $hasLedger ? $pdo->prepare("SELECT 1 FROM wa_auto_sends WHERE kind = 'staff_list' AND ref = ?
+                                                       AND (outcome IS NULL OR outcome IN ('sent','uncertain')) LIMIT 1") : null;
+                foreach (self::pendingToday($pdo, $config, $dataDir, $now) as $key) {
+                    if ($tried !== null) {
+                        $tried->execute(['list:' . $day . ':' . $key]);
+                        if ($tried->fetchColumn() !== false) { $out['left_out']++; continue; }
+                    }
+                    $code = self::state($pdo, 'list_last:' . $day . ':' . $key);
+                    $ins = $pdo->prepare("INSERT INTO quote_list_sends (list_date, owner_key, outcome, item_count, detail, sections, created_at)
+                                          VALUES (?, ?, 'missed', 0, ?, NULL, ?)");
+                    $ins->execute([$day, $key, ($code === null || $code === '') ? 'no_attempt' : $code, UtcClock::stamp($now)]);
+                    $out['missed']++;
+                }
+            }
+            $pdo->prepare("INSERT OR REPLACE INTO quote_followup_state (k, v, updated_at) VALUES ('list_swept', ?, datetime('now'))")
+                ->execute([$day]);
+            $pdo->prepare("DELETE FROM quote_followup_state WHERE k LIKE 'list_last:%' AND substr(k, 11, 10) <= ?")->execute([$day]);
+            $pdo->exec('COMMIT');
+        } catch (\Throwable $e) {
+            try { $pdo->exec('ROLLBACK'); } catch (\Throwable $e2) { /* nothing was committed */ }
+            throw $e;
+        }
+        return $out;
+    }
+
+    /** A quote_list_sends row; false when the store refused it (the day's row exists already). */
+    private static function writeRow(\PDO $pdo, string $day, string $key, string $outcome, int $items, ?string $detail, ?string $sections, string $createdAt): bool
+    {
+        try {
+            $pdo->prepare('INSERT INTO quote_list_sends (list_date, owner_key, outcome, item_count, detail, sections, created_at)
+                           VALUES (?, ?, ?, ?, ?, ?, ?)')
+                ->execute([$day, $key, $outcome, $items, $detail, $sections, $createdAt]);
+            return true;
+        } catch (\Throwable $e) {
+            return false;
+        }
+    }
+
+    // ── the staff page (§H.2.11.5) ──────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * The page's rows: every quotation the list reads (open, or answered or opted out this week), for one salesperson
+     * ($ownerId: rows whose owner_staff_id is theirs) or for everyone ($ownerId null: seesAll). Each row: key, ref, owner
+     * (staff id or null), conv (the conversation the call is made on), name (the customer's), section (the first of
+     * due, call, replied, stop, or 'scheduled'), stop, expiring, maybe_sent, next (the next step's moment, unix, or null)
+     * and hold (a fixed code). The phone is never returned.
+     *
+     * @return array<int,array>
+     */
+    public static function pageRows(\PDO $pdo, array $config, ?string $dataDir, ?int $ownerId, int $now): array
+    {
+        if (!self::hasTable($pdo, 'quote_tracker')) return [];
+        $ws = UtcClock::stamp(self::weekStart($now));
+        $sql = "SELECT * FROM quote_tracker WHERE (status = 'open' OR (status IN ('answered','opted_out') AND status_at >= ?))";
+        $args = [$ws];
+        if ($ownerId !== null) { $sql .= ' AND owner_staff_id = ?'; $args[] = $ownerId; }
+        $st = $pdo->prepare($sql . ' ORDER BY sent_at DESC, quote_key');
+        $st->execute($args);
+        $rows = $st->fetchAll(\PDO::FETCH_ASSOC);
+        if (!class_exists('QuoteChase')) require_once __DIR__ . '/QuoteChase.php';
+        $chaseOn = \QuoteChase::on($config, $dataDir);
+        $out = [];
+        $fu = $pdo->prepare('SELECT closed_at, close_reason, due_at FROM followups WHERE id = ?');
+        foreach ($rows as $r) {
+            $c = self::classify($pdo, $config, $dataDir, [$r], $now);
+            $key = (string)$r['quote_key'];
+            $section = 'scheduled';
+            foreach (['due', 'call', 'replied', 'stop'] as $s) {
+                if (in_array($key, $c['sections'][$s], true)) { $section = $s; break; }
+            }
+            $next = null; $hold = null;
+            $f = null;
+            if ((int)($r['followup_id'] ?? 0) > 0) { $fu->execute([(int)$r['followup_id']]); $f = $fu->fetch(\PDO::FETCH_ASSOC) ?: null; }
+            if ($f !== null && $f['closed_at'] === null && $chaseOn && $f['due_at'] !== null) $next = UtcClock::parse((string)$f['due_at']);
+            if (in_array($section, ['call', 'scheduled'], true) && ($section === 'call' || $next === null)) {
+                if (!$chaseOn) $hold = 'chase_off';
+                elseif (trim((string)($r['chase_hold'] ?? '')) !== '') $hold = (string)$r['chase_hold'];
+                elseif ($f !== null && $f['closed_at'] !== null) $hold = 'closed:' . (string)($f['close_reason'] ?? '');
+                elseif ($f !== null && $section === 'call') $hold = self::PERSONA_HELD;
+                elseif ($f === null) $hold = 'not_opened';
+            }
+            $conv = (int)($r['spoke_conv_id'] ?? 0) > 0 ? (int)$r['spoke_conv_id'] : (int)($r['sent_conv_id'] ?? 0);
+            $out[] = [
+                'key' => $key, 'ref' => (string)$r['quote_ref'], 'owner' => $r['owner_staff_id'] === null ? null : (int)$r['owner_staff_id'],
+                'conv' => $conv, 'name' => self::customerName($pdo, $r, $conv), 'section' => $section, 'stop' => $section === 'stop',
+                'expiring' => in_array($key, $c['sections']['expiring'], true), 'maybe_sent' => in_array($key, $c['sections']['maybe_sent'], true),
+                'unread' => ($c['notes'][$key] ?? '') === 'unread', 'note' => (string)($c['notes'][$key] ?? ''),
+                'next' => $section === 'stop' ? null : $next, 'hold' => $section === 'stop' ? null : $hold, 'status' => (string)$r['status'],
+            ];
+        }
+        return $out;
+    }
+
+    /** The page's section words (§H.2.11.5): the list's, and 'scheduled' for a chase whose next step is on a later day. */
+    const PAGE_SECTIONS = [
+        'due'       => 'Reminder due today (sent automatically)',
+        'call'      => 'Yours to call (no automatic reminder)',
+        'replied'   => 'Replied, not yet paid — call them',
+        'stop'      => 'Asked us to stop — do not message',
+        'scheduled' => 'Automatic reminder later',
+    ];
+    /** A hold in plain words (the page's "or the hold in plain words"); fixed text, never data. */
+    const HOLD_WORDS = [
+        'chase_off'        => 'automatic reminders are off',
+        'never_wrote'      => 'the customer never wrote to us: no automatic reminder',
+        'owned_number'     => 'on your own WhatsApp number: no automatic reminder',
+        'partner_number'   => "on a partner's number: no automatic reminder",
+        'colleague'        => "one of DishNet's own numbers",
+        'ambiguous'        => 'the chat does not say what they asked about: no automatic reminder',
+        'escalation'       => 'handed to a person: no automatic reminder',
+        'before_switch_on' => 'sent before automatic reminders began',
+        'past_validity'    => 'too close to its expiry for a reminder',
+        'not_opened'       => 'reminder not set up yet',
+        self::PERSONA_HELD => "this step's reminder is held: yours to call",
+        'closed:exhausted' => 'all three reminders were sent',
+    ];
+
+    /** A hold code in plain words; an unknown code reads as "no automatic reminder". */
+    public static function holdWords(?string $hold): string
+    {
+        if ($hold === null || $hold === '') return '';
+        if (isset(self::HOLD_WORDS[$hold])) return self::HOLD_WORDS[$hold];
+        if (strpos($hold, 'channel_refused:') === 0) return 'the number may not send automatic messages';
+        return 'no automatic reminder';
+    }
+
+    /** A moment as the page prints it: Kampala, e.g. "Wed 4 Nov, 10:00". */
+    public static function when(int $t): string
+    {
+        return self::local($t)->format('D j M, H:i');
+    }
+
+    /** The customer's name: the conversation's display_name or crm_client_name, else the KYC application's, else the lead's. */
+    private static function customerName(\PDO $pdo, array $r, int $conv): string
+    {
+        if ($conv > 0) {
+            $st = $pdo->prepare('SELECT display_name, crm_client_name FROM wa_conversations WHERE id = ?');
+            $st->execute([$conv]);
+            $c = $st->fetch(\PDO::FETCH_ASSOC);
+            if (is_array($c)) {
+                foreach (['display_name', 'crm_client_name'] as $f) {
+                    $v = trim((string)($c[$f] ?? ''));
+                    if ($v !== '') return $v;
+                }
+            }
+        }
+        $qid = $r['quote_id'] === null ? '' : (string)(int)$r['quote_id'];
+        $ref = (string)$r['quote_ref'];
+        foreach ([['kyc_applications', 'quote_id', $qid], ['kyc_applications', 'quote_ref', $ref]] as [$t, $f, $v]) {
+            foreach (self::blobWhere($pdo, $t, $f, $v) as $a) {
+                $n = trim(trim((string)($a['firstname'] ?? '')) . ' ' . trim((string)($a['lastname'] ?? '')));
+                if ($n !== '') return $n;
+            }
+        }
+        foreach ([['leads', 'crm_quote_id', $qid], ['leads', 'quote_ref', $ref]] as [$t, $f, $v]) {
+            foreach (self::blobWhere($pdo, $t, $f, $v) as $l) {
+                $n = trim((string)($l['customer_name'] ?? ''));
+                if ($n !== '') return $n;
+            }
+        }
+        return '';
+    }
+
+    // ── small things ────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** quote_daily_list_staff: the pilot ids, or null when unset (no limit). A list, or digits separated by anything. */
+    private static function pilotIds(array $config): ?array
+    {
+        $raw = $config['quote_daily_list_staff'] ?? null;
+        if ($raw === null || $raw === '' || $raw === []) return null;
+        $parts = is_array($raw) ? $raw : (preg_split('/[^0-9]+/', (string)$raw) ?: []);
+        $ids = [];
+        foreach ($parts as $p) { $p = trim((string)$p); if ($p !== '' && ctype_digit($p) && (int)$p > 0) $ids[] = (int)$p; }
+        return $ids;
+    }
+
+    /** The retailers rows (the store's JSON collection), by id. */
+    private static function retailers(\PDO $pdo): array
+    {
+        $out = [];
+        if (!self::hasTable($pdo, 'retailers')) return $out;
+        foreach ($pdo->query('SELECT id, data FROM retailers ORDER BY id')->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            $d = json_decode((string)$r['data'], true);
+            if (!is_array($d)) continue;
+            $d['id'] = (int)$r['id'];
+            $out[(int)$r['id']] = $d;
+        }
+        return $out;
+    }
+
+    /** The staff names the page shows managers, by id ('' when the account has none). */
+    public static function staffNames(\PDO $pdo): array
+    {
+        $out = [];
+        foreach (self::retailers($pdo) as $id => $r) $out[$id] = trim((string)($r['name'] ?? ''));
+        return $out;
+    }
+
+    /** The rows of a JSON collection whose $.field equals $value (as text, trimmed). An absent table is empty. */
+    private static function blobWhere(\PDO $pdo, string $table, string $field, string $value): array
+    {
+        if (trim($value) === '' || !self::hasTable($pdo, $table)) return [];
+        $st = $pdo->prepare("SELECT id, data FROM [{$table}] WHERE TRIM(CAST(json_extract(data, '$.{$field}') AS TEXT)) = ? ORDER BY id");
+        $st->execute([trim($value)]);
+        $out = [];
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            $d = json_decode((string)$r['data'], true);
+            if (is_array($d)) $out[] = $d;
+        }
+        return $out;
+    }
+
+    private static function state(\PDO $pdo, string $k): ?string
+    {
+        if (!self::hasTable($pdo, 'quote_followup_state')) return null;
+        $st = $pdo->prepare('SELECT v FROM quote_followup_state WHERE k = ?');
+        $st->execute([$k]);
+        $v = $st->fetchColumn();
+        return $v === false ? null : (string)$v;
+    }
+
+    private static function setState(\PDO $pdo, string $k, string $v): void
+    {
+        $pdo->prepare("INSERT OR REPLACE INTO quote_followup_state (k, v, updated_at) VALUES (?, ?, datetime('now'))")->execute([$k, $v]);
+    }
+
+    private static function hasTable(\PDO $pdo, string $name): bool
+    {
+        $st = $pdo->prepare("SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = ?");
+        $st->execute([$name]);
+        return (int)$st->fetchColumn() > 0;
+    }
+
+    private static function local(int $t): \DateTime
+    {
+        return (new \DateTime('@' . $t))->setTimezone(new \DateTimeZone(self::TZ));
+    }
+
+    /** The Kampala date of $t. */
+    public static function localDay(int $t): string
+    {
+        return self::local($t)->format('Y-m-d');
+    }
+
+    /** Kampala midnight of $t's day, as unix time. */
+    private static function dayStart(int $t): int
+    {
+        return (new \DateTime(self::localDay($t) . ' 00:00:00', new \DateTimeZone(self::TZ)))->getTimestamp();
+    }
+
+    /** The start of "this week": Kampala midnight six days before today's. */
+    private static function weekStart(int $t): int
+    {
+        return self::dayStart(self::dayStart($t) - (self::WEEK_DAYS - 1) * 86400 + 3600);
+    }
+
+    /** The master flag rule: 1, true, on, yes. */
+    private static function truthy($v): bool
+    {
+        if ($v === true) return true;
+        return in_array(strtolower(trim((string)($v ?? ''))), ['1', 'true', 'on', 'yes'], true);
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/QuoteSendEvidence.php b/dishnet-hybrid-sudan/lib/QuoteSendEvidence.php
new file mode 100644
index 0000000..f6e6d3c
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/QuoteSendEvidence.php
@@ -0,0 +1,314 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * QuoteSendEvidence — what proves a quotation was sent on WhatsApp, and the pure rules read from it (5.18.104, Uganda,
+ * root docs/73 §H.2.9.1–§H.2.9.5; contract C9; Part P's IP-1).
+ *
+ * Pure: nothing here opens a book, a file or a connection. The tracker (lib/QuoteTracker.php), the report
+ * (tools/sales_followup_report.php) and Part P's agent copy (lib/QuoteAgentCopy.php) pass the rows in.
+ *
+ *   EVENTS, MARKERS     a row confirms a quote when it is outbound, its event is in EVENTS and its body carries one of the
+ *                       three markers with the number (§H.2.9.1); sendDocument never writes wa_messages, so a PDF is never
+ *                       evidence
+ *   read($row)          [marker, number] of a confirming row, or null
+ *   key($number)        'ref:' + the number, trimmed, a leading '#' removed (§H.2.9.2)
+ *   validUntil(...)     the Kampala date the quotation is valid until (§H.2.9.3)
+ *   kycAgent(...)       owner rule 1 — the ONE function rules 1 and 6 and Part P's P7 call (§H.2.9.4, IP-1)
+ *   owner(...)          owner rules 1–7 over the facts passed in; the first that yields one active retailers row
+ *   spokeTo(...)        the conversation the customer spoke to us on (§H.2.9.5)
+ *   sentChannel(...)    the Evolution channel the quotation left from: account | support (§H.2.9.2)
+ *   madeBy(...)         kyc | lead | manual | ucrm | resend | lte
+ *
+ * Every date is computed in a literal Africa/Kampala zone (R-16), never dn_tz(). PHP 7.4.
+ */
+final class QuoteSendEvidence
+{
+    /** The literal zone every date here is computed in. */
+    public const TZ = 'Africa/Kampala';
+
+    /** The quotation events (NotificationRetry::EVENTS' quote subset minus quote_cash; lib/NotificationRetry.php:32). */
+    const EVENTS = ['ops_quote_created', 'ops_quote_wa', 'ops_quote_text', 'quote_kyc', 'quote_lead', 'quote_manual'];
+
+    /** The three markers with the number (lib/QuotationService.php:513, webhook.php:3002, includes/api/api_whatsapp.php:665,674). */
+    const MARKERS = [
+        'ref'   => '📋 *Ref:* ',
+        'order' => '🆔 *Order:* ',
+        'quote' => '📄 *Quote #',
+    ];
+
+    /** The validity line the 📋 texts carry (lib/QuotationService.php:503-504,516): date('d M Y'). */
+    const VALID_LINE = '⏳ *Valid Until:* ';
+
+    /** A uCRM quotation's PDF is valid 7 days from its date (ucrm_pdf_templates/quotation_uganda/template.html.twig:205). */
+    const UCRM_VALID_DAYS = 7;
+    /** "Valid for 30 days." (includes/api/api_whatsapp.php:670,679). */
+    const QUOTE_TEXT_VALID_DAYS = 30;
+
+    /** A customer's latest inbound row must fall in (sent_at − 30 d, sent_at] for spoke-to (§H.2.9.5). */
+    const SPOKE_WINDOW_S = 30 * 86400;
+
+    /** The owner sources a tracker row may carry; 'pending' only while no rule yields and the row is under 1 h old. */
+    const OWNER_SOURCES = ['kyc_sales_person', 'kyc_submitter', 'lead_owner', 'quotes_log', 'channel', 'conv_lead',
+                           'kyc_client', 'pending', 'none'];
+
+    // ── evidence ──────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * [marker, number] when $row confirms a quotation (outbound, an EVENTS event, a marker with a number), else null.
+     * $row: direction, event_key, body (a wa_messages row as stored).
+     *
+     * @return array{0:string,1:string}|null
+     */
+    public static function read(array $row): ?array
+    {
+        if ((string)($row['direction'] ?? '') !== 'out') return null;
+        if (!in_array((string)($row['event_key'] ?? ''), self::EVENTS, true)) return null;
+        return self::numberOf((string)($row['body'] ?? ''));
+    }
+
+    /**
+     * The first marker in the text, and the number it carries, or null. The 📋 and 🆔 markers carry the rest of their
+     * line; 📄 carries what stands before its closing '*'.
+     *
+     * @return array{0:string,1:string}|null
+     */
+    public static function numberOf(string $body): ?array
+    {
+        $best = null;
+        foreach (self::MARKERS as $kind => $marker) {
+            $p = strpos($body, $marker);
+            if ($p === false) continue;
+            if ($best === null || $p < $best[1]) $best = [$kind, $p];
+        }
+        if ($best === null) return null;
+        [$kind, $p] = $best;
+        $rest = substr($body, $p + strlen(self::MARKERS[$kind]));
+        $nl = strpos($rest, "\n");
+        $line = $nl === false ? $rest : substr($rest, 0, $nl);
+        if ($kind === 'quote') {
+            $star = strpos($line, '*');
+            if ($star === false) return null;
+            $line = substr($line, 0, $star);
+        }
+        $number = self::clean($line);
+        return $number === '' ? null : [$kind, $number];
+    }
+
+    /** The number, trimmed, with a leading '#' removed (§H.2.9.2). */
+    public static function clean(string $number): string
+    {
+        $n = trim($number);
+        if ($n !== '' && $n[0] === '#') $n = trim(substr($n, 1));
+        return $n;
+    }
+
+    /** quote_key = 'ref:' + the number the customer saw (A3). */
+    public static function key(string $number): string
+    {
+        return 'ref:' . self::clean($number);
+    }
+
+    // ── valid_until (§H.2.9.3) ───────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * The Kampala date (Y-m-d) the quotation is valid until: the earlier of the date the text states (the 📋 validity
+     * line, or the sent date + 30 for 📄) and, when a uCRM id is known, the Kampala send date + 7. A 🆔 text states none
+     * and is always a uCRM quotation, so the second applies to it whether or not its id was mapped. With no date at all
+     * (a 📋 text whose line cannot be read and no uCRM id), the sent date + 7: the shorter rule, so a chase stops sooner.
+     */
+    public static function validUntil(string $marker, string $body, string $sentAtUtc, bool $quoteIdKnown): string
+    {
+        $sentDay = self::kampalaDay($sentAtUtc);
+        $dates = [];
+        if ($marker === 'ref') {
+            $stated = self::statedValidity($body);
+            if ($stated !== null) $dates[] = $stated;
+        } elseif ($marker === 'quote') {
+            $dates[] = self::addDays($sentDay, self::QUOTE_TEXT_VALID_DAYS);
+        }
+        if ($quoteIdKnown || $marker === 'order') $dates[] = self::addDays($sentDay, self::UCRM_VALID_DAYS);
+        if ($dates === []) $dates[] = self::addDays($sentDay, self::UCRM_VALID_DAYS);
+        sort($dates);
+        return $dates[0];
+    }
+
+    /** The date on the 📋 validity line, Y-m-d, or null when there is none or it cannot be read. */
+    public static function statedValidity(string $body): ?string
+    {
+        $p = strpos($body, self::VALID_LINE);
+        if ($p === false) return null;
+        $rest = substr($body, $p + strlen(self::VALID_LINE));
+        $nl = strpos($rest, "\n");
+        $s = trim($nl === false ? $rest : substr($rest, 0, $nl));
+        $d = \DateTime::createFromFormat('!d M Y', $s, new \DateTimeZone(self::TZ));
+        if ($d === false) return null;
+        $errs = \DateTime::getLastErrors();
+        if (is_array($errs) && ((int)($errs['warning_count'] ?? 0) > 0 || (int)($errs['error_count'] ?? 0) > 0)) return null;
+        return $d->format('Y-m-d');
+    }
+
+    /** The Kampala date of a UTC storage stamp. */
+    public static function kampalaDay(string $utcStamp): string
+    {
+        $t = strtotime(trim($utcStamp) . ' UTC');
+        if ($t === false) $t = 0;
+        return (new \DateTime('@' . $t))->setTimezone(new \DateTimeZone(self::TZ))->format('Y-m-d');
+    }
+
+    private static function addDays(string $day, int $n): string
+    {
+        $d = new \DateTime($day . ' 12:00:00', new \DateTimeZone(self::TZ));
+        $d->modify('+' . $n . ' days');
+        return $d->format('Y-m-d');
+    }
+
+    // ── owners (F4, §H.2.9.4) ────────────────────────────────────────────────────────────────────────────────────
+
+    /** An active account (StaffDirectory::isActive, lib/StaffDirectory.php:38): only active accounts count. */
+    public static function isActive(array $row): bool
+    {
+        return !empty($row['is_active']);
+    }
+
+    /**
+     * The id of the ONE active account named $name (exact, case-insensitive, trimmed; cron_quote_wa.php:177-183), or
+     * null: no match, two or more active matches, or a match that is inactive only.
+     */
+    public static function activeByName(array $retailerRows, string $name): ?int
+    {
+        $want = strtolower(trim($name));
+        if ($want === '') return null;
+        $hit = [];
+        foreach ($retailerRows as $r) {
+            if (!is_array($r) || !self::isActive($r)) continue;
+            if (strtolower(trim((string)($r['name'] ?? ''))) === $want && (int)($r['id'] ?? 0) > 0) $hit[(int)$r['id']] = true;
+        }
+        return count($hit) === 1 ? (int)array_key_first($hit) : null;
+    }
+
+    /** The id when it names an active account, else null. */
+    public static function activeId(array $retailerRows, $id): ?int
+    {
+        $id = (int)$id;
+        if ($id <= 0) return null;
+        foreach ($retailerRows as $r) {
+            if (is_array($r) && (int)($r['id'] ?? 0) === $id) return self::isActive($r) ? $id : null;
+        }
+        return null;
+    }
+
+    /**
+     * Owner rule 1 on one KYC application: `sales_person` naming exactly one active account → kyc_sales_person; else an
+     * active `retailer_id` → kyc_submitter; else none. Two or more active accounts named, or a name that matches only an
+     * inactive account, give no owner from the name. The one function rules 1 and 6 and Part P's P7 call (IP-1).
+     *
+     * @return array{id:?int, source:string}
+     */
+    public static function kycAgent(array $application, array $retailerRows): array
+    {
+        $byName = self::activeByName($retailerRows, (string)($application['sales_person'] ?? ''));
+        if ($byName !== null) return ['id' => $byName, 'source' => 'kyc_sales_person'];
+        $sub = self::activeId($retailerRows, $application['retailer_id'] ?? 0);
+        if ($sub !== null) return ['id' => $sub, 'source' => 'kyc_submitter'];
+        return ['id' => null, 'source' => 'none'];
+    }
+
+    /**
+     * Rules 1–7 (A12), the first that yields one active retailers row. $f holds what the tracker read for the row:
+     *   kyc_app      the KYC application mapped by quote_id (rule 1)
+     *   lead_log     a quotes_log row of type lead joined by crm_quote_id or quote_ref (rule 2's condition) …
+     *   lead         … and the lead it names (its assigned_to)
+     *   log          the quotes_log row joined by crm_quote_id or quote_ref (rule 3, its sent_by)
+     *   spoke_chan   the spoke-to conversation's wa_channels row (rule 4: owner_type staff; a partner yields none)
+     *   conv_lead    the lead that conversation's lead_id names (rule 5)
+     *   client_app   the latest KYC for the same crm_client_id before sent_at (rule 6)
+     *
+     * @return array{id:?int, source:string}   source 'none' when no rule yields (rule 7: the central list)
+     */
+    public static function owner(array $f, array $retailerRows): array
+    {
+        if (is_array($f['kyc_app'] ?? null)) {
+            $k = self::kycAgent($f['kyc_app'], $retailerRows);
+            if ($k['id'] !== null) return $k;
+        }
+        if (!empty($f['lead_log']) && is_array($f['lead'] ?? null)) {
+            $id = self::activeId($retailerRows, $f['lead']['assigned_to'] ?? 0);
+            if ($id !== null) return ['id' => $id, 'source' => 'lead_owner'];
+        }
+        if (is_array($f['log'] ?? null)) {
+            $id = self::activeByName($retailerRows, (string)($f['log']['sent_by'] ?? ''));
+            if ($id !== null) return ['id' => $id, 'source' => 'quotes_log'];
+        }
+        $ch = $f['spoke_chan'] ?? null;
+        if (is_array($ch) && (string)($ch['owner_type'] ?? '') === 'staff') {
+            $id = self::activeId($retailerRows, $ch['owner_staff_id'] ?? 0);
+            if ($id !== null) return ['id' => $id, 'source' => 'channel'];
+        }
+        if (is_array($f['conv_lead'] ?? null)) {
+            $id = self::activeId($retailerRows, $f['conv_lead']['assigned_to'] ?? 0);
+            if ($id !== null) return ['id' => $id, 'source' => 'conv_lead'];
+        }
+        if (is_array($f['client_app'] ?? null)) {
+            $k = self::kycAgent($f['client_app'], $retailerRows);
+            if ($k['id'] !== null) return ['id' => $k['id'], 'source' => 'kyc_client'];
+        }
+        return ['id' => null, 'source' => 'none'];
+    }
+
+    // ── spoke-to, the channel, the maker (§H.2.9.2, §H.2.9.5) ───────────────────────────────────────────────────
+
+    /**
+     * The conversation the customer spoke to us on: among $candidates (each id, channel, role, category, last_in — the
+     * latest inbound row's stamp at or before the send, UTC, or null), those not filed 'staff' whose last_in falls in
+     * (sent_at − 30 d, sent_at]; the later one wins; a tie goes to a sales-role channel, then the lower id. Null = never
+     * wrote. The caller passes only conversations whose phone is exactly the customer's (never the last nine digits).
+     */
+    public static function spokeTo(array $candidates, string $sentAtUtc): ?array
+    {
+        $sent = strtotime(trim($sentAtUtc) . ' UTC');
+        if ($sent === false) return null;
+        $best = null;
+        foreach ($candidates as $c) {
+            if (!is_array($c)) continue;
+            if (strtolower(trim((string)($c['category'] ?? ''))) === 'staff') continue;
+            $li = trim((string)($c['last_in'] ?? ''));
+            if ($li === '') continue;
+            $t = strtotime($li . ' UTC');
+            if ($t === false || $t <= $sent - self::SPOKE_WINDOW_S || $t > $sent) continue;
+            $rank = [$t, ((string)($c['role'] ?? '') === 'sales') ? 1 : 0, -(int)($c['id'] ?? 0)];
+            if ($best === null || $rank > $best[0]) $best = [$rank, $c];
+        }
+        return $best === null ? null : $best[1];
+    }
+
+    /** `account` when the conversation is `accounts` or wa_force_accounts is on (lib/NotificationService.php:127-129,1920-1926). */
+    public static function sentChannel(string $convChannel, bool $forceAccounts): string
+    {
+        return ($convChannel === 'accounts' || $forceAccounts) ? 'account' : 'support';
+    }
+
+    /** wa_force_accounts as NotificationService reads it (true, '1' or 1). */
+    public static function forceAccounts(array $config): bool
+    {
+        $v = $config['wa_force_accounts'] ?? false;
+        return $v === true || $v === '1' || $v === 1;
+    }
+
+    /**
+     * Who made it: resend for the WhatsApp tab's text fallback; kyc when a KYC application maps it; lte for a KYC-form
+     * text no application maps (the LTE registration's, includes/api/api_crm_misc.php:574-640); lead or manual by the
+     * plugin's own quote log or its event; ucrm otherwise (made in uCRM: the webhook or cron flow B).
+     */
+    public static function madeBy(string $event, ?array $kycApp, ?array $logRow): string
+    {
+        if ($event === 'ops_quote_text') return 'resend';
+        if ($kycApp !== null) return 'kyc';
+        if ($event === 'quote_kyc') return 'lte';
+        $type = $logRow !== null ? (string)($logRow['type'] ?? '') : '';
+        if ($event === 'quote_lead' || $type === 'lead') return 'lead';
+        if ($event === 'quote_manual' || $type === 'manual') return 'manual';
+        if ($type === 'kyc') return 'lte';
+        return 'ucrm';
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/QuoteTracker.php b/dishnet-hybrid-sudan/lib/QuoteTracker.php
new file mode 100644
index 0000000..dabcef4
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/QuoteTracker.php
@@ -0,0 +1,936 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/StaffJobsGate.php';
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/QuoteSendEvidence.php';
+require_once __DIR__ . '/HumanTakeover.php';
+
+/**
+ * QuoteTracker — quote tracking, P2a (5.18.104, Uganda, root docs/73 §H.2.9; contract C7, C9; rulings R3, R18).
+ *
+ * Tracking records; it sends nothing. One run, from cron/quote_chase.php (master's `quote_chase` line, behind
+ * `quote_tracking_enabled`), at ONE moment taken when it begins:
+ *
+ *   1. derive    up to 500 wa_messages ids past the cursor (`quote_followup_state` tracker_cursor). Each confirming row
+ *                (QuoteSendEvidence) gives one quote_tracker row per quote_key, the earliest winning (INSERT OR IGNORE);
+ *                a clash on idx_qt_quote_id is recorded once as ref_conflict:<quote_key>. The rows, those records and
+ *                the cursor are written in ONE transaction, never the cursor before them (§H.2.9.2, Q17-F04). The
+ *                statuses set at creation (colleague, paid) and backfilled (sent before quote_tracking_since, R-17)
+ *                are written with the row (§H.2.9.5).
+ *   2. owners    rules 1–7 (F4, §H.2.9.4). With none yielding a row under 1 h old is `pending` and retried; at 1 h it is
+ *                final (`none`). A run whose owner pass reached every pending row ends by writing `tracker_ran`, its
+ *                moment (ruling R18; Q16-F04); a run its budget cut short writes none.
+ *   3. stops     §H.2.9.7, in order, on every open row; the first that holds sets the status once (qt_status_once) and
+ *                closes the linked follow-up with the same reason (STATUS_TO_CLOSE).
+ *   4. mapping   a linked follow-up closed by another job maps back (§H.2.10.8, CLOSE_TO_STATUS); a close that keeps the
+ *                quotation open sets its chase_hold to the code.
+ *
+ * What the chase (stage B2b: lib/QuoteChase.php, cron/followup_send.php) reads from here: stop() and customerStop() —
+ * the same reads preSendCheck and the after-claim re-read make (§H.2.10.6 items 2 and 4); setStatus(); convIds();
+ * number() — which number a chase leaves from (§H.2.10.2); openingHold() — the holds an opening sets first (ambiguous,
+ * colleague; §H.2.10.3); ucrmStatus() — the uCRM status stop's mapping; the two close-reason tables.
+ *
+ * Inert unless on(): Uganda (StaffJobsGate) and quote_tracking_enabled. Every Kampala date and hour is computed in a
+ * literal Africa/Kampala zone. A table this reads that is absent reads as empty; any other read failure throws, so a
+ * run that cannot read a stop stops, and never reads "no stop". PHP 7.4.
+ */
+final class QuoteTracker
+{
+    /** The literal zone every Kampala date and hour here is computed in (R-16). */
+    public const TZ = 'Africa/Kampala';
+
+    /** 089's CHECK on quote_tracker.status. */
+    const STATUSES = ['open', 'answered', 'opted_out', 'taken', 'paid', 'registered', 'accepted', 'declined',
+                      'superseded', 'expired', 'colleague'];
+
+    /** wa_messages ids a run reads past the cursor (§H.2.9.2). */
+    const BATCH = 500;
+    /** An owner not found is retried while the row is under this old; then it is final (§H.2.9.4). */
+    const PENDING_S = 3600;
+    /** A quotation expires after 20:00 Kampala on valid_until (§H.2.9.7). */
+    const EXPIRY_HOUR = 20;
+    /** The first run reads back this far (§H.2.9.5: "the first run's 30 days"). */
+    const FIRST_RUN_S = 30 * 86400;
+
+    /** §H.2.9.7's stops the tracker reads every run, in order. The uCRM status (accepted/declined) is read by the
+     *  chase before a step is drafted (one GET), through ucrmStatus(). */
+    const STOPS = ['opted_out', 'answered', 'taken', 'paid', 'registered', 'accepted', 'superseded', 'expired'];
+    /** The three a customer or a colleague can cause in the seconds before a send (§H.2.10.6 item 4, ruling R18). */
+    const CUSTOMER_STOPS = ['opted_out', 'answered', 'taken'];
+
+    /** A stop's status → the reason the linked follow-up is closed with ("closes the linked follow-up with the same reason"). */
+    const STATUS_TO_CLOSE = [
+        'opted_out' => 'opted_out', 'answered' => 'replied', 'taken' => 'human_closed', 'paid' => 'converted',
+        'registered' => 'converted', 'accepted' => 'converted', 'declined' => 'not_interested',
+        'superseded' => 'superseded', 'expired' => 'expired', 'colleague' => 'staff',
+    ];
+    /** A follow-up's close reason → the tracker's status (§H.2.10.8). */
+    const CLOSE_TO_STATUS = [
+        'replied' => 'answered', 'opted_out' => 'opted_out', 'human_closed' => 'taken', 'staff_cancelled' => 'taken',
+        'escalated' => 'taken', 'converted' => 'accepted', 'not_interested' => 'declined', 'staff' => 'colleague',
+    ];
+    /** A close that leaves the quotation open with no hold: the chase ran out of steps; a stop or expiry ends it. */
+    const CLOSE_STAYS_OPEN = ['exhausted'];
+    /** Every other close reason (send_failed, cancelled, a channel refusal's code, rollback …) leaves the quotation open
+     *  with chase_hold set to the code. These two are the tracker's own closes, written after its status. */
+    const CLOSE_OWN = ['superseded', 'expired'];
+
+    /** The ops events that say a payment arrived (lib/NotificationService.php:799,749). */
+    const PAYMENT_EVENTS = ['ops_payment_received', 'ops_invoice_auto_paid'];
+
+    // ── the switch ─────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** Uganda (StaffJobsGate, with the data directory) and quote_tracking_enabled (1, true, on, yes). */
+    public static function on(array $config, ?string $dataDir): bool
+    {
+        return self::truthy($config['quote_tracking_enabled'] ?? null) && StaffJobsGate::applies($config, $dataDir);
+    }
+
+    // ── one run ────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /**
+     * One tracker run at $moment (unix time, the run's one moment), working while time() < $until. $store is the
+     * plugin store (ColleagueNumbers, AutomationPolicy read the accounts through it); null leaves those checks out.
+     *
+     * @return array<string,int> counts and fixed flags only — never an id: read, confirming, inserted, kept_earliest,
+     *                           ref_conflict, no_phone, advanced (1 when the cursor moved; the cursor itself is a
+     *                           wa_messages.id and is never returned), owners_found, owners_final, owners_pending, ran
+     *                           (1 when tracker_ran was written), stopped, mapped, held, cut (1 when the budget ended
+     *                           the run early)
+     */
+    public static function run(\PDO $pdo, array $config, ?string $dataDir, $store, int $moment, int $until): array
+    {
+        $ctx = self::context($pdo, $config, $dataDir, $store);
+        $c = ['read' => 0, 'confirming' => 0, 'inserted' => 0, 'kept_earliest' => 0, 'ref_conflict' => 0, 'no_phone' => 0,
+              'advanced' => 0, 'owners_found' => 0, 'owners_final' => 0, 'owners_pending' => 0, 'ran' => 0, 'stopped' => 0,
+              'mapped' => 0, 'held' => 0, 'cut' => 0];
+
+        foreach (self::derive($pdo, $ctx, $moment) as $k => $v) $c[$k] = $v;
+
+        $reached = true;
+        foreach (self::pendingRows($pdo) as $row) {
+            if (time() >= $until) { $reached = false; break; }
+            $r = self::resolveOwner($pdo, $ctx, $row, $moment);
+            $c[$r]++;
+        }
+        if ($reached) {
+            $pdo->prepare("INSERT OR REPLACE INTO quote_followup_state (k, v, updated_at) VALUES ('tracker_ran', ?, datetime('now'))")
+                ->execute([UtcClock::stamp($moment)]);
+            $c['ran'] = 1;
+        } else {
+            $c['cut'] = 1;
+        }
+
+        foreach (self::openRows($pdo) as $row) {
+            if (time() >= $until) { $c['cut'] = 1; break; }
+            $s = self::stopWith($pdo, $ctx, $row, $moment, null);
+            if ($s !== null && self::setStatus($pdo, (string)$row['quote_key'], $s[0], $s[1], $moment, 'quote_tracker')) $c['stopped']++;
+        }
+
+        if (time() < $until) {
+            foreach (self::mapClosed($pdo, $moment) as $k => $v) $c[$k] += $v;
+        } else {
+            $c['cut'] = 1;
+        }
+        return $c;
+    }
+
+    // ── 1. derive (§H.2.9.1–§H.2.9.3, §H.2.9.5) ──────────────────────────────────────────────────────────────────
+
+    /**
+     * Read up to BATCH ids past the cursor; insert the tracker rows, the conflicts and the cursor in one transaction.
+     * A row's created_at is its insert's own storage time (089's DEFAULT), never the run's moment: the offers hold's
+     * past-moment form bounds a tracker row by it (ruling R18), so it must not read earlier than the write. A status set
+     * at creation is stamped with the run's moment, which is at or before the write: the safe side of that bound.
+     */
+    private static function derive(\PDO $pdo, array $ctx, int $moment): array
+    {
+        $out = ['read' => 0, 'confirming' => 0, 'inserted' => 0, 'kept_earliest' => 0, 'ref_conflict' => 0, 'no_phone' => 0, 'advanced' => 0];
+        $cursor = self::cursor($pdo, $moment);
+        $st = $pdo->prepare('SELECT id, conversation_id, direction, event_key, body, sent_at, created_at FROM wa_messages
+                              WHERE id > ? ORDER BY id LIMIT ' . self::BATCH);
+        $st->execute([$cursor]);
+        $msgs = $st->fetchAll(\PDO::FETCH_ASSOC);
+        if ($msgs === []) return $out;
+        $out['read'] = count($msgs);
+        $last = (int)$msgs[count($msgs) - 1]['id'];
+
+        $plans = [];
+        foreach ($msgs as $m) {
+            $ev = QuoteSendEvidence::read($m);
+            if ($ev === null) continue;
+            $out['confirming']++;
+            $plan = self::plan($pdo, $ctx, $m, $ev, $moment);
+            if ($plan === null) { $out['no_phone']++; continue; }
+            $plans[] = $plan;
+        }
+
+        $ins = $pdo->prepare('INSERT OR IGNORE INTO quote_tracker (quote_key, quote_ref, quote_id, crm_client_id, phone,
+                                evidence_msg_id, evidence_event, made_by, sent_at, sent_conv_id, sent_channel, valid_until,
+                                owner_staff_id, owner_source, spoke_conv_id, spoke_channel, backfilled, status, status_at,
+                                status_reason)
+                              VALUES (:quote_key, :quote_ref, :quote_id, :crm_client_id, :phone, :evidence_msg_id,
+                                :evidence_event, :made_by, :sent_at, :sent_conv_id, :sent_channel, :valid_until,
+                                :owner_staff_id, :owner_source, :spoke_conv_id, :spoke_channel, :backfilled, :status,
+                                :status_at, :status_reason)');
+        $has = $pdo->prepare('SELECT 1 FROM quote_tracker WHERE quote_key = ?');
+        $conflict = $pdo->prepare("INSERT OR IGNORE INTO quote_followup_state (k, v) VALUES (?, ?)");
+        $pdo->exec('BEGIN IMMEDIATE');
+        try {
+            foreach ($plans as $p) {
+                $ins->execute($p);
+                if ($ins->rowCount() === 1) { $out['inserted']++; continue; }
+                $has->execute([$p[':quote_key']]);
+                if ($has->fetchColumn() !== false) { $out['kept_earliest']++; continue; }
+                // ignored, and no row of that key: the uCRM id is another quotation's (idx_qt_quote_id; Q17-F04)
+                $conflict->execute(['ref_conflict:' . $p[':quote_key'], (string)$p[':quote_id']]);
+                $out['ref_conflict']++;
+            }
+            $pdo->prepare("INSERT OR REPLACE INTO quote_followup_state (k, v, updated_at) VALUES ('tracker_cursor', ?, datetime('now'))")
+                ->execute([(string)$last]);
+            $pdo->exec('COMMIT');
+        } catch (\Throwable $e) {
+            try { $pdo->exec('ROLLBACK'); } catch (\Throwable $e2) { /* nothing was committed */ }
+            throw $e;
+        }
+        $out['advanced'] = 1;   // a flag: the cursor (an id) stays in quote_followup_state, never in a count or a log
+        return $out;
+    }
+
+    /** The cursor; on the very first run, just before the earliest outbound row of the last 30 days. */
+    private static function cursor(\PDO $pdo, int $moment): int
+    {
+        $st = $pdo->query("SELECT v FROM quote_followup_state WHERE k = 'tracker_cursor'");
+        $v = $st->fetchColumn();
+        if ($v !== false) return max(0, (int)$v);
+        $first = $pdo->prepare("SELECT MIN(id) FROM wa_messages WHERE direction = 'out' AND sent_at >= ?");
+        $first->execute([UtcClock::stamp($moment - self::FIRST_RUN_S)]);
+        $min = $first->fetchColumn();
+        if ($min !== false && $min !== null) return max(0, (int)$min - 1);
+        return (int)$pdo->query('SELECT COALESCE(MAX(id), 0) FROM wa_messages')->fetchColumn();
+    }
+
+    /** The values of one tracker row, from reads only; null when the conversation is gone or has no number. */
+    private static function plan(\PDO $pdo, array $ctx, array $m, array $ev, int $moment): ?array
+    {
+        [$marker, $number] = $ev;
+        $conv = self::conversation($pdo, (int)$m['conversation_id']);
+        if ($conv === null) return null;
+        $phone = self::phoneOf((string)$conv['phone'], $ctx);
+        if ($phone === '') return null;
+        $sentAt = self::norm((string)$m['sent_at']);
+        if ($sentAt === null) return null;
+        $key = QuoteSendEvidence::key($number);
+
+        $quoteId = self::quoteIdOf($pdo, $ctx, $number);
+        $kycApp  = self::kycByQuote($pdo, $ctx, $quoteId, $number);
+        $log     = self::logOf($pdo, $ctx, $quoteId, $number);
+        $client  = self::clientOf($kycApp, $log, $conv);
+        $spoke   = self::spokeOf($pdo, $ctx, $phone, $sentAt);
+        $own     = self::ownerOf($pdo, $ctx, $quoteId, $number, $kycApp, $log, $client, $spoke, $sentAt);
+        if ($own['id'] === null) $own['source'] = ($moment - UtcClock::parse($sentAt) < self::PENDING_S) ? 'pending' : 'none';
+
+        $status = 'open'; $reason = null;
+        if (self::isColleague($ctx, $phone, QuoteSendEvidence::sentChannel((string)$conv['channel'], $ctx['force_accounts']))) {
+            $status = 'colleague'; $reason = 'colleague_number';
+        } elseif ($quoteId !== null && self::cashPaid($pdo, $ctx, $quoteId)) {
+            $status = 'paid'; $reason = 'cash_kyc';
+        }
+        $since = $ctx['since'];
+        $backfilled = ($since === null || UtcClock::parse($sentAt) < $since) ? 1 : 0;
+
+        return [
+            ':quote_key' => $key, ':quote_ref' => $number, ':quote_id' => $quoteId, ':crm_client_id' => $client,
+            ':phone' => $phone, ':evidence_msg_id' => (int)$m['id'], ':evidence_event' => (string)$m['event_key'],
+            ':made_by' => QuoteSendEvidence::madeBy((string)$m['event_key'], $kycApp, $log),
+            ':sent_at' => $sentAt, ':sent_conv_id' => (int)$conv['id'],
+            ':sent_channel' => QuoteSendEvidence::sentChannel((string)$conv['channel'], $ctx['force_accounts']),
+            ':valid_until' => QuoteSendEvidence::validUntil($marker, (string)$m['body'], $sentAt, $quoteId !== null),
+            ':owner_staff_id' => $own['id'], ':owner_source' => $own['source'],
+            ':spoke_conv_id' => $spoke !== null ? (int)$spoke['id'] : null,
+            ':spoke_channel' => $spoke !== null ? (string)$spoke['channel'] : null,
+            ':backfilled' => $backfilled, ':status' => $status,
+            ':status_at' => $status === 'open' ? null : UtcClock::stamp($moment), ':status_reason' => $reason,
+        ];
+    }
+
+    // ── 2. owners (F4, §H.2.9.4) ────────────────────────────────────────────────────────────────────────────────
+
+    private static function pendingRows(\PDO $pdo): array
+    {
+        return $pdo->query("SELECT * FROM quote_tracker WHERE owner_source = 'pending' ORDER BY sent_at, quote_key")->fetchAll(\PDO::FETCH_ASSOC);
+    }
+
+    /** One pending row, judged at the run's moment: found, final (none) or still pending. */
+    private static function resolveOwner(\PDO $pdo, array $ctx, array $row, int $moment): string
+    {
+        $quoteId = $row['quote_id'] === null ? null : (int)$row['quote_id'];
+        $number  = (string)$row['quote_ref'];
+        $kycApp  = self::kycByQuote($pdo, $ctx, $quoteId, $number);
+        $log     = self::logOf($pdo, $ctx, $quoteId, $number);
+        $spoke   = (int)($row['spoke_conv_id'] ?? 0) > 0 ? self::conversation($pdo, (int)$row['spoke_conv_id']) : null;
+        $client  = $row['crm_client_id'] === null ? null : (int)$row['crm_client_id'];
+        $own = self::ownerOf($pdo, $ctx, $quoteId, $number, $kycApp, $log, $client, $spoke, (string)$row['sent_at']);
+        if ($own['id'] !== null) {
+            $pdo->prepare("UPDATE quote_tracker SET owner_staff_id = ?, owner_source = ? WHERE quote_key = ? AND owner_source = 'pending'")
+                ->execute([$own['id'], $own['source'], (string)$row['quote_key']]);
+            return 'owners_found';
+        }
+        if ($moment - UtcClock::parse((string)$row['sent_at']) >= self::PENDING_S) {
+            $pdo->prepare("UPDATE quote_tracker SET owner_source = 'none' WHERE quote_key = ? AND owner_source = 'pending'")
+                ->execute([(string)$row['quote_key']]);
+            return 'owners_final';
+        }
+        return 'owners_pending';
+    }
+
+    /** Rules 1–7 over what the book holds for this quotation (QuoteSendEvidence::owner). */
+    private static function ownerOf(\PDO $pdo, array $ctx, ?int $quoteId, string $number, ?array $kycApp, ?array $log,
+                                    ?int $client, ?array $spoke, string $sentAt): array
+    {
+        $leadLog = $log !== null && (string)($log['type'] ?? '') === 'lead' ? $log : self::leadLogOf($pdo, $ctx, $quoteId, $number);
+        $facts = [
+            'kyc_app'    => $kycApp,
+            'lead_log'   => $leadLog !== null,
+            'lead'       => $leadLog !== null ? self::leadOf($pdo, $ctx, $quoteId, $number) : null,
+            'log'        => $log,
+            'spoke_chan' => $spoke !== null ? self::channelRow($pdo, $ctx, (string)$spoke['channel']) : null,
+            'conv_lead'  => $spoke !== null && $ctx['conv_lead_id'] && (int)($spoke['lead_id'] ?? 0) > 0
+                            ? self::blobOne($pdo, $ctx, 'leads', 'id', (string)(int)$spoke['lead_id']) : null,
+            'client_app' => $client !== null ? self::kycOfClientBefore($pdo, $ctx, $client, $sentAt) : null,
+        ];
+        return QuoteSendEvidence::owner($facts, $ctx['retailers']);
+    }
+
+    // ── 3. stops (§H.2.9.7) ─────────────────────────────────────────────────────────────────────────────────────
+
+    private static function openRows(\PDO $pdo): array
+    {
+        return $pdo->query("SELECT * FROM quote_tracker WHERE status = 'open' ORDER BY sent_at, quote_key")->fetchAll(\PDO::FETCH_ASSOC);
+    }
+
+    /**
+     * The first of §H.2.9.7's stops that holds for this tracker row at $now: [status, a fixed reason code], or null.
+     * $only limits it to some stops, in the same order (customerStop() passes CUSTOMER_STOPS). Reads only.
+     *
+     * @return array{0:string,1:string}|null
+     */
+    public static function stop(\PDO $pdo, array $config, ?string $dataDir, array $row, int $now, ?array $only = null): ?array
+    {
+        return self::stopWith($pdo, self::tenantContext($config, $dataDir), $row, $now, $only);
+    }
+
+    private static function stopWith(\PDO $pdo, array $ctx, array $row, int $now, ?array $only): ?array
+    {
+        $p = (string)$row['phone'];
+        if ($p === '' || $p === 'erased') return null;
+        $sent = (string)$row['sent_at'];
+        $convs = self::convIds($pdo, $p, (int)($row['sent_conv_id'] ?? 0));
+        foreach (self::STOPS as $stop) {
+            if ($only !== null && !in_array($stop, $only, true)) continue;
+            $r = null;
+            switch ($stop) {
+                case 'opted_out':  $r = self::optedOut($pdo, $p, $convs, $sent); break;
+                case 'answered':   $r = self::answered($pdo, $p, $convs, $sent); break;
+                case 'taken':      $r = HumanTakeover::since($pdo, $p, $convs, $sent); break;
+                case 'paid':       $r = self::paid($pdo, $ctx, $row, $convs); break;
+                case 'registered': $r = self::registered($pdo, $ctx, $row); break;
+                case 'accepted':   $r = self::approved($pdo, $convs, $row); break;
+                case 'superseded': $r = self::superseded($pdo, $row); break;
+                case 'expired':    $r = self::expired($row, $now); break;
+            }
+            if ($r !== null) return [$stop, $r];
+        }
+        return null;
+    }
+
+    /** The stops a customer or a colleague can cause (opted_out, answered with marks, taken): preSendCheck's and the
+     *  after-claim re-read's (§H.2.10.6 items 2 and 4; ruling R18). */
+    public static function customerStop(\PDO $pdo, array $config, ?string $dataDir, array $row, int $now): ?array
+    {
+        return self::stop($pdo, $config, $dataDir, $row, $now, self::CUSTOMER_STOPS);
+    }
+
+    /** A live opt-out for p (any channel, any scope), or an inbound since the send that ContactOptOut::detect reads as STOP. */
+    private static function optedOut(\PDO $pdo, string $p, array $convs, string $sent): ?string
+    {
+        if (self::hasTable($pdo, 'contact_optouts')) {
+            $phones = self::convPhones($pdo, $convs, $p);
+            $in = implode(',', array_fill(0, count($phones), '?'));
+            $st = $pdo->prepare("SELECT 1 FROM contact_optouts WHERE active = 1 AND phone IN ({$in}) LIMIT 1");
+            $st->execute($phones);
+            if ($st->fetchColumn() !== false) return 'optout_row';
+        }
+        if ($convs === []) return null;
+        if (!class_exists('ContactOptOut')) require_once __DIR__ . '/ContactOptOut.php';
+        $st = $pdo->prepare('SELECT body FROM wa_messages WHERE conversation_id IN (' . implode(',', $convs) . ")
+                              AND direction = 'in' AND (sent_at > ? OR created_at > ?) ORDER BY id");
+        $st->execute([$sent, $sent]);
+        foreach ($st->fetchAll(\PDO::FETCH_COLUMN) as $body) {
+            if (\ContactOptOut::detect((string)$body)['stop']) return 'stop_message';
+        }
+        return null;
+    }
+
+    /** An inbound row from p after the send, on any of p's conversations ([AUDIO] included); or an inbound mark (R-01). */
+    private static function answered(\PDO $pdo, string $p, array $convs, string $sent): ?string
+    {
+        if ($convs !== []) {
+            $st = $pdo->prepare('SELECT 1 FROM wa_messages WHERE conversation_id IN (' . implode(',', $convs) . ")
+                                  AND direction = 'in' AND (sent_at > ? OR created_at > ?) LIMIT 1");
+            $st->execute([$sent, $sent]);
+            if ($st->fetchColumn() !== false) return 'reply';
+        }
+        if (self::hasTable($pdo, 'wa_seen_marks')) {
+            $st = $pdo->prepare("SELECT 1 FROM wa_seen_marks WHERE direction = 'in' AND phone = ? AND seen_at > ? LIMIT 1");
+            $st->execute([$p, $sent]);
+            if ($st->fetchColumn() !== false) return 'unread_inbound';
+        }
+        return null;
+    }
+
+    /** A payment after the send: a receipt to p, a cashbook receipt for the client, a collection, a Cash KYC. */
+    private static function paid(\PDO $pdo, array $ctx, array $row, array $convs): ?string
+    {
+        $sent = (string)$row['sent_at'];
+        $local = self::kampalaStamp($sent);
+        if ($convs !== []) {
+            $ev = implode(',', array_fill(0, count(self::PAYMENT_EVENTS), '?'));
+            $st = $pdo->prepare('SELECT 1 FROM wa_messages WHERE conversation_id IN (' . implode(',', $convs) . ")
+                                  AND direction = 'out' AND event_key IN ({$ev}) AND sent_at > ? LIMIT 1");
+            $st->execute(array_merge(self::PAYMENT_EVENTS, [$sent]));
+            if ($st->fetchColumn() !== false) return 'payment_message';
+        }
+        $client = $row['crm_client_id'] === null ? 0 : (int)$row['crm_client_id'];
+        if ($client <= 0) return null;
+        if (self::hasColumns($pdo, 'cb_ledger', ['direction', 'crm_payment_id', 'crm_client_id', 'created_at'])) {
+            $st = $pdo->prepare("SELECT 1 FROM cb_ledger WHERE direction = 'in' AND crm_payment_id > 0 AND crm_client_id = ?
+                                   AND created_at > ? LIMIT 1");
+            $st->execute([$client, $local]);
+            if ($st->fetchColumn() !== false) return 'cashbook';
+        }
+        if (self::hasColumns($pdo, 'payment_collections', ['data'])) {
+            $st = $pdo->prepare("SELECT 1 FROM payment_collections
+                                  WHERE CAST(json_extract(data, '$.crm_customer_id') AS TEXT) = ?
+                                    AND COALESCE(json_extract(data, '$.created_at'), '') > ? LIMIT 1");
+            $st->execute([(string)$client, $local]);
+            if ($st->fetchColumn() !== false) return 'collection';
+        }
+        foreach (self::kycOfClient($pdo, $ctx, $client) as $a) {
+            if (self::isCashPaid($a) && (string)($a['submitted_at'] ?? '') > $local) return 'cash_kyc';
+        }
+        return null;
+    }
+
+    /** Non-KYC quotations: a KYC after the send with the client, or with p as its canonical mobile or wa_quote_phone. */
+    private static function registered(\PDO $pdo, array $ctx, array $row): ?string
+    {
+        if ((string)$row['made_by'] === 'kyc') return null;
+        $local = self::kampalaStamp((string)$row['sent_at']);
+        $client = $row['crm_client_id'] === null ? 0 : (int)$row['crm_client_id'];
+        if ($client > 0) {
+            foreach (self::kycOfClient($pdo, $ctx, $client) as $a) {
+                if ((string)($a['submitted_at'] ?? '') > $local) return 'kyc_client';
+            }
+        }
+        if (!self::hasColumns($pdo, 'kyc_applications', ['data'])) return null;
+        $st = $pdo->prepare("SELECT id, data FROM kyc_applications WHERE COALESCE(json_extract(data, '$.submitted_at'), '') > ?");
+        $st->execute([$local]);
+        $p = (string)$row['phone'];
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            $a = json_decode((string)$r['data'], true);
+            if (!is_array($a)) continue;
+            foreach (['mobile', 'wa_quote_phone'] as $f) {
+                if (self::phoneOf((string)($a[$f] ?? ''), $ctx) === $p) return 'kyc_phone';
+            }
+        }
+        return null;
+    }
+
+    /** ops_quote_approved to p after the send whose body holds #<ref> (webhook.php:2527-2563). */
+    private static function approved(\PDO $pdo, array $convs, array $row): ?string
+    {
+        if ($convs === []) return null;
+        $st = $pdo->prepare('SELECT body FROM wa_messages WHERE conversation_id IN (' . implode(',', $convs) . ")
+                              AND direction = 'out' AND event_key = 'ops_quote_approved' AND sent_at > ?");
+        $st->execute([(string)$row['sent_at']]);
+        $re = '/#' . preg_quote((string)$row['quote_ref'], '/') . '(?![A-Za-z0-9])/u';
+        foreach ($st->fetchAll(\PDO::FETCH_COLUMN) as $body) {
+            if (preg_match($re, (string)$body)) return 'quote_approved';
+        }
+        return null;
+    }
+
+    /** A newer quotation to p: another tracked quotation sent later. */
+    private static function superseded(\PDO $pdo, array $row): ?string
+    {
+        $st = $pdo->prepare('SELECT 1 FROM quote_tracker WHERE phone = ? AND quote_key <> ? AND sent_at > ? LIMIT 1');
+        $st->execute([(string)$row['phone'], (string)$row['quote_key'], (string)$row['sent_at']]);
+        return $st->fetchColumn() !== false ? 'newer_quote' : null;
+    }
+
+    /** After 20:00 Kampala on valid_until. */
+    private static function expired(array $row, int $now): ?string
+    {
+        $vu = trim((string)($row['valid_until'] ?? ''));
+        if ($vu === '') return null;
+        try {
+            $end = new \DateTime($vu . ' ' . sprintf('%02d', self::EXPIRY_HOUR) . ':00:00', new \DateTimeZone(self::TZ));
+        } catch (\Throwable $e) {
+            return null;
+        }
+        return $now > $end->getTimestamp() ? 'valid_until' : null;
+    }
+
+    /**
+     * The uCRM quote status the chase reads with one GET before a step is drafted: 2 → accepted, 3 or 4 → declined
+     * (cron_quote_wa.php:277, unverified on 4.5.33); any other value, or a failed read (null), does not stop.
+     */
+    public static function ucrmStatus($status): ?string
+    {
+        if ($status === null || !is_numeric($status)) return null;
+        $s = (int)$status;
+        if ($s === 2) return 'accepted';
+        if ($s === 3 || $s === 4) return 'declined';
+        return null;
+    }
+
+    /**
+     * A status leaves `open` once (qt_status_once): true when this call moved it. The linked follow-up, if open, is
+     * closed with the same reason (STATUS_TO_CLOSE), by FollowUpService::close().
+     */
+    public static function setStatus(\PDO $pdo, string $quoteKey, string $status, ?string $reason, int $now, string $actor = 'quote_tracker'): bool
+    {
+        if ($status === 'open' || !in_array($status, self::STATUSES, true)) return false;
+        $st = $pdo->prepare("UPDATE quote_tracker SET status = ?, status_at = ?, status_reason = ? WHERE quote_key = ? AND status = 'open'");
+        $st->execute([$status, UtcClock::stamp($now), $reason, $quoteKey]);
+        if ($st->rowCount() !== 1) return false;
+        $fu = $pdo->prepare('SELECT followup_id FROM quote_tracker WHERE quote_key = ?');
+        $fu->execute([$quoteKey]);
+        $fid = (int)$fu->fetchColumn();
+        if ($fid > 0 && isset(self::STATUS_TO_CLOSE[$status])) {
+            if (!class_exists('FollowUpService')) require_once __DIR__ . '/FollowUpService.php';
+            (new \FollowUpService($pdo))->close($fid, self::STATUS_TO_CLOSE[$status], (string)$reason, $actor);
+        }
+        return true;
+    }
+
+    // ── 4. a linked follow-up closed elsewhere (§H.2.10.8) ───────────────────────────────────────────────────────
+
+    /** @return array{mapped:int, held:int} */
+    private static function mapClosed(\PDO $pdo, int $now): array
+    {
+        $out = ['mapped' => 0, 'held' => 0];
+        $rows = $pdo->query("SELECT t.quote_key, t.chase_hold, f.close_reason FROM quote_tracker t JOIN followups f ON f.id = t.followup_id
+                              WHERE t.status = 'open' AND f.closed_at IS NOT NULL ORDER BY t.sent_at, t.quote_key")->fetchAll(\PDO::FETCH_ASSOC);
+        $hold = $pdo->prepare("UPDATE quote_tracker SET chase_hold = ? WHERE quote_key = ? AND status = 'open' AND chase_hold IS NULL");
+        foreach ($rows as $r) {
+            $reason = (string)($r['close_reason'] ?? '');
+            $m = self::closeOutcome($reason);
+            if ($m['status'] !== null) {
+                if (self::setStatus($pdo, (string)$r['quote_key'], $m['status'], 'followup:' . $reason, $now)) $out['mapped']++;
+            } elseif ($m['hold'] !== null && $r['chase_hold'] === null) {
+                $hold->execute([$m['hold'], (string)$r['quote_key']]);
+                if ($hold->rowCount() === 1) $out['held']++;
+            }
+        }
+        return $out;
+    }
+
+    /**
+     * What a follow-up's close reason does to its quotation: a status (CLOSE_TO_STATUS), nothing (exhausted, or the
+     * tracker's own closes), or a chase_hold carrying the code (every other reason).
+     *
+     * @return array{status:?string, hold:?string}
+     */
+    public static function closeOutcome(string $reason): array
+    {
+        if (isset(self::CLOSE_TO_STATUS[$reason])) return ['status' => self::CLOSE_TO_STATUS[$reason], 'hold' => null];
+        if ($reason === '' || in_array($reason, self::CLOSE_STAYS_OPEN, true) || in_array($reason, self::CLOSE_OWN, true)) {
+            return ['status' => null, 'hold' => null];
+        }
+        return ['status' => null, 'hold' => $reason];
+    }
+
+    // ── the number a chase leaves from (§H.2.10.2, F5, A13) and the opening holds (§H.2.10.3) ─────────────────────
+
+    /**
+     * Which conversation and channel a chase of this tracker row leaves from, or why none. Reads only.
+     *   - the customer spoke to us: that conversation and its channel; a salesperson's own number held by
+     *     OwnedNumberHold → owned_number; a partner's number → partner_number;
+     *   - never wrote: quote_chase_cold off → never_wrote; on → the quotation's own conversation, on its Evolution
+     *     channel (sent_channel: account for accounts, never accounts);
+     *   - AutomationPolicy::refusal(channel, phone): a final reason → channel_refused:<code>; a transient one → wait.
+     *
+     * @return array{conv_id:?int, channel:?string, hold:?string, wait:?string, cold:bool}
+     */
+    public static function number(\PDO $pdo, array $config, ?string $dataDir, array $row, $owned = null, $policy = null): array
+    {
+        $none = function (string $hold, bool $cold = false): array {
+            return ['conv_id' => null, 'channel' => null, 'hold' => $hold, 'wait' => null, 'cold' => $cold];
+        };
+        if ($owned === null) {
+            if (!class_exists('OwnedNumberHold')) require_once __DIR__ . '/OwnedNumberHold.php';
+            $owned = \OwnedNumberHold::forInstall($config, $dataDir, $pdo);
+        }
+        $spoke = (int)($row['spoke_conv_id'] ?? 0);
+        if ($spoke > 0) {
+            $conv = $spoke;
+            $chan = (string)($row['spoke_channel'] ?? '');
+            $cold = false;
+            if ($owned->holds($chan)) return $none('owned_number');
+            $ch = self::channelRow($pdo, ['wa_channels' => self::hasTable($pdo, 'wa_channels')], $chan);
+            if ($ch !== null && (string)($ch['owner_type'] ?? '') === 'partner') return $none('partner_number');
+        } else {
+            if (!self::truthy($config['quote_chase_cold'] ?? null)) return $none('never_wrote', true);
+            $conv = (int)($row['sent_conv_id'] ?? 0);
+            $chan = (string)($row['sent_channel'] ?? 'support');
+            $cold = true;
+        }
+        if ($policy === null) {
+            if (!class_exists('AutomationPolicy')) require_once __DIR__ . '/AutomationPolicy.php';
+            $policy = \AutomationPolicy::forInstall($config, $dataDir, $pdo);
+        }
+        $why = (string)$policy->refusal($chan, (string)($row['phone'] ?? ''));
+        if ($why !== '') {
+            if (\AutomationPolicy::transient($why)) return ['conv_id' => $conv, 'channel' => $chan, 'hold' => null, 'wait' => $why, 'cold' => $cold];
+            return $none('channel_refused:' . $why, $cold);
+        }
+        return ['conv_id' => $conv, 'channel' => $chan, 'hold' => null, 'wait' => null, 'cold' => $cold];
+    }
+
+    /**
+     * The holds an opening sets first (§H.2.10.3): `colleague` (the row's status, or the number DishNet's own now) and
+     * `ambiguous` (FollowUpPolicy::contentLevel on the conversation the chase would use). Null = neither.
+     */
+    public static function openingHold(\PDO $pdo, array $config, ?string $dataDir, array $row, $store = null): ?string
+    {
+        $ctx = self::context($pdo, $config, $dataDir, $store);
+        if ((string)($row['status'] ?? '') === 'colleague') return 'colleague';
+        if (self::isColleague($ctx, (string)$row['phone'], (string)($row['sent_channel'] ?? 'support'))) return 'colleague';
+        $convId = (int)($row['spoke_conv_id'] ?? 0) > 0 ? (int)$row['spoke_conv_id'] : (int)($row['sent_conv_id'] ?? 0);
+        $conv = $convId > 0 ? self::conversation($pdo, $convId) : null;
+        if ($conv !== null) {
+            if (!class_exists('FollowUpPolicy')) require_once __DIR__ . '/FollowUpPolicy.php';
+            if (\FollowUpPolicy::contentLevel($conv) === \FollowUpPolicy::CONTENT_NONE) return 'ambiguous';
+        }
+        return null;
+    }
+
+    /** Every conversation of p (phone exactly p, never the last nine digits) except category 'staff', with the
+     *  quotation's own conversation. */
+    public static function convIds(\PDO $pdo, string $phone, int $sentConvId = 0): array
+    {
+        $st = $pdo->prepare("SELECT id FROM wa_conversations WHERE phone = ? AND COALESCE(category, '') <> 'staff'");
+        $st->execute([$phone]);
+        $ids = [];
+        foreach ($st->fetchAll(\PDO::FETCH_COLUMN) as $i) $ids[(int)$i] = (int)$i;
+        if ($sentConvId > 0) {
+            $s2 = $pdo->prepare("SELECT id FROM wa_conversations WHERE id = ? AND COALESCE(category, '') <> 'staff'");
+            $s2->execute([$sentConvId]);
+            $i = $s2->fetchColumn();
+            if ($i !== false) $ids[(int)$i] = (int)$i;
+        }
+        ksort($ids);
+        return array_values($ids);
+    }
+
+    // ── what the book holds about a quotation (reads) ────────────────────────────────────────────────────────────
+
+    /** The tenant alone: what the stops need to read a number (phoneOf). */
+    private static function tenantContext(array $config, ?string $dataDir): array
+    {
+        if (!class_exists('PhoneNumber')) require_once __DIR__ . '/PhoneNumber.php';
+        if (!class_exists('TenantProfile')) require_once __DIR__ . '/TenantProfile.php';
+        try { $tenant = \TenantProfile::current($config, $dataDir); } catch (\Throwable $e) { $tenant = null; }
+        return ['tenant' => $tenant];
+    }
+
+    /** What a run reads once: the tenant, the accounts, the switches and the tables present. */
+    private static function context(\PDO $pdo, array $config, ?string $dataDir, $store): array
+    {
+        if (!class_exists('PhoneNumber')) require_once __DIR__ . '/PhoneNumber.php';
+        if (!class_exists('TenantProfile')) require_once __DIR__ . '/TenantProfile.php';
+        $tenant = null;
+        try { $tenant = \TenantProfile::current($config, $dataDir); } catch (\Throwable $e) { $tenant = null; }
+        $since = trim((string)($config['quote_tracking_since'] ?? ''));
+        $sinceT = $since === '' ? null : (ctype_digit($since) ? (int)$since : UtcClock::parse($since));
+        $ctx = [
+            'config' => $config, 'data' => $dataDir, 'tenant' => $tenant, 'store' => $store,
+            'since' => ($sinceT === null || $sinceT <= 0) ? null : $sinceT,
+            'force_accounts' => QuoteSendEvidence::forceAccounts($config),
+            'wa_channels' => self::hasTable($pdo, 'wa_channels'),
+            'conv_lead_id' => self::hasColumns($pdo, 'wa_conversations', ['lead_id']),
+            'colleagues' => null, 'policy' => null, 'retailers' => self::blobAll($pdo, 'retailers'),
+        ];
+        if ($store !== null) {
+            try {
+                if (!class_exists('ColleagueNumbers')) require_once __DIR__ . '/ColleagueNumbers.php';
+                $ctx['colleagues'] = \ColleagueNumbers::forInstall($config, $dataDir, $store);
+            } catch (\Throwable $e) { $ctx['colleagues'] = null; }
+            try {
+                if (!class_exists('AutomationPolicy')) require_once __DIR__ . '/AutomationPolicy.php';
+                $ctx['policy'] = \AutomationPolicy::forInstall($config, $dataDir, $pdo, $store);
+            } catch (\Throwable $e) { $ctx['policy'] = null; }
+        }
+        return $ctx;
+    }
+
+    /** ColleagueNumbers, or AutomationPolicy::senderClass, says the number is DishNet's (§H.2.9.5). */
+    private static function isColleague(array $ctx, string $phone, string $channel): bool
+    {
+        if ($ctx['colleagues'] !== null && $ctx['colleagues']->isColleague($phone)) return true;
+        if ($ctx['policy'] !== null && (string)$ctx['policy']->senderClass($channel, $phone) !== '') return true;
+        return false;
+    }
+
+    /** International digits, no '+', by the tenant's rule; the raw digits when the number does not normalise. */
+    private static function phoneOf(string $raw, array $ctx): string
+    {
+        $digits = (string)preg_replace('/\D+/', '', $raw);
+        if ($digits === '' || $ctx['tenant'] === null) return $digits;
+        $intl = \PhoneNumber::international($raw, $ctx['tenant']);
+        return $intl === null ? $digits : ltrim($intl, '+');
+    }
+
+    private static function conversation(\PDO $pdo, int $id): ?array
+    {
+        $st = $pdo->prepare('SELECT * FROM wa_conversations WHERE id = ?');
+        $st->execute([$id]);
+        $r = $st->fetch(\PDO::FETCH_ASSOC);
+        return is_array($r) ? $r : null;
+    }
+
+    /** The uCRM quote id: wa_sent_quotes, then quotes_log, then kyc_applications ('PENDING' ignored) (§H.2.9.2). */
+    private static function quoteIdOf(\PDO $pdo, array $ctx, string $number): ?int
+    {
+        if (self::hasTable($pdo, 'wa_sent_quotes')) {
+            $st = $pdo->prepare('SELECT quote_id FROM wa_sent_quotes WHERE TRIM(quote_ref) = ? ORDER BY sent_at, quote_id LIMIT 1');
+            $st->execute([$number]);
+            $v = $st->fetchColumn();
+            if ($v !== false && (int)$v > 0) return (int)$v;
+        }
+        $log = self::blobWhere($pdo, 'quotes_log', 'quote_ref', $number);
+        foreach ($log as $r) if ((int)($r['crm_quote_id'] ?? 0) > 0) return (int)$r['crm_quote_id'];
+        foreach (self::blobWhere($pdo, 'kyc_applications', 'quote_ref', $number) as $a) {
+            $q = trim((string)($a['quote_id'] ?? ''));
+            if ($q !== '' && strtoupper($q) !== 'PENDING' && ctype_digit($q) && (int)$q > 0) return (int)$q;
+        }
+        return null;
+    }
+
+    /** The KYC application this quotation is: by its uCRM id, else by its number ('PENDING' never). */
+    private static function kycByQuote(\PDO $pdo, array $ctx, ?int $quoteId, string $number): ?array
+    {
+        if ($quoteId !== null) {
+            foreach (self::blobWhere($pdo, 'kyc_applications', 'quote_id', (string)$quoteId) as $a) return $a;
+        }
+        if (strtoupper(trim($number)) === 'PENDING') return null;
+        foreach (self::blobWhere($pdo, 'kyc_applications', 'quote_ref', $number) as $a) return $a;
+        return null;
+    }
+
+    /** The plugin's own quote log row: by its uCRM id, else by its number. */
+    private static function logOf(\PDO $pdo, array $ctx, ?int $quoteId, string $number): ?array
+    {
+        if ($quoteId !== null) {
+            foreach (self::blobWhere($pdo, 'quotes_log', 'crm_quote_id', (string)$quoteId) as $r) return $r;
+        }
+        foreach (self::blobWhere($pdo, 'quotes_log', 'quote_ref', $number) as $r) return $r;
+        return null;
+    }
+
+    /** A quotes_log row of type lead joined by crm_quote_id or quote_ref. */
+    private static function leadLogOf(\PDO $pdo, array $ctx, ?int $quoteId, string $number): ?array
+    {
+        $rows = $quoteId !== null ? self::blobWhere($pdo, 'quotes_log', 'crm_quote_id', (string)$quoteId) : [];
+        foreach (array_merge($rows, self::blobWhere($pdo, 'quotes_log', 'quote_ref', $number)) as $r) {
+            if ((string)($r['type'] ?? '') === 'lead') return $r;
+        }
+        return null;
+    }
+
+    /** The lead a lead quotation was made for: leads.json stamps quote_ref and crm_quote_id (lib/QuotationService.php:237-249). */
+    private static function leadOf(\PDO $pdo, array $ctx, ?int $quoteId, string $number): ?array
+    {
+        if ($quoteId !== null) {
+            foreach (self::blobWhere($pdo, 'leads', 'crm_quote_id', (string)$quoteId) as $l) return $l;
+        }
+        foreach (self::blobWhere($pdo, 'leads', 'quote_ref', $number) as $l) return $l;
+        return null;
+    }
+
+    /** The client: from the KYC application or the quote log, else the conversation's only when its link is trusted. */
+    private static function clientOf(?array $kycApp, ?array $log, array $conv): ?int
+    {
+        foreach ([$kycApp, $log] as $r) {
+            if ($r !== null && (int)($r['crm_client_id'] ?? 0) > 0) return (int)$r['crm_client_id'];
+        }
+        if ((int)($conv['crm_client_id'] ?? 0) > 0) {
+            if (!class_exists('FollowUpPolicy')) require_once __DIR__ . '/FollowUpPolicy.php';
+            if (in_array((string)($conv['crm_link_method'] ?? ''), \FollowUpPolicy::TRUSTED_LINKS, true)) return (int)$conv['crm_client_id'];
+        }
+        return null;
+    }
+
+    /** Spoke-to (§H.2.9.5): the conversations with phone exactly p, each with its latest inbound row at or before the send. */
+    private static function spokeOf(\PDO $pdo, array $ctx, string $p, string $sentAt): ?array
+    {
+        $st = $pdo->prepare("SELECT c.*, (SELECT MAX(m.sent_at) FROM wa_messages m WHERE m.conversation_id = c.id
+                                              AND m.direction = 'in' AND m.sent_at <= ?) AS last_in
+                               FROM wa_conversations c WHERE c.phone = ?");
+        $st->execute([$sentAt, $p]);
+        $cands = [];
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $c) {
+            $ch = self::channelRow($pdo, $ctx, (string)$c['channel']);
+            $c['role'] = $ch !== null ? (string)($ch['role'] ?? '') : ((string)$c['channel'] === 'accounts' ? 'account' : (string)$c['channel']);
+            $cands[] = $c;
+        }
+        return QuoteSendEvidence::spokeTo($cands, $sentAt);
+    }
+
+    private static function channelRow(\PDO $pdo, array $ctx, string $channel): ?array
+    {
+        if (empty($ctx['wa_channels']) || $channel === '') return null;
+        $st = $pdo->prepare('SELECT * FROM wa_channels WHERE channel_id = ?');
+        $st->execute([$channel]);
+        $r = $st->fetch(\PDO::FETCH_ASSOC);
+        return is_array($r) ? $r : null;
+    }
+
+    /** Every KYC application of the client. */
+    private static function kycOfClient(\PDO $pdo, array $ctx, int $client): array
+    {
+        return self::blobWhere($pdo, 'kyc_applications', 'crm_client_id', (string)$client);
+    }
+
+    /** The latest KYC application of the client submitted before the send (rule 6); submitted_at is date(), Kampala. */
+    private static function kycOfClientBefore(\PDO $pdo, array $ctx, int $client, string $sentAt): ?array
+    {
+        $local = self::kampalaStamp($sentAt);
+        $best = null;
+        foreach (self::kycOfClient($pdo, $ctx, $client) as $a) {
+            $s = (string)($a['submitted_at'] ?? '');
+            if ($s === '' || $s >= $local) continue;
+            if ($best === null || [$s, (int)($a['id'] ?? 0)] > [(string)$best['submitted_at'], (int)($best['id'] ?? 0)]) $best = $a;
+        }
+        return $best;
+    }
+
+    /** A Cash KYC with amount_charged > 0 for this uCRM quote id (lib/KycService.php:1198). */
+    private static function cashPaid(\PDO $pdo, array $ctx, int $quoteId): bool
+    {
+        foreach (self::blobWhere($pdo, 'kyc_applications', 'quote_id', (string)$quoteId) as $a) {
+            if (self::isCashPaid($a)) return true;
+        }
+        return false;
+    }
+
+    private static function isCashPaid(array $a): bool
+    {
+        return strtolower(trim((string)($a['sales_type'] ?? ''))) === 'cash' && (float)($a['amount_charged'] ?? 0) > 0;
+    }
+
+    /** The raw phones of p's conversations, with p itself: opt-outs are stored as the digits they were typed with. */
+    private static function convPhones(\PDO $pdo, array $convs, string $p): array
+    {
+        $out = [$p => $p];
+        if ($convs !== []) {
+            foreach ($pdo->query('SELECT phone FROM wa_conversations WHERE id IN (' . implode(',', $convs) . ')')->fetchAll(\PDO::FETCH_COLUMN) as $ph) {
+                $d = (string)preg_replace('/\D+/', '', (string)$ph);
+                if ($d !== '') $out[$d] = $d;
+            }
+        }
+        return array_values($out);
+    }
+
+    // ── the store's JSON collections (blob tables: id, data) ─────────────────────────────────────────────────────
+
+    /** Every row of a collection, each with its id. An absent table is empty. */
+    private static function blobAll(\PDO $pdo, string $table): array
+    {
+        if (!self::hasColumns($pdo, $table, ['data'])) return [];
+        $out = [];
+        foreach ($pdo->query("SELECT id, data FROM [{$table}] ORDER BY id")->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            $d = json_decode((string)$r['data'], true);
+            if (!is_array($d)) continue;
+            $d['id'] = (int)$r['id'];
+            $out[] = $d;
+        }
+        return $out;
+    }
+
+    /** The rows whose $.field equals $value (compared as text, trimmed), lowest id first. An absent table is empty. */
+    private static function blobWhere(\PDO $pdo, string $table, string $field, string $value): array
+    {
+        if (trim($value) === '' || !self::hasColumns($pdo, $table, ['data'])) return [];
+        if (!preg_match('/^[a-z_][a-z0-9_]*$/', $field)) throw new \InvalidArgumentException('not a field name');
+        $st = $pdo->prepare("SELECT id, data FROM [{$table}] WHERE TRIM(CAST(json_extract(data, '$.{$field}') AS TEXT)) = ? ORDER BY id");
+        $st->execute([trim($value)]);
+        $out = [];
+        foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+            $d = json_decode((string)$r['data'], true);
+            if (!is_array($d)) continue;
+            $d['id'] = (int)$r['id'];
+            $out[] = $d;
+        }
+        return $out;
+    }
+
+    private static function blobOne(\PDO $pdo, array $ctx, string $table, string $field, string $value): ?array
+    {
+        if ($field === 'id') {
+            if (!self::hasColumns($pdo, $table, ['data'])) return null;
+            $st = $pdo->prepare("SELECT id, data FROM [{$table}] WHERE id = ?");
+            $st->execute([(int)$value]);
+            $r = $st->fetch(\PDO::FETCH_ASSOC);
+            if (!is_array($r)) return null;
+            $d = json_decode((string)$r['data'], true);
+            if (!is_array($d)) return null;
+            $d['id'] = (int)$r['id'];
+            return $d;
+        }
+        $rows = self::blobWhere($pdo, $table, $field, $value);
+        return $rows[0] ?? null;
+    }
+
+    // ── small things ─────────────────────────────────────────────────────────────────────────────────────────────
+
+    private static function hasTable(\PDO $pdo, string $name): bool
+    {
+        $st = $pdo->prepare("SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = ?");
+        $st->execute([$name]);
+        return (int)$st->fetchColumn() > 0;
+    }
+
+    /** The table exists and has every one of these columns. */
+    private static function hasColumns(\PDO $pdo, string $table, array $cols): bool
+    {
+        if (!preg_match('/^[a-z_][a-z0-9_]*$/', $table) || !self::hasTable($pdo, $table)) return false;
+        $have = [];
+        foreach ($pdo->query("PRAGMA table_info([{$table}])")->fetchAll(\PDO::FETCH_ASSOC) as $c) $have[(string)$c['name']] = true;
+        foreach ($cols as $c) if (!isset($have[$c])) return false;
+        return true;
+    }
+
+    /** A stored stamp in the storage form ('Y-m-d H:i:s' UTC), or null when it cannot be read. */
+    private static function norm(string $s): ?string
+    {
+        $t = UtcClock::parse($s);
+        return $t === 0 ? null : UtcClock::stamp($t);
+    }
+
+    /** The same moment as a Kampala wall-clock stamp: how date() dates the KYC, cashbook and collection rows here. */
+    private static function kampalaStamp(string $utcStamp): string
+    {
+        return (new \DateTime('@' . UtcClock::parse($utcStamp)))->setTimezone(new \DateTimeZone(self::TZ))->format('Y-m-d H:i:s');
+    }
+
+    /** The master flag rule: 1, true, on, yes. */
+    private static function truthy($v): bool
+    {
+        if ($v === true) return true;
+        return in_array(strtolower(trim((string)($v ?? ''))), ['1', 'true', 'on', 'yes'], true);
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/ReminderDay.php b/dishnet-hybrid-sudan/lib/ReminderDay.php
new file mode 100644
index 0000000..9f77598
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/ReminderDay.php
@@ -0,0 +1,66 @@
+<?php
+declare(strict_types=1);
+
+/**
+ * ReminderDay — whether today's payment reminders can still come after a send made now (5.18.104, root docs/73
+ * §H.2.5.3 step 8b; A17; ruling R8). Pure: it reads only what it is given.
+ *
+ * On a day the reminders run, a claimed customer send (quote, enquiry, offer) waits until the reminder job has
+ * finished, so that "one automated customer message per person per Kampala day" holds in both directions: a chase or an
+ * offer never goes before a reminder the same person gets later that day. The one rule: the ledger's reminders_first
+ * and Part O both call done().
+ *
+ * done() is true when any of these holds:
+ *   - NotifyGate::REMINDERS does not apply (the reminders then run in the 02:00 maintenance job);
+ *   - now, in a literal Africa/Kampala, is at or after reminder_until_hour, normalised exactly as cron/master.php does;
+ *   - master_schedule.json's customer_reminders ran today at or after reminder_hour and finished (duration_ms >= 0;
+ *     master writes -1 before the job and the real duration after it).
+ * The seeded row (last_run 1) is not done; a crashed run (-1) holds sends until reminder_until_hour, never later.
+ * PHP 7.4.
+ */
+final class ReminderDay
+{
+    /** The literal zone the reminder hours are judged in (master runs under dn_tz(), which is this on Uganda). */
+    public const TZ = 'Africa/Kampala';
+
+    /** True when today's payment reminders cannot still come after a send made now. */
+    public static function done(array $schedule, array $config, ?string $dataDir, int $now): bool
+    {
+        try {
+            if (!class_exists('NotifyGate')) require_once __DIR__ . '/NotifyGate.php';
+            if (!\NotifyGate::applies(\NotifyGate::REMINDERS, $config, $dataDir)) return true;
+        } catch (\Throwable $e) {
+            return false;   // cannot tell: wait for the until-hour, never send before a reminder
+        }
+        [$from, $until] = self::hours($config);
+        $local = (new \DateTime('@' . $now))->setTimezone(new \DateTimeZone(self::TZ));
+        if ((int)$local->format('G') >= $until) return true;
+        $row = $schedule['customer_reminders'] ?? null;
+        if (!is_array($row)) return false;
+        $opening = self::todayAt($now, $from);
+        return (int)($row['last_run'] ?? 0) >= $opening && (int)($row['duration_ms'] ?? -1) >= 0;
+    }
+
+    /**
+     * [reminder_hour, reminder_until_hour], normalised exactly as cron/master.php normalises them before it dispatches
+     * customer_reminders (a test compares the two over a table of inputs).
+     *
+     * @return array{0:int,1:int}
+     */
+    public static function hours(array $config): array
+    {
+        $from  = (int)($config['reminder_hour'] ?? 9);
+        $until = (int)($config['reminder_until_hour'] ?? 17);
+        if ($from < 0 || $from > 23) $from = 9;
+        if ($until <= $from || $until > 24) $until = min(24, $from + 8);
+        return [$from, $until];
+    }
+
+    /** Unix time of $hour:00 today in a literal Africa/Kampala ($hour may be 24: the next midnight). */
+    public static function todayAt(int $now, int $hour): int
+    {
+        $d = (new \DateTime('@' . $now))->setTimezone(new \DateTimeZone(self::TZ));
+        $d->setTime(0, 0, 0);
+        return $d->getTimestamp() + $hour * 3600;
+    }
+}
diff --git a/dishnet-hybrid-sudan/lib/SalesFollowupChecks.php b/dishnet-hybrid-sudan/lib/SalesFollowupChecks.php
new file mode 100644
index 0000000..52ae2a4
--- /dev/null
+++ b/dishnet-hybrid-sudan/lib/SalesFollowupChecks.php
@@ -0,0 +1,900 @@
+<?php
+declare(strict_types=1);
+
+require_once __DIR__ . '/UtcClock.php';
+require_once __DIR__ . '/PluginLog.php';
+require_once __DIR__ . '/WaSendBudget.php';
+require_once __DIR__ . '/HumanTakeover.php';
+require_once __DIR__ . '/QuoteSendEvidence.php';
+require_once __DIR__ . '/QuoteChaseText.php';
+
+/**
+ * SalesFollowupChecks — Part F's callables in the ladder (5.18.104, Uganda, root docs/73 §H.2.12.5; ruling R13's row F).
+ *
+ *   preconditions($ro, $config, $dataDir, $step)   rows 1 (report: nothing to judge), 2 (Part F's half: 089's and 090's
+ *                                                   _schema_checks rows, dn_tz()), 6 (chase: W2 and wa_seen_marks, and
+ *                                                   what `on chase` prints) and 10 (cold: what `on cold` prints)
+ *   check($ro, $config, $dataDir, $id, $now)       L-ON, Q1-ON, Q2-ON, Q3-ON, Q5-ON
+ *
+ * Every read goes through the tool's read-only $ro; nothing here opens a connection or writes (ruling R13). A check
+ * answers PASS, FAIL <code> or NOT_YET too_soon|no_traffic|no_test with counts and notes (ruling R6), computed in a
+ * literal Africa/Kampala. A clause that re-judges a past act judges it at the moment it was decided, from what could be
+ * read then, under the limits recorded with it; what its maker could not know is a count, never a FAIL (ruling R18).
+ * Output is counts, fixed codes, dates and handset labels; never a phone, a name or a message. PHP 7.4.
+ */
+final class SalesFollowupChecks
+{
+    /** The literal zone every day and hour is judged in. */
+    public const TZ = 'Africa/Kampala';
+
+    const DAY_S = 86400;
+    /** The ledger's in-flight bound: a later claim settles every row in flight this long (§H.2.5.3 step 3a). */
+    const ORPHAN_S = 900;
+    /** The hour past the switch L-ON never judges (Q16-F02). */
+    const MARGIN_S = 3600;
+    /** A tracker row is pending for its first hour (§H.2.9.4). */
+    const PENDING_S = 3600;
+    /** The ledger's details for a row its own sweep settled. */
+    const SWEPT = ['stale_orphan', 'stale'];
+    /** The list's section a STOP is listed under (§H.2.11.4). */
+    const STOP_SECTION = 'stop';
+    /** At most this many keys a section lists (§H.2.11.3). */
+    const MAX_REFS = 15;
+    /** How far back a check reads (the ledger keeps 400 days; a check judges at most this window). */
+    const WINDOW_DAYS = 60;
+
+    private function __construct() {}
+
+    // ── preconditions (ruling R13, row F) ──────────────────────────────────────────────────────────────────────
+
+    /** @return array{ok:bool, code:?string, lines:list<string>} */
+    public static function preconditions(\PDO $ro, array $config, string $dataDir, string $step): array
+    {
+        $ok = function (array $lines): array { return ['ok' => true, 'code' => null, 'lines' => $lines]; };
+        $no = function (string $code, array $lines): array { return ['ok' => false, 'code' => $code, 'lines' => $lines]; };
+        switch ($step) {
+            case 'report':
+                return $ok([]);   // its date is an option the tool validates (A12-03)
+            case 'ack':
+                $lines = [];
+                foreach (['089_quote_followups.sql', '090_wa_voice.sql'] as $f) {
+                    if (!self::schemaRow($ro, $f)) return $no('schema_check_missing:' . $f, array_merge($lines, ['_schema_checks ' . $f . ': absent']));
+                    $lines[] = '_schema_checks ' . $f . ': present';
+                }
+                if (!function_exists('dn_tz')) require_once __DIR__ . '/timezone.php';
+                if (dn_tz($config) !== self::TZ) return $no('zone', array_merge($lines, ['dn_tz(): not Africa/Kampala — every claim would answer zone']));
+                $lines[] = 'dn_tz(): Africa/Kampala';
+                return $ok($lines);
+            case 'chase':
+                $src = (string)@file_get_contents(dirname(__DIR__) . '/evo_webhook.php');
+                if (strpos($src, "WaSeenMarks::note(\$pdo, \$config, \$dataDir, 'in', \$phone,") === false || strpos($src, "\$convId === null && \$text === ''") === false) {
+                    return $no('w2_missing', ['the W2 hunk of evo_webhook.php is not installed']);
+                }
+                if (!self::hasTable($ro, 'wa_seen_marks')) return $no('marks_missing', ['wa_seen_marks: absent']);
+                return $ok(array_merge(['W2: installed', 'wa_seen_marks: present'], self::chaseLines($ro, $config, $dataDir)));
+            case 'cold':
+                return $ok(self::coldLines($ro, $config, $dataDir));
+        }
+        return $no('unknown_step', []);
+    }
+
+    /** What `on chase` prints: R-01's measurement, the would-be chases by handset, the holds, the persona, the paced drafts. */
+    private static function chaseLines(\PDO $ro, array $config, string $dataDir): array
+    {
+        $lines = [];
+        $since = UtcClock::stamp((int)(self::parseTime($config['quote_tracking_since'] ?? null) ?? (time() - 30 * self::DAY_S)));
+        foreach (self::all($ro, "SELECT substr(seen_at, 1, 10) AS d, direction, kind, COUNT(*) AS n FROM wa_seen_marks WHERE seen_at >= ?
+                                  GROUP BY d, direction, kind = 'lid_no_number' ORDER BY d", [$since]) as $r) {
+            $lines[] = 'marks ' . $r['d'] . ' ' . ($r['kind'] === 'lid_no_number' ? 'lid_no_number' : $r['direction']) . '=' . (int)$r['n'];
+        }
+        if (self::hasTable($ro, 'quote_tracker')) {
+            $lines[] = 'tracked quotes with an inbound mark after the send: ' . (int)self::one($ro,
+                "SELECT COUNT(*) FROM quote_tracker t WHERE EXISTS (SELECT 1 FROM wa_seen_marks m WHERE m.direction = 'in' AND m.phone = t.phone AND m.seen_at > t.sent_at)");
+            foreach (self::all($ro, "SELECT COALESCE(chase_hold, 'none') AS h, COUNT(*) AS n FROM quote_tracker WHERE status = 'open' GROUP BY h ORDER BY h") as $r) {
+                $lines[] = 'open quotes held ' . $r['h'] . '=' . (int)$r['n'];
+            }
+        }
+        try {
+            if (!class_exists('QuoteChase')) require_once __DIR__ . '/QuoteChase.php';
+            $labels = self::handsetLabels($config);
+            foreach (\QuoteChase::demand($ro, $config, $dataDir, time()) as $h => $n) {
+                $lines[] = 'would-be chases today on ' . ($labels[$h] ?? 'another handset') . ': ' . (int)$n;
+            }
+        } catch (\Throwable $e) {
+            $lines[] = 'would-be chases: not read';
+        }
+        $lines[] = 'persona: ' . (QuoteChaseText::personaConfirmed($config) ? 'confirmed (sf_persona_confirmed set)' : 'held (sf_persona_confirmed unset): the composed forms stay held');
+        if (self::hasTable($ro, 'followup_drafts')) {
+            $kind = self::hasColumn($ro, 'followups', 'kind') ? " AND COALESCE(f.kind, 'enquiry') = 'enquiry'" : '';
+            $lines[] = 'approved enquiry drafts that become paced: ' . (int)self::one($ro,
+                "SELECT COUNT(*) FROM followup_drafts d JOIN followups f ON f.id = d.followup_id WHERE d.status = 'approved' AND f.closed_at IS NULL{$kind}");
+        }
+        return $lines;
+    }
+
+    /** What `on cold` prints: the cold quotes chasable and refused by reason, and the role statement (§H.2.10.9). */
+    private static function coldLines(\PDO $ro, array $config, string $dataDir): array
+    {
+        $lines = [];
+        if (self::hasTable($ro, 'quote_tracker')) {
+            $by = [];
+            try {
+                if (!class_exists('AutomationPolicy')) require_once __DIR__ . '/AutomationPolicy.php';
+                if (!class_exists('OwnedNumberHold')) require_once __DIR__ . '/OwnedNumberHold.php';
+                $pol = \AutomationPolicy::forInstall($config, $dataDir, $ro);
+                $own = \OwnedNumberHold::forInstall($config, $dataDir, $ro);
+                foreach (self::all($ro, "SELECT phone, sent_channel FROM quote_tracker WHERE status = 'open' AND COALESCE(spoke_conv_id, 0) <= 0") as $r) {
+                    $ch = (string)$r['sent_channel'];
+                    $why = $own->holds($ch) ? 'owned_number' : $pol->refusal($ch, (string)$r['phone'], false);
+                    $by[$why === '' ? 'chasable' : $why] = ($by[$why === '' ? 'chasable' : $why] ?? 0) + 1;
+                }
+            } catch (\Throwable $e) {
+                $by = ['not_read' => 1];
+            }
+            ksort($by);
+            foreach ($by as $k => $n) $lines[] = 'cold quotes ' . $k . '=' . $n;
+        }
+        $lines[] = 'a cold chase leaves from the quote\'s own number (support or account); a reply is answered there in that role, not the sales role';
+        return $lines;
+    }
+
+    // ── checks ─────────────────────────────────────────────────────────────────────────────────────────────────
+
+    /** @return array{status:string, counts:array<string,int>, notes:list<string>} */
+    public static function check(\PDO $ro, array $config, string $dataDir, string $id, int $now): array
+    {
+        try {
+            switch ($id) {
+                case 'L-ON':  return self::lOn($ro, $config, $dataDir, $now);
+                case 'Q1-ON': return self::q1On($ro, $config, $dataDir, $now);
+                case 'Q2-ON': return self::q2On($ro, $config, $dataDir, $now);
+                case 'Q3-ON': return self::q3On($ro, $config, $dataDir, $now, false);
+                case 'Q5-ON': return self::q3On($ro, $config, $dataDir, $now, true);
+            }
+        } catch (\Throwable $e) {
+            return self::res('FAIL read_error', [], ['the check could not read the book (' . get_class($e) . ')']);
+        }
+        return self::res('FAIL unknown_check', [], []);
+    }
+
+    // ── L-ON (§H.2.12.5) ───────────────────────────────────────────────────────────────────────────────────────
+
+    private static function lOn(\PDO $ro, array $config, string $dataDir, int $now): array
+    {
+        $since = self::parseTime($config['wa_send_ledger_since'] ?? null);
+        if ($since === null) return self::res('FAIL since_unreadable', [], ['wa_send_ledger_since: unset or unreadable']);
+        $notes = ['wa_send_ledger_since: ' . UtcClock::stamp($since)];
+        if ($now < $since + self::DAY_S) return self::res('NOT_YET too_soon', [], $notes);
+        if (!self::hasTable($ro, 'wa_auto_sends')) return self::res('FAIL schema', [], array_merge($notes, ['wa_auto_sends: absent']));
+        $c = ['rows' => 0, 'inside_switch_margin' => 0, 'hook_write_lost' => 0, 'wasender' => 0, 'noinstance' => 0,
+              'orphans_settled' => 0, 'orphans_unswept' => 0, 'log_rows_matched' => 0];
+        $fail = [];
+        $labels = self::handsetLabels($config);
+        $registered = $labels;   // the registry as read: label() adds every other line to $labels (§H.2.12.5; ruling R6)
+        $from = UtcClock::stamp(max($since - self::DAY_S, $now - self::WINDOW_DAYS * self::DAY_S));
+
+        // The ledger: rows by kind per handset per day, and the true total.
+        foreach (self::all($ro, "SELECT local_day, handset, kind, COUNT(*) AS n FROM wa_auto_sends WHERE claimed_at >= ?
+                                  GROUP BY local_day, handset, kind ORDER BY local_day, handset, kind", [$from]) as $r) {
+            $c['rows'] += (int)$r['n'];
+            $notes[] = 'ledger ' . $r['local_day'] . ' ' . self::label($labels, (string)$r['handset']) . ' ' . $r['kind'] . '=' . (int)$r['n'];
+        }
+        foreach (self::all($ro, "SELECT handset, local_day, COUNT(*) AS n, MAX(cap_day) AS cap FROM wa_auto_sends
+                                  WHERE claimed_at >= ? AND proactive = 1 AND (outcome IS NULL OR outcome <> 'not_sent')
+                                  GROUP BY handset, local_day ORDER BY local_day", [$from]) as $r) {
+            $notes[] = 'proactive ' . $r['local_day'] . ' ' . self::label($labels, (string)$r['handset']) . ': ' . (int)$r['n']
+                     . ' of ' . ($r['cap'] === null ? 'no cap recorded' : (int)$r['cap']);
+        }
+
+        // The positive control on the hooks (K2-23, Q19-F02): per Kampala day and kind, the Message Log's rows to match.
+        $start = max(self::nextMidnight($since), $since + self::MARGIN_S);
+        $log = []; $pre = [];
+        if (self::hasTable($ro, 'notification_audit_log')) {
+            $person = HumanTakeover::personEvents();
+            $st = $ro->prepare('SELECT event, success, http_code, sent_at FROM notification_audit_log WHERE sent_at >= ? ORDER BY id');
+            $st->execute([self::local($since - self::DAY_S)->format('Y-m-d H:i:s')]);
+            foreach ($st->fetchAll(\PDO::FETCH_ASSOC) as $r) {
+                $ev = (string)$r['event'];
+                if ($ev === '' || in_array($ev, $person, true)) continue;
+                if (substr($ev, -18) === '_suppressed_optout') continue;                   // written before any send
+                if ((int)$r['success'] === 0 && $r['http_code'] === null) continue;        // written before any send
+                $t = self::fromLocal((string)$r['sent_at']);
+                if ($t === null || $t > $now) continue;
+                $kind = self::kindOfEvent($ev);
+                if ($t < $start) { $pre[$kind] = ($pre[$kind] ?? 0) + 1; continue; }
+                $day = self::local($t)->format('Y-m-d');
+                $log[$day][$kind] = ($log[$day][$kind] ?? 0) + 1;
+            }
+        }
+        $startS = UtcClock::stamp($start);
+        foreach ($pre as $kind => $n) {
+            $had = (int)self::one($ro, 'SELECT COUNT(*) FROM wa_auto_sends WHERE kind = ? AND claimed_at >= ? AND claimed_at < ?',
+                                  [$kind, UtcClock::stamp($since), $startS]);
+            $c['inside_switch_margin'] += max(0, $n - $had);
+        }
+        $ledger = [];
+        foreach (self::all($ro, 'SELECT local_day, kind, COUNT(*) AS n FROM wa_auto_sends WHERE claimed_at >= ? GROUP BY local_day, kind', [$startS]) as $r) {
+            $ledger[(string)$r['local_day']][(string)$r['kind']] = (int)$r['n'];
+        }
+        $counts = self::stateCounts($ro);
+        $lines = self::lostLines($config);
+        $usable = self::logUsable();
+        foreach ($log as $day => $kinds) {
+            ksort($kinds);
+            foreach ($kinds as $kind => $n) {
+                $was = (int)($counts['wasender'][$day][$kind] ?? 0);
+                $noi = (int)($counts['noinstance'][$day][$kind] ?? 0);
+                $have = (int)($ledger[$day][$kind] ?? 0);
+                $lost = (int)($lines[$day][$kind] ?? 0);
+                $c['wasender'] += $was;
+                $c['noinstance'] += $noi;
+                $need = max(0, $n - $was - $noi);
+                $short = max(0, $need - $have);
+                $c['log_rows_matched'] += min($need, $have);
+                if ($was > 0) $notes[] = 'wasender ' . $day . ' ' . $kind . '=' . $was;
+                if ($noi > 0) $notes[] = 'noinstance ' . $day . ' ' . $kind . '=' . $noi;
+                if ($lost > 0) $notes[] = 'hook_write_lost ' . $day . ' ' . $kind . ' lines=' . $lost;
+                if ($short === 0) continue;
+                $trace = $have > 0 || $was > 0 || $noi > 0 || $lost > 0;
+                if (!$trace && $usable !== null && strcmp($usable, $day) < 0) {
+                    $fail[] = 'hook_silent';
+                    $notes[] = 'hook_silent ' . $day . ' ' . $kind . '=' . $short;
+                    continue;
+                }
+                $c['hook_write_lost'] += $short;
+                if (!$trace) $notes[] = 'plugin_log_not_read';
+            }
+        }
+
+        // Orphans: a claim still in flight more than 900 s after a later claim on its handset.
+        foreach (self::all($ro, "SELECT a.id, a.handset, a.claimed_at FROM wa_auto_sends a WHERE a.outcome IS NULL AND a.claimed_at >= ?", [$from]) as $r) {
+            $later = self::one($ro, "SELECT 1 FROM wa_auto_sends b WHERE b.handset = ? AND b.mode = 'claim' AND b.id > ?
+                                     AND CAST(strftime('%s', b.claimed_at) AS INTEGER) >= CAST(strftime('%s', ?) AS INTEGER) + ? LIMIT 1",
+                                [(string)$r['handset'], (int)$r['id'], (string)$r['claimed_at'], self::ORPHAN_S]);
+            if ($later !== false && $later !== null) { $fail[] = 'ledger_orphan'; continue; }
+            if ($now - UtcClock::parse((string)$r['claimed_at']) >= self::ORPHAN_S) $c['orphans_unswept']++;
+        }
+        foreach (self::all($ro, "SELECT local_day, COUNT(*) AS n FROM wa_auto_sends WHERE detail = 'stale_orphan' AND claimed_at >= ? GROUP BY local_day", [$from]) as $r) {
+            $c['orphans_settled'] += (int)$r['n'];
+            $notes[] = 'stale_orphan ' . $r['local_day'] . '=' . (int)$r['n'];
+        }
+        if ((int)self::one($ro, "SELECT COUNT(*) FROM wa_auto_sends WHERE handset NOT GLOB 'i:?*'") > 0) $fail[] = 'handset_malformed';
+        foreach (self::all($ro, 'SELECT DISTINCT handset FROM wa_auto_sends WHERE claimed_at >= ?', [$from]) as $r) {
+            if (!isset($registered[(string)$r['handset']])) $notes[] = 'a handset not in the registry: ' . self::label($labels, (string)$r['handset']);
+        }
+        if (!$usable) $notes[] = 'data/plugin.log: not readable or not writable here';
+        $notes = array_values(array_unique($notes));
+        if ($fail !== []) return self::res('FAIL ' . $fail[0], $c, array_merge($notes, ['failed: ' . implode(', ', array_unique($fail))]));
+        return self::res('PASS', $c, $notes);
+    }
+
+    /** A Message Log event's kind, as the hooks file it: AlertService's by its event (A11-04), the rest by NOTIFY_KINDS. */
+    public static function kindOfEvent(string $event): string
+    {
+        if (strpos($event, 'ops_alert_') === 0) {
+            if ($event === 'ops_alert_escalate') return 'handover_alert';
+            if ($event === 'ops_alert_quote_list') return 'staff_list';
+            return 'other';
+        }
+        return WaSendBudget::NOTIFY_KINDS[$event] ?? 'other';
+    }
+
+    /** quote_followup_state's wasender:<day>:<kind> and noinstance:<day>:<kind> counts. */
+    private static function stateCounts(\PDO $ro): array
+    {
+        $out = ['wasender' => [], 'noinstance' => []];
+        if (!self::hasTable($ro, 'quote_followup_state')) return $out;
+        foreach (self::all($ro, "SELECT k, v FROM quote_followup_state WHERE k LIKE 'wasender:%' OR k LIKE 'noinstance:%'") as $r) {
+            $p = explode(':', (string)$r['k']);
+            if (count($p) !== 3) continue;
+            $out[$p[0]][$p[1]][$p[2]] = (int)$r['v'];
+        }
+        return $out;
+    }
+
+    /**
+     * data/plugin.log's `hook_write_lost <kind>` lines by Kampala day and kind, each placed from the zone PluginLog wrote
+     * it in (UTC where the stamp says so); a line in a day's last minute counts for the next day too.
+     */
+    private static function lostLines(array $config): array
+    {
+        $out = [];
+        $f = PluginLog::path();
+        if (!is_file($f) || !is_readable($f)) return $out;
+        if (!function_exists('dn_tz_obj')) require_once __DIR__ . '/timezone.php';
+        $zone = dn_tz_obj($config);
+        $h = @fopen($f, 'r');
+        if ($h === false) return $out;
+        while (($l = fgets($h)) !== false) {
+            if (strpos($l, 'hook_write_lost ') === false) continue;
+            if (!preg_match('/^\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})( UTC)?\] \[wa_send_ledger\] hook_write_lost ([a-z_]+)/', $l, $m)) continue;
+            try {
+                $t = (new \DateTime($m[1], $m[2] !== '' ? new \DateTimeZone('UTC') : $zone))->getTimestamp();
+            } catch (\Throwable $e) { continue; }
+            $kind = $m[3];
+            $loc = self::local($t);
+            $day = $loc->format('Y-m-d');
+            $out[$day][$kind] = ($out[$day][$kind] ?? 0) + 1;
+            if ($loc->format('H:i') === '23:59') {
+                $next = self::local($t + 60)->format('Y-m-d');
+                $out[$next][$kind] = ($out[$next][$kind] ?? 0) + 1;
+            }
+        }
+        fclose($h);
+        return $out;
+    }
+
+    /**
+     * Whether data/plugin.log could take a line and can be read: PluginLog's own test (:41) and readable. Returns the
+     * Kampala date of its earliest dated line (a judged day must come after it), or null when it is not usable.
+     */
+    private static function logUsable(): ?string
+    {
+        $f = PluginLog::path();
+        $dir = dirname($f);
+        if (!is_dir($dir) || !is_file($f) || !is_readable($f) || !is_writable($f)) return null;
+        $h = @fopen($f, 'r');
+        if ($h === false) return null;
+        $first = null;
+        while (($l = fgets($h)) !== false) {
+            if (preg_match('/^\[(\d{4}-\d{2}-\d{2}) \d{2}:\d{2}:\d{2}/', $l, $m)) { $first = $m[1]; break; }
+        }
+        fclose($h);
+        return $first;
+    }
+
+    // ── Q1-ON (§H.2.12.5) ──────────────────────────────────────────────────────────────────────────────────────
+
+    private static function q1On(\PDO $ro, array $config, string $dataDir, int $now): array
+    {
+        $since = self::parseTime($config['quote_tracking_since'] ?? null);
+        if ($since === null) return self::res('FAIL since_unreadable', [], ['quote_tracking_since: unset or unreadable']);
+        $notes = ['quote_tracking_since: ' . UtcClock::stamp($since)];
+        if (!self::hasTable($ro, 'quote_tracker')) return self::res('FAIL schema', [], array_merge($notes, ['quote_tracker: absent']));
+        $sinceS = UtcClock::stamp($since);
+        $c = ['confirming' => 0, 'tracked' => 0, 'awaiting_run' => 0, 'evidence_gone' => 0, 'ref_conflict' => 0, 'no_phone' => 0,
+              'pending' => 0, 'pending_awaiting_run' => 0, 'followups_opened' => 0, 'quote_claims' => 0, 'sticky' => 0];
+        $fail = [];
+        $events = QuoteSendEvidence::EVENTS;
+        $in = implode(',', array_fill(0, count($events), '?'));
+        $rows = self::all($ro, "SELECT m.id, m.conversation_id, m.direction, m.event_key, m.body, m.sent_at FROM wa_messages m
+                                 WHERE m.direction = 'out' AND m.event_key IN ({$in}) AND m.sent_at >= ? ORDER BY m.id",
+                           array_merge($events, [$sinceS]));
+        $c['tracked'] = (int)self::one($ro, 'SELECT COUNT(*) FROM quote_tracker WHERE sent_at >= ?', [$sinceS]);
+        $confirming = [];
+        foreach ($rows as $m) {
+            $ev = QuoteSendEvidence::read($m);
+            if ($ev === null) continue;
+            $confirming[] = [$m, QuoteSendEvidence::key((string)$ev[1])];
+        }
+        $c['confirming'] = count($confirming);
+        if ($now < $since + self::DAY_S || ($c['confirming'] === 0 && $c['tracked'] === 0)) return self::res('NOT_YET no_traffic', $c, $notes);
+
+        // Parity, at the tracker's reach and by key (ruling R18 point 1; Q17-F04).
+        $cursor = self::state($ro, 'tracker_cursor');
+        $cur = ($cursor === null || !ctype_digit($cursor)) ? 0 : (int)$cursor;
+        foreach ($confirming as [$m, $key]) {
+            if ((int)$m['id'] > $cur) { $c['awaiting_run']++; continue; }
+            if (self::one($ro, 'SELECT 1 FROM quote_tracker WHERE quote_key = ?', [$key]) !== false) continue;
+            if (self::state($ro, 'ref_conflict:' . $key) !== null) continue;
+            $phone = self::one($ro, 'SELECT phone FROM wa_conversations WHERE id = ?', [(int)$m['conversation_id']]);
+            if ($phone === false || preg_replace('/\D+/', '', (string)$phone) === '') { $c['no_phone']++; continue; }
+            $fail[] = 'tracker_parity';
+        }
+        foreach (self::all($ro, 'SELECT quote_key, evidence_msg_id FROM quote_tracker WHERE backfilled = 0 AND sent_at >= ?', [$sinceS]) as $t) {
+            $m = self::row($ro, 'SELECT id, direction, event_key, body FROM wa_messages WHERE id = ?', [(int)$t['evidence_msg_id']]);
+            if ($m === null) { $c['evidence_gone']++; continue; }
+            $ev = QuoteSendEvidence::read($m);
+            if ($ev === null || QuoteSendEvidence::key((string)$ev[1]) !== (string)$t['quote_key']) $fail[] = 'tracker_parity';
+        }
+        if ($c['awaiting_run'] > 0) $notes[] = 'confirming rows past the tracker\'s cursor (awaiting its run): ' . $c['awaiting_run'];
+
+        // pending, judged at the tracker's own moment (Q16-F04).
+        $ran = self::parseTime(self::state($ro, 'tracker_ran'));
+        foreach (self::all($ro, "SELECT sent_at FROM quote_tracker WHERE owner_source = 'pending'") as $r) {
+            $c['pending']++;
+            $sent = UtcClock::parse((string)$r['sent_at']);
+            if ($ran !== null && $ran - $sent >= self::PENDING_S) { $fail[] = 'pending_past_1h'; continue; }
+            if ($now - $sent >= self::PENDING_S) $c['pending_awaiting_run']++;
+        }
+        $c['ref_conflict'] = (int)self::one($ro, "SELECT COUNT(*) FROM quote_followup_state WHERE k LIKE 'ref_conflict:%'");
+        foreach (self::all($ro, 'SELECT owner_source, COUNT(*) AS n FROM quote_tracker GROUP BY owner_source ORDER BY owner_source') as $r) {
+            $notes[] = 'owner source ' . $r['owner_source'] . '=' . (int)$r['n'];
+        }
+        $like = self::truthy($config['kyc_messages_like_crm'] ?? null);
+        $notes[] = 'kyc_messages_like_crm: ' . ($like ? 'on' : 'off');
+        if (!$like) $notes[] = 'with kyc_messages_like_crm off, a KYC quotation to a client with an earlier application is owned by that application (§H.2.9.4)';
+        if (self::hasColumn($ro, 'wa_conversations', 'state')) {
+            $c['sticky'] = (int)self::one($ro, "SELECT COUNT(*) FROM quote_tracker t JOIN wa_conversations w ON w.id = t.sent_conv_id
+                                                 WHERE t.status = 'open' AND w.state = 'human_active'");
+        }
+        if (self::hasTable($ro, 'wa_seen_marks')) {
+            foreach (self::all($ro, "SELECT substr(seen_at, 1, 10) AS d, direction, kind = 'lid_no_number' AS lid, COUNT(*) AS n FROM wa_seen_marks
+                                      WHERE seen_at >= ? GROUP BY d, direction, lid ORDER BY d", [$sinceS]) as $r) {
+                $notes[] = 'marks ' . $r['d'] . ' ' . ((int)$r['lid'] === 1 ? 'lid_no_number' : $r['direction']) . '=' . (int)$r['n'];
+            }
+        }
+        // Until the chase first comes on: nothing opened, nothing claimed (step 6's own work once it has).
+        if (self::hasColumn($ro, 'followups', 'kind')) {
+            $c['followups_opened'] = (int)self::one($ro, "SELECT COUNT(*) FROM followups WHERE kind = 'quote' AND opened_at >= ?", [$sinceS]);
+        }
+        if (self::hasTable($ro, 'wa_auto_sends')) {
+            $c['quote_claims'] = (int)self::one($ro, "SELECT COUNT(*) FROM wa_auto_sends WHERE kind = 'quote' AND claimed_at >= ?", [$sinceS]);
+        }
+        if (trim((string)($config['sf_chase_first_on'] ?? '')) === '') {
+            if ($c['followups_opened'] > 0) $fail[] = 'chase_before_switch';
+            if ($c['quote_claims'] > 0) $fail[] = 'chase_before_switch';
+        } else {
+            $notes[] = 'since the chase first came on: ' . $c['followups_opened'] . ' quote follow-ups opened, ' . $c['quote_claims'] . ' quote claims (step 6\'s, judged by Q3-ON)';
+        }
+        if ($fail !== []) return self::res('FAIL ' . $fail[0], $c, array_merge($notes, ['failed: ' . implode(', ', array_unique($fail))]));
+        return self::res('PASS', $c, $notes);
+    }
+
+    // ── Q2-ON (§H.2.12.5) ──────────────────────────────────────────────────────────────────────────────────────
+
+    private static function q2On(\PDO $ro, array $config, string $dataDir, int $now): array
+    {
+        $since = self::parseTime($config['quote_daily_list_since'] ?? null);
+        if ($since === null) return self::res('FAIL since_unreadable', [], ['quote_daily_list_since: unset or unreadable']);
+        $notes = ['quote_daily_list_since: ' . UtcClock::stamp($since)];
+        if (!self::hasTable($ro, 'quote_list_sends')) return self::res('FAIL schema', [], array_merge($notes, ['quote_list_sends: absent']));
+        $swept = (string)(self::state($ro, 'list_swept') ?? '');
+        $days = [];
+        for ($d = self::dayStart($since); $d <= $now; $d += self::DAY_S) {
+            $day = self::local($d + 3600)->format('Y-m-d');
+            $eleven = self::at($day, 11);
+            if ((int)self::local($eleven)->format('N') === 7) continue;
+            if ($eleven <= $since || $eleven > $now) continue;
+            if ($swept === '' || strcmp($day, $swept) > 0) continue;
+            $days[] = $day;
+        }
+        if ($days === []) return self::res('NOT_YET too_soon', [], $notes);
+        $c = ['lists_sent' => 0, 'lists_uncertain' => 0, 'missed' => 0, 'no_longer_due' => 0, 'settle_not_landed' => 0,
+              'handset_moved' => 0, 'optout_after_build' => 0, 'central_keys' => 0, 'sunday' => 0];
+        $fail = [];
+        $sales = self::salesHandset($config);
+        $hasLedger = self::hasTable($ro, 'wa_auto_sends');
+        $owners = [];   // owner_key => 'owner n', this run's index (§H.2.8.2)
+        $c['sunday'] = 0;
+        foreach (self::all($ro, "SELECT list_date FROM quote_list_sends WHERE outcome IN ('sent','uncertain')") as $r) {
+            if ((int)self::local(self::at((string)$r['list_date'], 12))->format('N') === 7) $c['sunday']++;
+        }
+        if ($c['sunday'] > 0) $fail[] = 'sunday_list';
+        foreach ($days as $day) {
+            $byOwner = [];
+            foreach (self::all($ro, 'SELECT * FROM quote_list_sends WHERE list_date = ? ORDER BY id', [$day]) as $r) $byOwner[(string)$r['owner_key']][] = $r;
+            // A try that may have gone with no list row at all (a death after its claim, which the sweep leaves out; Q18-F03).
+            if ($hasLedger) {
+                $seen = [];
+                foreach (self::all($ro, "SELECT ref FROM wa_auto_sends WHERE kind = 'staff_list' AND ref LIKE ? AND (outcome IS NULL OR outcome IN ('sent','uncertain'))",
+                                   ['list:' . $day . ':%']) as $l) {
+                    $owner = substr((string)$l['ref'], strlen('list:' . $day . ':'));
+                    if (!isset($byOwner[$owner]) && !isset($seen[$owner])) { $seen[$owner] = true; $c['settle_not_landed']++; }
+                }
+            }
+            foreach ($byOwner as $owner => $rs) {
+                $ref = 'list:' . $day . ':' . $owner;
+                $ledger = $hasLedger ? self::all($ro, "SELECT * FROM wa_auto_sends WHERE kind = 'staff_list' AND ref = ? ORDER BY id", [$ref]) : [];
+                $done = null; $missed = null;
+                foreach ($rs as $r) {
+                    if (in_array($r['outcome'], ['sent', 'uncertain'], true)) $done = $r;
+                    if ($r['outcome'] === 'missed') $missed = $r;
+                }
+                if ($done === null && $missed !== null) {
+                    $c['missed']++;
+                    $fail[] = (string)$missed['detail'] === 'digit_run' ? 'digit_run' : 'missed';
+                    $notes[] = 'missed ' . $day . ' ' . self::ownerLabel($owners, $owner) . ': ' . (string)$missed['detail'];
+                    continue;
+                }
+                if ($done === null) {
+                    $tried = false;
+                    foreach ($ledger as $l) if ($l['outcome'] === null || in_array($l['outcome'], ['sent', 'uncertain'], true)) $tried = true;
+                    if ($tried) $c['settle_not_landed']++; else $c['no_longer_due']++;
+                    continue;
+                }
+                $c[$done['outcome'] === 'sent' ? 'lists_sent' : 'lists_uncertain']++;
+                // In the ledger, by kind and ref alone (Q17-F03, Q18-F03).
+                if ($ledger === []) { $fail[] = 'list_ledger_missing'; }
+                else {
+                    $want = $done['outcome'] === 'sent' ? ['sent'] : ['sent', 'uncertain'];
+                    $match = false; $landing = false; $live = false;
+                    foreach ($ledger as $l) {
+                        if ($l['outcome'] !== 'not_sent') $live = true;
+                        if (in_array((string)$l['outcome'], $want, true) && !($done['outcome'] === 'sent' && in_array((string)$l['detail'], self::SWEPT, true))) $match = true;
+                        if ($l['outcome'] === null || ($l['outcome'] === 'uncertain' && in_array((string)$l['detail'], self::SWEPT, true))) $landing = true;
+                        if ($sales !== '' && (string)$l['handset'] !== $sales) $c['handset_moved']++;
+                    }
+                    if (!$live) $fail[] = 'list_ledger_not_sent';
+                    elseif (!$match && $landing) $c['settle_not_landed']++;
+                    elseif (!$match) $fail[] = 'list_ledger_mismatch';
+                }
+                // The sections as the list recorded them when it was built (A14-02).
+                $built = (string)$done['created_at'];
+                $sections = json_decode((string)$done['sections'], true);
+                if (!is_array($sections)) { $fail[] = 'sections_unreadable'; continue; }
+                foreach ($sections as $sec) {
+                    $keys = (array)($sec['keys'] ?? []);
+                    if (count($keys) !== min((int)($sec['n'] ?? -1), self::MAX_REFS)) $fail[] = 'sections_inconsistent';
+                    foreach ($keys as $k) {
+                        $t = self::row($ro, 'SELECT * FROM quote_tracker WHERE quote_key = ?', [(string)$k]);
+                        if ($t === null || strcmp((string)$t['created_at'], $built) > 0) { $fail[] = 'list_key_unknown'; continue; }
+                        if ($owner === 'central') { $c['central_keys']++; }
+                        elseif ('staff:' . (string)$t['owner_staff_id'] !== $owner) { $fail[] = 'list_owner'; }
+                        if ((string)($sec['section'] ?? '') === self::STOP_SECTION) continue;
+                        $o = self::optoutAt($ro, $t, $built);
+                        if ($o === 'before') $fail[] = 'listed_after_optout';
+                        elseif ($o === 'later') $c['optout_after_build']++;
+                    }
+                }
+                $openNow = $owner === 'central' ? null : (int)self::one($ro, "SELECT COUNT(*) FROM quote_tracker WHERE status = 'open' AND owner_staff_id = ?",
+                                                                       [(int)substr($owner, 6)]);
+                if ($openNow !== null) $notes[] = 'open now ' . self::ownerLabel($owners, $owner) . ': ' . $openNow . ' (the page, not compared)';
+            }
+        }
+        $notes = array_values(array_unique($notes));
+        if ($fail !== []) return self::res('FAIL ' . $fail[0], $c, array_merge($notes, ['failed: ' . implode(', ', array_unique($fail))]));
+        return self::res('PASS', $c, $notes);
+    }
+
+    /** A live opt-out for the tracker row's phone, matched as the list matches it: 'before' the build's second, 'later', or ''. */
+    private static function optoutAt(\PDO $ro, array $t, string $built): string
+    {
+        if (!self::hasTable($ro, 'contact_optouts')) return '';
+        $p = (string)$t['phone'];
+        if ($p === '' || $p === 'erased') return '';
+        $phones = [$p => $p];
+        if (!class_exists('QuoteTracker')) require_once __DIR__ . '/QuoteTracker.php';
+        foreach (\QuoteTracker::convIds($ro, $p, (int)($t['sent_conv_id'] ?? 0)) as $id) {
+            $d = (string)preg_replace('/\D+/', '', (string)self::one($ro, 'SELECT phone FROM wa_conversations WHERE id = ?', [$id]));
+            if ($d !== '') $phones[$d] = $d;
+        }
+        $in = implode(',', array_fill(0, count($phones), '?'));
+        $out = '';
+        foreach (self::all($ro, "SELECT created_at, active, lifted_at FROM contact_optouts WHERE phone IN ({$in})", array_values($phones)) as $o) {
+            // In force at the build: active and not lifted by then, or lifted (re-consent) only after it.
+            $liftedAfter = $o['lifted_at'] !== null && strcmp((string)$o['lifted_at'], $built) > 0;
+            $inForce = ((int)$o['active'] === 1 && ($o['lifted_at'] === null || $liftedAfter)) || ((int)$o['active'] === 0 && $liftedAfter);
+            if (strcmp((string)$o['created_at'], $built) < 0) { if ($inForce) return 'before'; continue; }
+            $out = 'later';
+        }
+        return $out;
+    }
+
+    // ── Q3-ON and Q5-ON (§H.2.12.5) ────────────────────────────────────────────────────────────────────────────
+
+    private static function q3On(\PDO $ro, array $config, string $dataDir, int $now, bool $cold): array
+    {
+        $since = self::parseTime($config['quote_chase_not_before'] ?? null);
+        if ($since === null) return self::res('FAIL since_unreadable', [], ['quote_chase_not_before: unset or unreadable']);
+        $notes = ['quote_chase_not_before: ' . UtcClock::stamp($since)];
+        if (!self::hasTable($ro, 'wa_auto_sends') || !self::hasTable($ro, 'quote_tracker') || !self::hasColumn($ro, 'followups', 'kind')) {
+            return self::res('FAIL schema', [], array_merge($notes, ['the ledger, the tracker or followups.kind: absent']));
+        }
+        $sinceS = UtcClock::stamp($since);
+        $trackSince = UtcClock::stamp((int)(self::parseTime($config['quote_tracking_since'] ?? null) ?? $since));
+        $c = ['claims' => 0, 'sent' => 0, 'uncertain' => 0, 'not_sent' => 0, 'in_flight' => 0, 'reply_after_claim' => 0,
+              'person_after_claim' => 0, 'reminder_after_claim' => 0, 'settle_not_landed' => 0, 'persona_renamed' => 0,
+              'chase_sends' => 0, 'chased_quotations' => 0];
+        $fail = [];
+        $labels = self::handsetLabels($config);
+        $claims = self::all($ro, "SELECT * FROM wa_auto_sends WHERE mode = 'claim' AND kind IN ('quote','enquiry') AND claimed_at >= ? ORDER BY id", [$sinceS]);
+        $quoteOf = function (array $a) use ($ro): ?array {
+            if (!preg_match('/^fu:(\d+):(\d+)$/', (string)$a['ref'], $m)) return null;
+            return self::row($ro, "SELECT f.id AS fid, f.channel, f.quote_key, t.* FROM followups f JOIN quote_tracker t ON t.quote_key = f.quote_key
+                                    WHERE f.id = ? AND f.kind = 'quote'", [(int)$m[1]]);
+        };
+        $judged = 0;
+        foreach ($claims as $a) {
+            $q = $a['kind'] === 'quote' ? $quoteOf($a) : null;
+            if ($cold) {
+                if ($q === null || (int)($q['spoke_conv_id'] ?? 0) > 0) continue;
+                if ((string)$q['channel'] === 'account') $fail[] = 'cold_on_accounts';
+            }
+            $judged++;
+            $c['claims']++;
+            $c[$a['outcome'] === null ? 'in_flight' : (string)$a['outcome']]++;
+            $t = UtcClock::parse((string)$a['claimed_at']);
+            $loc = self::local($t);
+            // The window the claim recorded (ruling R18 point 3).
+            $h = (int)$loc->format('G');
+            if ((int)$loc->format('N') === 7 || $a['win_from'] === null || $h < (int)$a['win_from'] || $h >= (int)$a['win_to']) $fail[] = 'outside_window';
+            // Never after 20:00 on valid_until.
+            if ($q !== null) {
+                $cut = self::at((string)$q['valid_until'], 20);
+                if ($cut === null || $t >= $cut) $fail[] = 'after_valid_until';
+            }
+            // The caps it recorded, over what it could count (a smaller id, the same handset and day, not not_sent).
+            $live = "(outcome IS NULL OR outcome <> 'not_sent')";
+            $day = (int)self::one($ro, "SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND local_day = ? AND proactive = 1 AND id < ? AND {$live}",
+                                  [(string)$a['handset'], (string)$a['local_day'], (int)$a['id']]);
+            if ($a['cap_day'] === null || $day + 1 > (int)$a['cap_day']) $fail[] = 'cap_day';
+            $hour = (int)self::one($ro, "SELECT COUNT(*) FROM wa_auto_sends WHERE handset = ? AND proactive = 1 AND id < ? AND {$live}
+                                         AND CAST(strftime('%s', claimed_at) AS INTEGER) > ?", [(string)$a['handset'], (int)$a['id'], $t - 3600]);
+            if ($a['cap_hour'] === null || $hour + 1 > (int)$a['cap_hour']) $fail[] = 'cap_hour';
+            // The spacing each earlier row asked for, by its own gap_s.
+            $gap = self::one($ro, "SELECT MAX(CAST(strftime('%s', claimed_at) AS INTEGER) + gap_s) FROM wa_auto_sends WHERE handset = ? AND id < ? AND {$live}",
+                             [(string)$a['handset'], (int)$a['id']]);
+            if ($gap !== null && $gap !== false && $t < (int)$gap) $fail[] = 'spacing';
+            // One customer message a person a Kampala day, in id order (S2-08); the other direction is a count (Q15-F01).
+            if ((string)$a['phone'] !== '') {
+                $pk = "'" . implode("','", WaSendBudget::PERSON_KINDS) . "'";
+                if (self::one($ro, "SELECT 1 FROM wa_auto_sends WHERE phone = ? AND local_day = ? AND id < ? AND kind IN ({$pk}) AND {$live} LIMIT 1",
+                              [(string)$a['phone'], (string)$a['local_day'], (int)$a['id']]) !== false) $fail[] = 'phone_today';
+                $c['reminder_after_claim'] += (int)self::one($ro, "SELECT COUNT(*) FROM wa_auto_sends WHERE phone = ? AND local_day = ? AND id > ?
+                                                                    AND kind IN ('reminder','winback') AND {$live}",
+                                                              [(string)$a['phone'], (string)$a['local_day'], (int)$a['id']]);
+            }
+            if ($a['kind'] !== 'quote' || $q === null || !in_array((string)$a['outcome'], ['sent', 'uncertain'], true)) continue;
+            // No chase claimed after the customer answered or a person took over, from what the sender could read (A14-08).
+            $phone = (string)$q['phone'];
+            $convs = self::convIds($ro, $phone, (int)$q['sent_conv_id']);
+            $qsent = (string)$q['sent_at'];
+            $claimS = (string)$a['claimed_at'];
+            if ($convs !== []) {
+                $inIds = implode(',', $convs);
+                if (self::one($ro, "SELECT 1 FROM wa_messages WHERE conversation_id IN ({$inIds}) AND direction = 'in'
+                                    AND (sent_at > ? OR created_at > ?) AND created_at < ? LIMIT 1", [$qsent, $qsent, $claimS]) !== false) $fail[] = 'chase_after_reply';
+                $c['reply_after_claim'] += (int)self::one($ro, "SELECT COUNT(*) FROM wa_messages WHERE conversation_id IN ({$inIds}) AND direction = 'in'
+                                                               AND created_at >= ?", [$claimS]);
+            }
+            if (self::hasTable($ro, 'wa_seen_marks') && $phone !== 'erased'
+                && self::one($ro, "SELECT 1 FROM wa_seen_marks WHERE direction = 'in' AND phone = ? AND seen_at > ? AND seen_at < ? LIMIT 1",
+                             [$phone, $qsent, $claimS]) !== false) $fail[] = 'chase_after_reply';
+            if ($phone !== 'erased') {
+                $who = HumanTakeover::phoneSince($ro, $phone, $qsent, UtcClock::stamp($t - 1));
+                if ($who !== null) $fail[] = 'chase_after_person';
+                elseif (HumanTakeover::phoneSince($ro, $phone, $claimS) !== null) $c['person_after_claim']++;
+            }
+            // Not from a partner number.
+            if (self::hasTable($ro, 'wa_channels') && (string)self::one($ro, 'SELECT owner_type FROM wa_channels WHERE channel_id = ?', [(string)$q['channel']]) === 'partner') {
+                $fail[] = 'partner_chase';
+            }
+            // The R-05 trap, by identity: no Team row carrying this chase's own sent id.
+            $wa = (string)$a['wa_message_id'];
+            if ($wa !== '' && self::one($ro, "SELECT 1 FROM wa_messages WHERE wa_message_id = ? AND agent_name = 'Team' LIMIT 1", [$wa]) !== false) $fail[] = 'echo_team';
+        }
+        if ($judged === 0 && !self::anyDue($ro, $since, $now, $cold)) return self::res('NOT_YET no_traffic', $c, $notes);
+
+        // Each chase sent is in the ledger, act by act (Q16-F01), and is the template its draft records.
+        $chased = [];
+        $sends = self::all($ro, "SELECT s.*, f.quote_key, f.channel AS fchannel FROM followup_sends s JOIN followups f ON f.id = s.followup_id
+                                  WHERE f.kind = 'quote' AND s.sent_at >= ? ORDER BY s.id", [$trackSince]);
+        foreach ($sends as $s) {
+            $q = self::row($ro, 'SELECT * FROM quote_tracker WHERE quote_key = ?', [(string)$s['quote_key']]);
+            if ($cold && ($q === null || (int)($q['spoke_conv_id'] ?? 0) > 0)) continue;
+            $c['chase_sends']++;
+            $chased[(string)$s['quote_key']] = true;
+            $rows = self::all($ro, "SELECT * FROM wa_auto_sends WHERE kind = 'quote' AND ref = ? ORDER BY id", ['fu:' . (int)$s['followup_id'] . ':' . (int)$s['attempt']]);
+            $sentId = (string)($s['wa_message_id'] ?? '');
+            $match = false; $landing = false; $live = false;
+            foreach ($rows as $r) {
+                if ($r['outcome'] !== 'not_sent') $live = true;
+                if ($r['outcome'] === 'sent' && (string)($r['wa_message_id'] ?? '') === $sentId) $match = true;
+                if ($r['outcome'] === null || ($r['outcome'] === 'uncertain' && in_array((string)$r['detail'], self::SWEPT, true))) $landing = true;
+            }
+            if ($rows === [] || !$live) $fail[] = 'chase_ledger_mismatch';
+            elseif (!$match && $landing) $c['settle_not_landed']++;
+            elseif (!$match) $fail[] = 'chase_ledger_mismatch';
+            // The body: render() of the step, variant and form its draft's template id records, with the first name it carries.
+            $model = (string)self::one($ro, 'SELECT model FROM followup_drafts WHERE id = ?', [(int)($s['draft_id'] ?? 0)]);
+            $id = QuoteChaseText::parseId($model);
+            if ($id === null || $q === null) { $fail[] = 'body_not_template'; continue; }
+            $name = null;
+            if ($id[2]) {
+                $name = preg_match("/^Hello, this is (.+?)'s assistant at DishNet/u", trim((string)$s['body']), $mm) ? $mm[1] : '';
+                if ($name === '') { $fail[] = 'body_not_template'; continue; }
+            }
+            if (!QuoteChaseText::matches((string)$s['body'], $id[0], $id[1], (string)$q['quote_ref'], (string)$q['valid_until'], $name, true)) {
+                $fail[] = 'body_not_template';
+                continue;
+            }
+            if ($name !== null) {
+                try {
+                    if (!class_exists('QuoteChase')) require_once __DIR__ . '/QuoteChase.php';
+                    $today = \QuoteChase::persona($config, $dataDir, $ro, self::accounts($ro), (string)$s['fchannel']);
+                    if ($today !== null && $today !== $name) $c['persona_renamed']++;
+                } catch (\Throwable $e) { /* not read: nothing counted */ }
+            }
+        }
+        $c['chased_quotations'] = count($chased);
+        $notes[] = 'chase sends ' . $c['chase_sends'] . ', quotations chased ' . $c['chased_quotations'] . ' (never compared)';
+        foreach (self::all($ro, "SELECT handset, COALESCE(outcome, 'in_flight') AS o, COUNT(*) AS n FROM wa_auto_sends WHERE kind = 'quote' AND mode = 'claim'
+                                  AND claimed_at >= ? GROUP BY handset, o ORDER BY handset, o", [$sinceS]) as $r) {
+            $notes[] = 'quote claims ' . self::label($labels, (string)$r['handset']) . ' ' . $r['o'] . '=' . (int)$r['n'];
+        }
+        if ($cold) {
+            foreach (self::all($ro, "SELECT f.close_reason AS r, COUNT(*) AS n FROM followups f JOIN quote_tracker t ON t.quote_key = f.quote_key
+                                      WHERE f.kind = 'quote' AND f.closed_at IS NOT NULL AND COALESCE(t.spoke_conv_id, 0) <= 0
+                                      AND f.opened_at >= ? GROUP BY f.close_reason ORDER BY f.close_reason", [$sinceS]) as $r) {
+                $notes[] = 'cold follow-ups closed ' . (string)$r['r'] . '=' . (int)$r['n'];
+            }
+        }
+        $notes = array_values(array_unique($notes));
+        if ($fail !== []) return self::res('FAIL ' . $fail[0], $c, array_merge($notes, ['failed: ' . implode(', ', array_unique($fail))]));
+        return self::res('PASS', $c, $notes);
+    }
+
+    /** At least one quote follow-up came due on an open day before today, since the chase came on (Q3-ON's traffic). */
+    private static function anyDue(\PDO $ro, int $since, int $now, bool $cold): bool
+    {
+        $join = $cold ? ' JOIN quote_tracker t ON t.quote_key = f.quote_key AND COALESCE(t.spoke_conv_id, 0) <= 0' : '';
+        foreach (self::all($ro, "SELECT f.due_at FROM followups f{$join} WHERE f.kind = 'quote' AND f.due_at IS NOT NULL AND f.due_at >= ? AND f.due_at < ?",
+                           [UtcClock::stamp($since), UtcClock::stamp(self::dayStart($now))]) as $r) {
+            if ((int)self::local(UtcClock::parse((string)$r['due_at']))->format('N') !== 7) return true;
+        }
+        return false;
+    }
+
+    // ── shared reads ───────────────────────────────────────────────────────────────────────────────────────────
+
+    /** Handset => a label by role and index (no instance name, no person): `h1 (sales)`. */
+    public static function handsetLabels(array $config): array
+    {
+        $out = [];
+        $i = 0;
+        foreach (['sales', 'support', 'account'] as $role) {
+            $h = WaSendBudget::handset((string)($config['evo_instance_' . $role] ?? ''));
+            if ($h === '') continue;
+            if (!isset($out[$h])) $out[$h] = 'h' . (++$i) . ' (' . $role . ')';
+            elseif (strpos($out[$h], $role) === false) $out[$h] = substr($out[$h], 0, -1) . ', ' . $role . ')';
+        }
+        return $out;
+    }
+
+    /**
+     * A handset by role and index (§H.2.5.7): a department's from handsetLabels(); any other line is given the next index
+     * of this run, in the order it is first named — never its instance name, a staff id or a number.
+     */
+    private static function label(array &$labels, string $h): string
+    {
+        if (!isset($labels[$h])) $labels[$h] = 'h' . (count($labels) + 1) . ' (another line)';
+        return $labels[$h];
+    }
+
+    /** An owner by index within this run (`owner 1…n`, §H.2.8.2), in the order first named; never the staff id. */
+    private static function ownerLabel(array &$owners, string $owner): string
+    {
+        if ($owner === 'central') return 'the central list';
+        if (!isset($owners[$owner])) $owners[$owner] = 'owner ' . (count($owners) + 1);
+        return $owners[$owner];
+    }
+
+    /** A read-only stand-in for the store's retailers.json, over $ro (what LineOwner::of reads for today's first name). */
+    private static function accounts(\PDO $ro)
+    {
+        $rows = [];
+        if (self::hasTable($ro, 'retailers')) {
+            foreach ($ro->query('SELECT data FROM [retailers] ORDER BY id')->fetchAll(\PDO::FETCH_COLUMN) as $j) {
+                $r = json_decode((string)$j, true);
+                if (is_array($r)) $rows[] = $r;
+            }
+        }
+        return new class($rows) {
+            private $rows;
+            public function __construct(array $rows) { $this->rows = $rows; }
+            public function load(string $file): array { return $file === 'retailers.json' ? $this->rows : []; }
+            public function findOne(string $file, string $field, $value): ?array
+            {
+                if ($file !== 'retailers.json') return null;
+                foreach ($this->rows as $r) if ((string)($r[$field] ?? '') === (string)$value) return $r;
+                return null;
+            }
+        };
+    }
+
+    private static function salesHandset(array $config): string
+    {
+        return WaSendBudget::handset((string)($config['evo_instance_sales'] ?? ''));
+    }
+
+    private static function convIds(\PDO $ro, string $phone, int $sentConvId): array
+    {
+        if (!class_exists('QuoteTracker')) require_once __DIR__ . '/QuoteTracker.php';
+        return \QuoteTracker::convIds($ro, $phone, $sentConvId);
+    }
+
+    private static function schemaRow(\PDO $ro, string $migration): bool
+    {
+        if (!self::hasTable($ro, '_schema_checks')) return false;
+        return (int)self::one($ro, 'SELECT COUNT(*) FROM _schema_checks WHERE migration = ? AND found = expected', [$migration]) > 0;
+    }
+
+    private static function state(\PDO $ro, string $k): ?string
+    {
+        if (!self::hasTable($ro, 'quote_followup_state')) return null;
+        $v = self::one($ro, 'SELECT v FROM quote_followup_state WHERE k = ?', [$k]);
+        return ($v === false || $v === null) ? null : (string)$v;
+    }
+
+    private static function parseTime($v): ?int
+    {
+        if (is_int($v)) return $v > 0 ? $v : null;
+        if (!is_string($v) || trim($v) === '') return null;
+        $s = trim($v);
+        $t = ctype_digit($s) ? (int)$s : UtcClock::parse($s);
+        return $t > 0 ? $t : null;
+    }
+
+    private static function truthy($v): bool
+    {
+        if (is_bool($v)) return $v;
+        if (is_int($v)) return $v === 1;
+        return is_string($v) && in_array(strtolower(trim($v)), ['1', 'true', 'on', 'yes'], true);
+    }
+
+    private static function local(int $t): \DateTime
+    {
+        return (new \DateTime('@' . $t))->setTimezone(new \DateTimeZone(self::TZ));
+    }
+
+    /** A Message Log stamp, written with date() in the install's zone (Kampala), as a unix time. */
+    private static function fromLocal(string $s): ?int
+    {
+        if (!preg_match('/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/', trim($s))) return null;
+        try { return (new \DateTime(trim($s), new \DateTimeZone(self::TZ)))->getTimestamp(); } catch (\Throwable $e) { return null; }
+    }
+
+    /** Kampala midnight of $t's day. */
+    private static function dayStart(int $t): int
+    {
+        return (new \DateTime(self::local($t)->format('Y-m-d') . ' 00:00:00', new \DateTimeZone(self::TZ)))->getTimestamp();
+    }
+
+    /** The first Kampala midnight after $t. */
+    private static function nextMidnight(int $t): int
+    {
+        return self::dayStart(self::dayStart($t) + self::DAY_S + 3600);
+    }
+
+    /** $hour:00 Kampala on a Y-m-d date; null when the date cannot be read. */
+    private static function at(string $ymd, int $hour): ?int
+    {
+        if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', trim($ymd))) return null;
+        try { return (new \DateTime(trim($ymd) . sprintf(' %02d:00:00', $hour), new \DateTimeZone(self::TZ)))->getTimestamp(); } catch (\Throwable $e) { return null; }
+    }
+
+    private static function res(string $status, array $counts, array $notes): array
+    {
+        return ['status' => $status, 'counts' => array_map('intval', $counts), 'notes' => array_values(array_map('strval', $notes))];
+    }
+
+    private static function hasTable(\PDO $pdo, string $name): bool
+    {
+        $st = $pdo->prepare("SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = ?");
+        $st->execute([$name]);
+        return (int)$st->fetchColumn() > 0;
+    }
+
+    private static function hasColumn(\PDO $pdo, string $table, string $col): bool
+    {
+        if (!self::hasTable($pdo, $table)) return false;
+        foreach ($pdo->query('PRAGMA table_info(' . $table . ')')->fetchAll(\PDO::FETCH_ASSOC) as $c) {
+            if (($c['name'] ?? '') === $col) return true;
+        }
+        return false;
+    }
+
+    /** @return mixed the first column of the first row, or false */
+    private static function one(\PDO $pdo, string $sql, array $args = [])
+    {
+        $st = $pdo->prepare($sql);
+        $st->execute($args);
+        return $st->fetchColumn();
+    }
+
+    private static function row(\PDO $pdo, string $sql, array $args = []): ?array
+    {
+        $st = $pdo->prepare($sql);
+        $st->execute($args);
+        $r = $st->fetch(\PDO::FETCH_ASSOC);
+        return is_array($r) ? $r : null;
+    }
+
+    private static function all(\PDO $pdo, string $sql, array $args = []): array
+    {
+        $st = $pdo->prepare($sql);
+        $st->execute($args);
+        return $st->fetchAll(\PDO::FETCH_ASSOC);
+    }
+}
