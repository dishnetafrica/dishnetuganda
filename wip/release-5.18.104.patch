+        }
+    });
+
+    $ctx->run('M03 the rung lowered: an R1 note whose first call recorded dry_run is not an R1 call (VK8; T28)', function () use ($ctx, $world, $on1) {
+        $b = $world();
+        $n = $b['notes'][7];
