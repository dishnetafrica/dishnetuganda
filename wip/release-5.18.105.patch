+        $ctx->eq($four, 1, 'F01 control: one number (support\'s) has a four-digit 30-day conv — F\'s 1,000 sessions');
+        $kinds = ['tail' => [], 'dash' => [], 'never' => []]; $seen = ['tail' => 0, 'dash' => 0, 'never' => 0];
+        foreach ($blocks as $d => $b) {
