+$lmP = (string)preg_replace('#^/api/v[0-9.]+#', '', (string)(parse_url((string)($_SERVER['REQUEST_URI'] ?? ''), PHP_URL_PATH) ?: ''));
+$lmM = (string)($_SERVER['REQUEST_METHOD'] ?? 'GET');
