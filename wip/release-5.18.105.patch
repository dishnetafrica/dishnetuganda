+                ? array_values(array_unique(array_merge(array_filter(array_keys($tree), function ($r) use ($h) { return strpos($r, $h) === 0; }),
+                                                        array_filter(array_keys($base), function ($r) use ($h) { return strpos($r, $h) === 0; }))))
