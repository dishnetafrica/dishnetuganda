+        $ctx->eq($f[0] ?? '', 'TASK A: Notified Test Agent → lead #' . $ids[30], 'LN-30 "TASK A: Notified <agent> → lead #<id>"');
+        $f = lm_ln($ctx, 'LN-31', $lines, $nums);
