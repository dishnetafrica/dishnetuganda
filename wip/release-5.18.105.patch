+    $rows = array_values(array_filter($state['rows'], function ($r) use ($since) { return (int)($r['pkId'] ?? 0) > $since; }));
+    lmwf_out(['ok' => true, 'messages' => array_slice($rows, 0, $limit)]);
+}
