+// ── Official Starlink API shadow fallback (ADDITIVE, FLAG-OFF) ──────────────────
+// Cookie stays primary. When the flag is on AND a kit has NO cookie usage, fill the
+// gap from the parallel official-API shadow (data/api_shadow/) so the kit shows real
+// data instead of "no usage yet". Default OFF => byte-identical behaviour.
+// Enable per-install: `touch data/api_shadow/VIEW_ENABLED` (or env DR_OFFICIAL_API_VIEW=yes).
+function drOfficialApiViewOn(string $pluginDir): bool {
+    return getenv('DR_OFFICIAL_API_VIEW') === 'yes'
+        || is_file($pluginDir . '/data/api_shadow/VIEW_ENABLED');
+}
+function drShadowAxis(string $iso): string {
+    if ($iso === '') return '';
+    $ts = strtotime($iso);
+    return $ts === false ? '' : date('M j', $ts);
+}
+// Official-API usage rows shaped like cookie sl_usage records, or [] when flag off /
+// no shadow present. Joined to kit_number via the shadow service_lines.json.
+function drOfficialApiUsageRows(string $pluginDir): array {
+    if (!drOfficialApiViewOn($pluginDir)) return [];
+    $dir   = $pluginDir . '/data/api_shadow';
+    $usage = drLoad($dir . '/usage.json');
+    if (!$usage) return [];
+    $slToKit = [];
+    foreach (drLoad($dir . '/service_lines.json') as $r) {
+        $sl = $r['service_line'] ?? ''; $kn = $r['kit_number'] ?? '';
+        if ($sl !== '' && $kn) $slToKit[$sl] = $kn;
+    }
+    $rows = [];
+    foreach ($usage as $u) {
+        $sl = $u['service_line'] ?? '';
+        $kn = $slToKit[$sl] ?? '';
+        if ($kn === '') continue; // need a kit_number to join into the plugin's views
+        $start = (string)($u['cycle_start'] ?? '');
+        $end   = (string)($u['cycle_end'] ?? '');
+        $rows[] = [
+            'kit_number'               => $kn,
+            'service_line'             => $sl,
+            'account_number'           => $u['account_number'] ?? '',
+            'cycle_key'                => substr($start, 0, 7),              // YYYY-MM (sortable)
+            'cycle_label'              => trim(drShadowAxis($start) . ' – ' . drShadowAxis($end), ' –'),
+            'total_gb'                 => (float)($u['total_gb'] ?? 0),
+            'local_priority_used_gb'   => (float)($u['priority_gb'] ?? 0),
+            'other_data_gb'            => (float)($u['standard_gb'] ?? 0),
+            'local_priority_allowance' => '',
+            'other_data_allowance'     => '',
+            'axis_left'                => drShadowAxis($start),
+            'axis_right'               => drShadowAxis($end),
+            'daily_blue'               => [],   // daily arrays not stored in the shadow yet
+            'daily_white'              => [],
+            'updated_at'               => $u['last_updated'] ?? '',
+            'source'                   => 'official_api',
+        ];
+    }
+    return $rows;
+}
+// Cookie-first merge: append shadow rows ONLY for kit_numbers with no cookie usage.
+function drMergeShadowUsage(array $cookieRows, string $pluginDir): array {
+    $shadow = drOfficialApiUsageRows($pluginDir);
+    if (!$shadow) return $cookieRows;
+    $haveCookie = [];
+    foreach ($cookieRows as $r) {
+        $kn = $r['kit_number'] ?? '';
+        if ($kn !== '') $haveCookie[$kn] = true;
+    }
+    foreach ($shadow as $r) {
+        $kn = $r['kit_number'] ?? '';
+        if ($kn !== '' && empty($haveCookie[$kn])) $cookieRows[] = $r;
+    }
+    return $cookieRows;
+}
+
 function drSave(string $path, array $data): void {
     file_put_contents($path, json_encode(array_values($data), JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));
 }
