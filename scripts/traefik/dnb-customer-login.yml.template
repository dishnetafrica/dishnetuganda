# /etc/easypanel/traefik/config/dnb-customer-login.yml
#
# The clean customer-login address — optional, cosmetic, and separate from the
# website change (the website links the canonical portal URL directly):
#
#   https://crm.dishnetuganda.com/customer-login   (and the http:// form)
#     → 302 → https://crm.dishnetuganda.com/crm/_plugins/dishnet-hybrid-sudan/public.php?page=customer_login
#
# One new file for Traefik's file provider, in the shape of traefik-mail.yml
# and the staging routes on this host: entryPoints "https" / "http", an explicit
# priority, tls.certResolver on the https router. It never edits main.yaml or
# uisp.yaml, adds two routers for one path on a host whose certificate already
# exists, and is removed by deleting the file. `permanent: false` (302) for the
# first weeks; change to true (301) once the address is stable. Placed and
# verified by scripts/customer-login-clean-url.sh, which fills the placeholders
# from uisp.yaml (the certificate resolver, and a priority above its host router).
http:
  routers:
    dnb-customer-login:
      rule: "Host(`crm.dishnetuganda.com`) && Path(`/customer-login`)"
      entryPoints: ["https"]
      __PRIORITY_LINE__
      service: noop@internal
      middlewares: ["dnb-customer-login-redirect"]
      tls:
        certResolver: __RESOLVER__
    dnb-customer-login-http:
      rule: "Host(`crm.dishnetuganda.com`) && Path(`/customer-login`)"
      entryPoints: ["http"]
      __PRIORITY_LINE__
      service: noop@internal
      middlewares: ["dnb-customer-login-redirect"]
  middlewares:
    dnb-customer-login-redirect:
      redirectRegex:
        regex: "^https?://crm\\.dishnetuganda\\.com/customer-login/?(\\?.*)?$"
        replacement: "https://crm.dishnetuganda.com/crm/_plugins/dishnet-hybrid-sudan/public.php?page=customer_login"
        permanent: false
