# DishNet MikroTik control plane — environment template.
#
# Copy to a file the web user can read and NOTHING else can:
#   cp plugin/.env.example /etc/dnb/dnb.env && chmod 0640 /etc/dnb/dnb.env
#
# This file lists every variable the code actually reads. It was generated from
# a grep of src/, bin/, plugin/ and tools/, not from memory: a variable the
# manifest forgot is still a variable the runtime demands, and this project has
# already recorded what an undeclared dependency costs at install time.
#
# NO VALUE BELOW IS A REAL CREDENTIAL. Every password here is a placeholder that
# `plugin.php doctor` will flag if it survives into a real deployment.

# ── required ────────────────────────────────────────────────────────────────
# The plugin's OWN PostgreSQL database. Never a Domain A / UCRM database.
DNB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=dnb

# HMAC pepper for auth tokens and activation tickets. 32+ random bytes, hex.
# Rotating it invalidates every outstanding token. Generate with:
#   php -r 'echo bin2hex(random_bytes(32)), "\n";'
DNB_TOKEN_PEPPER=CHANGE-ME-generate-32-random-bytes

# Symmetric key for stored device credentials (SecretBox). SecretBox REFUSES to
# run without it rather than defaulting, so any path that touches a device
# credential fails closed while this is unset. The Admin read panel does not
# need it; the worker and every device-credential write do.
DNB_SECRET_KEY=CHANGE-ME-generate-32-random-bytes

# ── database identities ─────────────────────────────────────────────────────
# Six login roles, one per execution context. They are NOT interchangeable and
# none is a member of another. Set every password: migration 001 and its
# successors create these roles with development literals, and an install that
# leaves them in place has six known passwords on the cluster.
DNB_OWNER_USER=dnb
DNB_OWNER_PASS=
DNB_APP_USER=dnb_app
DNB_APP_PASS=
DNB_WORKER_USER=dnb_worker
DNB_WORKER_PASS=
DNB_ADMIN_USER=dnb_admin
DNB_ADMIN_PASS=
DNB_ADMINAPI_USER=dnb_adminapi
DNB_ADMINAPI_PASS=
DNB_ADMINWRITE_USER=dnb_adminwrite
DNB_ADMINWRITE_PASS=
DNB_RADIUS_USER=dnb_radius
DNB_RADIUS_PASS=

# ── optional ────────────────────────────────────────────────────────────────
# Shared secret for the internal RADIUS accounting route. Unset means that
# route admits nobody.
DNB_INTERNAL_TOKEN=

# ── MUST BE ABSENT IN ANY REAL DEPLOYMENT ───────────────────────────────────
# Each of these is checked by `plugin.php doctor`, which fails when one is set
# outside a disposable environment.
#
# Returns the OTP in the API response. A development affordance only.
# DNB_EXPOSE_OTP=1
#
# Binds the Admin panel to a fabricated staff identity. The production binding
# is DenyAllIdentity, and staff authentication (W-4) is not built, so this is
# currently the ONLY way the panel renders anything. That is a condition on
# this release, not a feature.
# DN_DEV_STAFF_IDENTITY=yes-development-only
#
# The F6-B gate. Absent or not exactly this value means every hardware adapter
# stays simulated and no packet reaches a real MikroTik or a real RADIUS.
# F6-B IS NOT AUTHORIZED. Do not set this.
# DN_ALLOW_REAL_BINDINGS=yes-f6b-authorized
#
# BYPASSRLS test-fixture identity. tests/ only. Setting it in a deployment puts
# a row-level-security bypass into the runtime environment.
# DNB_INSPECT_USER=postgres
# DNB_INSPECT_PASS=
