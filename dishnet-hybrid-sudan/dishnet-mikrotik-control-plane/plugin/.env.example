# DishNet MikroTik control plane — environment template.
#
# Copy to a file the web user can read and NOTHING else can:
#   cp plugin/.env.example /etc/dnb/dnb.env && chmod 0640 /etc/dnb/dnb.env
#
# This file lists every variable the code actually reads. It was generated from
# a grep of src/, bin/, plugin/ and tools/, not from memory: a variable the
# manifest forgot is still a variable the runtime demands, and this project has
# already recorded what an undeclared dependency costs at install time.
#
# NO VALUE BELOW IS A REAL CREDENTIAL. Every password here is a placeholder that
# `plugin.php doctor` will flag if it survives into a real deployment.

# ── required ────────────────────────────────────────────────────────────────
# The plugin's OWN PostgreSQL database. Never a Domain A / UCRM database.
# QUOTED deliberately: the DSN contains semicolons, and `set -a; . this-file`
# otherwise parses them as command separators and sets DNB_DSN to the first
# fragment only. Measured, not theorised.
DNB_DSN="pgsql:host=127.0.0.1;port=5432;dbname=dnb"

# HMAC pepper for auth tokens and activation tickets. 32+ random bytes, hex.
# Rotating it invalidates every outstanding token. Generate with:
#   php -r 'echo bin2hex(random_bytes(32)), "\n";'
DNB_TOKEN_PEPPER=CHANGE-ME-generate-32-random-bytes

# Symmetric key for stored device credentials (SecretBox). SecretBox REFUSES to
# run without it rather than defaulting, so any path that touches a device
# credential fails closed while this is unset. The Admin read panel does not
# need it; the worker and every device-credential write do.
DNB_SECRET_KEY=CHANGE-ME-generate-32-random-bytes

# ── database identities ─────────────────────────────────────────────────────
# Seven login roles, one per execution context. They are NOT interchangeable and
# none is a member of another.
#
# The migrations create all seven with NO PASSWORD (docs/97), so under
# scram-sha-256 none of them can authenticate until the installer provisions a
# credential. Two ways, and you pick by what you set:
#
#   SUPPLIED   fill these in yourself. The installer applies them on every
#              install, so your secret manager stays the source of truth.
#   GENERATED  leave them empty and set DNB_SECRETS_OUT to a file path. The
#              installer mints 32 random bytes each and writes them there,
#              mode 0600. Nothing is ever printed.
DNB_OWNER_USER=dnb
DNB_OWNER_PASS=
DNB_APP_USER=dnb_app
DNB_APP_PASS=
DNB_WORKER_USER=dnb_worker
DNB_WORKER_PASS=
DNB_ADMIN_USER=dnb_admin
DNB_ADMIN_PASS=
DNB_ADMINAPI_USER=dnb_adminapi
DNB_ADMINAPI_PASS=
DNB_ADMINWRITE_USER=dnb_adminwrite
DNB_ADMINWRITE_PASS=
DNB_RADIUS_USER=dnb_radius
DNB_RADIUS_PASS=
# Migration 026: DishNet staff AUTHENTICATION. EXECUTE on login, resolve and
# logout, zero table privileges. Separate from the Admin write role on purpose:
# code that runs before anyone is authenticated must not connect as something
# that can register a router.
DNB_STAFFAUTH_USER=dnb_staffauth
DNB_STAFFAUTH_PASS=

# Install-time only. Where GENERATED secrets are written. Not needed when every
# password above is supplied.
# DNB_SECRETS_OUT=/etc/dnb/secrets.env

# Install-time only. Allows the installer to mint new passwords for roles that
# predate this installation. Refused by default: the roles are cluster-wide, so
# the deployment you would break may be a different database.
# DNB_ROTATE_CREDENTIALS=yes-rotate-now

# ── optional ────────────────────────────────────────────────────────────────
# Shared secret for the internal RADIUS accounting route. Unset means that
# route admits nobody.
DNB_INTERNAL_TOKEN=

# Worker delivery binding (docs/118): null | simulated | routeros. Unset means null:
# nothing is delivered and intents stay queued. 'routeros' also needs the F6-B gate
# (DN_ALLOW_REAL_BINDINGS) and refuses to start without it. No value ever falls back.
# DN_DELIVERY=null

# ── DishNet staff sign-in (migration 026, docs/114 G-B) ─────────────────────
# WHO may sign in to the Admin panel is an explicit choice. Unset: nobody
# (DenyAllIdentity — every route 401, POST /session 501). 'dishnet': the real
# provider — bcrypt and TOTP verified inside PostgreSQL, decaying lockout,
# revocable server-side sessions. Any other value refuses to start, and so does
# setting this beside DN_DEV_STAFF_IDENTITY.
# DN_STAFF_IDENTITY=dishnet
#
# A signed-in person must confirm an authenticator before doing anything but
# enrolling one. 'no' relaxes that for DEVELOPMENT ONLY; doctor blocks it
# elsewhere (D-AUTH-5: mandatory before a public hostname).
# DN_STAFF_REQUIRE_TOTP=yes
#
# The address(es) of the reverse proxy that terminates TLS. X-Forwarded-Proto
# is believed from these and ignored from everyone else. A staff session is
# issued only over TLS; unset, only a request PHP itself received over TLS
# counts, and every login through a proxy answers 403 insecure_transport.
# DN_TRUSTED_PROXY=127.0.0.1
#
# The portal's own origin. A mutating request whose Origin names anything else
# is refused. Unset: the Origin must match the request's Host.
# DN_PORTAL_ORIGIN=https://admin.example

# ── MUST BE ABSENT IN ANY REAL DEPLOYMENT ───────────────────────────────────
# Each of these is checked by `plugin.php doctor`, which fails when one is set
# outside a disposable environment.
#
# Returns the OTP in the API response. A development affordance only.
# DNB_EXPOSE_OTP=1
#
# Binds the Admin panel to a fabricated staff identity. The production binding
# is DenyAllIdentity, and staff authentication (W-4) is not built, so this is
# currently the ONLY way the panel renders anything. That is a condition on
# this release, not a feature.
# DN_DEV_STAFF_IDENTITY=yes-development-only
#
# The F6-B gate. Absent or not exactly this value means every hardware adapter
# stays simulated and no packet reaches a real MikroTik or a real RADIUS.
# F6-B IS NOT AUTHORIZED. Do not set this.
# DN_ALLOW_REAL_BINDINGS=yes-f6b-authorized
#
# BYPASSRLS test-fixture identity. tests/ only. Setting it in a deployment puts
# a row-level-security bypass into the runtime environment.
# DNB_INSPECT_USER=postgres
# DNB_INSPECT_PASS=
